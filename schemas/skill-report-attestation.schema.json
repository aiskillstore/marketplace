{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillstore.io/schemas/skill-report-attestation.schema.json",
  "title": "Skill Report Audit Attestation v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slug", "producer", "invocation", "report", "package"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "package_version", "audit_command_version"],
      "properties": {
        "repository": {
          "type": "string",
          "const": "aiskillstore/skillstore"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "package_version": {
          "type": "string",
          "minLength": 1
        },
        "audit_command_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "started_at",
        "completed_at",
        "cwd",
        "command",
        "skills_root",
        "slugs",
        "model",
        "stdout_digest",
        "stderr_digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "string"
          }
        },
        "skills_root": {
          "type": "string",
          "minLength": 1
        },
        "slugs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "stdout_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stderr_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_digest", "raw_audit_digest", "final_digest"],
      "properties": {
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "raw_audit_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_hash", "tree_hash"],
      "properties": {
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "tree_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
