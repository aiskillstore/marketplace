{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillstore.io/schemas/skill-publish-approvals.schema.json",
  "title": "Skill Publication Approval v2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approvals"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "content_hash",
          "tree_hash",
          "submission_id",
          "submission_source_url",
          "approval_issue_number",
          "approval_issue_url",
          "approval_comment_id",
          "approval_comment_url",
          "actor",
          "created_at",
          "updated_at",
          "expires_at",
          "reason",
          "pr_number",
          "pr_url",
          "pr_base_sha",
          "pr_head_ref",
          "pr_head_sha",
          "scope"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tree_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "submission_id": {
            "type": "string",
            "format": "uuid"
          },
          "submission_source_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+(?:/.*)?$"
          },
          "approval_issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "approval_issue_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/issues/[1-9][0-9]*$"
          },
          "approval_comment_id": {
            "type": "integer",
            "minimum": 1
          },
          "approval_comment_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
          },
          "actor": {
            "type": "string",
            "minLength": 1,
            "not": {
              "pattern": "\\[[Bb][Oo][Tt]\\]$"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 20
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1
          },
          "pr_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/pull/[1-9][0-9]*$"
          },
          "pr_base_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "pr_head_ref": {
            "type": "string",
            "minLength": 1
          },
          "pr_head_sha": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "scope": {
            "type": "string",
            "const": "safe_to_publish"
          }
        }
      }
    }
  }
}
