{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillstore.io/schemas/skill-publish-approvals.schema.json",
  "title": "Skill Publication Approval v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approvals"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "content_hash",
          "tree_hash",
          "actor",
          "approved_at",
          "reason",
          "evidence_url",
          "scope"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tree_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string",
            "minLength": 20
          },
          "evidence_url": {
            "type": "string",
            "pattern": "^https://github\\.com/[^/?#]+/[^/?#]+/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
          },
          "scope": {
            "type": "string",
            "const": "safe_to_publish"
          }
        }
      }
    }
  }
}
