  "content": {
    "user_title": "Prepare Compliant US A2P 10DLC Registrations",
    "value_statement": "10DLC registration often fails because evidence and API payload requirements differ. This skill prepares both artifacts and validates them before submission.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "10DLC registration",
      "A2P SMS compliance",
      "TCR campaign",
      "Sent API",
      "SMS opt-in evidence",
      "campaign payload validation",
      "Sender Profiles"
    ],
    "actual_capabilities": [
      "Builds a versioned readiness packet for legal identity, consent, message flow, autoresponses, and sample messages.",
      "Validates evidence packets locally for required fields, formats, supported use cases, and sample limits.",
      "Translates readiness evidence into the exact camelCase Sent campaign request structure.",
      "Validates Sent campaign payload fields, use cases, volume, URLs, and policy sample counts.",
      "Explains brand and campaign inheritance choices for Sender Profiles.",
      "Guides rejection diagnosis across local validation, Sent validation, TCR submission, and carrier operations."
    ],
    "limitations": [
      "It does not submit registrations or make Sent API requests automatically.",
      "It does not verify that URLs are publicly reachable or that consent evidence is legally sufficient.",
      "It does not guarantee TCR approval, carrier activation, message delivery, or regulatory compliance.",
      "It covers US A2P SMS over 10-digit long codes and the documented Sent v3 model."
    ],
    "use_cases": [
      {
        "title": "Prepare a first registration",
        "description": "Collect business and consent evidence, choose inheritance, and produce a validated sandbox campaign request.",
        "target_user": "Application developers integrating business SMS"
      },
      {
        "title": "Review campaign readiness",
        "description": "Check message flows, autoresponses, use cases, and samples before a registration reaches TCR.",
        "target_user": "Compliance and messaging operations teams"
      },
      {
        "title": "Resolve a rejected campaign",
        "description": "Identify the failing validation layer, correct the evidence or request, and prepare a controlled resubmission.",
        "target_user": "Support engineers handling registration failures"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start an evidence checklist",
        "prompt": "Create a 10DLC evidence checklist for my business. Ask only for missing information and use placeholders for sensitive consumer data.",
        "scenario": "Beginner preparation for a new registration"
      },
      {
        "title": "Review an evidence packet",
        "prompt": "Review this 10DLC evidence packet for required fields, consent quality, autoresponses, use-case alignment, and realistic synthetic samples.",
        "scenario": "Validate readiness before API translation"
      },
      {
        "title": "Build a sandbox request",
        "prompt": "Translate this approved evidence packet into a Sent campaign request. Preserve policy distinctions, use sandbox mode, and explain every mapping.",
        "scenario": "Create a reviewable campaign payload"
      },
      {
        "title": "Diagnose and remediate rejection",
        "prompt": "Analyze this validation response and campaign evidence. Identify the failing layer, propose corrections, show the exact changes, and avoid real mutation.",
        "scenario": "Advanced investigation of a rejected registration"
      }
    ],
    "output_examples": [
      {
        "input": "Review a marketing campaign with one sample message and incomplete HELP text.",
        "output": [
          "Readiness result: not ready for submission.",
          "Add a second realistic marketing sample with the recognizable brand and opt-out language.",
          "Expand the HELP response with the brand and a support method."
        ]
      },
      {
        "input": "Explain whether a tenant should inherit the brand but own its campaign.",
        "output": "Use brand inheritance when the tenant shares the registered legal brand. Disable campaign inheritance when its traffic, consent, and samples are tenant-specific."
      },
      {
        "input": "Interpret a campaign record with SENT_CREATED and submittedToTCR set to false.",
        "output": "A Sent campaign record exists, but registry submission has not occurred. Do not treat the campaign as active or send-ready."
      }
    ],
    "best_practices": [
      "Use synthetic names, phone numbers, codes, and URLs in fixtures and sample messages.",
      "Validate the evidence packet before translation, then validate the exact campaign request.",
      "Use sandbox mode and obtain confirmation before any real create, update, or delete operation."
    ],
    "anti_patterns": [
      "Do not treat the internal snake_case evidence packet as the Sent API payload.",
      "Do not select MIXED or LOW_VOLUME to hide traffic that belongs to another use case.",
      "Do not infer TCR approval or carrier activation from successful Sent record creation."
    ],
    "faq": [
      {
        "question": "Does this skill submit a campaign to Sent or TCR?",
        "answer": "No. It prepares and validates artifacts. Real API mutations require separate tooling and explicit confirmation."
      },
      {
        "question": "What is the difference between the evidence packet and campaign request?",
        "answer": "The evidence packet is an internal snake_case readiness artifact. The Sent request uses exact camelCase API fields."
      },
      {
        "question": "Which US messaging use cases are supported?",
        "answer": "The validators support all 13 values documented by the current Sent campaign model."
      },
      {
        "question": "How many sample messages are required?",
        "answer": "The API accepts one to five per use case. Marketing, mixed, and low-volume mixed traffic require at least two under compliance policy."
      },
      {
        "question": "Does a SENT_CREATED status mean the campaign is active?",
        "answer": "No. It means a Sent record exists. Review submittedToTCR and the raw status before treating the campaign as active."
      },
      {
        "question": "Can the validators confirm that consent evidence is legally sufficient?",
        "answer": "No. They check structure and basic policy fields. A qualified reviewer must assess legal sufficiency and current requirements."
      }
    ]
  },
