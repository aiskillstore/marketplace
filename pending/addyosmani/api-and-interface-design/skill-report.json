  "content": {
    "user_title": "Design Stable APIs and Interfaces",
    "value_statement": "Inconsistent interfaces create fragile integrations and costly breaking changes. This skill guides contract-first design, predictable errors, validation, compatibility, pagination, and reliable idempotency.",
    "seo_keywords": [
      "Claude API design",
      "Codex interface design",
      "Claude Code REST API",
      "contract-first development",
      "TypeScript interfaces",
      "API error handling",
      "idempotency keys",
      "backward compatibility",
      "REST pagination",
      "module boundaries"
    ],
    "actual_capabilities": [
      "Defines contract-first REST endpoints and typed module interfaces.",
      "Standardizes HTTP status codes and structured error responses.",
      "Places input validation at API and external service boundaries.",
      "Designs additive interface changes that preserve existing consumers.",
      "Explains atomic idempotency handling, payload guards, retries, and retention.",
      "Reviews naming, pagination, partial updates, and TypeScript type patterns."
    ],
    "limitations": [
      "Provides design guidance but does not deploy or operate an API.",
      "Examples use TypeScript concepts and require adaptation for other languages.",
      "Does not replace domain-specific security, privacy, or compliance review.",
      "Does not generate a complete OpenAPI or GraphQL specification automatically."
    ],
    "use_cases": [
      {
        "title": "Define a New Service Contract",
        "description": "Create predictable resources, request schemas, response schemas, errors, and pagination before implementation begins.",
        "target_user": "Backend engineers"
      },
      {
        "title": "Review a Public Interface Change",
        "description": "Identify breaking changes and redesign them as additive updates with clear migration behavior.",
        "target_user": "API maintainers"
      },
      {
        "title": "Align Cross-Team Boundaries",
        "description": "Establish typed contracts, naming conventions, validation ownership, and retry semantics between frontend and backend teams.",
        "target_user": "Technical leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Outline a REST Resource",
        "prompt": "Design REST endpoints for [resource]. Include methods, paths, request fields, response fields, status codes, and pagination.",
        "scenario": "Start a simple resource API."
      },
      {
        "title": "Define a Typed Contract",
        "prompt": "Create a contract-first interface for [feature]. Separate inputs from outputs and define one consistent error model.",
        "scenario": "Coordinate implementation across modules or teams."
      },
      {
        "title": "Review Compatibility Risks",
        "prompt": "Review this interface change: [change]. Identify observable behavior, breaking risks, and additive alternatives for existing consumers.",
        "scenario": "Evaluate a proposed public API update."
      },
      {
        "title": "Design Reliable Idempotency",
        "prompt": "Design idempotency for [operation]. Cover key ownership, atomic claiming, payload hashes, in-flight duplicates, unknown outcomes, and retention.",
        "scenario": "Protect advanced state-changing or payment workflows."
      }
    ],
    "output_examples": [
      {
        "input": "Design task-management endpoints for web and mobile clients.",
        "output": [
          "A resource map covering task creation, listing, retrieval, partial updates, deletion, and comments.",
          "A consistent error contract with validation, authorization, conflict, and server failure semantics.",
          "A pagination and filtering policy with stable field naming."
        ]
      },
      {
        "input": "Review an endpoint that charges a card and accepts retries.",
        "output": [
          "A client-owned idempotency key tied to one payment intent.",
          "An atomic uniqueness claim with request payload verification.",
          "Defined responses for completed, in-flight, failed, and unknown outcomes.",
          "A retention period based on the longest possible retry path."
        ]
      }
    ],
    "best_practices": [
      "Define inputs, outputs, errors, and observable behavior before implementation.",
      "Validate untrusted data at system boundaries and keep internal contracts typed.",
      "Prefer additive optional fields and document deprecation before removing behavior."
    ],
    "anti_patterns": [
      "Mixing error shapes or failure strategies across related endpoints.",
      "Changing public field types or removing fields without a migration plan.",
      "Implementing idempotency with a separate existence check and side effect."
    ],
    "faq": [
      {
        "question": "Does this skill support REST and GraphQL?",
        "answer": "It directly details REST and general interface principles. The contract, validation, compatibility, and error guidance also applies to GraphQL."
      },
      {
        "question": "Can it design TypeScript interfaces?",
        "answer": "Yes. It covers separate input and output types, discriminated unions, branded identifiers, and predictable method contracts."
      },
      {
        "question": "Does it create implementation code?",
        "answer": "It can guide code structure and provide examples, but its primary purpose is interface and contract design."
      },
      {
        "question": "How does it handle breaking changes?",
        "answer": "It favors additive optional fields, stable observable behavior, explicit deprecation, and planned consumer migration."
      },
      {
        "question": "What idempotency topics are covered?",
        "answer": "It covers stable keys, atomic claims, payload matching, concurrent retries, unknown outcomes, and retention windows."
      },
      {
        "question": "Does it perform security testing?",
        "answer": "No. It recommends boundary validation and hidden internal details, but dedicated security testing remains necessary."
      }
    ]
