{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STOW project terminology authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "normalization", "authority", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "normalization": {"const": "NFKC-casefold-whitespace"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "user-declaration",
            "project-glossary",
            "repository-documentation",
            "subject-field-authority",
            "configured-external-authority"
          ]
        },
        "revision": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "nonemptyStringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "origin"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "origin": {"enum": ["project-authority", "stow-synthetic"]}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "kind",
        "status",
        "preferred_form",
        "approved_forms",
        "nonpreferred_forms",
        "meaning_scope",
        "source_locator",
        "match"
      ],
      "properties": {
        "term": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "technical-noun",
            "technical-verb",
            "abbreviation",
            "canonical-term"
          ]
        },
        "status": {"enum": ["candidate", "approved", "rejected"]},
        "preferred_form": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "approved_forms": {"$ref": "#/$defs/nonemptyStringArray"},
        "nonpreferred_forms": {"$ref": "#/$defs/nonemptyStringArray"},
        "meaning_scope": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1},
        "match": {
          "enum": [
            "literal-exact",
            "literal-casefold",
            "token-exact",
            "token-casefold"
          ]
        },
        "good_example": {"$ref": "#/$defs/example"},
        "bad_example": {"$ref": "#/$defs/example"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "approved"}}},
          "then": {
            "properties": {
              "preferred_form": {"type": "string", "minLength": 1},
              "approved_forms": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "candidate"}}},
          "then": {
            "properties": {
              "preferred_form": {"type": "null"},
              "approved_forms": {"maxItems": 0},
              "nonpreferred_forms": {"maxItems": 0}
            }
          }
        }
      ]
    }
  }
}
