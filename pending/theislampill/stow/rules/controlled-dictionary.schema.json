{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["records", "approved", "not_approved", "letter_sections", "approved_verbs"],
      "properties": {
        "records": {"type": "integer", "minimum": 1},
        "approved": {"type": "integer", "minimum": 0},
        "not_approved": {"type": "integer", "minimum": 0},
        "letter_sections": {"type": "integer", "minimum": 1},
        "approved_verbs": {"type": "integer", "minimum": 0}
      }
    },
    "recordCommon": {
      "type": "object",
      "properties": {
        "locator": {"type": "string", "pattern": "^[A-Z]:[0-9]{4}$"},
        "headword_raw": {"type": "string", "minLength": 1},
        "normalized_base_key": {"type": "string", "minLength": 1},
        "part_of_speech": {"enum": ["n", "v", "adj", "adv", "pron", "art", "prep", "conj", "prefix", "unclassified"]},
        "status": {"enum": ["approved", "not_approved"]},
        "construction_annotation_raw": {"type": "string"},
        "approved_forms": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "form_parse_state": {"enum": ["not-applicable", "no-explicit-forms", "listed", "restricted-list", "restricted-no-other-forms", "source-separator-anomaly"]},
        "meaning_or_alternatives_raw": {"type": "string", "minLength": 1}
      }
    },
    "runtimeRecord": {
      "allOf": [
        {"$ref": "#/$defs/recordCommon"},
        {
          "additionalProperties": false,
          "required": ["locator", "headword_raw", "normalized_base_key", "part_of_speech", "status", "construction_annotation_raw", "approved_forms", "form_parse_state", "meaning_or_alternatives_raw"],
          "properties": {
            "locator": true,
            "headword_raw": true,
            "normalized_base_key": true,
            "part_of_speech": true,
            "status": true,
            "construction_annotation_raw": true,
            "approved_forms": true,
            "form_parse_state": true,
            "meaning_or_alternatives_raw": true
          }
        }
      ]
    },
    "canonicalRecord": {
      "allOf": [
        {"$ref": "#/$defs/recordCommon"},
        {
          "additionalProperties": false,
          "required": ["locator", "source_expression_raw", "headword_raw", "normalized_base_key", "part_of_speech", "status", "construction_annotation_raw", "forms_raw", "approved_forms", "form_parse_state", "meaning_or_alternatives_raw"],
          "properties": {
            "locator": true,
            "source_expression_raw": {"type": "string", "minLength": 1},
            "headword_raw": true,
            "normalized_base_key": true,
            "part_of_speech": true,
            "status": true,
            "construction_annotation_raw": true,
            "forms_raw": {"type": "string"},
            "approved_forms": true,
            "form_parse_state": true,
            "meaning_or_alternatives_raw": true
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "normalization", "extraction_scope", "generated_counts", "records"],
      "properties": {
        "schema_version": {"const": 1},
        "normalization": {"const": "NFKC-casefold-whitespace"},
        "extraction_scope": {"const": "main-table expression, status, meaning or alternatives, and mechanically derived listed forms; example columns are intentionally excluded"},
        "generated_counts": {"$ref": "#/$defs/counts"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/canonicalRecord"}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "normalization", "generated_counts", "records"],
      "properties": {
        "schema_version": {"const": 1},
        "normalization": {"const": "NFKC-casefold-whitespace"},
        "generated_counts": {"$ref": "#/$defs/counts"},
        "records": {"type": "array", "items": {"$ref": "#/$defs/runtimeRecord"}}
      }
    }
  ]
}
