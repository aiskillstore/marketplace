{
  "_comment": "示例：修改已有 deck 的标题文字+颜色+备注。注意：recipe 生成的 shape 是 textBox 不是 placeholder，需要先 inspect 看 name，或者用 query.nameRegex 模糊匹配。",
  "_step1_inspect": "xdoc pptx inspect input.pptx --json",
  "_step2_dry_run": "xdoc pptx apply -p edit-title.patch.json -i input.pptx -o output.pptx --dry-run --json",
  "schemaVersion": "pptx-patch/v1",
  "ops": [
    {
      "op": "set-text-frame",
      "slide": 0,
      "shape": {
        "query": {
          "nameRegex": "^.*-title$"
        }
      },
      "text": "新标题：Q3 2026 增长计划"
    },
    {
      "op": "set-run",
      "slide": 0,
      "shape": {
        "query": {
          "nameRegex": "^.*-title$"
        }
      },
      "paragraph": 0,
      "run": 0,
      "font": {
        "bold": true,
        "color": "1A73E8",
        "size": "32pt"
      }
    },
    {
      "op": "set-slide-notes",
      "slide": 0,
      "text": "重点强调环比增长率与新产品贡献。"
    }
  ]
}
