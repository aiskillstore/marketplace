{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerSummarySlide",
  "title": "ledgerSummarySlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "focus": {
            "type": "boolean"
          }
        },
        "required": ["value", "label", "basis"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 4
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "asOf",
    "unit",
    "verdict",
    "label",
    "judgments",
    "metrics"
  ],
  "additionalProperties": false
}
