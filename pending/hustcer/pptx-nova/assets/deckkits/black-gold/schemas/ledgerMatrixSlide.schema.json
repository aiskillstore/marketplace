{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerMatrixSlide",
  "title": "ledgerMatrixSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 55
      },
      "minItems": 5,
      "maxItems": 5
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "amount": {
            "type": "number"
          },
          "share": {
            "type": "number"
          },
          "representative": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "thesis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 85
          }
        },
        "required": ["name", "amount", "share", "representative", "thesis"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 5
    },
    "totalLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "asOf",
    "unit",
    "verdict",
    "headers",
    "rows",
    "totalLabel"
  ],
  "additionalProperties": false
}
