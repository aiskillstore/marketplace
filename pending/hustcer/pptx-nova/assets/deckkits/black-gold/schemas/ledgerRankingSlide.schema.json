{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerRankingSlide",
  "title": "ledgerRankingSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "chart": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["bar"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "minItems": 2,
          "maxItems": 8
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 8
        },
        "focus": {
          "type": "number",
          "minimum": 0
        },
        "numberFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-slotRole": "control"
        }
      },
      "required": ["kind", "name", "unit", "categories", "values"],
      "additionalProperties": false
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "focus": {
            "type": "boolean"
          }
        },
        "required": ["value", "label", "basis"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": ["title", "basis", "source", "asOf", "unit", "verdict", "chart", "metrics"],
  "additionalProperties": false
}
