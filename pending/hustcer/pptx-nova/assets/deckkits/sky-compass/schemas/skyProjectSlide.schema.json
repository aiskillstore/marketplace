{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.9,
        "heightIn": 0.38,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 12.03,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.03,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 12.03,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["green", "amber", "red"],
      "x-slotRole": "control"
    },
    "statusLabel": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.8,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "metadata": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.08,
              "heightIn": 0.3,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 15,
              "widthIn": 2.08,
              "heightIn": 0.5349999999999999,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 15,
              "widthIn": 7.08,
              "heightIn": 0.35,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 7.08,
              "heightIn": 0.31,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 7.08,
              "heightIn": 0.36,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 7.08,
              "heightIn": 0.36,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 7.08,
              "heightIn": 0.36,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          }
        },
        "required": ["heading", "evidence", "action", "owner", "date"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "section",
    "title",
    "basis",
    "period",
    "source",
    "verdict",
    "status",
    "statusLabel",
    "progress",
    "metadata",
    "items"
  ],
  "additionalProperties": false
}
