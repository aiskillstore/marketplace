{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianExhibitSlide",
  "title": "Cartesian native feature exhibit",
  "type": "object",
  "required": ["label", "title", "body", "source", "specimen"],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 11.6,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 12.2,
        "heightIn": 0.9,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 13,
        "widthIn": 11.8,
        "heightIn": 0.75,
        "lineHeight": 1.3,
        "maxLines": 2
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 11.5,
        "heightIn": 0.35,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "specimen": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["nodes", "charts", "equations"]
        },
        "nodes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "x-slotRole": "control",
                "x-slotProbeValue": 0.1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "x-slotRole": "control",
                "x-slotProbeValue": 0.1
              },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1,
                "x-slotRole": "control",
                "x-slotProbeValue": 0.2
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1,
                "x-slotRole": "control",
                "x-slotProbeValue": 0.6
              },
              "shape": {
                "type": "string",
                "enum": ["oval", "rectangle"],
                "x-slotRole": "control",
                "x-slotProbeValue": "oval"
              },
              "rotation": {
                "type": "number",
                "minimum": 0,
                "maximum": 360,
                "x-slotRole": "control",
                "x-slotProbeValue": 0
              },
              "size": {
                "type": "number",
                "minimum": 10,
                "maximum": 64,
                "x-slotRole": "control",
                "x-slotProbeValue": 10
              },
              "display": {
                "type": "boolean",
                "x-slotRole": "control",
                "x-slotProbeValue": false
              },
              "fill": {
                "type": "string",
                "enum": ["bg", "bg2", "card", "line", "ring20", "ring30"],
                "x-slotRole": "control",
                "x-slotProbeValue": "bg2"
              }
            },
            "required": ["text", "x", "y", "w", "h"]
          }
        },
        "charts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "column",
                  "column-3d",
                  "bar-3d",
                  "line",
                  "line-3d",
                  "area-3d",
                  "pie-3d",
                  "surface",
                  "surface-3d",
                  "scatter",
                  "bubble",
                  "combo",
                  "radar",
                  "doughnut",
                  "waterfall",
                  "funnel",
                  "histogram",
                  "treemap",
                  "sunburst",
                  "box-whisker"
                ]
              },
              "caption": {
                "type": "string",
                "minLength": 1
              },
              "variant": {
                "type": "string",
                "enum": [
                  "standard",
                  "clustered",
                  "stacked",
                  "percent-stacked",
                  "markers",
                  "lines",
                  "lines-no-markers",
                  "smooth",
                  "smooth-no-markers",
                  "exploded",
                  "wireframe"
                ]
              },
              "legend": {
                "type": "string",
                "enum": ["bottom", "top", "left", "right", "top-right"]
