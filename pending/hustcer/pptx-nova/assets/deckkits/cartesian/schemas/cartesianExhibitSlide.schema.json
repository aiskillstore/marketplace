                  },
                  "series": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
                        },
                        "values": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 24,
                          "items": {
                            "type": "number"
                          }
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["column", "line", "area"]
                        },
                        "secondaryAxis": {
                          "type": "boolean"
                        },
                        "points": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 24,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "x": {
                                "type": "number"
