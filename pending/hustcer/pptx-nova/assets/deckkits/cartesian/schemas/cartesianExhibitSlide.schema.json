                        }
                      },
                      "required": ["name"]
                    }
                  },
                  "open": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "number"
                    }
                  },
                  "high": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "number"
                    }
                  },
                  "low": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "number"
                    }
                  },
                  "close": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": []
              },
              "dataEx": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "points": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 24,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
