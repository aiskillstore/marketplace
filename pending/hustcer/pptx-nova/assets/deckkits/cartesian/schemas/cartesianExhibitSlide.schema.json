                  "rotY": {
                    "type": "number"
                  },
                  "rightAngleAxes": {
                    "type": "boolean"
                  },
                  "perspective": {
                    "type": "number"
                  },
                  "depthPercent": {
                    "type": "number"
                  },
                  "heightPercent": {
                    "type": "number"
                  }
                },
                "required": []
              },
              "plot": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "gapWidth": {
                    "type": "number"
                  },
                  "overlap": {
                    "type": "number"
                  },
                  "varyByCategories": {
                    "type": "boolean"
                  },
                  "bubbleScale": {
                    "type": "number"
                  },
                  "firstSliceAngle": {
                    "type": "number"
                  },
                  "holeSize": {
                    "type": "number"
                  },
                  "sizeRepresents": {
                    "type": "string",
                    "enum": ["area", "width"]
                  }
                },
                "required": []
              },
              "seriesStyles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "x-slotRole": "control"
                }
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "x-slotRole": "control"
                }
              }
