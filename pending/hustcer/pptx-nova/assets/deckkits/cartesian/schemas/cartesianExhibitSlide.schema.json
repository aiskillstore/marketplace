                        }
                      },
                      "required": ["name", "values"]
                    }
                  },
                  "quartileMethod": {
                    "type": "string",
                    "enum": ["inclusive", "exclusive"]
                  },
                  "showMean": {
                    "type": "boolean"
                  },
                  "showOutliers": {
                    "type": "boolean"
                  }
                },
                "required": []
              },
              "xScale": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "majorUnit": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minorUnit": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reverseOrder": {
                    "type": "boolean"
                  }
                },
                "required": []
              },
              "yScale": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "majorUnit": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minorUnit": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "reverseOrder": {
                    "type": "boolean"
                  }
                },
                "required": []
