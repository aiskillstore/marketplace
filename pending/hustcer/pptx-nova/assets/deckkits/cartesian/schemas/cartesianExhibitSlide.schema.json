                        "parent": {
                          "type": "string",
                          "minLength": 1,
                          "x-slotRole": "control",
                          "x-slotProbeOmit": true
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "value": {
                          "type": "number"
                        }
                      },
                      "required": ["id", "label", "value"]
                    }
                  },
                  "series": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1
