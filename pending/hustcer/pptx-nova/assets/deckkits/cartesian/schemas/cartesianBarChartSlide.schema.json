{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianBarChartSlide",
  "title": "cartesianBarChartSlide data schema",
  "type": "object",
  "required": ["label", "title", "body", "chart", "unit", "source"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 4.65,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 5.2,
        "heightIn": 0.785,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "body": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 13,
        "widthIn": 4.65,
        "heightIn": 1.7749999999999995,
        "lineHeight": 1.3,
        "maxLines": 6
      }
    },
    "chart": {
      "type": "object",
      "required": ["categories", "series"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 1.0416666666666667,
              "heightIn": 0.3,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          }
        },
        "series": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["name", "values"],
            "properties": {
              "name": {
                "type": "string",
                "x-slotBudget": {
                  "fontPt": 10,
                  "widthIn": 3.375,
                  "heightIn": 0.3,
                  "lineHeight": 1.2,
                  "maxLines": 1
                }
              },
              "values": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 7.15,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 12.27,
        "heightIn": 0.35,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "numberFormat": {
      "type": "string",
      "minLength": 1,
      "x-slotRole": "control"
    },
    "valueAxis": {
      "type": "object",
      "x-slotRole": "control",
      "properties": {
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "majorUnit": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false,
      "x-slotProbeOmit": true
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
