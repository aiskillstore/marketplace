{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianTeamSlide",
  "title": "cartesianTeamSlide data schema",
  "type": "object",
  "required": ["label", "title", "members"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 12.27,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 12.27,
        "heightIn": 0.85,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["initial", "name", "role"],
        "properties": {
          "initial": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 24,
              "widthIn": 1.6,
              "heightIn": 1.6,
              "lineHeight": 1.2,
              "maxLines": 3
            },
            "pattern": "^.{1,3}$"
          },
          "name": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 16,
              "widthIn": 2.4074999999999998,
              "heightIn": 0.6,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "role": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.4074999999999998,
              "heightIn": 0.7300000000000001,
              "lineHeight": 1.2,
              "maxLines": 3
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
