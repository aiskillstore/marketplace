{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianCoverSlide",
  "title": "cartesianCoverSlide data schema",
  "type": "object",
  "required": ["label", "title", "subtitle"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 7.8,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 64,
        "widthIn": 8.5,
        "heightIn": 1.45,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 15.5,
        "widthIn": 5.8,
        "heightIn": 1.1,
        "lineHeight": 1.3,
        "maxLines": 3
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
