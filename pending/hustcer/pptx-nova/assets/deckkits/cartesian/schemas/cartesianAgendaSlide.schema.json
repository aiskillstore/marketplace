{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianAgendaSlide",
  "title": "cartesianAgendaSlide data schema",
  "type": "object",
  "required": ["label", "title", "body", "items"],
  "properties": {
    "textLayout": {
      "type": "string",
      "enum": ["rows", "paragraphs"],
      "description": "Default rows use separate text boxes. paragraphs creates native target S{slideIndex}_AgendaParagraphs with one paragraph per item and a bottom rule.",
      "x-slotRole": "control"
    },
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 5.1,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 5.1,
        "heightIn": 0.785,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "body": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 13,
        "widthIn": 4.8,
        "heightIn": 1.705,
        "lineHeight": 1.3,
        "maxLines": 6
      }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "level": {
            "type": "number",
            "enum": [0, 1, 2, 3, 4, 5, 6, 7, 8],
            "description": "Native paragraph level for textLayout=paragraphs; defaults to 0.",
            "x-slotRole": "control",
            "x-slotProbeOmit": true
          },
          "number": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 18,
              "widthIn": 0.65,
              "heightIn": 0.5900000000000001,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "text": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 13,
              "widthIn": 5.050000000000001,
              "heightIn": 0.5900000000000001,
              "lineHeight": 1.3,
              "maxLines": 2
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
