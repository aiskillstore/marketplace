{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianImageStatsSlide",
  "title": "cartesianImageStatsSlide data schema",
  "type": "object",
  "required": ["imageLabel", "label", "title", "paragraphs", "stats"],
  "properties": {
    "imageLabel": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 5.2,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 5.8,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 5.8,
        "heightIn": 0.785,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "x-slotBudget": {
          "fontPt": 13,
          "widthIn": 5.8,
          "heightIn": 1.0125,
          "lineHeight": 1.3,
          "maxLines": 3
        }
      }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 24,
              "widthIn": 1.6666666666666667,
              "heightIn": 0.56,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 1.6666666666666667,
              "heightIn": 0.29999999999999993,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
