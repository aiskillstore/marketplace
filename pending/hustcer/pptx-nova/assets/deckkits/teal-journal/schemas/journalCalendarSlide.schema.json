{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "journalCalendarSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 28,
        "widthIn": 11.73,
        "heightIn": 0.55,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 11.73,
        "heightIn": 0.48,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.65,
        "heightIn": 0.25,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "axisStart": {
      "type": "number",
      "x-slotProbeValue": 0,
      "x-slotRole": "control"
    },
    "axisEnd": {
      "type": "number",
      "x-slotProbeValue": 12,
      "x-slotRole": "control"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 3.5045,
        "heightIn": 0.33,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "allocationUnit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 3.03,
        "heightIn": 0.34,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 3.5045,
              "heightIn": 0.32,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 3.5045,
              "heightIn": 0.32,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          },
          "start": {
            "type": "number",
            "x-slotProbeSequence": [0, 3, 6, 9],
            "x-slotRole": "control"
          },
          "end": {
            "type": "number",
            "x-slotProbeSequence": [3, 6, 9, 12],
            "x-slotRole": "control"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": ["observed", "planned"],
            "x-slotRole": "control"
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 3.75,
              "heightIn": 1,
              "lineHeight": 1.12,
              "maxLines": 3
            },
            "pattern": "\\S"
          }
        },
        "required": ["label", "period", "start", "end", "value", "status", "evidence"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 4
    },
    "allocation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.03,
              "heightIn": 0.3,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          },
          "value": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    }
  },
  "required": [
    "title",
    "subtitle",
    "eyebrow",
    "verdict",
    "source",
    "axisStart",
    "axisEnd",
    "unit",
    "allocationUnit",
    "phases",
    "allocation"
  ],
  "additionalProperties": false
}
