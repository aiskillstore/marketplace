{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "journalAudienceSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 28,
        "widthIn": 11.73,
        "heightIn": 0.55,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 11.73,
        "heightIn": 0.48,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.65,
        "heightIn": 0.25,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "lead": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 14,
            "widthIn": 2.8,
            "heightIn": 0.45,
            "lineHeight": 1.12,
            "maxLines": 1
          },
          "pattern": "\\S"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 14,
            "widthIn": 2.8,
            "heightIn": 3.2,
            "lineHeight": 1.12,
            "maxLines": 10
          },
          "pattern": "\\S"
        }
      },
      "required": ["heading", "body"],
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 2.6933333333333334,
              "heightIn": 1.1566666666666665,
              "lineHeight": 1.12,
              "maxLines": 4
            },
            "pattern": "\\S"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotProbeValue": 1,
            "x-slotRole": "control"
          },
          "align": {
            "type": "string",
            "enum": ["left", "right", "center"],
            "x-slotRole": "control"
          }
        },
        "required": ["label", "weight", "align"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 5
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 2.6933333333333334,
            "heightIn": 1.1566666666666665,
            "lineHeight": 1.12,
            "maxLines": 4
          },
          "pattern": "\\S"
        },
        "minItems": 3,
        "maxItems": 5
      },
      "minItems": 2,
      "maxItems": 5
    },
    "focusColumn": {
      "type": "number",
      "minimum": 0,
      "x-slotProbeValue": 1,
      "x-slotRole": "control"
    },
    "methodology": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.53,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    }
  },
  "required": [
    "title",
    "subtitle",
    "eyebrow",
    "verdict",
    "source",
    "lead",
    "columns",
    "rows",
    "focusColumn",
    "methodology"
  ],
  "additionalProperties": false
}
