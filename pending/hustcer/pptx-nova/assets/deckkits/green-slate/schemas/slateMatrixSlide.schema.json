{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateMatrixSlide",
  "title": "slateMatrixSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 24,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.28,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.85,
        "heightIn": 0.38,
        "maxLines": 1
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.8,
              "heightIn": 0.45,
              "maxLines": 2
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          },
          "align": {
            "type": "string",
            "enum": ["left", "center", "right"]
          }
        },
        "required": ["heading", "weight", "align"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 6
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 90,
                  "x-slotBudget": {
                    "fontPt": 12,
                    "widthIn": 1.8,
                    "heightIn": 0.6,
                    "maxLines": 2
                  }
                },
                "tone": {
                  "type": "string",
                  "enum": ["normal", "positive", "negative", "muted"]
                }
              },
              "required": ["text", "tone"],
              "additionalProperties": false
            },
            "minItems": 3,
            "maxItems": 6
          }
        },
        "required": ["cells"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 6
    },
    "legend": {
      "type": "string",
      "minLength": 1,
      "maxLength": 145,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.2,
        "maxLines": 1
      }
    }
  },
  "required": ["title", "label", "source", "asOf", "basis", "verdict", "columns", "rows", "legend"],
  "additionalProperties": false
}
