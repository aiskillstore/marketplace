{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateRangeSlide",
  "title": "slateRangeSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 24,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.28,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.85,
        "heightIn": 0.38,
        "maxLines": 1
      }
    },
    "range": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65,
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.75,
            "maxLines": 3
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.75,
            "maxLines": 3
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.2,
              "heightIn": 0.45,
              "maxLines": 2
            }
          },
          "minItems": 2,
          "maxItems": 6
        },
        "low": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 6
        },
        "high": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 6
        },
        "lowerLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 26,
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.75,
            "maxLines": 3
          }
        },
        "spanLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 26,
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.75,
            "maxLines": 3
          }
        }
      },
      "required": ["name", "unit", "categories", "low", "high", "lowerLabel", "spanLabel"],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.3,
              "heightIn": 0.46,
              "maxLines": 2
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.3,
              "heightIn": 0.85,
              "maxLines": 3
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": ["title", "label", "source", "asOf", "basis", "verdict", "range", "notes"],
  "additionalProperties": false
}
