{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateNoticeSlide",
  "title": "slateNoticeSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70,
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 4.2,
        "heightIn": 2.8,
        "maxLines": 4
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "paragraphs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 650,
        "x-slotBudget": {
          "fontPt": 12,
          "widthIn": 6.9,
          "heightIn": 2,
          "maxLines": 9
        }
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": ["title", "label", "source", "asOf", "paragraphs"],
  "additionalProperties": false
}
