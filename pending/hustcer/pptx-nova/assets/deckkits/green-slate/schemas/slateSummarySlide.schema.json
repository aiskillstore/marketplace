{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateSummarySlide",
  "title": "slateSummarySlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 24,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.28,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.85,
        "heightIn": 0.38,
        "maxLines": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.3,
              "heightIn": 0.46,
              "maxLines": 2
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.3,
              "heightIn": 0.85,
              "maxLines": 3
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "x-slotBudget": {
              "fontPt": 34,
              "widthIn": 1.85,
              "heightIn": 0.72,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.85,
              "heightIn": 0.38,
              "maxLines": 1
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.85,
              "heightIn": 0.65,
              "maxLines": 3
            }
          }
        },
        "required": ["value", "label", "detail"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": ["title", "label", "source", "asOf", "basis", "verdict", "findings", "metrics"],
  "additionalProperties": false
}
