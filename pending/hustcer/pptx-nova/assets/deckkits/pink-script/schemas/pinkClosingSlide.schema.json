{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkClosingSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Closing invitation.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "actions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Action heading.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Action detail.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          }
        },
        "required": ["title", "description"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 3
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "actions"],
  "additionalProperties": false
}
