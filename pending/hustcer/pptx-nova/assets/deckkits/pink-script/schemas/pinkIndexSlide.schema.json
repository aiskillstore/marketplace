{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkIndexSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Short oversized index title.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "continuation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Index continuation.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Chapter title.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Chapter description.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "meta": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Short chapter folio or category.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "focus": {
            "type": "boolean",
            "x-slotRole": "control"
          }
        },
        "required": ["title", "description", "meta", "focus"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 5
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "continuation", "items"],
  "additionalProperties": false
}
