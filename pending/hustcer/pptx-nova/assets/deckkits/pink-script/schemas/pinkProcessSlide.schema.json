{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkProcessSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Process title.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Process interpretation.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "steps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Step heading.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Step detail.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          }
        },
        "required": ["title", "description"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 5
      }
    },
    "timeline": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Independent schedule or process footer.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "intro", "steps", "timeline"],
  "additionalProperties": false
}
