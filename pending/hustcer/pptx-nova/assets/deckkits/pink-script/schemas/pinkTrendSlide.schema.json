{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkTrendSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Trend assertion.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible chart unit.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "categories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "description": "Ordered category label.",
        "x-slotBudget": {
          "fontPt": 12,
          "widthIn": 4,
          "heightIn": 0.8,
          "lineHeight": 1.12,
          "maxLines": 3
        }
      },
      "x-slotBudget": {
        "maxItems": 12
      }
    },
    "series": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Visible series legend name.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "values": {
            "type": "array",
            "minItems": 3,
            "maxItems": 12,
            "items": {
              "type": "number"
            },
            "x-slotBudget": {
              "maxItems": 12
            }
          }
        },
        "required": ["name", "values"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 2
      }
    },
    "focusIndex": {
      "type": "number",
      "minimum": 0,
      "x-slotProbeValue": 0,
      "x-slotRole": "control"
    },
    "callout": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Independent displayed callout; regenerate after numeric edits.",
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.8,
            "lineHeight": 1.12,
            "maxLines": 3
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Callout label.",
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.8,
            "lineHeight": 1.12,
            "maxLines": 3
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Evidence explanation.",
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.8,
            "lineHeight": 1.12,
            "maxLines": 3
          }
        }
      },
      "required": ["value", "label", "description"],
      "additionalProperties": false
    }
  },
  "required": [
    "brand",
    "section",
    "kicker",
    "source",
    "title",
    "unit",
    "categories",
    "series",
    "focusIndex",
    "callout"
  ],
  "additionalProperties": false
}
