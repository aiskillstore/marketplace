{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarFindingSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 10.85,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.7,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "metric": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 15,
            "widthIn": 5.9,
            "heightIn": 0.45,
            "lineHeight": 1.05,
            "maxLines": 1
