        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "comparator": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 15,
            "widthIn": 5,
            "heightIn": 0.5,
            "lineHeight": 1.05,
            "maxLines": 1
          }
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "enum": ["%"],
      "x-slotBudget": {
        "fontPt": 38,
        "widthIn": 5,
        "heightIn": 0.8,
        "lineHeight": 1.05,
        "maxLines": 1
