      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 5,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "gapUnit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 5,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 2
