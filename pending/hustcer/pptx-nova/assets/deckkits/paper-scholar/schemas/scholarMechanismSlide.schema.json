{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarMechanismSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 10.85,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.7,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 2.92,
              "heightIn": 2.155,
              "lineHeight": 1.05,
              "maxLines": 7
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 2.92,
              "heightIn": 2.155,
              "lineHeight": 1.05,
              "maxLines": 7
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.7,
              "heightIn": 0.3,
              "lineHeight": 1.05,
              "maxLines": 1
            }
          },
          "halfLife": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotProbeValue": 2.4
          }
        },
        "required": ["label", "halfLife"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "maxTime": {
      "type": "number",
      "exclusiveMinimum": 0,
      "x-slotProbeValue": 16
    },
    "ticks": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "x-slotProbeSequence": [2, 8, 12, 16],
        "x-slotRole": "control"
      },
      "minItems": 2,
      "maxItems": 4
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 2.95,
        "heightIn": 0.5,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "xLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.1,
        "heightIn": 0.28,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "yLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.2,
        "heightIn": 0.27,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "formulaLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 3.2,
        "heightIn": 0.45,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "plotNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.1,
        "heightIn": 0.27,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "modelNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3.2,
        "heightIn": 1.2999999999999998,
        "lineHeight": 1.05,
        "maxLines": 5
      }
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "definitions",
    "series",
    "maxTime",
    "ticks",
    "unit",
    "xLabel",
    "yLabel",
    "formulaLabel",
    "plotNote",
    "modelNote"
  ],
  "additionalProperties": false
}
