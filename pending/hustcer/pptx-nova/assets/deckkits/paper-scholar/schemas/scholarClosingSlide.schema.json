{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarClosingSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 10.85,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.7,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 2.1999999999999997,
              "heightIn": 1.935,
              "lineHeight": 1.05,
              "maxLines": 7
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 2.1999999999999997,
              "heightIn": 1.935,
              "lineHeight": 1.05,
              "maxLines": 7
            }
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.8499999999999996,
              "heightIn": 1.3900000000000001,
              "lineHeight": 1.05,
              "maxLines": 5
            }
          },
          "how": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.720000000000001,
              "heightIn": 1.3900000000000001,
              "lineHeight": 1.05,
              "maxLines": 5
            }
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "enum": [
              "clock",
              "hourglass",
              "refresh",
              "train",
              "school",
              "briefcase",
              "walk",
              "leaf",
              "droplet",
              "tool",
              "building"
            ],
            "x-slotRole": "control"
          }
        },
        "required": ["heading", "detail", "why", "how", "icon"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    },
    "reviewLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 2.7,
        "heightIn": 0.9,
        "lineHeight": 1.05,
        "maxLines": 3
      }
    },
    "review": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.7,
              "heightIn": 1.5250000000000004,
              "lineHeight": 1.05,
              "maxLines": 6
            }
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.7,
              "heightIn": 1.5250000000000004,
              "lineHeight": 1.05,
              "maxLines": 6
            }
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    }
  },
  "required": ["title", "basis", "source", "actions", "reviewLabel", "review"],
  "additionalProperties": false
}
