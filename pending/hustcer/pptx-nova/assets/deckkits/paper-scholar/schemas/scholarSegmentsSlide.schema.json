{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarSegmentsSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 10.85,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.7,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "headers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "x-slotBudget": {
          "fontPt": 13,
          "widthIn": 2.368695652173913,
          "heightIn": 0.33999999999999997,
          "lineHeight": 1.05,
          "maxLines": 1
        }
      },
      "minItems": 3,
      "maxItems": 5
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 13,
              "widthIn": 3.1926086956521735,
              "heightIn": 1.42,
              "lineHeight": 1.05,
              "maxLines": 5
            }
          },
          "cells": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "x-slotBudget": {
                "fontPt": 13,
                "widthIn": 2.368695652173913,
                "heightIn": 1.42,
                "lineHeight": 1.05,
                "maxLines": 5
              }
            },
            "minItems": 2,
            "maxItems": 4
          },
          "tone": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "enum": ["pale", "blush"],
            "x-slotRole": "control"
          },
          "emphasisColumn": {
            "type": "number",
            "minimum": 1,
            "maximum": 4,
            "x-slotProbeValue": 1,
            "x-slotRole": "control"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "enum": [
              "clock",
              "hourglass",
              "refresh",
              "train",
              "school",
              "briefcase",
              "walk",
              "leaf",
              "droplet",
              "tool",
              "building"
            ],
            "x-slotRole": "control"
          }
        },
        "required": ["label", "cells", "tone", "icon"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 5
    },
    "summaryLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.55,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "summaryValue": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.55,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "footnote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.55,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "takeaway": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 2.12,
        "heightIn": 3.6,
        "lineHeight": 1.05,
        "maxLines": 14
      }
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "headers",
    "rows",
    "summaryLabel",
    "summaryValue",
    "footnote",
    "takeaway"
  ],
  "additionalProperties": false
}
