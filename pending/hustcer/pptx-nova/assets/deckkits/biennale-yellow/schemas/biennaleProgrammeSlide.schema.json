{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleProgrammeSlide",
  "title": "biennaleProgrammeSlide data schema",
  "type": "object",
  "required": ["kicker", "word", "description", "headLabel", "strands"],
  "properties": {
    "kicker": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 4.6,
        "heightIn": 0.25,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "word": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 64,
        "widthIn": 4.95,
        "heightIn": 3.05,
        "lineHeight": 1.18,
        "maxLines": 2
      }
    },
    "description": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.55,
        "heightIn": 1.05,
        "lineHeight": 1.3,
        "maxLines": 5
      }
    },
    "headLabel": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 7.05,
        "heightIn": 0.25,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "strands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["num", "title", "body"],
        "properties": {
          "num": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
