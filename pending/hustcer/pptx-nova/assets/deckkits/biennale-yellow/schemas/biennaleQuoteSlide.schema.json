{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleQuoteSlide",
  "title": "biennaleQuoteSlide data schema",
  "type": "object",
  "required": ["kicker", "quote", "author", "role"],
  "properties": {
    "kicker": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 8.9,
        "heightIn": 0.26,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "quote": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 9.4,
        "heightIn": 3.4,
        "lineHeight": 1.18,
        "maxLines": 6
      }
    },
    "author": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2.2,
        "heightIn": 0.45,
        "lineHeight": 1.18,
        "maxLines": 2
      }
    },
    "role": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.9,
        "heightIn": 0.7,
        "lineHeight": 1.3,
        "maxLines": 3
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
