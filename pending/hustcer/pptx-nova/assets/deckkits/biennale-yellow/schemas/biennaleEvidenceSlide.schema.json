{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleEvidenceSlide",
  "title": "Biennale native evidence data",
  "type": "object",
  "required": ["title", "label", "source", "seriesName", "unit", "kind", "points", "stats"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "seriesName": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": ["bar", "line"]
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "emphasis": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["value", "suffix", "label", "description"],
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1
          },
          "suffix": {
            "type": "string"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
