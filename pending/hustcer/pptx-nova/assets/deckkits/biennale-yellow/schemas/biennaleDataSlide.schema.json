{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleDataSlide",
  "title": "biennaleDataSlide data schema",
  "type": "object",
  "required": ["title", "label", "stats", "bars", "unit", "source"],
  "properties": {
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 8,
        "heightIn": 0.74,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 4,
        "heightIn": 0.55,
        "lineHeight": 1.18,
        "maxLines": 3
      }
    },
    "stats": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["value", "suffix", "label", "description"],
        "properties": {
          "value": {
            "type": "string"
          },
          "suffix": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "bars": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "value", "accent"],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "accent": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 11.4,
        "heightIn": 0.28,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "numberFormat": {
      "enum": ["#,##0", "#,##0.##", "0.00E+00"]
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
