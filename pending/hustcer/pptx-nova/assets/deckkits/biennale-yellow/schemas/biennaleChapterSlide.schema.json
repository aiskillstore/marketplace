{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleChapterSlide",
  "title": "biennaleChapterSlide data schema",
  "type": "object",
  "required": ["rail", "number", "title", "lede"],
  "properties": {
    "rail": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 11.5,
        "heightIn": 0.26,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "number": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 172,
        "widthIn": 5,
        "heightIn": 3.45,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 10.8,
        "heightIn": 1.45,
        "lineHeight": 1.18,
        "maxLines": 2
      }
    },
    "lede": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.5,
        "heightIn": 0.95,
        "lineHeight": 1.3,
        "maxLines": 5
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
