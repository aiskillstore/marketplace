{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableManifestoSlide",
  "title": "longTableManifestoSlide data schema",
  "type": "object",
  "required": ["mark", "eyebrow", "title", "paragraphs", "signature", "source"],
  "properties": {
    "mark": {
      "type": "string",
      "maxLength": 2,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 0.44,
        "heightIn": 0.44,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 6,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "maxLength": 56,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 43,
        "widthIn": 4.65,
        "heightIn": 3.3,
        "lineHeight": 1.1,
        "maxLines": 3
      }
    },
    "paragraphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 210,
        "minLength": 1,
        "pattern": "\\S",
        "x-slotBudget": {
          "fontPt": 14,
          "widthIn": 6.55,
          "heightIn": 0.3166666666666667,
          "lineHeight": 1.1,
          "maxLines": 1
        }
      }
    },
    "signature": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 6.55,
        "heightIn": 0.38,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.55,
        "heightIn": 0.45,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
