{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableCoverSlide",
  "title": "longTableCoverSlide data schema",
  "type": "object",
  "required": [
    "edition",
    "editionLabel",
    "title",
    "pills",
    "stat",
    "statNote",
    "tagline",
    "description"
  ],
  "properties": {
    "edition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 0.44,
        "heightIn": 0.44,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "editionLabel": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 5,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 54,
        "widthIn": 6.4,
        "heightIn": 2.4,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "pills": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 18,
        "minLength": 1,
        "pattern": "\\S",
        "x-slotBudget": {
          "fontPt": 11,
          "widthIn": 2.32,
          "heightIn": 0.45,
          "lineHeight": 1.1,
          "maxLines": 1
        }
      }
    },
    "stat": {
      "type": "string",
      "maxLength": 28,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 5.8,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "statNote": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 5.8,
        "heightIn": 0.36,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "tagline": {
      "type": "string",
      "maxLength": 44,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 5.8,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "description": {
      "type": "string",
      "maxLength": 160,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 6.3,
        "heightIn": 0.65,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "bigEdition": {
      "type": "string",
      "maxLength": 8,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 96,
        "widthIn": 4.6,
        "heightIn": 4.2,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "bigLabel": {
      "type": "string",
      "maxLength": 42,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 13,
        "widthIn": 4.6,
        "heightIn": 0.65,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "bigMeta": {
      "type": "string",
      "maxLength": 120,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 4.6,
        "heightIn": 0.6,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
