{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableCalendarSlide",
  "title": "longTableCalendarSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "columns", "rows"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 11.9,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "maxLength": 56,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.9,
        "heightIn": 0.35,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 16,
        "minLength": 1,
        "pattern": "\\S",
        "x-slotBudget": {
          "fontPt": 10.5,
          "widthIn": 0.6135,
          "heightIn": 0.27,
          "lineHeight": 1.1,
          "maxLines": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "array",
        "minItems": 5,
        "maxItems": 5,
        "items": {
          "type": "string",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 11,
            "widthIn": 0.6135,
            "heightIn": 0.51,
            "lineHeight": 1.1,
            "maxLines": 2
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
