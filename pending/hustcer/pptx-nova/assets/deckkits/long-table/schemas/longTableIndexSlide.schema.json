{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableIndexSlide",
  "title": "longTableIndexSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "cards"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 11.9,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "maxLength": 54,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.9,
        "heightIn": 0.35,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["no", "city", "title", "text", "meta"],
        "properties": {
          "no": {
            "type": "string",
            "maxLength": 12,
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 1.4027999999999998,
              "heightIn": 0.28,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "city": {
            "type": "string",
            "maxLength": 24,
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 1.9037999999999997,
              "heightIn": 0.28,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "title": {
            "type": "string",
            "maxLength": 44,
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 20,
              "widthIn": 3.34,
              "heightIn": 1,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "text": {
            "type": "string",
            "maxLength": 220,
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 3.34,
              "heightIn": 1.4499999999999997,
              "lineHeight": 1.1,
              "maxLines": 6
            }
          },
          "meta": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 22,
              "minLength": 1,
              "pattern": "\\S",
              "x-slotBudget": {
                "fontPt": 10.5,
                "widthIn": 1.2691999999999999,
                "heightIn": 0.28,
                "lineHeight": 1.1,
                "maxLines": 1
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
