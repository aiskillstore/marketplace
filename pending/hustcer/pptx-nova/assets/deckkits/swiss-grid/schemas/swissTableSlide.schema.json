{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissTableSlide",
  "title": "swissTableSlide 2.0 data",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 12.03,
        "heightIn": 0.78,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.03,
        "heightIn": 0.42,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 1.805,
              "heightIn": 0.38,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "align": {
            "enum": ["left", "center", "right"],
            "x-slotRole": "control"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          }
        },
        "required": ["label"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 6
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 11,
            "widthIn": 1.805,
            "heightIn": 0.33636363636363636,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        },
        "minItems": 2,
        "maxItems": 6
      },
      "minItems": 1,
      "maxItems": 11
    },
    "rowTones": {
      "type": "array",
      "items": {
        "enum": ["neutral", "focus"]
      },
      "minItems": 1,
      "maxItems": 11,
      "x-slotRole": "control"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.03,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": ["eyebrow", "title", "subtitle", "columns", "rows", "source"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
