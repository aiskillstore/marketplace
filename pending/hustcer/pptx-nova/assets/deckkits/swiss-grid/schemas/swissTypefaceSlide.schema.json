{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissTypefaceSlide",
  "title": "swissTypefaceSlide 2.0 data",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 12.03,
        "heightIn": 0.78,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.03,
        "heightIn": 0.42,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "sampleText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 84,
        "widthIn": 3.81,
        "heightIn": 1.82,
        "lineHeight": 1.1,
        "maxLines": 1
      },
      "x-slotFallbackOf": "cards[].sampleText"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 15,
              "widthIn": 3.81,
              "heightIn": 0.36,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "meta": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3.81,
              "heightIn": 0.28,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "specimenStyle": {
            "enum": ["heavy", "bold", "regular"],
            "x-slotRole": "control"
          },
          "sampleText": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 84,
              "widthIn": 3.81,
              "heightIn": 1.82,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "weight": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3.81,
              "heightIn": 0.28,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "lead": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.81,
              "heightIn": 0.54,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 3.81,
              "heightIn": 0.74,
              "lineHeight": 1.1,
              "maxLines": 3
            }
          },
          "focus": {
            "type": "boolean",
            "x-slotRole": "control"
          }
        },
        "required": ["name", "meta", "specimenStyle", "weight", "lead", "body"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 3
    }
  },
  "required": ["eyebrow", "title", "subtitle", "sampleText", "cards"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
