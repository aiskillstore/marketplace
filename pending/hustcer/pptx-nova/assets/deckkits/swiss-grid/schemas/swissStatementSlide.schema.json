{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissStatementSlide",
  "title": "swissStatementSlide 2.0 data",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.38,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 42,
        "widthIn": 6.38,
        "heightIn": 1.7,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 6.38,
        "heightIn": 0.9,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 6.38,
        "heightIn": 1.05,
        "lineHeight": 1.1,
        "maxLines": 4
      }
    }
  },
  "required": ["label", "title", "subtitle", "body"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
