{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissBrandGridSlide",
  "title": "swissBrandGridSlide 2.0 data",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 12.03,
        "heightIn": 0.78,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.03,
        "heightIn": 0.42,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 15,
              "widthIn": 3.14,
              "heightIn": 0.44,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "meta": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3.14,
              "heightIn": 0.4,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 3.81,
              "heightIn": 0.8500000000000003,
              "lineHeight": 1.1,
              "maxLines": 3
            }
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotRole": "control",
            "x-slotProbeValue": "building"
          },
          "focus": {
            "type": "boolean",
            "x-slotRole": "control"
          }
        },
        "required": ["name", "meta", "body"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 6
    }
  },
  "required": ["eyebrow", "title", "subtitle", "brands"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
