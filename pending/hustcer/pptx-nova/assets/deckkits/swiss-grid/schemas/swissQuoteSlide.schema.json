{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissQuoteSlide",
  "title": "swissQuoteSlide 2.0 data",
  "type": "object",
  "properties": {
    "quote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 9.1,
        "heightIn": 1.65,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 8.8,
        "heightIn": 1.65,
        "lineHeight": 1.1,
        "maxLines": 5
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 9.1,
        "heightIn": 0.36,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 9.1,
        "heightIn": 0.34,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": ["quote", "body", "author", "source"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
