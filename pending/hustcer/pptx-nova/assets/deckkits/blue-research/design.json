{
  "schemaVersion": "pptx-nova-design/v1",
  "id": "blue-research",
  "version": "0.1.0",
  "canvas": {
    "widthIn": 13.333,
    "heightIn": 7.5
  },
  "colors": {
    "paper": "FFFFFF",
    "ink": "000000",
    "navy": "00295F",
    "accent": "00ACEE",
    "accentText": "006B8C",
    "deep": "0064BC",
    "pale": "BEE0FF",
    "history": "D5D6D9",
    "surface": "F1F2F1",
    "rule": "D5D6D9",
    "muted": "53606E",
    "body": "000000",
    "orange": "F17E00",
    "highlight": "F2E292",
    "editionInk": "4B8AB8"
  },
  "fonts": {
    "display": {
      "latin": "Arial",
      "eastAsian": "Songti SC"
    },
    "body": {
      "latin": "Arial",
      "eastAsian": "Songti SC"
    }
  },
  "textFrame": {
    "marginLeft": "0in",
    "marginRight": "0in",
    "marginTop": "0in",
    "marginBottom": "0in"
  },
  "theme": {
    "colors": {
      "lt1": "paper",
      "dk1": "ink",
      "lt2": "surface",
      "dk2": "navy",
      "accent1": "accent",
      "accent2": "deep",
      "accent3": "pale",
      "accent4": "history",
      "accent5": "orange",
      "accent6": "highlight",
      "hlink": "deep",
      "folHlink": "navy"
    },
    "fonts": {
      "major": "display",
      "minor": "body"
    }
  },
  "roles": {
    "surface": "paper",
    "text": "ink",
    "rule": "rule",
    "series": "accent",
    "focus": "deep"
  },
  "refurbish": {
    "palette": {
      "background": "paper",
      "text": "ink",
      "muted": "muted",
      "accent": "accent",
      "line": "rule",
      "surface": "surface"
    },
    "fonts": {
      "display": "display",
      "body": "body",
      "cjk": "body"
    }
  },
  "rules": [
    {
      "id": "palette",
      "check": "allowed-colors"
    },
    {
      "id": "fonts",
      "check": "allowed-fonts"
    },
    {
      "id": "effects",
      "check": "forbidden-effects",
      "values": ["shadow", "glow", "reflection", "softEdge"]
    },
    {
      "id": "bounds",
      "check": "bounds"
    },
    {
      "id": "readable",
      "check": "font-floor",
      "minPt": 10.5
    },
    {
      "id": "research-language",
      "check": "research-language"
    }
  ],
  "research": {
    "family": "blue-research/v1",
    "styles": {
      "hero": {
        "role": "display",
        "sizePt": 42,
        "color": "navy",
        "bold": false,
        "lineHeight": 1.18
      },
      "title": {
        "role": "display",
        "sizePt": 22,
        "color": "navy",
        "bold": false,
        "lineHeight": 1.1
      },
      "heading": {
        "role": "body",
        "sizePt": 13,
        "color": "navy",
        "bold": true,
        "lineHeight": 1.1
      },
      "body": {
        "role": "body",
        "sizePt": 12,
        "color": "ink",
        "bold": false,
        "lineHeight": 1.1
      },
      "small": {
        "role": "body",
        "sizePt": 10.5,
        "color": "muted",
        "bold": false,
        "lineHeight": 1.1
      },
      "table": {
        "role": "body",
        "sizePt": 11,
        "color": "ink",
        "bold": false,
        "lineHeight": 1.1
      },
      "figure": {
        "role": "body",
        "sizePt": 20,
        "color": "navy",
        "bold": true,
        "lineHeight": 1.1
      },
      "edition": {
        "role": "body",
        "sizePt": 38,
        "color": "editionInk",
        "bold": true,
        "lineHeight": 1.1
      },
      "quote": {
        "role": "body",
        "sizePt": 40,
        "color": "deep",
        "bold": true,
        "lineHeight": 1.1
      }
    },
    "spacing": {
      "gap": 0.25,
      "rulePt": 0.65
    },
    "rhythm": {
      "maxConsecutive": 2
    },
    "chrome": {
      "eyebrow": [0.6, 0.4, 12.13, 0.3],
      "title": [0.6, 0.7, 12.13, 0.85],
      "subtitle": [0.6, 1.81, 12.13, 0.32],
      "strip": [0, 6.35, 13.333, 0.4],
      "stripLabel": [0.6, 6.41, 1.45, 0.27],
      "verdict": [2.22, 6.41, 10.5, 0.27],
      "source": [0.6, 6.85, 10.9, 0.25],
      "page": [11.9, 6.85, 0.83, 0.25]
    },
    "capacity": {
      "claims": [3, 3],
      "notes": [2, 3],
      "agenda": [3, 5],
      "chartCategories": [3, 6],
      "chartSeries": [1, 2],
      "columns": [4, 6],
      "rows": [3, 6],
      "drivers": [2, 4],
      "tierRows": [3, 6],
      "events": [3, 4],
      "goals": [3, 3],
      "steps": [3, 3],
      "stepActions": [1, 4],
      "findings": [3, 4],
      "readers": [2, 3],
      "dependencies": [3, 3]
    },
