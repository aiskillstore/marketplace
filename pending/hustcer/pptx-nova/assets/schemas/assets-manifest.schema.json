{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-assets-manifest/v1",
  "title": "pptx-nova assets manifest",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": {
      "const": "pptx-nova-assets-manifest/v1"
    },
    "assetRoot": {
      "type": "string",
      "description": "Run-dir relative root for local asset files."
    },
    "entries": {
      "$ref": "#/definitions/assetEntries"
    },
    "assets": {
      "$ref": "#/definitions/assetEntries"
    }
  },
  "anyOf": [{ "required": ["entries"] }, { "required": ["assets"] }],
  "additionalProperties": true,
  "definitions": {
    "assetEntries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/assetEntry"
      }
    },
    "assetEntry": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "type": "string",
          "description": "Examples: image, screenshot, logo, formula, icon, chart-data."
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "built-in",
            "generated",
            "rendered",
            "native",
            "placeholder",
            "needs-review",
            "needs-user",
            "missing",
            "forbidden"
          ],
          "default": "available"
        },
        "licenseRisk": {
          "type": "string",
          "enum": ["none", "unknown", "blocked"]
        },
        "usage": {
          "type": "string",
          "description": "Business usage such as logo, product-screenshot, icon, chart-image, formula."
        },
        "path": {
          "type": "string"
        },
        "sourceKind": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/assetSource"
        },
        "slotId": {
          "type": "string"
        },
        "slot": {
          "$ref": "#/definitions/imageSlot"
        },
        "pptxUse": {
          "$ref": "#/definitions/pptxUse"
        },
        "generationPromptGuard": {
          "$ref": "#/definitions/promptGuard"
        }
      },
      "additionalProperties": true
    },
    "assetSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "originalPath": {
          "type": "string"
        },
        "licenseNote": {
          "type": "string"
        },
        "licenseRisk": {
          "type": "string",
          "enum": ["none", "unknown", "blocked"]
        },
        "generator": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "promptGuard": {
          "$ref": "#/definitions/promptGuard"
        },
        "latex": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "enum": ["inline", "block"]
        }
      },
      "additionalProperties": true
    },
    "pptxUse": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "crop": {
          "type": "string",
          "enum": ["cover", "contain"]
        },
        "noCrop": {
          "type": "boolean"
        },
        "slotId": {
          "type": "string"
        },
        "ratio": {
          "$ref": "#/definitions/imageRatio"
        },
        "fitPolicy": {
          "$ref": "#/definitions/fitPolicy"
        },
        "noSlideChrome": {
          "type": "boolean"
        },
        "slot": {
          "$ref": "#/definitions/imageSlot"
        },
        "promptGuard": {
          "$ref": "#/definitions/promptGuard"
        }
      },
      "additionalProperties": true
    },
    "imageSlot": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "ratio": {
          "$ref": "#/definitions/imageRatio"
        },
        "fitPolicy": {
          "$ref": "#/definitions/fitPolicy"
        },
        "safeArea": {
          "type": "string"
        },
        "sourceFidelity": {
          "type": "string",
          "enum": ["exact", "representative", "decorative", "placeholder"]
        },
        "backgroundPolicy": {
          "type": "string",
          "enum": ["transparent", "opaque", "full-bleed", "isolated"]
        },
        "noSlideChrome": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "promptGuard": {
      "type": "object",
      "properties": {
        "noSlideChrome": {
          "type": "boolean"
        },
        "forbid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "imageRatio": {
      "type": "string",
      "enum": ["21:9", "16:10", "16:9", "4:3", "3:2", "3:4", "1:1"]
    },
    "fitPolicy": {
      "type": "string",
      "enum": ["cover", "contain", "no-crop", "crop-safe"]
    }
  }
}
