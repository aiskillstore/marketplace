{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-session-operation/v1",
  "title": "pptx-nova session rule operation plan",
  "type": "object",
  "required": ["schemaVersion", "event", "slideCountDelta", "targets", "explicitOverrides"],
  "properties": {
    "schemaVersion": { "const": "pptx-nova-session-operation/v1" },
    "event": {
      "type": "string",
      "enum": ["slide-added", "element-added", "ordinary-edit"]
    },
    "slideCountDelta": { "type": "integer" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "slide",
          "elementKind",
          "shapeName",
          "opIndexes",
          "changeCategories"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "const": "produced-object" },
          "slide": { "type": "integer", "minimum": 0 },
          "elementKind": { "type": "string", "enum": ["slide-title", "summary-box"] },
          "shapeName": { "type": "string", "minLength": 1 },
          "opIndexes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "uniqueItems": true
          },
          "changeCategories": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "enum": ["shape", "text", "style", "structure"] },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "explicitOverrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "source"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["kind", "quote"],
            "properties": {
              "kind": { "const": "current-user-request" },
              "quote": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
