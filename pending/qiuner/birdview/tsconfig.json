{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "rootDir": "src",
    "outDir": "scripts",
    "types": ["node"]
  },
  "include": ["src/**/*.mts"],
  "exclude": ["src/viewer/**", "src/site/**"]
}
