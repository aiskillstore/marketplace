#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Atri10
# Scan Executor artifacts for credential-shaped content.
#
# Reports file and line. NEVER prints the matched value — printing it would
# copy the secret into the agent's context and the session transcript, which
# is the failure this script exists to prevent.
#
# Both stores are in scope: docs/executor/ is tracked from the start, and
# .executor/ is git-ignored only by default — the user may commit it.
#
# Usage: exec-scan-secrets [PATH ...]     default: both stores
# Exit:  0 clean, 1 findings, 2 usage/setup error
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

targets=()
if [ $# -gt 0 ]; then
  targets=("$@")
else
  # The two stores anchor to different roots. Resolving .executor/ from the
  # working tree would make the default scan silently skip the entire
  # execution store when run inside a linked worktree — and a skipped store
  # reporting "clean" is precisely the failure this gate exists to prevent.
  docs_root=$(exec_root)
  run_root=$(exec_main_root)
  [ -d "$docs_root/docs/executor" ] && targets+=("$docs_root/docs/executor")
  [ -d "$run_root/.executor" ] && targets+=("$run_root/.executor")
fi

if [ ${#targets[@]} -eq 0 ]; then
  echo "no Executor stores found — nothing to scan"
  exit 0
fi

# Every target must exist. Checking only the first — or letting find's
# stderr suppression swallow a missing dir — reports "clean" for a store
# that was never scanned, which is the failure this gate exists to catch.
missing=()
for t in "${targets[@]}"; do
  [ -e "$t" ] || missing+=("$t")
done
[ ${#missing[@]} -eq 0 ] || exec_die "no such path(s): ${missing[*]}"

# name|regex — high signal only. A scanner that cries wolf gets ignored, and
# an ignored scanner is worse than none.
ASSIGN_RE='(secret|token|passwd|password|api[_-]?key|access[_-]?key|client[_-]?secret)[[:space:]]*[:=][[:space:]]*["'\''][^"'\'' ]{12,}["'\'']'
PATTERNS=(
  'private key block|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'openai-style key|\bsk-[A-Za-z0-9_-]{20,}'
  'github token|\bgh[pousr]_[A-Za-z0-9]{20,}'
  'aws access key id|\bAKIA[0-9A-Z]{16}\b'
  'slack token|\bxox[baprs]-[A-Za-z0-9-]{10,}'
  'google api key|\bAIza[0-9A-Za-z_-]{35}\b'
  'stripe key|\b[sr]k_(live|test)_[A-Za-z0-9]{20,}'
  'jwt|\bey[A-Za-z0-9_-]{10,}\.ey[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'
  'authorization header|[Aa]uthorization:[[:space:]]*(Bearer|Basic|token)[[:space:]]+[A-Za-z0-9._~+/=-]{12,}'
  'credentialed url|[a-zA-Z][a-zA-Z0-9+.-]*://[^[:space:]:@/]+:[^[:space:]@/]{6,}@'
  "secret assignment|$ASSIGN_RE"
  'pem file body|^[A-Za-z0-9+/]{60,}={0,2}$'
)

# Suppression rule — the matched VALUE decides, not the line it sits on.
# Under the old line-wide IGNORE a single doc keyword (TODO, example, ...)
# anywhere on a line hid every secret on it, including a real one.
#
#   1. If EVERY match of the pattern on the line is itself a placeholder
#      or template shape (VALUE_IGNORE), the line is suppressed.
#   2. Otherwise a pure comment/doc line (COMMENT_RE) that names a doc
#      keyword (LINE_IGNORE) is still suppressed — but never when the line
#      carries an assignment-shaped secret (ASSIGN_RE): people do comment
#      out real keys, and a commented-out real key is still a leak.
VALUE_IGNORE='(<[^>]*>|\{\{|\$\{|REDACTED|redacted|EXAMPLE|example|YOUR_|CHANGE_ME|xxxx|XXXX|\.\.\.|â€¦|placeholder)'
LINE_IGNORE='(TODO|EXAMPLE|example|placeholder|REDACTED|redacted|CHANGE_ME|YOUR_|xxxx|XXXX)'
COMMENT_RE='^[[:space:]]*(#|//|/\*|\*|<!--|;|-[[:space:]]|>)'

findings=0
for target in "${targets[@]}"; do
  while IFS= read -r file; do
    case "$file" in
      *.diff|*.md|*.txt|*.json|*.yml|*.yaml|*.html|*.log|*.env|*.env.*|*.sh|*.pem|*.key|*.py|*.cjs|*.js|*.ts|*.conf|*.cfg|*.ini) ;;
      *) continue ;;
    esac
    for entry in "${PATTERNS[@]}"; do
      name=${entry%%|*}
      regex=${entry#*|}
      while IFS=: read -r lineno _rest; do
        [ -n "${lineno:-}" ] || continue
        line=$(sed -n "${lineno}p" "$file")
        # Rule 1: suppress only when every secret-shaped match on the line
        # is itself a placeholder or template shape.
        all_placeholder=1
        saw_match=0
        while IFS= read -r m; do
          saw_match=1
          if ! printf '%s\n' "$m" | grep -qE "$VALUE_IGNORE"; then
            all_placeholder=0
            break
          fi
        done < <(printf '%s\n' "$line" | grep -oE "$regex" || true)
        [ "$saw_match" -eq 1 ] && [ "$all_placeholder" -eq 1 ] && continue
        # Rule 2: comment/doc lines carrying only a doc keyword stay
        # suppressed — unless the line also holds an assignment-shaped
        # secret.
        if printf '%s\n' "$line" | grep -qE "$COMMENT_RE" \
           && printf '%s\n' "$line" | grep -qE "$LINE_IGNORE" \
           && ! printf '%s\n' "$line" | grep -qE "$ASSIGN_RE"; then
          continue
        fi
        printf '%s:%s: possible %s\n' "${file#"$(exec_root)/"}" "$lineno" "$name"
        findings=$((findings + 1))
      done < <(grep -nE "$regex" "$file" 2>/dev/null || true)
    done
  done < <(find "$target" -type f)
done

echo
if [ "$findings" -eq 0 ]; then
  echo "clean: no credential-shaped content found in ${#targets[@]} store(s)"
  exit 0
fi

cat >&2 <<'EOF'
FINDINGS ABOVE BLOCK HANDOFF.

Do not print, echo, or copy any matched value — that copies the secret into
the transcript. Tell the human: which file, which line, what kind.

If the content is only in .executor/ and was never committed, that file is
the only copy: the human decides redact-in-place or discard.

If it reached git, this is credential rotation, not a file edit. The human
rotates. History rewriting is their call, never yours.
EOF
exit 1
