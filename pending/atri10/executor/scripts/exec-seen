#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Atri10
# exec-seen — record observed worker contact. Rewrites the Last-Seen cell on
# every open dispatches.md row for the task. Called on EVENTS (dispatch,
# revive, a worker return the pump relays), never per fold — a Last-Seen
# stamped every turn makes the fallback permanently fresh and the
# suspect/dead rungs unreachable, which is the failure the heartbeat exists
# to catch.
#
# Usage:
#   exec-seen PLAN_FILE TASK_ID
set -euo pipefail
. "$(cd "$(dirname "$0")" && pwd)/_exec-lib.sh"

[ $# -eq 2 ] && [ -f "$1" ] || exec_die "usage: exec-seen PLAN_FILE TASK_ID"

dir=$(exec_workspace_dir "$1")
dfile="$dir/dispatches.md"
[ -f "$dfile" ] || exec_die "no dispatches.md in $dir — run exec-workspace first"

exec_dispatch_set "$dfile" "$2" "Last-Seen" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "seen $2 at $(date -u +%Y-%m-%dT%H:%M:%SZ)"
