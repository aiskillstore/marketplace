{
  "title": "Zillow For-Sale, Rent & Sold Listing Extractor",
  "description": "Search Zillow by city, ZIP, property URL, ZPID or address; filter buy, rent and sold listings; enrich each record with property or rental-building detail.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "search": {
      "title": "Search Location",
      "type": "string",
      "description": "City, ZIP, neighborhood, county or state to search (for example 'Houston, TX' or '77002').",
      "prefill": "Houston, TX",
      "editor": "textfield",
      "sectionCaption": "Search Settings",
      "sectionDescription": "Enter a location and choose a search mode. You can also use the lookup lists below or paste URLs."
    },
    "mode": {
      "title": "Search Mode",
      "type": "string",
      "description": "Search active for-sale listings, rentals, or recently sold listings.",
      "editor": "select",
      "default": "BUY",
      "prefill": "BUY",
      "enum": [
        "BUY",
        "RENT",
        "SOLD"
      ],
      "enumTitles": [
        "For Sale (Buy)",
        "For Rent",
        "Recently Sold"
      ]
    },
    "maxItems": {
      "title": "Maximum Properties",
      "type": "integer",
      "description": "Maximum number of records for the whole run across all sources (1-5000).",
      "minimum": 1,
      "maximum": 5000,
      "default": 50,
      "prefill": 3
    },
    "endPage": {
      "title": "Maximum Pages",
      "type": "integer",
      "description": "Maximum search result pages per search task (1-24). Zillow returns up to 41 listings per page.",
      "minimum": 1,
      "maximum": 24,
      "default": 5,
      "prefill": 1
    },
    "startUrls": {
      "title": "Start URLs",
      "type": "array",
      "description": "Property detail URLs, /apartments/ building URLs, or Zillow search page URLs. Search URLs keep their own filters and mode.",
      "editor": "requestListSources",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "title": "URL",
            "type": "string",
            "description": "Page URL to scrape."
          }
        }
      },
      "sectionCaption": "Lookup Lists",
      "sectionDescription": "Use any combination of URLs, ZPIDs and street addresses. Explicit detail sources are always enriched."
    },
    "zpids": {
      "title": "ZPIDs",
      "type": "array",
      "description": "Zillow property IDs or URLs containing _zpid. Each ZPID is resolved to its canonical detail page.",
      "editor": "stringList",
      "items": {
        "type": "string"
      }
    },
    "addresses": {
      "title": "Street Addresses",
      "type": "array",
      "description": "Full street addresses to resolve to Zillow property pages, for example '1306 Castle Ct, Houston, TX 77006'.",
      "editor": "stringList",
      "items": {
        "type": "string"
      }
    },
    "priceMin": {
      "title": "Minimum Price",
      "type": "integer",
      "description": "Minimum listing price in US dollars.",
      "minimum": 0,
      "maximum": 100000000,
      "sectionCaption": "Filters",
      "sectionDescription": "Filters are applied to location searches and search URLs through Zillow's searchQueryState."
    },
    "priceMax": {
      "title": "Maximum Price",
      "type": "integer",
      "description": "Maximum listing price in US dollars.",
      "minimum": 0,
      "maximum": 100000000
    },
    "bedsMin": {
      "title": "Minimum Bedrooms",
      "type": "string",
      "description": "Minimum number of bedrooms.",
      "editor": "select",
      "default": "any",
      "enum": [
        "any",
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "enumTitles": [
        "Any",
        "1+",
        "2+",
        "3+",
        "4+",
        "5+"
      ]
    },
    "bathsMin": {
      "title": "Minimum Bathrooms",
      "type": "string",
      "description": "Minimum number of bathrooms.",
      "editor": "select",
      "default": "any",
      "enum": [
        "any",
        "1",
        "1.5",
        "2",
        "2.5",
        "3",
        "4",
        "5"
      ],
      "enumTitles": [
        "Any",
        "1+",
        "1.5+",
        "2+",
        "2.5+",
        "3+",
        "4+",
        "5+"
      ]
    },
    "sqftMin": {
      "title": "Minimum Square Feet",
      "type": "integer",
      "description": "Minimum living area in square feet.",
      "minimum": 0,
      "maximum": 100000
    },
    "sqftMax": {
      "title": "Maximum Square Feet",
      "type": "integer",
      "description": "Maximum living area in square feet.",
      "minimum": 0,
      "maximum": 100000
    },
    "lotSizeMin": {
      "title": "Minimum Lot Size",
      "type": "string",
      "description": "Minimum lot size in square feet.",
      "editor": "select",
      "default": "any",
      "enum": [
        "any",
        "2000",
        "5000",
        "10890",
        "21780",
        "43560",
        "87120"
      ],
      "enumTitles": [
        "Any",
        "2,000 sqft",
        "5,000 sqft",
        "0.25 acre",
        "0.5 acre",
        "1 acre",
        "2 acres"
      ]
    },
    "lotSizeMax": {
      "title": "Maximum Lot Size",
      "type": "string",
      "description": "Maximum lot size in square feet.",
      "editor": "select",
      "default": "any",
      "enum": [
        "any",
        "2000",
        "5000",
        "10890",
        "21780",
        "43560",
        "87120"
      ],
      "enumTitles": [
        "Any",
        "2,000 sqft",
        "5,000 sqft",
        "0.25 acre",
        "0.5 acre",
        "1 acre",
        "2 acres"
      ]
    },
    "yearBuiltMin": {
      "title": "Built After",
      "type": "integer",
      "description": "Earliest construction year.",
      "minimum": 1800,
      "maximum": 2026
    },
    "yearBuiltMax": {
      "title": "Built Before",
      "type": "integer",
      "description": "Latest construction year.",
      "minimum": 1800,
      "maximum": 2026
    },
    "hoaMax": {
      "title": "Maximum HOA Fee",
      "type": "integer",
      "description": "Maximum monthly HOA fee in US dollars.",
      "minimum": 0,
      "maximum": 10000
    },
    "parkingSpotsMin": {
      "title": "Minimum Parking Spots",
      "type": "integer",
      "description": "Minimum number of parking spots (1-10).",
      "minimum": 1,
      "maximum": 10
    },
    "propertyTypes": {
      "title": "Property Types",
      "type": "array",
      "description": "Limit results to selected property types. Leave empty for all homes.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "house",
          "condo",
          "townhouse",
          "multiFamily",
          "manufactured",
          "lotLand",
          "apartment"
        ],
        "enumTitles": [
          "House",
          "Condo",
          "Townhouse",
          "Multi-family",
          "Manufactured",
          "Lot / Land",
          "Apartment"
        ]
      }
    },
    "daysOnZillow": {
      "title": "Days on Zillow",
      "type": "string",
      "description": "Only include listings added within this period.",
      "editor": "select",
      "default": "any",
      "enum": [
        "any",
        "1",
        "7",
        "14",
        "30",
        "90",
        "180",
        "365",
        "730",
        "1095"
      ],
      "enumTitles": [
        "Any",
        "1 day",
        "7 days",
        "14 days",
        "30 days",
        "90 days",
        "6 months",
        "12 months",
        "24 months",
        "36 months"
      ]
    },
    "sortBy": {
      "title": "Sort By",
      "type": "string",
      "description": "Result order. Relevance uses Zillow's priority order in RENT mode.",
      "editor": "select",
      "default": "relevance",
      "enum": [
        "relevance",
        "priceLow",
        "priceHigh",
        "newest",
        "zestimate",
        "zestimateLow"
      ],
      "enumTitles": [
        "Relevance",
        "Price: low to high",
        "Price: high to low",
        "Newest",
        "Zestimate: high to low",
        "Zestimate: low to high"
      ]
    },
    "fsboOnly": {
      "title": "For Sale By Owner Only",
      "type": "boolean",
      "description": "Only include for-sale-by-owner listings.",
      "default": false,
      "prefill": false
    },
    "foreclosureOnly": {
      "title": "Foreclosure Only",
      "type": "boolean",
      "description": "Only include foreclosure listings.",
      "default": false,
      "prefill": false
    },
    "auctionOnly": {
      "title": "Auction Only",
      "type": "boolean",
      "description": "Only include auction listings.",
      "default": false,
      "prefill": false
    },
    "newConstructionOnly": {
      "title": "New Construction Only",
      "type": "boolean",
      "description": "Only include new-construction listings.",
      "default": false,
      "prefill": false
    },
    "includePending": {
      "title": "Include Pending Listings",
      "type": "boolean",
      "description": "Add pending and under-contract listings to active results.",
      "default": false,
      "prefill": false
    },
    "openHouseOnly": {
      "title": "Open House Only",
      "type": "boolean",
      "description": "Only include listings with an open house.",
      "default": false,
      "prefill": false
    },
    "priceReducedOnly": {
      "title": "Price Reduced Only",
      "type": "boolean",
      "description": "Only include listings with a price reduction.",
      "default": false,
      "prefill": false
    },
    "keyword": {
      "title": "Keyword",
      "type": "string",
      "description": "Free-text keyword to match in the listing, for example 'pool'.",
      "editor": "textfield"
    },
    "amenities": {
      "title": "Amenities",
      "type": "array",
      "description": "Only include listings with the selected amenities.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "pool",
          "garage",
          "airConditioning",
          "waterfront",
          "cityView",
          "threeDHome",
          "age55Plus",
          "singleStory",
          "basementFinished",
          "basementUnfinished",
          "waterView",
          "mountainView",
          "parkView"
        ],
        "enumTitles": [
          "Pool",
          "Garage",
          "Air conditioning",
          "Waterfront",
          "City view",
          "3D home",
          "55+ community",
          "Single story",
          "Finished basement",
          "Unfinished basement",
          "Water view",
          "Mountain view",
          "Park view"
        ]
      }
    },
    "rentalFilters": {
      "title": "Rental Filters",
      "type": "array",
      "description": "Rent-only filters. Ignored with a status note outside RENT mode.",
      "editor": "select",
      "sectionCaption": "Rental Filters",
      "sectionDescription": "These filters apply only to RENT searches.",
      "items": {
        "type": "string",
        "enum": [
          "pets",
          "furnished",
          "parking",
          "inUnitLaundry",
          "shortTerm",
          "noPets",
          "byOwner",
          "incomeRestricted",
          "studentHousing",
          "onlyRentalSeniorHousingType",
          "hasFitnessCenter",
          "hasDishwasher",
          "onlyRentalInstantTourAvailable",
          "hasAcceptingBackupOffers"
        ],
        "enumTitles": [
          "Pets allowed",
          "Furnished",
          "Parking",
          "In-unit laundry",
          "Short-term lease",
          "No pets",
          "By owner",
          "Income restricted",
          "Student housing",
          "Senior housing",
          "Fitness center",
          "Dishwasher",
          "Instant tour available",
          "Accepting backup offers"
        ]
      }
    },
    "scrapeDetails": {
      "title": "Scrape Full Details",
      "type": "boolean",
      "description": "Fetch each search result's detail page for description, photos, MLS, tax, open house and building floor plans. Explicit URLs, ZPIDs and addresses are always enriched.",
      "default": true,
      "prefill": false,
      "sectionCaption": "Options"
    }
  },
  "required": [
    "mode"
  ]
}
