  "content": {
    "user_title": "Reconcile Your Home Bar Inventory",
    "value_statement": "Recorded bottle lists become unreliable after purchases, moves, and regular use. This skill compares both sides and prepares an exhaustive correction proposal for review.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "home bar inventory",
      "bottle inventory audit",
      "inventory reconciliation",
      "physical bottle count",
      "bar stock tracking",
      "inventory discrepancy review"
    ],
    "actual_capabilities": [
      "Separates the recorded inventory from current physical observations.",
      "Proposes one-to-one links using bottle identity, location, and fill evidence.",
      "Classifies matched, missing, added, duplicate, mismatched, and uncertain items.",
      "Preserves unknown labels, dates, fill levels, and unexplained discrepancies.",
      "Runs a bundled verifier to ensure every record and observation is accounted for once.",
      "Returns a review package without changing an inventory system."
    ],
    "limitations": [
      "Users must provide stable identifiers and explicit values or unknown markers.",
      "The verifier checks exhaustive accounting, but it cannot prove bottle identity.",
      "Photographs do not establish verified fields without user confirmation.",
      "The skill does not decide freshness, infer missing-item causes, or apply corrections."
    ],
    "use_cases": [
      {
        "title": "Reconcile a routine home count",
        "description": "Compare a saved bottle list with a new shelf count after purchases, use, or moves.",
        "target_user": "Home cocktail enthusiast"
      },
      {
        "title": "Review a large bottle collection",
        "description": "Track every recorded and observed bottle while preserving uncertain matches for later confirmation.",
        "target_user": "Bottle collector"
      },
      {
        "title": "Prepare a correction proposal",
        "description": "Produce a complete discrepancy package for a person who controls the inventory system.",
        "target_user": "Household inventory manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Compare two bottle lists",
        "prompt": "Use the home-bar-inventory-audit skill. Compare my recorded bottles with my physical count. Preserve unknown values and propose changes without applying them.",
        "scenario": "Beginner audit with two short lists"
      },
      {
        "title": "Review inventory mismatches",
        "prompt": "Reconcile these records and observations by stable ID. Identify location and fill mismatches. Give every unlinked item one supported disposition.",
        "scenario": "Intermediate discrepancy review"
      },
      {
        "title": "Preserve duplicate uncertainty",
        "prompt": "Audit this collection with several identical bottles. Use one-to-one links. Mark uncertain identities as needs_review unless my evidence confirms a duplicate.",
        "scenario": "Advanced matching with ambiguous bottles"
      },
      {
        "title": "Verify exhaustive accounting",
        "prompt": "Normalize this frozen inventory and physical count under the audit contract. Run the bundled verifier. Return the complete review package and all freshness handoffs.",
        "scenario": "Advanced end-to-end reconciliation"
      }
    ],
    "output_examples": [
      {
        "input": "The record lists gin, vermouth, and Campari. The shelf contains matching gin, relocated vermouth, and unrecorded soda water.",
        "output": "Review package: gin matched, vermouth has a location mismatch, Campari is missing, and soda water is a proposed addition. No correction was applied."
      },
      {
        "input": "One recorded gin could match either of two identical observed bottles with unknown fill levels.",
        "output": "Both identities remain unresolved. One bottle is linked for review, and the second observation also needs review. No duplicate is assumed."
      },
      {
        "input": "A rum record has no physical match and no disposition.",
        "output": "Verification stops because the rum record is unaccounted. Assign missing or needs_review before creating the exhaustive review package."
      }
    ],
    "best_practices": [
      "Freeze the recorded list and physical count before matching any bottles.",
      "Use unique stable IDs and retain unknown values until evidence resolves them.",
      "Review every proposed correction and freshness handoff before updating another system."
    ],
    "anti_patterns": [
      "Do not infer consumption, disposal, theft, or relocation for a missing bottle.",
      "Do not use one observation to satisfy multiple inventory records.",
      "Do not label an identical bottle as duplicate without user confirmation."
    ],
    "faq": [
      {
        "question": "Does this skill update my inventory system?",
        "answer": "No. It creates a correction proposal and stops before any external edit."
      },
      {
        "question": "What information should I provide?",
        "answer": "Provide stable IDs, exact labels, sizes, fill levels, locations, open dates, and direct notes when available."
      },
      {
        "question": "Can it identify bottles from photographs?",
        "answer": "It can use supplied observations, but unreadable or unconfirmed photograph details must remain unknown."
      },
      {
        "question": "How does it handle missing bottles?",
        "answer": "It marks an unlinked record as missing or needs_review without inferring what happened."
      },
      {
        "question": "How does it handle identical bottles?",
        "answer": "It keeps ambiguous identities under review unless the user confirms a separate bottle as intentional or redundant."
      },
      {
        "question": "Does it evaluate vermouth or cream liqueur freshness?",
        "answer": "No. It routes condition questions to a product-specific freshness skill after reconciliation."
      }
    ]
