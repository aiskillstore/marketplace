  "content": {
    "user_title": "诊断并优化你的装修方案",
    "value_statement": "装修方案常因布局、尺寸和收纳规划不足而影响居住体验。此技能使用本地装修知识资料，提供结构化诊断、具体建议和常见风险提示。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "装修方案诊断",
      "室内设计",
      "空间布局",
      "户型改造",
      "收纳规划",
      "装修避坑",
      "风格搭配"
    ],
    "actual_capabilities": [
      "评估客厅、卧室、厨房等功能区的布局和动线。",
      "识别户型改造与空间利用中的常见限制。",
      "根据区域和物品类型提出收纳规划建议。",
      "解释风格搭配、色彩与硬装取舍的基本原则。",
      "列出嵌入式设备、安装和施工协调中的常见问题。",
      "提供选择装修设计师和沟通方案的参考要点。"
    ],
    "limitations": [
      "不能替代持证建筑、结构、电气或燃气专业人员的现场判断。",
      "不能确认墙体是否可拆，改造前必须核对原始图纸和物业要求。",
      "建议基于用户提供的信息，尺寸、预算和当地规范需要自行复核。",
      "不提供施工合同审查、报价核验或材料质量检测结论。"
    ],
    "use_cases": [
      {
        "title": "审查新房平面方案",
        "description": "在开工前检查功能区、家具位置和主要动线的合理性。",
        "target_user": "准备装修的新房业主"
      },
      {
        "title": "优化小户型收纳",
        "description": "按房间和物品类型整理收纳优先级，减少闲置和取用障碍。",
        "target_user": "小户型居住者"
      },
      {
        "title": "准备与设计师沟通",
        "description": "将需求转化为尺寸、功能和风险问题，便于评审设计方案。",
        "target_user": "正在比较设计方案的业主"
      }
    ],
    "prompt_templates": [
      {
        "title": "初步诊断",
        "scenario": "刚拿到平面方案",
        "prompt": "请诊断我的两居室装修方案。客厅约 20 平方米，餐桌靠近厨房，主卧需要书桌。请先给结论，再列出布局问题和改进建议。"
      },
      {
        "title": "收纳规划",
        "scenario": "需要分房间规划收纳",
        "prompt": "请为三口之家规划收纳。说明玄关、厨房、卧室和儿童房应优先收纳哪些物品，并提示常见尺寸和使用风险。"
      },
      {
        "title": "户型改造评审",
        "scenario": "考虑调整空间功能",
        "prompt": "我想把次卧改为书房兼客房。请按动线、采光、隔音、收纳和可恢复性评估方案，并列出开工前必须向物业和专业人员确认的问题。"
      },
      {
        "title": "综合方案复核",
        "scenario": "开工前最终检查",
        "prompt": "请按布局、收纳、风格、嵌入式设备和施工衔接诊断我的装修方案。每项给出优先级、建议做法、需要确认的尺寸和避坑提醒。"
      }
    ],
    "output_examples": [
      {
        "input": "厨房水槽、切菜区和灶具排成一线，但切菜台面很窄。",
