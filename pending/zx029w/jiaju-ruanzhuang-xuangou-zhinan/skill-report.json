  "content": {
    "user_title": "规划家具软装选购与空间搭配",
    "value_statement": "家具尺寸、材质和配色选择容易造成预算浪费与空间不协调。本技能结合户型、预算和使用需求，提供明确的选购与搭配建议。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "家具选购指南",
      "软装搭配",
      "窗帘选购",
      "空间配色",
      "家具尺寸规划",
      "装修避坑"
    ],
    "actual_capabilities": [
      "根据户型、预算和居住需求整理家具软装方案。",
      "提供沙发、柜类、成品家具与实木家具的选购要点。",
      "比较窗帘材质、遮光、尺寸、安装位置和配色方案。",
      "运用配色、留白、收纳和分层照明原则优化空间。",
      "针对小户型、卧室、客厅、书房和阳台提出布置建议。",
      "在改造和安全问题中提示承重、物业、防水与用电检查。"
    ],
    "limitations": [
      "不能替代现场测量、材料检测或专业施工评估。",
      "参考资料不能保证覆盖最新价格、产品型号和地方规范。",
      "无法仅凭文字确认承重结构、污染水平或产品真实材质。",
      "部分资料依赖图片语境，纯文字建议可能缺少视觉细节。"
    ],
    "use_cases": [
      {
        "title": "制定新家采购清单",
        "description": "按空间、尺寸、预算和优先级整理家具与软装采购顺序。",
        "target_user": "首次装修的业主"
      },
      {
        "title": "优化小户型布局",
        "description": "识别占地过大的家具，并提供收纳、留白和动线调整建议。",
        "target_user": "小户型住户"
      },
      {
        "title": "核对软装方案",
        "description": "检查窗帘、家具、配色和灯光是否协调，并列出风险点。",
        "target_user": "室内设计从业者"
      }
    ],
    "prompt_templates": [
      {
        "title": "选择客厅沙发",
        "prompt": "我的客厅开间是[尺寸]，常住[人数]人，预算[金额]。请推荐沙发尺寸、材质和布局，并说明避坑点。",
        "scenario": "首次选择主要家具"
      },
      {
        "title": "规划卧室窗帘",
        "prompt": "卧室朝向[方向]，窗户类型是[类型]，我重视[遮光或采光]。请比较窗帘材质、安装方式和配色。",
        "scenario": "解决遮光与搭配问题"
      },
      {
        "title": "审核全屋软装清单",
        "prompt": "这是我的户型、家具尺寸、墙地颜色和预算：[信息]。请按空间审核清单，指出尺寸、配色、收纳和动线问题。",
        "scenario": "采购前系统核对方案"
      },
      {
        "title": "制定分阶段软装方案",
        "prompt": "根据[户型信息]、[家庭成员]、[生活习惯]和[总预算]，制定三阶段软装计划。请给出优先级、预算比例、替代方案和安全检查项。",
        "scenario": "复杂家庭需求与预算规划"
      }
    ],
    "output_examples": [
      {
        "input": "客厅较小，三人居住，想买 L 型沙发。",
        "output": "不建议先定 L 型。先核对开间、通道和电视距离，再选择短直排沙发配轻便单椅，保留主要动线。"
      },
      {
        "input": "西晒卧室需要高遮光窗帘，预算有限。",
        "output": [
          "优先选择厚实面料或双层同色布帘。",
          "避免易脱落的低价涂层遮光布。",
          "使用窗帘盒配轨道，减少顶部和侧边漏光。",
          "下单前复核窗宽、落地高度和开启方向。"
        ]
      },
      {
        "input": "硬装完成后，客厅颜色和摆件很多，怎样调整？",
        "output": "先保留不超过三种主色，再减少重复摆件。统一窗帘与大件家具色调，并通过基础光、重点光和氛围光建立层次。"
      }
    ],
    "best_practices": [
      "提供房间净尺寸、门洞、电梯尺寸、预算和常住人数。",
      "先确定大件家具尺寸与动线，再选择颜色和装饰品。",
      "涉及拆改、用电或防水时，先向物业和专业人员核实。"
    ],
    "anti_patterns": [
      "只提供风格名称，却不说明尺寸、预算和生活需求。",
      "根据网图直接购买大件家具，不核对入户和摆放尺寸。",
      "把通用建议当作材料检测、结构鉴定或施工许可。"
    ],
    "faq": [
      {
        "question": "这个技能适合哪些装修阶段？",
        "answer": "适合方案规划、采购前核对、入住后调整和局部软装更新。"
      },
      {
        "question": "需要提供哪些信息？",
        "answer": "建议提供户型、净尺寸、朝向、预算、家庭成员、现有颜色和生活习惯。"
      },
      {
        "question": "可以推荐具体品牌或型号吗？",
        "answer": "可以整理比较标准，但资料不保证覆盖最新品牌、型号、价格和库存。"
      },
      {
        "question": "能判断家具是否为真材实料吗？",
        "answer": "不能仅凭描述确认材质。购买前应核对检测报告、合同标注、样品和售后条款。"
      },
      {
        "question": "能直接决定拆墙或改水电吗？",
        "answer": "不能。拆改前必须确认承重结构、物业要求、防水范围和专业施工条件。"
      },
      {
        "question": "建议是否只适用于西安？",
        "answer": "多数选购和搭配原则可以通用，但价格、气候和物业规则需要按当地情况调整。"
      }
    ]
  },
