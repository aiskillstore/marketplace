{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "policy",
    "intent",
    "decision",
    "first_substantive_actor",
    "required_pre_steps",
    "reason_code",
    "silent_fallback_authorized",
    "direct_codex_authorized",
    "git_authorized",
    "acceptance_authorized",
    "fixed_overhead_warning",
    "token_disclaimer",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-delegation-policy-decision"]
    },
    "policy": {
      "type": "string",
      "enum": ["delegation-first", "direct-codex", "second-eye"]
    },
    "intent": {
      "type": "string",
      "enum": ["explore", "task", "project"]
    },
    "decision": {
      "type": "string",
      "enum": [
        "delegate-agy",
        "direct-codex",
        "second-eye",
        "blocked",
        "partially_verified"
      ]
    },
    "first_substantive_actor": {
      "type": "string",
      "enum": ["agy", "codex", "none"]
    },
    "required_pre_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "delegation-first-active",
        "direct-codex-override",
        "second-eye-override",
        "missing-user-opt-in",
        "missing-transmission-approval",
        "missing-scope-approval",
        "hard-stop-active",
        "preflight-failed",
        "provider-unavailable",
        "provider-quota-exhausted",
        "cycle-budget-exhausted",
        "no-candidate-exhausted"
      ]
    },
    "caller_model": {
      "oneOf": [
        {"type": "string", "maxLength": 100, "pattern": "^[a-zA-Z0-9._:-]+$"},
        {"type": "null"}
      ]
    },
    "caller_effort": {
      "oneOf": [
        {"type": "string", "enum": ["low", "medium", "high", "none", "unspecified"]},
        {"type": "null"}
      ]
    },
    "silent_fallback_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "direct_codex_authorized": {
      "type": "boolean"
    },
    "git_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "acceptance_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "fixed_overhead_warning": {
      "type": "string"
    },
    "token_disclaimer": {
      "type": "string",
      "enum": [
        "Token observations are not billing, quota, or general savings evidence."
      ]
    },
    "rationale": {
      "type": "string"
    }
  }
}
