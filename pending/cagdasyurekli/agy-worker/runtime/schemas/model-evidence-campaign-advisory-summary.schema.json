{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "lane", "scenario", "recommendation",
    "rationale_code", "candidate", "anchors", "recommendation_only", "applied",
    "dispatch_authorized", "model_change_authorized", "effort_change_authorized",
    "acceptance_authorized", "git_authorized", "limitations",
    "token_inference_disclaimer"
  ],
  "definitions": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "ordinal", "coverage", "identity", "provenance", "runtime_version",
        "uncertainty", "drift_fraction", "rationale_codes"
      ],
      "properties": {
        "role": {"enum": ["candidate", "anchor"]},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 20},
        "coverage": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "identity": {"enum": ["match", "mismatch", "missing", "substituted"]},
        "provenance": {"enum": ["vendor_declared", "observational", "independent", "local"]},
        "runtime_version": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            {"type": "null"}
          ]
        },
        "uncertainty": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "drift_fraction": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "rationale_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "within-bounds", "lane-limitation", "identity-mismatch",
              "model-substituted", "observed-model-missing", "scenario-drift",
              "harness-drift", "evaluator-drift", "config-drift", "policy-drift",
              "window-drift", "telemetry-incompatible", "insufficient-coverage",
              "budget-exhausted", "insufficient-samples", "drift-exceeded",
              "error-rate-exceeded", "verification-failed", "uncertainty-exceeded"
            ]
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"enum": ["agy-model-evidence-campaign-advisory-summary"]},
    "lane": {"enum": ["vendor_declared", "measured", "observational"]},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_category", "scenario_version", "harness_version",
        "evaluator_version", "policy_version"
      ],
      "properties": {
        "workflow_category": {"enum": ["explore", "task", "project", "benchmark", "other"]},
        "scenario_version": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            {"type": "null"}
          ]
        },
        "harness_version": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
        "evaluator_version": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
        "policy_version": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"}
      }
    },
    "recommendation": {"enum": ["candidate_evidence_only", "no_recommendation"]},
    "rationale_code": {
      "enum": [
        "verified-measured-evidence", "anchor-drift", "trigger-drift",
        "identity-mismatch", "model-substituted", "observed-model-missing",
        "missing-subject", "unexpected-subject", "scenario-drift", "harness-drift",
        "evaluator-drift", "config-drift", "policy-drift", "window-drift",
        "telemetry-incompatible", "insufficient-coverage", "budget-exhausted",
        "insufficient-samples", "drift-exceeded", "error-rate-exceeded",
        "verification-failed", "uncertainty-exceeded", "lane-limitation"
      ]
    },
    "candidate": {
      "allOf": [
        {"$ref": "#/definitions/subject"},
        {"properties": {"role": {"const": "candidate"}, "ordinal": {"const": 0}}}
      ]
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "additionalItems": false,
      "items": [
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 1}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 2}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 3}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 4}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 5}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 6}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 7}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 8}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 9}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 10}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 11}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 12}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 13}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 14}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 15}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 16}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 17}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 18}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 19}}}]},
        {"allOf": [{"$ref": "#/definitions/subject"}, {"properties": {"role": {"const": "anchor"}, "ordinal": {"const": 20}}}]}
      ]
    },
    "recommendation_only": {"type": "boolean", "enum": [true]},
    "applied": {"type": "boolean", "enum": [false]},
    "dispatch_authorized": {"type": "boolean", "enum": [false]},
    "model_change_authorized": {"type": "boolean", "enum": [false]},
    "effort_change_authorized": {"type": "boolean", "enum": [false]},
    "acceptance_authorized": {"type": "boolean", "enum": [false]},
    "git_authorized": {"type": "boolean", "enum": [false]},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "token_inference_disclaimer": {"const": "Token observations are telemetry counts only and must never be used to infer billing, quota, allowance, or general cost savings."}
  }
}
