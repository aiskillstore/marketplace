{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "dataset_id",
    "dataset_version",
    "created_date",
    "freshness_window_days",
    "expiry_date",
    "items"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-intelligence-evidence"]
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$",
      "maxLength": 100
    },
    "dataset_version": {
      "type": "string",
      "maxLength": 50
    },
    "created_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "freshness_window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 730
    },
    "expiry_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provenance_type",
          "source_uri",
          "observed_date",
          "expiry_date",
          "harness",
          "harness_version",
          "agy_version",
          "requested_model",
          "observed_model",
          "substituted",
          "effort",
          "task_taxonomy",
          "sample_size",
          "calibration_only",
          "metrics",
          "telemetry_bindings",
          "confidence",
          "limitations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$",
            "maxLength": 100
          },
          "provenance_type": {
            "type": "string",
            "enum": ["vendor", "independent", "local"]
          },
          "source_uri": {
            "type": "string",
            "pattern": "^(https://[a-zA-Z0-9_./-]+|local://[a-zA-Z0-9_./-]+)(?![\\s\\S])",
            "maxLength": 2048
          },
          "observed_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "expiry_date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "harness": {
            "type": "string",
            "maxLength": 100
          },
          "harness_version": {
            "type": "string",
            "maxLength": 100
          },
          "agy_version": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 100},
              {"type": "null"}
            ]
          },
          "requested_model": {
            "type": "string",
            "maxLength": 100
          },
          "observed_model": {
            "oneOf": [
              {"type": "string", "minLength": 1, "maxLength": 100},
              {"type": "null"}
            ]
          },
          "substituted": {
            "oneOf": [
              {"type": "boolean"},
              {"type": "null"}
            ]
          },
          "effort": {
            "type": "string",
            "enum": ["low", "medium", "high", "none", "unspecified"]
          },
          "task_taxonomy": {
            "type": "string",
            "maxLength": 100
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "calibration_only": {
            "type": "boolean"
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quality_score",
              "latency_p50_seconds",
              "latency_p95_seconds",
              "mean_input_tokens",
              "mean_output_tokens",
              "mean_cached_tokens",
              "mean_thinking_tokens"
            ],
            "properties": {
              "quality_score": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 100},
                  {"type": "null"}
                ]
              },
              "latency_p50_seconds": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000},
                  {"type": "null"}
                ]
              },
              "latency_p95_seconds": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000},
                  {"type": "null"}
                ]
              },
              "mean_input_tokens": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000000},
                  {"type": "null"}
                ]
              },
              "mean_output_tokens": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000000},
                  {"type": "null"}
                ]
              },
              "mean_cached_tokens": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000000},
                  {"type": "null"}
                ]
              },
              "mean_thinking_tokens": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000000},
                  {"type": "null"}
                ]
              }
            }
          },
          "telemetry_bindings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accounting",
              "tokenizer",
              "currency",
              "cost_basis",
              "estimated_cost_per_task"
            ],
            "properties": {
              "accounting": {
                "type": "string",
                "maxLength": 100
              },
              "tokenizer": {
                "type": "string",
                "maxLength": 100
              },
              "currency": {
                "type": "string",
                "maxLength": 100
              },
              "cost_basis": {
                "oneOf": [
                  {"type": "string", "enum": ["observed_billed", "version_bound_list_price"]},
                  {"type": "null"}
                ]
              },
              "estimated_cost_per_task": {
                "oneOf": [
                  {"type": "number", "minimum": 0, "maximum": 1000000},
                  {"type": "null"}
                ]
              }
            }
          },
          "confidence": {
            "oneOf": [
              {"type": "string", "enum": ["high", "medium", "low"]},
              {"type": "null"}
            ]
          },
          "limitations": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "maxLength": 1000
            }
          }
        }
      }
    }
  }
}
