{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker recommendation-only advisory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "stage", "recommendation_only", "applied", "decision", "recommended_tier", "rationale", "cost_impact", "evidence"],
  "properties": {
    "schema_version": {"type": "number", "enum": [1]},
    "kind": {"type": "string", "enum": ["model-tier-recommendation"]},
    "stage": {"type": "string", "enum": ["pre-dispatch", "post-gate"]},
    "recommendation_only": {"type": "boolean", "enum": [true]},
    "applied": {"type": "boolean", "enum": [false]},
    "selected_tier": {"type": "string"},
    "user_model": {"type": "string"},
    "user_effort": {"type": "string", "enum": ["low", "medium", "high"]},
    "resolved_agy_model": {"type": "string"},
    "matrix_sha256": {"type": "string"},
    "matrix_agy_version": {"type": "string"},
    "matrix_source_revision": {"type": "string"},
    "decision": {"type": "string", "enum": ["no-escalation", "consider-higher-tier"]},
    "recommended_tier": {},
    "rationale": {"type": "string"},
    "cost_impact": {"type": "object"},
    "evidence": {"type": "object"}
  }
}
