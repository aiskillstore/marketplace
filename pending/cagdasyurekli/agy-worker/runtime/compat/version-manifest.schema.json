{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgyVersionManifest",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "versions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "agy-version-manifest"
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "version",
          "support_tier",
          "allowed_operations",
          "expected_stdout",
          "source_sha256",
          "source_size",
          "release_commit",
          "distribution_url",
          "distribution_sha512",
          "recovery_binding_sha256",
          "recovery_stdout",
          "recovery_runner_sha256",
          "recovery_runner_bytes",
          "recovery_summary_bytes",
          "output_profile_name",
          "prior_name"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "support_tier": {
                  "const": "current"
                }
              }
            },
            "then": {
              "properties": {
                "allowed_operations": {
                  "const": [
                    "activation",
                    "capture",
                    "classifier",
                    "profile",
                    "reprofile",
                    "version-evidence"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "support_tier": {
                  "const": "previous"
                }
              }
            },
            "then": {
              "properties": {
                "allowed_operations": {
                  "const": [
                    "capture",
                    "profile",
                    "version-evidence"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "support_tier": {
                  "const": "historical"
                }
              }
            },
            "then": {
              "properties": {
                "allowed_operations": {
                  "const": []
                }
              }
            }
          }
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
          },
          "support_tier": {
            "type": "string",
            "enum": [
              "current",
              "previous",
              "historical"
            ]
          },
          "allowed_operations": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "activation",
                "capture",
                "classifier",
                "profile",
                "reprofile",
                "version-evidence"
              ]
            }
          },
          "expected_stdout": {
            "type": "string"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_size": {
            "type": "integer",
            "minimum": 1
          },
          "release_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "distribution_url": {
            "type": "string",
            "format": "uri"
          },
          "distribution_sha512": {
            "type": "string",
            "pattern": "^[0-9a-f]{128}$"
          },
          "historical_recovery_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "historical_recovery_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_stdout": {
            "type": "string"
          },
          "recovery_runner_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "recovery_runner_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "recovery_summary_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "output_profile_name": {
            "type": "string"
          },
          "prior_name": {
            "type": "string"
          },
          "reprofile_output_name": {
            "type": "string"
          },
          "failure_ruleset_version": {
            "type": "string"
          },
          "capture_runner_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capture_record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capture_stdout_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "capture_response_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "inventory_normalized_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "slug_count": {
            "type": "integer",
            "minimum": 1
          },
          "slugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
