  "content": {
    "user_title": "运营数据资产并持续创造价值",
    "value_statement": "入表后的数据资产容易闲置、减值或缺少持续收入。该技能提供运营体系、周期动作、健康评价和分成机制设计。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "数据资产运营",
      "数据资产入表",
      "运营月历",
      "运营分成",
      "资产健康指标",
      "减值测试支持"
    ],
    "actual_capabilities": [
      "按维持、变现、增值和资本四个层次设计数据资产运营路径。",
      "制定每日、每月、每季、每半年、每年和不定期运营动作。",
      "评估资产使用率、持续收入占比、复购率、收益率和价值衰减率。",
      "设计收入或利润分成、核算、期限、审计权和排他性安排。",
      "生成运营交接、绩效评价、盘点减值和年度规划的交付框架。"
    ],
    "limitations": [
      "不能替代会计师、律师、评估机构或监管机关的正式意见。",
      "健康指标阈值是参考值，需要结合行业、资产类型和企业目标调整。",
      "不能自动连接运营系统、更新台账或执行财务核算。",
      "政策、授权、权属和合同条款需要用户提供最新证据并人工核验。"
    ],
    "use_cases": [
      {
        "title": "建立入表后运营体系",
        "description": "明确组织职责、运营流程、周期动作和交付物。",
        "target_user": "数据资产负责人"
      },
      {
        "title": "诊断资产运营健康",
        "description": "根据五个指标识别闲置、收入不足、复购偏低和减值风险。",
        "target_user": "财务与审计团队"
      },
      {
        "title": "设计合作分成方案",
        "description": "比较收入分成与利润分成，并定义核算、期限和审计安排。",
        "target_user": "数据产品运营方"
      }
    ],
    "prompt_templates": [
      {
        "title": "快速运营诊断",
        "prompt": "请根据以下资产清单和运营数据，评估五个健康指标，并列出主要问题、证据和优先行动：[粘贴资料]",
        "scenario": "首次了解现有运营状态"
      },
      {
        "title": "制定运营月历",
        "prompt": "请为这些数据资产制定十二个月运营月历。按频率列出动作、负责人、输入、输出和检查标准：[粘贴资料]",
        "scenario": "建立常态化运营节奏"
      },
      {
        "title": "设计运营分成机制",
        "prompt": "请基于双方投入、授权期限和收入预测，比较收入分成与利润分成，并提出比例、核算、审计和退出方案：[粘贴资料]",
        "scenario": "准备数据源方合作谈判"
      },
      {
        "title": "编制年度运营方案",
        "prompt": "请整合资产台账、产品表现、客户记录和财务数据，形成年度运营方案。包含分层策略、指标目标、月历、预算、风险和减值支持。",
        "scenario": "开展完整年度规划"
      }
    ],
    "output_examples": [
      {
        "input": "某企业有十项入表资产，但只有三项持续使用，年度复购率为百分之二十。",
        "output": "诊断摘要：资产使用率和复购率低于参考健康值。优先盘点闲置原因，建立季度回访，并为高潜资产制定产品迭代计划。"
      },
      {
        "input": "医院提供数据，运营方负责加工和销售，双方希望按收入分成。",
        "output": "分成方案要点：以实际回款为基础，按月对账、按季结算。数据源方保留审计权，期限与授权期一致，并设置退出条件。"
      },
      {
        "input": "为已入表的数据产品安排下一季度运营工作。",
        "output": [
          "每周：检查更新及时性、接口可用性和异常处理记录。",
          "每月：更新台账，完成财务对账和重点客户回访。",
          "季度末：复盘产品表现、收入、复购和资产减值迹象。"
        ]
      }
    ],
    "best_practices": [
      "先核验权属、授权、合规和数据质量，再设计变现或资本化动作。",
      "为每项运营动作指定负责人、完成时间、证据和可检查的输出。",
      "记录指标口径、数据来源和计算周期，保证结果可复核。"
    ],
    "anti_patterns": [
      "跳过数据更新和基础运营，直接推进融资或资产证券化。",
      "使用不可审计的利润口径计算分成，导致双方无法核对。",
      "只提交方案，不建立负责人、周期动作和持续跟踪记录。"
    ],
    "faq": [
      {
        "question": "这个技能适合哪些数据资产？",
        "answer": "适合已经入表、登记、产品化或进入交易运营阶段的数据资产。"
