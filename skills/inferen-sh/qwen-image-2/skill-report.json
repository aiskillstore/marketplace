    "user_title": "Create Qwen Images with inference.sh",
    "value_statement": "Creative teams need reliable Qwen image generation without building API integrations. This skill provides prompt patterns for inference.sh text-to-image and image editing workflows.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Qwen Image 2",
      "Alibaba image generation",
      "inference.sh CLI",
      "text-to-image",
      "image editing",
      "AI poster generation",
      "multi-reference editing"
    ],
    "actual_capabilities": [
      "Runs Qwen-Image-2.0 and Qwen-Image-2.0-Pro through infsh app run examples.",
      "Shows text-to-image prompts for single or multiple generated images.",
      "Supports multi-reference image editing with one to three source images.",
      "Documents width, height, seed, watermark, negative prompt, and prompt extension options.",
      "Explains when to use the Pro model for text-heavy posters and layouts."
    ],
    "limitations": [
      "Requires an installed inference.sh CLI and an authenticated infsh session.",
      "Generated content depends on remote model availability and inference.sh account access.",
      "Reference image examples use placeholder URLs that users must replace.",
      "The skill does not include local image validation or moderation code."
    ],
    "use_cases": [
      {
        "title": "Draft Visual Concepts",
        "description": "Create first-pass campaign images, mood boards, and style explorations from concise prompts.",
        "target_user": "Visual designers"
      },
      {
        "title": "Produce Marketing Variations",
        "description": "Generate poster or logo variations with controlled dimensions and model selection.",
        "target_user": "Marketing teams"
      },
      {
        "title": "Prototype Image Workflows",
        "description": "Test inference.sh image generation and editing commands before adding them to a product workflow.",
        "target_user": "Developers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Generate a First Image",
        "scenario": "Beginner text-to-image request",
        "prompt": "Use qwen-image-2 to create one square image of [subject] in [style]. Explain the selected model and options."
      },
      {
        "title": "Create Design Variations",
        "scenario": "Intermediate concept exploration",
        "prompt": "Generate four variations of [concept] with a consistent visual style. Use a seed so I can compare prompt changes."
      },
      {
        "title": "Edit Reference Images",
        "scenario": "Advanced multi-reference edit",
        "prompt": "Use three reference images to combine [person], [item], and [pose]. Keep identity and composition consistent."
      },
      {
        "title": "Build a Text Poster",
        "scenario": "Advanced Pro model workflow",
        "prompt": "Use qwen-image-2-pro for a vertical poster with exact quoted headline text, subtitle text, colors, and layout constraints."
      }
    ],
    "output_examples": [
      {
        "input": "Create a sale poster with a clear headline and beach background.",
        "output": "A Pro model plan with exact quoted text, vertical dimensions, and prompt extension disabled for precise lettering."
      },
      {
        "input": "Edit three reference images into one fashion image.",
        "output": "A multi-reference edit request that identifies the person, clothing, and pose sources before generation."
      },
      {
        "input": "Generate four logo ideas for a coffee shop.",
        "output": "A variation request using the fast model, four outputs, and a concise style direction for comparison."
      }
    ],
    "best_practices": [
      "Use the Pro model for exact visible text or poster-style layouts.",
      "Set a fixed seed when comparing prompt changes.",
      "Replace placeholder image URLs with accessible images before editing."
    ],
    "anti_patterns": [
      "Do not include private or regulated images unless your inference.sh account permits that use.",
      "Do not rely on placeholder URLs in production prompts.",
      "Do not request exact text while leaving prompt extension enabled when precision matters."
    ],
    "faq": [
      {
        "question": "What does this skill use to generate images?",
        "answer": "It uses the inference.sh CLI to run Alibaba Qwen-Image-2.0 image applications."
      },
      {
        "question": "Does it support image editing?",
        "answer": "Yes. The skill documents multi-reference editing with one to three input images."
      },
      {
        "question": "When should I use the Pro model?",
        "answer": "Use Qwen-Image-2.0-Pro when exact text, poster layouts, or fine detail matter."
      },
      {
        "question": "Can I generate multiple images at once?",
        "answer": "Yes. The documented num_images option supports one to six generated images."
      },
      {
        "question": "Does the skill work offline?",
        "answer": "No. It requires the inference.sh CLI, account access, and remote model execution."
      },
      {
