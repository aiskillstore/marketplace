  "content": {
    "user_title": "设计可成交的数据产品交易方案",
    "value_statement": "数据交易常因场所、定价、权利和交付安排不清而停滞。该技能提供从需求识别到售后复用的结构化方案。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "数据交易",
      "数据交易所",
      "交易结构设计",
      "数据产品定价",
      "合规审核",
      "数据交付"
    ],
    "actual_capabilities": [
      "比较场内交易、流通平台和场外交易的适用条件。",
      "比较数据集、API、订阅、许可、分成和联合建模模式。",
      "设计交付方式、计价方式、权利范围和使用限制。",
      "整理买卖双方尽调、合规审核和交易材料清单。",
      "制定报价、谈判、合同、结算、验收和售后步骤。",
      "按清单检查交易准备和交付质量。"
    ],
    "limitations": [
      "不能替代律师、监管机关或持牌机构出具正式意见。",
      "不能保证交易所准入、审核通过或最终成交。",
      "具体费率、税务和规则需要向目标机构核实。",
      "定价区间依赖用户提供的成本、市场和价值证据。"
    ],
    "use_cases": [
      {
        "title": "规划首笔场内交易",
        "description": "选择交易场所、交易模式和安全交付方式，并形成准备清单。",
        "target_user": "首次销售数据产品的企业负责人"
      },
      {
        "title": "设计买方采购结构",
        "description": "明确许可范围、计价、验收、保密和禁止转售条款。",
        "target_user": "采购数据产品的业务与合规团队"
      },
      {
        "title": "准备交易审核材料",
        "description": "梳理权属、质量、合规、样本和标的说明等提交材料。",
        "target_user": "数据交易服务机构和项目经理"
      }
    ],
    "prompt_templates": [
      {
        "title": "选择交易场所",
        "prompt": "我们计划销售[数据产品]，买方是[类型]，预算为[范围]。请比较场内与场外交易，并给出选择建议。",
        "scenario": "初步判断交易渠道"
      },
      {
        "title": "比较交易模式",
        "prompt": "请根据[更新频率]、[使用方式]、[价值指标]和[敏感等级]，比较六种交易模式，并推荐计价方法。",
        "scenario": "确定商业模式和收费方式"
      },
      {
        "title": "设计完整交易结构",
        "prompt": "为[数据产品]设计交易结构。请覆盖交付、计价、授权期限、使用范围、安全控制、验收、付款和违约处理。",
        "scenario": "准备谈判和合同要点"
      },
      {
        "title": "制定端到端成交计划",
        "prompt": "基于以下买卖双方资料，制定从尽调到售后的成交计划。列出阶段、责任人、输入、输出、风险、检查项和决策门槛：[资料]。",
        "scenario": "管理复杂数据交易项目"
      }
    ],
    "output_examples": [
      {
        "input": "我们向国企出售持续更新的产业数据，需要交易凭证并限制转售。",
        "output": [
          "建议优先选择场内交易，以取得合规背书和成交凭证。",
          "建议采用年度订阅或按量 API，并限定用途、期限和用户范围。",
          "敏感字段优先通过沙箱或受控 API 交付。",
          "合同应禁止转售、再识别和未经授权的第三方共享。"
        ]
      },
      {
        "input": "买方认为数据价值不明确，不愿支付固定高价。",
        "output": [
          "先用样本或沙箱完成价值验证和验收指标确认。",
          "采用按量计费、分阶段付款或基础费加效果分成。",
          "保留价格调整条件，并记录每次让步对应的非价格交换。"
        ]
      },
      {
        "input": "请检查场内交易前还缺少哪些准备。",
        "output": "检查主体准入、权属登记、质量报告、用途审查、合规声明、样本、定价依据、交付方案、法律审查和验收标准。"
      }
    ],
    "best_practices": [
      "先核实权属、用途和主体资格，再讨论价格与交付。",
      "让每个价格区间都有成本、市场或价值证据。",
      "根据数据敏感度选择文件、API 或沙箱交付。"
    ],
    "anti_patterns": [
      "不要把示例费率、税务分类或规则当作最新正式结论。",
      "不要在未限制用途、转售和共享时交付原始数据。",
      "不要用降价替代价值验证、标的包装和需求确认。"
    ],
    "faq": [
      {
