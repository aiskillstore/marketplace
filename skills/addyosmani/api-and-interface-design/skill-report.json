  "content": {
    "user_title": "Design Stable APIs and Interfaces",
    "value_statement": "Unclear contracts, inconsistent errors, and unsafe retries make APIs difficult to use and evolve. This skill provides practical patterns for typed interfaces, validation boundaries, compatibility, pagination, and idempotency.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "API design",
      "REST API",
      "TypeScript interfaces",
      "idempotency keys",
      "API contracts",
      "backward compatibility",
      "error handling"
    ],
    "actual_capabilities": [
      "Define typed input and output contracts for APIs, modules, and component boundaries.",
      "Standardize REST resource naming, status codes, error bodies, pagination, and filtering.",
      "Place validation at system boundaries and identify untrusted external data.",
      "Design additive interface changes that reduce compatibility breaks.",
      "Evaluate idempotency keys, atomic claims, duplicate requests, and retry outcomes.",
      "Use discriminated unions and branded types to make TypeScript interfaces safer."
    ],
    "limitations": [
      "It provides design guidance and examples, but it does not implement or test an API.",
      "It does not select a framework, database, authentication provider, or deployment platform.",
      "It cannot verify runtime behavior, traffic patterns, provider guarantees, or existing consumer dependencies.",
      "Examples require adaptation to the application domain, threat model, and operational constraints."
    ],
    "use_cases": [
      {
        "title": "Plan a New REST API",
        "description": "Define resource URLs, typed payloads, error responses, pagination, filters, and compatibility rules before implementation.",
        "target_user": "Backend developer"
      },
      {
        "title": "Review a Public Interface",
        "description": "Inspect an existing API or module boundary for inconsistent contracts, breaking changes, weak validation, and unsafe retry behavior.",
        "target_user": "Tech lead"
      },
      {
        "title": "Design Reliable Payment Retries",
        "description": "Model idempotency keys, atomic request claims, payload matching, in-flight duplicates, and unknown outcomes for state-changing operations.",
        "target_user": "Platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Draft an API Contract",
        "prompt": "Design a REST API for [resource]. Define endpoints, typed inputs and outputs, status codes, error bodies, pagination, and naming conventions.",
        "scenario": "Beginner"
      },
      {
        "title": "Improve Interface Consistency",
        "prompt": "Review this API contract for inconsistent response shapes, validation placement, naming, and backward compatibility. Recommend specific changes: [paste contract].",
        "scenario": "Intermediate"
      },
      {
        "title": "Plan a Safe Interface Evolution",
        "prompt": "Design an additive migration from [current interface] to [target interface]. Identify consumer risks, compatibility steps, deprecation timing, and verification checks.",
        "scenario": "Advanced"
      },
      {
        "title": "Harden a Retried Operation",
        "prompt": "Design an idempotent workflow for [operation]. Cover key derivation, unique storage, request hashing, concurrent duplicates, unknown outcomes, retention, and failure recovery.",
        "scenario": "Expert"
      }
    ],
    "output_examples": [
      {
        "input": "Create a contract for a task service with create, list, update, and delete operations.",
        "output": [
          "Define typed inputs and outputs for each operation.",
          "Use plural task resources, consistent status codes, structured errors, and paginated list responses.",
          "Make deletion idempotent and specify behavior for missing tasks."
        ]
      },
      {
        "input": "Review a charge endpoint that checks for an idempotency key, charges a card, then stores the key.",
        "output": "The sequence has a race because concurrent requests can both pass the check. Claim the key with a unique constraint before the charge, compare request hashes, and define a deliberate response for in-flight duplicates."
      },
      {
        "input": "Plan a compatible addition of an optional priority field to task creation.",
        "output": "Add the optional field without changing existing types or removing fields. Document the default, validate it at the API boundary, update shared types, and add contract tests for old clients."
      }
    ],
    "best_practices": [
      "Define typed contracts before implementation and keep input models separate from output models.",
      "Validate untrusted data at system boundaries, then keep internal functions aligned with shared types.",
      "Design state-changing operations for retries, atomic claims, explicit duplicate handling, and durable evidence."
    ],
    "anti_patterns": [
      "Returning different error shapes across endpoints or exposing internal server details.",
      "Breaking existing fields, skipping pagination, or adding incompatible changes without a migration path.",
      "Checking an idempotency key and acting later without an atomic uniqueness guarantee."
    ],
    "faq": [
      {
        "question": "What kinds of interfaces does this skill cover?",
        "answer": "It covers REST APIs, GraphQL schemas, module boundaries, component props, and other public contracts between system parts."
      },
      {
        "question": "Does this skill generate implementation code?",
        "answer": "It provides design guidance and illustrative TypeScript examples. It does not implement, deploy, or test the complete system."
      },
      {
        "question": "When should validation occur?",
        "answer": "Validate external input at API, form, configuration, and third-party response boundaries. Internal code can rely on established contracts."
      },
      {
        "question": "How does it approach backward compatibility?",
        "answer": "Prefer additive optional fields and extensions. Avoid changing existing types or removing observable behavior that consumers may depend on."
      },
      {
        "question": "Why are idempotency keys important?",
        "answer": "Retries can repeat state-changing effects after timeouts. A durable, atomically claimed key lets the system distinguish one intent from repeated attempts."
      },
      {
        "question": "Can it review an existing API?",
        "answer": "Yes. Provide the contract or relevant documentation, and it can identify inconsistent semantics, compatibility risks, validation gaps, and retry hazards."
      }
    ]
