  "content": {
    "user_title": "Instrument Production Systems for Clear Diagnosis",
    "value_statement": "Production failures are difficult to diagnose when telemetry is missing or noisy. This skill guides focused logging, metrics, tracing, alerts, runbooks, and verification.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "observability",
      "application instrumentation",
      "structured logging",
      "OpenTelemetry",
      "production monitoring",
      "incident response",
      "distributed tracing"
    ],
    "actual_capabilities": [
      "Defines operational questions before selecting telemetry signals.",
      "Designs structured logs with stable events, correlation identifiers, and entry-point attribution.",
      "Applies RED and USE metric patterns with bounded label cardinality.",
      "Guides OpenTelemetry tracing and context propagation across service boundaries.",
      "Creates symptom-based alerts, concise runbooks, and staging verification checks."
    ],
    "limitations": [
      "Does not diagnose an active incident or replace service-specific debugging.",
      "Does not configure a complete vendor backend or deployment environment.",
      "Requires project context to choose libraries, thresholds, retention, and sampling rates.",
      "Does not replace privacy, compliance, or threat-model review for telemetry data."
    ],
    "use_cases": [
      {
        "title": "Instrument a New Service",
        "description": "Add logs, metrics, traces, and alerts while building a production service.",
        "target_user": "Application developer"
      },
      {
        "title": "Review Operational Readiness",
        "description": "Check whether a feature exposes enough evidence for reliable production support.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Improve Incident Diagnostics",
        "description": "Convert lessons from a slow incident into focused telemetry and current runbooks.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose Telemetry Signals",
        "prompt": "Review this feature description: [description]. List the main on-call questions, then map each question to logs, metrics, or traces.",
        "scenario": "Beginner planning for a new production feature"
      },
      {
        "title": "Design Structured Logging",
        "prompt": "Review these request paths and current logs: [details]. Propose stable event names, safe fields, correlation identifiers, levels, and entry-point attribution.",
        "scenario": "Improving logs for a service with several entry points"
      },
      {
        "title": "Build Metrics and Alerts",
        "prompt": "Given these endpoints, dependencies, SLOs, and traffic patterns: [details], design RED and USE metrics plus symptom-based alerts with justified thresholds.",
        "scenario": "Preparing monitoring for production deployment"
      },
      {
        "title": "Audit End-to-End Observability",
        "prompt": "Audit this architecture and instrumentation: [details]. Identify blind spots across logs, metrics, traces, context propagation, cardinality, alerts, runbooks, and verification.",
        "scenario": "Advanced reliability review across distributed services"
      }
    ],
    "output_examples": [
      {
        "input": "Plan observability for a payment retry workflow.",
        "output": [
          "Track first-attempt success, permanent failures by bounded reason, and provider latency percentiles.",
          "Emit structured payment events with request and payment identifiers, excluding customer data.",
          "Trace provider calls and alert on sustained user-visible failure rates."
        ]
      },
      {
        "input": "Review metrics that use customer identifiers as labels.",
        "output": "Customer identifiers create unbounded cardinality. Keep aggregate metrics bounded and place customer-level diagnostic context in protected logs or traces."
      },
      {
        "input": "Create a runbook outline for a high error-rate alert.",
        "output": "State what the alert means, provide the first diagnostic query, describe likely branches, name the escalation owner, and link relevant dashboards."
      }
    ],
    "best_practices": [
      "Start with explicit operational questions and connect every signal to one question.",
      "Allowlist telemetry fields and verify that secrets and full personal data never enter a sink.",
      "Trigger staging paths and inspect actual logs, metrics, traces, alerts, and runbook links."
    ],
    "anti_patterns": [
      "Do not add unstructured logs without stable events or correlation identifiers.",
      "Do not use unbounded values such as user identifiers, raw URLs, or errors as metric labels.",
      "Do not page on infrastructure causes when user-visible symptoms remain unmonitored."
    ],
    "faq": [
      {
        "question": "Which telemetry signal should I use?",
        "answer": "Use metrics for aggregate health, traces for cross-service flow, and structured logs for detailed event context."
      },
      {
        "question": "Does this skill require OpenTelemetry?",
        "answer": "No. It recommends OpenTelemetry for vendor-neutral tracing and metrics, but the signal design principles work with other tools."
      },
      {
        "question": "How should correlation identifiers be handled?",
        "answer": "Create or accept an identifier at the boundary, then propagate it through logs, spans, headers, and queue metadata."
      },
      {
        "question": "How does the skill prevent metric cardinality problems?",
        "answer": "It limits labels to small, fixed sets and moves unique diagnostic values into logs or traces."
      },
      {
        "question": "What makes an alert actionable?",
        "answer": "An actionable alert represents user impact, has a justified threshold and duration, reaches the correct responder, and links to a current runbook."
      },
      {
        "question": "Can this skill verify production readiness?",
        "answer": "It provides a verification process, but teams must execute staging tests and inspect their actual telemetry systems."
      }
    ]
