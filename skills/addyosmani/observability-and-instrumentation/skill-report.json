  "content": {
    "user_title": "Instrument Production Systems with Clear Telemetry",
    "value_statement": "Production teams need reliable evidence when services fail, slow down, or behave unexpectedly. This skill helps design useful logs, metrics, traces, alerts, and verification steps.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "observability",
      "instrumentation",
      "structured logging",
      "OpenTelemetry",
      "metrics",
      "distributed tracing",
      "alerting"
    ],
    "actual_capabilities": [
      "Define operational questions before adding telemetry.",
      "Choose structured logs, metrics, or traces for each diagnostic question.",
      "Design correlation IDs and entry-point fields across service boundaries.",
      "Recommend RED and USE metrics with bounded label cardinality.",
      "Create symptom-based alerts with thresholds, durations, and runbook links.",
      "Plan staging checks that verify logs, metrics, traces, and alerts."
    ],
    "limitations": [
      "It does not install or configure monitoring vendors.",
      "It does not inspect live telemetry or production systems.",
      "Examples require adaptation to the application framework and runtime.",
      "Alert thresholds still require service-specific SLOs or historical data."
    ],
    "use_cases": [
      {
        "title": "Instrument a New Endpoint",
        "description": "Define the endpoint questions, add structured logs, and select RED metrics with bounded labels.",
        "target_user": "Backend developer"
      },
      {
        "title": "Improve Incident Diagnosis",
        "description": "Add correlation IDs, distributed tracing, and actionable alerts so on-call engineers can follow a failing request.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Review Production Readiness",
        "description": "Use the verification checklist to assess telemetry coverage, secret handling, alert quality, and staging validation.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start with Observability Questions",
        "prompt": "Review this feature description and list two to four questions an on-call engineer must answer. Map each question to a log, metric, or trace.",
        "scenario": "Beginner"
      },
      {
        "title": "Design Structured Logging",
        "prompt": "Design structured log events for this endpoint. Include stable event names, safe fields, log levels, correlation IDs, and entry-point attribution.",
        "scenario": "Intermediate"
      },
      {
        "title": "Plan Service Telemetry",
        "prompt": "Create an observability plan for this service and its dependencies. Cover RED metrics, bounded labels, OpenTelemetry traces, sampling, and symptom-based alerts.",
        "scenario": "Advanced"
      },
      {
        "title": "Audit an Instrumentation Change",
        "prompt": "Review this instrumentation diff against the observability checklist. Identify missing signals, cardinality risks, sensitive data exposure, alert weaknesses, and staging tests.",
        "scenario": "Expert"
      }
    ],
    "output_examples": [
      {
        "input": "A payment retry feature needs telemetry for success rate, permanent failures, and provider latency.",
        "output": [
          "Use structured events for payment outcomes and provider error codes.",
          "Add a latency histogram with percentiles for provider calls.",
          "Trace a sampled checkout request and retain error traces."
        ]
      },
      {
        "input": "A team wants to page on CPU usage and label metrics with customer IDs.",
        "output": "Use user-facing error rate or latency for paging, and move customer identifiers to logs or traces. Keep metric labels bounded."
      },
      {
        "input": "A service has alerts but no runbooks or staging verification.",
        "output": [
          "Link every alert to a short runbook with meaning, first check, and escalation path.",
          "Test induced failures and confirm telemetry reaches the correct channel."
        ]
      }
    ],
    "best_practices": [
      "Start from concrete on-call questions and map every signal to one question.",
      "Allowlist telemetry fields and exclude secrets, tokens, passwords, and full PII.",
      "Verify telemetry and alert delivery in staging before calling the work complete."
    ],
    "anti_patterns": [
      "Adding unstructured logs without a stable event name or correlation ID.",
      "Using user IDs, raw URLs, or error text as metric labels.",
      "Paging on infrastructure causes without a user-facing symptom or runbook."
    ],
    "faq": [
      {
        "question": "What does this skill help me instrument?",
        "answer": "It guides logging, metrics, distributed tracing, alerting, runbooks, and telemetry verification for production features."
      },
      {
        "question": "Does it recommend a specific monitoring vendor?",
        "answer": "No. It favors vendor-neutral OpenTelemetry concepts and explains how to adapt them to common backends."
      },
      {
        "question": "Why are structured logs important?",
        "answer": "Structured fields make events searchable, consistent, and easier to correlate during incidents."
      },
      {
        "question": "How should I choose metric labels?",
        "answer": "Use small fixed sets such as route templates, status classes, and provider names. Keep unbounded values in logs or traces."
      },
      {
        "question": "Should every alert page an engineer?",
        "answer": "No. Page only for actionable user-facing symptoms. Use tickets for degradations that can wait."
      },
      {
        "question": "How do I validate new telemetry?",
        "answer": "Induce a staging failure, inspect structured logs, send test traffic, follow a trace, and test each alert and runbook link."
      }
    ]
