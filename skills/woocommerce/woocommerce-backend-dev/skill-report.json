  "content": {
    "user_title": "Build WooCommerce Backend PHP with Project Standards",
    "value_statement": "WooCommerce backend changes can fail review when they ignore project conventions. This skill guides compliant classes, hooks, data operations, annotations, and tests.",
    "seo_keywords": [
      "WooCommerce backend development",
      "WooCommerce PHP",
      "WordPress coding standards",
      "PHPStan annotations",
      "WooCommerce unit tests",
      "dependency injection",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Guides class placement, PSR-4 namespaces, imports, and file naming.",
      "Applies WooCommerce naming, visibility, static method, and docblock conventions.",
      "Documents action and filter hooks with parameters and version annotations.",
      "Uses the WooCommerce dependency injection container and initialization pattern.",
      "Adds validation, ownership checks, and error handling around data changes.",
      "Structures PHPUnit tests with WooCommerce fixtures, testdox, data providers, and logger mocks."
    ],
    "limitations": [
      "It does not execute tests, linting, or migrations by itself.",
      "Its conventions target the WooCommerce repository, not every WordPress plugin.",
      "It does not replace security review for authorization, payment, or destructive operations.",
      "Version annotation guidance depends on access to the current trunk source."
    ],
    "use_cases": [
      {
        "title": "Implement a backend feature",
        "description": "Create an internal service with correct placement, naming, injection, documentation, and tests.",
        "target_user": "WooCommerce core contributor"
      },
      {
        "title": "Refactor a data workflow",
        "description": "Improve order or cart operations with validation, ownership checks, and honest PHPStan types.",
        "target_user": "PHP maintainer"
      },
      {
        "title": "Review a backend change",
        "description": "Check hooks, docblocks, test structure, and repository conventions before approving a pull request.",
        "target_user": "Code reviewer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create an internal class",
        "prompt": "Create a WooCommerce internal class for [purpose]. Follow repository naming, namespace, visibility, dependency injection, docblock, and file placement conventions.",
        "scenario": "Beginner class creation"
      },
      {
        "title": "Add a documented hook",
        "prompt": "Add a WooCommerce [action or filter] for [event]. Include the callback pattern, complete hook documentation, parameters, and the correct since version.",
        "scenario": "Intermediate hook development"
      },
      {
        "title": "Secure a data operation",
        "prompt": "Implement [data operation] for [entity]. Validate existence, state, ownership, capabilities, return values, race conditions, and failure handling.",
        "scenario": "Advanced data integrity work"
      },
      {
        "title": "Refactor and test a service",
        "prompt": "Refactor [service] to use dependency injection and accurate PHPStan types. Preserve runtime behavior and add focused tests for success, failure, and retry paths.",
        "scenario": "Advanced cross-cutting backend change"
      }
    ],
    "output_examples": [
      {
        "input": "Create an internal order validation service.",
        "output": [
          "Placement: src/Internal with the Automattic WooCommerce namespace.",
          "Design: injected dependencies, private helpers, and a public entry point.",
          "Verification: success, invalid order, and dependency failure tests."
        ]
      },
      {
        "input": "Document an existing product-save action.",
        "output": "Adds a concise hook description, one parameter entry per argument, and a since version derived from repository history."
      },
      {
        "input": "Fix a nullable order PHPStan warning without changing behavior.",
        "output": [
          "Make the property annotation nullable.",
          "Keep the runtime fallback that materializes the order.",
          "Narrow the value before use and test the retry path."
        ]
      }
    ],
    "best_practices": [
      "Inspect nearby WooCommerce code before choosing placement, dependencies, and public APIs.",
      "Validate entity state, ownership, capabilities, and return values before changing data.",
      "Run focused tests and linting for every modified backend path."
    ],
    "anti_patterns": [
      "Do not add standalone functions when a testable class method fits the repository design.",
      "Do not remove runtime behavior only to silence a static analysis warning.",
      "Do not perform destructive data operations without validation and authorization."
    ],
    "faq": [
      {
        "question": "Does this skill support WooCommerce extensions?",
        "answer": "It targets WooCommerce core conventions. Extension architecture may require different namespaces, paths, and compatibility decisions."
      },
      {
        "question": "Can it create PHP unit tests?",
        "answer": "Yes. It guides test locations, fixtures, testdox documentation, data providers, assertions, and logger mocks."
      },
      {
        "question": "Does it run tests or linting?",
        "answer": "No. The agent must use the repository commands and report the results separately."
      },
      {
        "question": "How does it choose a since version?",
        "answer": "New APIs use the trunk WooCommerce version without the dev suffix. Existing hooks use repository history."
      },
      {
        "question": "Does it cover data security?",
        "answer": "It guides validation, ownership, capability checks, race conditions, error handling, and audit logging."
      },
      {
        "question": "Can it suppress PHPStan warnings?",
        "answer": "Only when the code is correct and the suppression explains the false positive. Root causes should be fixed first."
      }
    ]
