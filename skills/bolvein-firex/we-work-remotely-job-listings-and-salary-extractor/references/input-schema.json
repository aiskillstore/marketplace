    "postedWithin": {
      "title": "Listed within",
      "type": "string",
      "description": "Keep jobs listed within this window. The listing date is the current (renewed) date, not the original post date.",
      "editor": "select",
      "enum": [
        "any",
        "1",
        "3",
        "7",
        "14",
        "30"
      ],
      "enumTitles": [
        "Any time",
        "Last 24 hours",
        "Last 3 days",
        "Last 7 days",
        "Last 14 days",
        "Last 30 days"
      ],
      "default": "any",
      "prefill": "any"
    },
    "minSalary": {
      "title": "Minimum salary (USD)",
      "type": "integer",
      "description": "Minimum annualized salary in USD. Jobs without a disclosed salary are kept unless requireSalary is on. Published currencies are not converted.",
      "editor": "number",
      "minimum": 0,
      "maximum": 2000000
    },
    "maxSalary": {
      "title": "Maximum salary (USD)",
      "type": "integer",
      "description": "Maximum annualized salary in USD. Jobs without a disclosed salary are kept unless requireSalary is on. Published currencies are not converted.",
      "editor": "number",
      "minimum": 0,
      "maximum": 2000000
    },
    "requireSalary": {
      "title": "Only jobs with salary",
      "type": "boolean",
      "description": "Only keep jobs with a confidently parsed salary range. Off by default so jobs that do not disclose pay are not lost.",
      "default": false,
      "prefill": false
    },
    "includeDescription": {
      "title": "Include full description",
      "type": "boolean",
      "description": "Include the full description HTML and text. Salary is parsed even when this is off.",
      "default": true,
      "prefill": true
    },
    "cleanHtml": {
      "title": "Clean description HTML",
      "type": "boolean",
      "description": "Remove scripts, tracking pixels and unsafe attributes from descriptionHtml.",
      "default": true,
      "prefill": true
    },
    "includeDetails": {
      "title": "Fetch detail pages",
      "type": "boolean",
      "description": "Also fetch each job's HTML page for extra structured fields. The public job XML (apply URL/email, company bio, exact dates) is always read. Off by default; adds one HTML request per job.",
      "default": false,
      "prefill": false
    },
    "includeCompanyProfile": {
      "title": "Fetch company profiles",
      "type": "boolean",
      "description": "Fetch the company profile for each emitted job (website, logo, about, open-job count). On by default; adds one request per company.",
      "default": true,
      "prefill": false
    },
    "incremental": {
      "title": "New jobs only",
      "type": "boolean",
      "description": "Only return jobs that are new or renewed since the previous run of the same search. State is stored automatically.",
      "default": false,
      "prefill": false
    },
    "stateKey": {
      "title": "Incremental state name",
      "type": "string",
      "description": "Optional name for an incremental campaign. Leave empty to derive it from the search filters.",
      "editor": "textfield"
    },
    "maxItems": {
      "title": "Max jobs",
      "type": "integer",
      "description": "Maximum jobs to return (1-5000).",
      "editor": "number",
      "default": 200,
      "prefill": 3,
      "minimum": 1,
      "maximum": 5000
    }
  },
  "required": [
    "mode"
  ]
}
