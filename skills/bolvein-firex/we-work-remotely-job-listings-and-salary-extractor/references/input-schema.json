{
  "title": "We Work Remotely Job Listings & Salary Extractor Input",
  "description": "Collect We Work Remotely jobs from the board's 12 official category RSS feeds, with salary parsing, region/country eligibility, full descriptions and company profiles.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to scrape. browse reads category feeds, search filters the full current inventory, byUrls accepts We Work Remotely links.",
      "editor": "select",
      "enum": [
        "browse",
        "search",
        "byUrls"
      ],
      "enumTitles": [
        "Browse categories",
        "Search by keyword",
        "Scrape specific URLs"
      ],
      "default": "browse",
      "prefill": "browse"
    },
    "categories": {
      "title": "Job categories",
      "type": "array",
      "description": "One or more categories. Leave empty to collect every category (recommended for the full inventory).",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "remote-full-stack-programming-jobs",
          "remote-front-end-programming-jobs",
          "remote-back-end-programming-jobs",
          "remote-customer-support-jobs",
          "remote-design-jobs",
          "remote-product-design-jobs",
          "remote-ux-ui-design-jobs",
          "remote-devops-sysadmin-jobs",
          "remote-management-and-finance-jobs",
          "remote-product-jobs",
          "remote-sales-and-marketing-jobs",
          "all-other-remote-jobs"
        ],
        "enumTitles": [
          "Full-Stack Programming",
          "Front-End Programming",
          "Back-End Programming",
          "Customer Support",
          "Design",
          "Product Design",
          "UX/UI Design",
          "DevOps and Sysadmin",
          "Management and Finance",
          "Product",
          "Sales and Marketing",
          "All Other Remote"
        ]
      },
      "uniqueItems": true,
      "default": [],
      "prefill": [
        "remote-full-stack-programming-jobs"
      ]
    },
    "searchTerm": {
      "title": "Search words",
      "type": "string",
      "description": "Words to match in the title, company, category or description. All words must match. Required in search mode.",
      "editor": "textfield"
    },
    "startUrls": {
      "title": "Start URLs",
      "type": "array",
      "description": "Job, category, search, company or listing URLs. Mix freely. (mode=byUrls)",
      "editor": "stringList",
      "items": {
        "type": "string"
      },
      "default": [],
      "prefill": []
    },
    "employmentTypes": {
      "title": "Employment types",
      "type": "array",
      "description": "Employment types to keep. Leave empty for all. We Work Remotely publishes Full-Time and Contract roles.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "Full-Time",
          "Contract"
        ],
        "enumTitles": [
          "Full-Time",
          "Contract"
        ]
      },
      "uniqueItems": true,
      "default": [],
      "prefill": []
    },
    "regions": {
      "title": "Regions",
      "type": "array",
      "description": "Keep jobs open to one or more regions. Jobs open worldwide always match. Leave empty for all.",
      "editor": "select",
      "items": {
        "type": "string",
        "enum": [
          "Anywhere in the World",
          "USA Only",
          "USA",
          "North America Only",
          "North America",
          "Latin America Only",
          "Latin America",
          "Americas Only",
          "Americas",
          "Europe",
          "Europe Only",
          "UK Only",
          "UK",
