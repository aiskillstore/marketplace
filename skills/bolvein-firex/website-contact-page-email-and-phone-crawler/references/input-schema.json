{
  "title": "Website Contact Finder Input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "urls": {
      "title": "Website URLs",
      "type": "array",
      "description": "Websites to scan for public contact details. You can paste full URLs or bare domains; duplicates are removed.",
      "editor": "stringList",
      "prefill": [
        "https://apify.com"
      ]
    },
    "maxPagesPerSite": {
      "title": "Max Pages Per Site",
      "type": "integer",
      "description": "Maximum number of pages to fetch per website. Contact, about, team and imprint pages are prioritised.",
      "default": 20,
      "prefill": 5,
      "minimum": 1,
      "maximum": 200,
      "editor": "number"
    },
    "maxConcurrency": {
      "title": "Page Concurrency Per Site",
      "type": "integer",
      "description": "How many pages of the same website may be fetched in parallel.",
      "default": 5,
      "prefill": 5,
      "minimum": 1,
      "maximum": 20,
      "editor": "number"
    },
    "maxSitesConcurrency": {
      "title": "Website Concurrency",
      "type": "integer",
      "description": "How many websites are scanned in parallel. Lower this if you hit rate limits.",
      "default": 3,
      "prefill": 3,
      "minimum": 1,
      "maximum": 10,
      "editor": "number"
    },
    "requestTimeoutSecs": {
      "title": "Request Timeout (seconds)",
      "type": "integer",
      "description": "Maximum time to wait for one page before trying the next proxy tier.",
      "default": 15,
      "prefill": 15,
      "minimum": 5,
      "maximum": 60,
      "editor": "number"
    },
