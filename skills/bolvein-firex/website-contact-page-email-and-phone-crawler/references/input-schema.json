    "useProxy": {
      "title": "Use Proxy First",
      "type": "boolean",
      "description": "Start with the Apify proxy ladder instead of trying direct requests first. The actor always retries blocked requests through the proxy ladder automatically.",
      "default": false,
      "prefill": false
    },
    "smartPrioritise": {
      "title": "Smart Page Prioritisation",
      "type": "boolean",
      "description": "Try common contact, about, team, imprint and support paths first, and queue contact-like links ahead of other internal links.",
      "default": true,
      "prefill": true
    },
    "respectRobotsTxt": {
      "title": "Respect robots.txt",
      "type": "boolean",
      "description": "Skip pages that the website's robots.txt disallows. Turn this off only when you own the site or have permission to crawl it.",
      "default": true,
      "prefill": true
    },
    "useSitemap": {
      "title": "Discover Pages From Sitemap",
      "type": "boolean",
      "description": "Read sitemap.xml and robots.txt sitemap entries to find contact and about pages that are not linked from the homepage.",
      "default": true,
      "prefill": true
    },
    "renderFallback": {
      "title": "Render JavaScript Pages When Needed",
      "type": "boolean",
      "description": "If plain HTML contains no email or phone, render up to two pages in a headless browser to capture contacts loaded by JavaScript.",
      "default": true,
      "prefill": true
    },
    "onlyWithContacts": {
      "title": "Only Output Sites With Contacts",
      "type": "boolean",
      "description": "Drop records for websites where no email, phone, social profile or contact form was found.",
      "default": false,
      "prefill": false
    },
    "includeNamedEmails": {
      "title": "Include Personal Emails",
      "type": "boolean",
      "description": "Include personal addresses such as jane.smith@company.com. When off, only role addresses such as info@, sales@ and support@ are kept.",
      "default": true,
      "prefill": true
    }
  },
  "required": [
