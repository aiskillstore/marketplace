{
  "title": "Walk Score Lookup Input",
  "description": "Look up Walk Score, Transit Score, and Bike Score for US addresses, cities, neighborhoods, or states, with ratings, coordinates, transit lines, and city/neighborhood context.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "What to look up.",
      "editor": "select",
      "enum": [
        "byAddress",
        "byCity",
        "byNeighborhood",
        "byState",
        "byRanking"
      ],
      "enumTitles": [
        "Addresses (bulk)",
        "Cities (with neighborhood table)",
        "Neighborhoods",
        "All cities in a state",
        "Top US cities (national ranking)"
      ],
      "default": "byCity",
      "prefill": "byCity"
    },
    "addresses": {
      "title": "Addresses (mode=byAddress)",
      "type": "array",
      "description": "US street addresses, e.g. '1 Beach St, San Francisco, CA 94133'. walkscore.com/score/... URLs are also accepted.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "cities": {
      "title": "Cities (mode=byCity)",
      "type": "array",
      "description": "Cities as 'Seattle, WA', 'Seattle-WA', or a walkscore.com city URL.",
      "editor": "stringList",
      "default": [
        "Seattle, WA"
      ],
      "prefill": [
        "Seattle, WA"
      ]
    },
    "neighborhoods": {
      "title": "Neighborhoods (mode=byNeighborhood)",
      "type": "array",
      "description": "Neighborhoods as 'Ballard, Seattle, WA' or a walkscore.com neighborhood URL.",
      "editor": "stringList",
      "default": [],
      "prefill": []
    },
    "state": {
      "title": "State (mode=byState)",
      "type": "string",
      "description": "US state whose city table to read.",
      "editor": "select",
      "enum": [
        "AL",
        "AK",
        "AZ",
        "AR",
        "CA",
        "CO",
        "CT",
        "DE",
        "DC",
        "FL",
        "GA",
        "HI",
        "ID",
        "IL",
        "IN",
        "IA",
        "KS",
        "KY",
        "LA",
        "ME",
        "MD",
        "MA",
        "MI",
        "MN",
        "MS",
        "MO",
        "MT",
        "NE",
        "NV",
        "NH",
        "NJ",
        "NM",
        "NY",
        "NC",
        "ND",
        "OH",
        "OK",
        "OR",
        "PA",
        "RI",
        "SC",
        "SD",
        "TN",
        "TX",
        "UT",
        "VT",
        "VA",
        "WA",
        "WV",
        "WI",
        "WY"
      ],
      "enumTitles": [
        "Alabama",
        "Alaska",
        "Arizona",
        "Arkansas",
        "California",
        "Colorado",
        "Connecticut",
        "Delaware",
        "District of Columbia",
        "Florida",
        "Georgia",
        "Hawaii",
        "Idaho",
        "Illinois",
        "Indiana",
        "Iowa",
        "Kansas",
        "Kentucky",
        "Louisiana",
        "Maine",
        "Maryland",
        "Massachusetts",
        "Michigan",
        "Minnesota",
        "Mississippi",
        "Missouri",
        "Montana",
        "Nebraska",
        "Nevada",
        "New Hampshire",
        "New Jersey",
        "New Mexico",
        "New York",
        "North Carolina",
        "North Dakota",
        "Ohio",
        "Oklahoma",
        "Oregon",
        "Pennsylvania",
        "Rhode Island",
        "South Carolina",
        "South Dakota",
        "Tennessee",
        "Texas",
        "Utah",
        "Vermont",
        "Virginia",
        "Washington",
        "West Virginia",
        "Wisconsin",
        "Wyoming"
      ],
      "default": "WA",
      "prefill": "WA"
    },
    "includeNeighborhoods": {
      "title": "Include neighborhood table (mode=byCity)",
      "type": "boolean",
      "description": "Add the city page's neighborhood ranking table to each city record.",
      "default": true,
      "prefill": false
    },
    "maxItems": {
      "title": "Max records",
      "type": "integer",
      "description": "Maximum records to emit (state summary counts as one).",
      "minimum": 1,
      "maximum": 1000,
      "default": 50,
      "prefill": 1
    }
  },
  "required": [
    "mode"
  ]
}
