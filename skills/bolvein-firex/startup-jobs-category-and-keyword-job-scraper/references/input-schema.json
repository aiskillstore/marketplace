{
  "title": "startup.jobs Job Search Input",
  "description": "Search live startup.jobs listings by category, role, keyword, location, company, salary, experience and work mode.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "category": {
      "title": "Job category",
      "type": "string",
      "editor": "select",
      "description": "Broad job category. Choose All categories to search everything, or Remote jobs for remote-only listings.",
      "enum": [
        "all",
        "engineering",
        "design",
        "marketing",
        "sales",
        "product",
        "operations",
        "data",
        "finance",
        "hr",
        "legal",
        "customer-success",
        "remote"
      ],
      "enumTitles": [
        "All categories",
        "Engineering",
        "Design",
        "Marketing",
        "Sales",
        "Product",
        "Operations",
        "Data and analytics",
        "Finance and accounting",
        "Human resources",
        "Legal",
        "Customer success",
        "Remote jobs"
      ],
      "default": "remote",
      "prefill": "remote"
    },
    "role": {
      "title": "Job role",
      "type": "string",
      "editor": "select",
      "description": "Specific role from the startup.jobs role taxonomy. When set, the category is ignored.",
      "enum": [
        "",
        "account-executive",
        "account-manager",
        "android-developer",
        "attorney",
        "backend-engineer",
        "business-analyst",
        "business-development",
        "business-development-manager",
        "chief-executive-officer-ceo",
        "chief-financial-officer-cfo",
        "chief-marketing-officer-cmo",
        "chief-of-staff",
        "chief-operating-officer-coo",
        "chief-technology-officer-cto",
        "content-creator",
        "copywriter",
        "creative-director",
        "customer-service",
        "customer-success-manager",
        "data-analyst",
        "data-engineer",
        "data-scientist",
        "design",
        "design-manager",
        "devops",
        "digital-marketing-manager",
        "embedded-engineer",
        "engineering",
        "engineering-manager",
        "finance",
        "finance-accounting",
        "frontend-engineer",
        "full-stack-engineer",
        "graphic-designer",
        "growth-hacker",
        "hardware-engineer",
        "hr",
        "ios-developer",
        "legal",
        "machine-learning-engineer",
        "management",
        "marketing",
        "marketing-manager",
        "mechanical-engineer",
        "mobile-developer",
        "office-manager",
        "operations",
        "operations-manager",
        "product",
        "product-designer",
        "product-manager",
        "product-marketing-manager",
        "production",
        "project-manager",
        "qa-engineer",
        "recruiter",
        "sales",
        "sales-manager",
        "security-engineer",
        "social-media-manager",
        "software-architect",
        "software-engineer",
        "systems-engineer",
        "user-researcher",
        "visual-designer"
      ],
      "enumTitles": [
        "(any role)",
        "Account Executive",
        "Account Manager",
        "Android Developer",
        "Attorney",
        "Backend Engineer",
        "Business Analyst",
        "Business Development",
        "Business Development Manager",
        "Chief Executive Officer (CEO)",
        "Chief Financial Officer (CFO)",
        "Chief Marketing Officer (CMO)",
        "Chief of Staff",
        "Chief Operating Officer (COO)",
        "Chief Technology Officer (CTO)",
        "Content Creator",
        "Copywriter",
        "Creative Director",
        "Customer Service",
        "Customer Success Manager",
        "Data Analyst",
        "Data Engineer",
        "Data Scientist",
        "Design",
        "Design Manager",
        "DevOps",
        "Digital Marketing Manager",
        "Embedded Engineer",
        "Engineering",
        "Engineering Manager",
        "Finance",
        "Finance/Accounting",
        "Frontend Engineer",
        "Full-Stack Engineer",
        "Graphic Designer",
        "Growth Hacker",
        "Hardware Engineer",
        "HR",
        "iOS Developer",
        "Legal",
        "Machine Learning Engineer",
        "Management",
        "Marketing",
        "Marketing Manager",
        "Mechanical Engineer",
        "Mobile Developer",
        "Office Manager",
        "Operations",
        "Operations Manager",
        "Product",
        "Product Designer",
        "Product Manager",
        "Product Marketing Manager",
        "Production",
        "Project Manager",
        "QA Engineer",
        "Recruiter",
        "Sales",
        "Sales Manager",
        "Security Engineer",
        "Social Media Manager",
        "Software Architect",
        "Software Engineer",
        "Systems Engineer",
        "User Researcher",
        "Visual Designer"
      ],
      "default": "",
      "prefill": ""
    },
    "keyword": {
      "title": "Search keyword",
      "type": "string",
      "editor": "textfield",
      "description": "Matches job titles, company names and tags on startup.jobs. It does not search full description text."
    },
    "company": {
      "title": "Company",
      "type": "string",
      "editor": "textfield",
      "description": "Company name, slug or startup.jobs company URL (e.g. stripe or https://startup.jobs/company/stripe)."
    },
    "location": {
      "title": "Location",
      "type": "string",
      "editor": "textfield",
      "description": "City or country name, or a startup.jobs location URL (e.g. United States, London, https://startup.jobs/locations/germany). Use Remote for remote jobs."
    },
    "workplaceType": {
      "title": "Workplace",
      "type": "string",
      "editor": "select",
      "description": "Filter by remote, hybrid or on-site work.",
      "enum": [
        "",
        "remote",
        "hybrid",
        "on-site"
      ],
      "enumTitles": [
        "Any workplace",
        "Remote",
        "Hybrid",
        "On-site"
      ],
      "default": "",
      "prefill": ""
    },
    "employmentType": {
      "title": "Employment type",
      "type": "string",
      "editor": "select",
      "description": "Filter by full-time, part-time, contract or internship roles.",
      "enum": [
        "",
        "full-time",
        "part-time",
        "contractor",
        "internship"
      ],
      "enumTitles": [
        "Any employment type",
        "Full-time",
        "Part-time",
        "Contract",
        "Internship"
      ],
      "default": "",
      "prefill": ""
    },
    "experienceLevel": {
      "title": "Experience level",
      "type": "string",
      "editor": "select",
      "description": "Filter by the experience range published on the listing. Jobs without an experience level are excluded when this is set.",
      "enum": [
        "",
        "0-1",
        "1-3",
        "3-6",
        "6+"
      ],
      "enumTitles": [
        "Any experience",
        "0-1 years",
        "1-3 years",
        "3-6 years",
        "6+ years"
      ],
      "default": "",
      "prefill": ""
    },
    "minSalaryUsd": {
      "title": "Minimum salary (USD)",
      "type": "integer",
      "description": "Only jobs whose published maximum salary is at least this amount in USD. Jobs without a published salary are excluded.",
      "minimum": 0,
      "maximum": 1000000
    },
    "maxSalaryUsd": {
      "title": "Maximum salary (USD)",
      "type": "integer",
      "description": "Only jobs whose published minimum salary is at most this amount in USD. Jobs without a published salary are excluded.",
      "minimum": 0,
      "maximum": 1000000
    },
    "postedWithin": {
      "title": "Posted within",
      "type": "string",
      "editor": "select",
      "description": "Only include jobs published within this period.",
      "enum": [
        "",
        "1",
        "7",
        "30",
        "90"
      ],
      "enumTitles": [
        "Any time",
        "Last 24 hours",
        "Last 7 days",
        "Last 30 days",
        "Last 90 days"
      ],
      "default": "",
      "prefill": ""
    },
    "maxItems": {
      "title": "Max items",
      "type": "integer",
      "description": "Maximum number of jobs to return (1-500).",
      "minimum": 1,
      "maximum": 500,
      "default": 50,
      "prefill": 2
    }
  },
  "required": []
}
