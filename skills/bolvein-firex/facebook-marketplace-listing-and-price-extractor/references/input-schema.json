{
  "title": "Facebook Marketplace Input",
  "description": "Scrape public Facebook Marketplace listings without cookies or login. Search by keyword and location, scrape Marketplace URLs, or fetch direct item pages. Fast mode reads feed rows; deep mode adds descriptions, condition, seller, coordinates, and photos.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "editor": "select",
      "enum": [
        "auto",
        "search",
        "urls",
        "items"
      ],
      "enumTitles": [
        "Auto (use URLs first, then keyword search)",
        "Search by keyword and location",
        "Scrape these Marketplace URLs",
        "Fetch these listing URLs or IDs"
      ],
      "default": "auto",
      "prefill": "urls",
      "description": "What to scrape. auto uses startUrls when present and otherwise builds a keyword search. search builds a search from searchQueries plus location. urls scrapes the given Marketplace search, category, or city-feed URLs. items fetches direct item URLs or numeric IDs."
    },
    "startUrls": {
      "title": "Marketplace URLs or Item IDs",
      "type": "array",
      "editor": "requestListSources",
      "default": [],
      "description": "Marketplace search, city-category, global-category, city-feed, or /marketplace/item/ URLs. In mode=items, a bare numeric listing ID is also accepted.",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "title": "URL",
            "description": "A valid Facebook Marketplace URL or a listing ID in mode=items."
          }
        }
      },
      "prefill": [
        {
          "url": "https://www.facebook.com/marketplace/nyc/search/?query=laptop"
        }
      ],
      "example": [
        {
          "url": "https://www.facebook.com/marketplace/nyc/search/?query=laptop"
        }
      ]
    },
    "searchQueries": {
      "title": "Search Queries",
      "type": "array",
      "editor": "stringList",
      "description": "One to 20 keywords or phrases (mode=search or mode=auto without URLs). Each query becomes one source.",
      "default": [],
      "prefill": [
        "laptop"
      ],
      "example": [
        "laptop",
        "office chair"
      ]
    },
    "location": {
      "title": "Location",
      "type": "string",
      "editor": "textfield",
      "description": "Marketplace location slug, city, postal code, or address used by keyword search (mode=search or mode=auto without URLs). Examples: nyc, Austin, Texas, 90210, London.",
      "prefill": "nyc",
      "example": "Austin, Texas"
    },
