      "prefill": "US",
      "description": "ISO 3166-1 alpha-2 country used when resolving a human location. Use GB for London, CA for Toronto, and so on."
    },
    "latitude": {
      "title": "Latitude",
      "type": "number",
      "editor": "number",
      "minimum": -90,
      "maximum": 90,
      "description": "Optional search center latitude. Provide longitude too."
    },
    "longitude": {
      "title": "Longitude",
      "type": "number",
      "editor": "number",
      "minimum": -180,
      "maximum": 180,
      "description": "Optional search center longitude. Provide latitude too."
    },
    "radiusKm": {
      "title": "Radius (km)",
      "type": "integer",
      "editor": "number",
      "minimum": 1,
      "maximum": 500,
      "default": 65,
      "prefill": 65,
      "description": "Search radius in kilometres for keyword or category search. URL mode keeps the radius in the URL unless you set this explicitly."
    },
    "category": {
      "title": "Category",
      "type": "string",
      "editor": "select",
      "enum": [
        "all",
        "vehicles",
        "electronics",
        "furniture",
        "home",
        "tools",
        "sports",
        "toys",
        "appliances",
        "jewelry",
        "autoparts",
        "garden",
        "pets",
        "books",
        "shoes",
        "games",
        "motorcycles",
        "boats",
        "antiques",
        "arts",
        "health",
        "cell-phones",
        "computers",
        "video-games",
        "cameras"
      ],
      "enumTitles": [
        "All categories",
        "Vehicles",
        "Electronics",
        "Furniture",
        "Home goods",
        "Tools",
        "Sporting goods",
        "Toys and games",
        "Appliances",
        "Jewelry and watches",
        "Auto parts",
        "Garden and outdoor",
        "Pet supplies",
        "Books",
        "Shoes",
        "Games",
        "Motorcycles",
        "Boats",
        "Antiques and collectibles",
        "Arts and crafts",
        "Health and beauty",
        "Cell phones",
        "Computers",
        "Video games",
        "Cameras"
      ],
      "default": "all",
      "prefill": "all",
      "description": "Marketplace category. If searchQueries is empty, the actor opens the city category feed (or the global category feed for a human location). Books, shoes, games, motorcycles, cell-phones, computers, video-games, and cameras were verified as category feeds but expose no server category ID, so they are not usable as keyword filters; use categoryId or a category URL for those."
    },
    "categoryId": {
      "title": "Category ID",
      "type": "string",
      "editor": "textfield",
      "description": "Advanced numeric Facebook category ID. Takes precedence over category when set."
    },
    "sortBy": {
      "title": "Sort Order",
      "type": "string",
      "editor": "select",
      "enum": [
        "relevance",
        "newest",
        "oldest",
        "price_asc",
        "price_desc",
        "distance"
      ],
      "enumTitles": [
        "Relevance",
        "Newest first",
        "Oldest first",
        "Price: low to high",
        "Price: high to low",
        "Distance (requires coordinates)"
      ],
      "default": "relevance",
      "prefill": "relevance",
      "description": "Server-side sort where Marketplace supports it, plus a client-side re-sort by price or posting time. Rows without a price sort last."
    },
    "minPrice": {
      "title": "Minimum Price",
      "type": "number",
      "editor": "number",
      "minimum": 0,
      "description": "Only listings at or above this price. Rows without a price are dropped."
    },
    "maxPrice": {
      "title": "Maximum Price",
      "type": "number",
      "editor": "number",
      "minimum": 0,
      "description": "Only listings at or below this price. Rows without a price are dropped."
    },
    "condition": {
      "title": "Condition",
      "type": "string",
      "editor": "select",
      "enum": [
        "any",
        "new",
        "used_like_new",
        "used_good",
        "used_fair"
      ],
      "enumTitles": [
        "Any condition",
        "New",
        "Used: like new",
        "Used: good",
        "Used: fair"
      ],
      "default": "any",
      "prefill": "any",
      "description": "Server-side condition filter in search/category modes. In deep mode the detail condition is checked too; fast URL rows without condition data are kept."
    },
    "deliveryMethod": {
      "title": "Delivery Method",
      "type": "string",
      "editor": "select",
      "enum": [
        "all",
        "shipping",
        "local"
      ],
      "enumTitles": [
        "All methods",
        "Shipping",
        "Local pickup or meetup"
      ],
      "default": "all",
      "prefill": "all",
      "description": "Client-side filter over the listing's delivery types. Listings without delivery data are dropped when this filter is active. Legacy local_pickup is accepted as local."
    },
    "daysSinceListed": {
      "title": "Listed Within (days)",
      "type": "integer",
      "editor": "number",
      "minimum": 1,
      "maximum": 365,
      "description": "Only listings created within this many days. Rows without a posting time are dropped."
    },
    "availability": {
      "title": "Availability",
      "type": "string",
      "editor": "select",
      "enum": [
        "all",
        "available",
        "sold",
        "pending"
      ],
      "enumTitles": [
        "All listings",
        "Available",
        "Sold",
        "Pending"
      ],
      "default": "all",
      "prefill": "all",
      "description": "Client-side status filter. Search feeds are mostly available; sold and pending are more common on direct item pages."
    },
    "exactMatch": {
      "title": "Exact Keyword Match",
      "type": "boolean",
      "default": false,
      "prefill": false,
      "description": "Keep only rows whose title (and description in deep mode) contains every query word."
    },
    "maxItems": {
      "title": "Maximum Listings",
      "type": "integer",
      "editor": "number",
      "minimum": 1,
      "maximum": 10000,
      "default": 50,
      "prefill": 3,
      "description": "Global output limit across all sources."
    },
    "maxItemsPerUrl": {
      "title": "Maximum Listings Per URL",
      "type": "integer",
      "editor": "number",
      "minimum": 1,
      "maximum": 10000,
      "default": 50,
      "prefill": 3,
      "description": "Per-source output limit."
    },
    "maxPagesPerUrl": {
      "title": "Maximum Pages Per URL",
      "type": "integer",
      "editor": "number",
      "minimum": 1,
      "maximum": 500,
      "default": 100,
      "prefill": 1,
      "description": "Cost guard for cursor pagination. The actor stops earlier on source exhaustion, a repeated cursor, two empty pages, or maxItems. There is no fixed row cap: a Phase 6 probe reached 1,694 unique search rows across 71 pages before Facebook returned an empty page 72."
    },
    "scrapeMode": {
      "title": "Scrape Mode",
      "type": "string",
      "editor": "select",
      "enum": [
        "fast",
        "deep",
        "auto"
      ],
      "enumTitles": [
        "Fast (feed data only)",
        "Deep (fetch each listing page)",
        "Auto (deep only when details or photos are requested)"
      ],
      "default": "fast",
      "prefill": "fast",
      "description": "fast streams feed rows. deep fetches each listing page for description, condition, attributes, seller, coordinates, and photos. auto follows includeListingDetails and includeAllPhotos."
    },
    "includeListingDetails": {
      "title": "Include Listing Details",
      "type": "boolean",
      "default": false,
      "prefill": false,
      "description": "Compatibility alias that enables deep mode unless scrapeMode=fast is explicit."
    },
    "includeAllPhotos": {
      "title": "Include All Photos",
      "type": "boolean",
      "default": false,
      "prefill": false,
      "description": "Enables deep mode and adds the full photo gallery."
    },
    "rehostImages": {
      "title": "Rehost Images",
      "type": "boolean",
      "default": true,
      "prefill": false,
      "description": "Copy primary photos and seller avatars into the actor key-value store so the emitted URLs do not expire. The original Facebook URL is kept in primaryPhotoUrlOriginal. When off, mediaUrlTemporary is emitted."
    },
    "deduplicateAcrossInputs": {
      "title": "Deduplicate Across Inputs",
      "type": "boolean",
      "default": true,
      "prefill": true,
      "description": "Emit each listing ID once across sources. Disable to preserve repeats from repeated input URLs."
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "type": "object",
      "editor": "proxy",
      "description": "Optional advanced override. The actor works without a proxy and automatically escalates only when Facebook blocks a request. A missing value never stops a run."
    }
  }
}
