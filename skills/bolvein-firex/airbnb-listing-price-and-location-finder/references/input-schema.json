    "proxyConfiguration": {
      "title": "Proxy configuration",
      "type": "object",
      "description": "Optional. Leave empty and the actor connects directly, then switches to an automatic Apify proxy only if Airbnb blocks a request.",
      "editor": "proxy"
    }
  }
}
