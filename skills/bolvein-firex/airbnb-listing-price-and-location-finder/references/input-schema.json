{
  "title": "Airbnb Stay Finder: Nightly Rates, Fees & Availability",
  "description": "Search Airbnb stays by city, neighborhood, place ID or map area, or load specific listing URLs. Get nightly and stay-total prices, fees, host details, amenities, reviews and a 12-month availability calendar.",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Mode",
      "type": "string",
      "description": "Search discovers listings by location or map area. Details loads the listing URLs or IDs you provide.",
      "editor": "select",
      "enum": [
        "search",
        "details"
      ],
      "enumTitles": [
        "Search by location or map area",
        "Load specific listing URLs or IDs"
      ],
      "default": "search",
      "prefill": "search",
      "sectionCaption": "Search"
    },
    "location": {
      "title": "Location",
      "type": "string",
      "description": "City, region, country or neighborhood, e.g. New York, Paris, SoHo. Airbnb's own location lookup validates the name before searching (mode=search).",
      "editor": "textfield",
      "prefill": "New York"
    },
    "placeId": {
      "title": "Airbnb place ID",
      "type": "string",
      "description": "Optional Google/Airbnb place ID (e.g. ChIJOwg_06VPwokRYv534QaPC8g). Takes precedence over the resolved location and skips text matching (mode=search).",
      "editor": "textfield"
    },
    "neighborhood": {
      "title": "Neighborhood",
      "type": "string",
      "description": "Optional neighborhood to combine with Location, e.g. SoHo + New York (mode=search).",
      "editor": "textfield"
    },
    "bbox": {
      "title": "Map bounding box",
      "type": "object",
      "description": "Search inside a map rectangle instead of a named location. Use decimal degrees: swLat, swLng (south-west corner) and neLat, neLng (north-east corner), plus an optional zoom (1-22). Example: {\"swLat\": 40.7075, \"swLng\": -74.0135, \"neLat\": 40.7904, \"neLng\": -73.9591, \"zoom\": 13} (mode=search).",
      "editor": "json"
    },
    "listingUrls": {
      "title": "Listing URLs",
      "type": "array",
      "description": "Airbnb room URLs, e.g. https://www.airbnb.com/rooms/23222680 (mode=details).",
      "editor": "stringList",
      "sectionCaption": "Specific listings"
    },
    "listingIds": {
      "title": "Listing IDs",
      "type": "array",
      "description": "Numeric Airbnb listing IDs, e.g. 23222680. You can mix these with listing URLs (mode=details).",
      "editor": "stringList"
    },
    "checkIn": {
      "title": "Check-in date",
      "type": "string",
      "description": "Stay start date in YYYY-MM-DD format. Leave both dates empty to use Airbnb's displayed quote (search) or to skip the price quote (details).",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "nullable": true,
      "sectionCaption": "Stay dates and guests"
    },
    "checkOut": {
      "title": "Check-out date",
      "type": "string",
      "description": "Stay end date in YYYY-MM-DD format. Must be after the check-in date.",
      "editor": "textfield",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "nullable": true
    },
    "adults": {
      "title": "Adults",
      "type": "integer",
      "description": "Number of adult guests (1-16).",
      "default": 1,
      "minimum": 1,
      "maximum": 16
    },
    "children": {
      "title": "Children",
      "type": "integer",
      "description": "Number of children aged 2-12 (0-15).",
      "default": 0,
      "minimum": 0,
      "maximum": 15
    },
    "infants": {
      "title": "Infants",
      "type": "integer",
      "description": "Number of infants under 2 (0-5).",
      "default": 0,
      "minimum": 0,
      "maximum": 5
    },
    "pets": {
      "title": "Pets",
      "type": "integer",
      "description": "Number of pets (0-5).",
      "default": 0,
      "minimum": 0,
      "maximum": 5
    },
    "minPrice": {
      "title": "Minimum nightly price",
      "type": "integer",
      "description": "Lowest nightly price to include, in the selected currency. 0 means no minimum.",
      "default": 0,
      "minimum": 0,
      "maximum": 100000,
      "sectionCaption": "Filters"
    },
    "maxPrice": {
      "title": "Maximum nightly price",
      "type": "integer",
      "description": "Highest nightly price to include, in the selected currency. 0 means no maximum.",
      "default": 0,
      "minimum": 0,
      "maximum": 100000
    },
    "roomType": {
      "title": "Room type",
      "type": "string",
      "description": "Restrict results to one Airbnb room type.",
      "editor": "select",
      "enum": [
        "Any",
        "Entire home/apt",
        "Private room",
        "Shared room",
        "Hotel room"
      ],
      "enumTitles": [
        "Any room type",
        "Entire home or apartment",
        "Private room",
        "Shared room",
        "Hotel room"
      ],
      "default": "Any"
    },
    "propertyType": {
      "title": "Property type",
      "type": "string",
      "description": "Restrict results to one Airbnb property type.",
      "editor": "select",
      "enum": [
        "Any",
        "Apartment",
        "House",
        "Villa",
        "Condominium",
        "Loft",
        "Guest suite",
        "Guesthouse",
        "Hotel",
        "Resort",
        "Cottage",
        "Cabin",
        "Bungalow",
        "Townhouse",
        "Tiny home",
        "Boat",
        "Barn",
        "Camper/RV",
        "Farm stay",
        "Castle",
        "Cave",
        "Dome",
        "Container",
        "Treehouse",
        "Yurt",
        "Serviced apartment"
      ],
      "enumTitles": [
        "Any property type",
        "Apartment",
        "House",
        "Villa",
        "Condominium",
        "Loft",
        "Guest suite",
        "Guesthouse",
        "Hotel",
        "Resort",
        "Cottage",
        "Cabin",
        "Bungalow",
        "Townhouse",
        "Tiny home",
        "Boat",
        "Barn",
        "Camper/RV",
        "Farm stay",
        "Castle",
        "Cave",
        "Dome",
        "Container",
        "Treehouse",
        "Yurt",
        "Serviced apartment"
      ],
      "default": "Any"
    },
    "minBedrooms": {
      "title": "Minimum bedrooms",
      "type": "integer",
      "description": "Minimum number of bedrooms. 0 means no minimum.",
      "default": 0,
      "minimum": 0,
      "maximum": 20
    },
    "minBeds": {
      "title": "Minimum beds",
      "type": "integer",
      "description": "Minimum number of beds. 0 means no minimum.",
      "default": 0,
      "minimum": 0,
      "maximum": 30
    },
    "minBathrooms": {
      "title": "Minimum bathrooms",
      "type": "integer",
      "description": "Minimum number of bathrooms. 0 means no minimum.",
      "default": 0,
      "minimum": 0,
      "maximum": 20
    },
    "maxListings": {
      "title": "Maximum listings",
      "type": "integer",
      "description": "Hard cap on records (1-300). Airbnb pages hold 40 results each; duplicate cards are removed automatically.",
      "default": 20,
      "prefill": 3,
      "minimum": 1,
      "maximum": 300,
      "sectionCaption": "Output"
    },
    "includeDetails": {
      "title": "Include full listing details",
      "type": "boolean",
      "description": "Adds the listing page and an exact stay quote: host, amenities, photos, description, fees and availability. Costs extra requests per listing.",
      "default": false,
      "prefill": false,
      "sectionCaption": "Detail enrichment"
    },
    "includeReviews": {
      "title": "Include reviews",
      "type": "boolean",
      "description": "Fetch recent guest reviews for each listing (up to maxReviews).",
      "default": false,
      "prefill": false
    },
    "maxReviews": {
      "title": "Maximum reviews per listing",
      "type": "integer",
      "description": "Reviews returned per listing (1-24).",
      "default": 12,
      "minimum": 1,
      "maximum": 24
    },
    "includeCalendar": {
      "title": "Include availability calendar",
      "type": "boolean",
      "description": "Fetch the day-by-day availability calendar for each listing.",
      "default": false,
      "prefill": false
    },
    "calendarMonths": {
      "title": "Calendar months",
      "type": "integer",
      "description": "Number of months to return, starting with the current month (1-12).",
      "default": 12,
      "minimum": 1,
      "maximum": 12
    },
    "currency": {
      "title": "Currency",
      "type": "string",
      "description": "Currency for prices. Airbnb returns quotes in this currency.",
      "editor": "select",
