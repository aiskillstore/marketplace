  "content": {
    "user_title": "Generate Native-Alpha Transparent Images",
    "value_statement": "Image generators can return opaque files or painted checkerboards when transparency is required. This skill generates native-alpha assets and validates every untouched output.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "transparent image generation",
      "native alpha",
      "transparent PNG",
      "transparent WebP",
      "image alpha validation",
      "sprite generation",
      "product cutout"
    ],
    "actual_capabilities": [
      "Requests new PNG or WebP assets with model-native pixel transparency.",
      "Validates format, dimensions, alpha channels, transparent pixels, and corner alpha values.",
      "Computes SHA-256 evidence for each untouched output file.",
      "Guides visual edge inspection across contrasting backgrounds.",
      "Retries failed native-alpha generations within a defined three-attempt limit.",
      "Separates generation, alpha validation, edge inspection, user acceptance, and publication states."
    ],
    "limitations": [
      "It does not remove backgrounds from existing opaque images.",
      "Native-alpha support depends on the selected image model and host tool.",
      "Alpha validation cannot prove that fur, glass, smoke, or other fine edges look clean.",
      "The validator supports PNG and WebP files and requires Pillow."
    ],
    "use_cases": [
      {
        "title": "Create Transparent Stickers",
        "description": "Generate isolated character stickers with transparent padding and verify the original file before delivery.",
        "target_user": "Illustrators and character designers"
      },
      {
        "title": "Build Game Sprite Assets",
        "description": "Produce native-alpha sprites individually and record technical validation for each asset.",
        "target_user": "Game developers"
      },
      {
        "title": "Prepare Product Cutouts",
        "description": "Create product assets without post-generation masking and inspect their edges on light and dark surfaces.",
        "target_user": "E-commerce content teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Generate One Transparent Asset",
        "prompt": "Create a new [subject] as a transparent PNG. Keep the complete subject visible with genuine native alpha outside it.",
        "scenario": "A beginner needs one isolated asset."
      },
      {
        "title": "Preserve a Reference Identity",
        "prompt": "Use my authorized reference for [identity and style]. Create a new [pose] as a native-alpha PNG without copying the reference background.",
        "scenario": "A user provides an authorized character or product reference."
      },
      {
        "title": "Protect Fine Edges",
        "prompt": "Generate [subject] with native transparency. Preserve fine [fur, hair, glass, or smoke] edges without shadows, halos, borders, or cropped details.",
        "scenario": "The subject has translucent or detailed boundaries."
      },
      {
        "title": "Produce a Validated Asset Set",
        "prompt": "Generate these assets one at a time: [asset list]. Validate each untouched original, inspect edges, and report evidence separately before continuing.",
        "scenario": "An advanced workflow needs several verified deliverables."
      }
    ],
    "output_examples": [
      {
        "input": "Create a transparent PNG sticker of a mascot with soft fur.",
        "output": "A native-alpha PNG is generated and validated. The report includes dimensions, alpha statistics, corner values, file hash, and edge inspection."
      },
      {
        "input": "Generate three transparent game sprites from an authorized character sheet.",
        "output": "Each sprite is generated and checked separately. Failed alpha outputs are retried within the limit, and accepted originals receive individual evidence."
      },
      {
        "input": "Create a transparent product image with glass edges.",
        "output": "The untouched WebP passes alpha checks, then receives visual review for haze, halos, shadows, and edge quality on contrasting backgrounds."
      }
    ],
    "best_practices": [
      "State the subject and native-transparency requirement clearly without repeatedly describing checkerboards.",
      "Validate the untouched original before resizing, optimizing, compositing, or publishing it.",
      "Inspect accepted assets on both light and dark backgrounds after technical validation."
    ],
    "anti_patterns": [
      "Do not treat a PNG extension or successful tool response as proof of transparency.",
      "Do not repair an opaque generation with masking, segmentation, chroma key, or synthetic alpha.",
      "Do not label an asset production-ready when edge inspection failed or was skipped."
    ],
    "faq": [
      {
        "question": "What does native alpha mean?",
        "answer": "The image model returns transparent pixels in the original PNG or WebP file without later background removal."
      },
      {
        "question": "Can this skill remove an existing background?",
        "answer": "No. Use a disclosed background-extraction workflow for edits to existing opaque images."
      },
      {
        "question": "How does the skill verify transparency?",
        "answer": "It decodes the original file and checks its format, alpha channel, transparent pixels, visible pixels, and optional corner transparency."
      },
      {
        "question": "Does passing alpha validation guarantee clean edges?",
        "answer": "No. Fine edges can still contain haze, halos, shadows, clipping, or incorrect details."
      },
      {
        "question": "What happens when generation returns an opaque image?",
        "answer": "The skill retries native generation up to three total attempts by default, then reports failure without editing the image."
      },
      {
        "question": "Which file formats are supported?",
        "answer": "The validator supports PNG and WebP files that Pillow can decode."
      }
    ]
  },
