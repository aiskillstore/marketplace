    "user_title": "Build Reliable Python Database Layers",
    "value_statement": "Python database code can fail through poor session, transaction, or migration patterns. This skill provides practical SQLAlchemy 2.0 patterns for robust applications.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "SQLAlchemy",
      "Python database patterns",
      "Alembic migrations",
      "async SQLAlchemy",
      "connection pooling",
      "unit of work",
      "repository pattern"
    ],
    "actual_capabilities": [
      "Explains SQLAlchemy 2.0 model, query, and relationship patterns.",
      "Shows async engine, session factory, and FastAPI dependency patterns.",
      "Provides Alembic setup guidance and migration command examples.",
      "Describes connection pool sizing, health checks, and monitoring hooks.",
      "Covers transaction scopes, savepoints, isolation levels, and locking.",
      "Includes repository and unit of work patterns for service layers."
    ],
    "limitations": [
      "Does not connect to live databases or inspect production schemas by itself.",
      "Examples use placeholder database URLs that must be replaced safely.",
      "Does not validate every database vendor behavior or SQLAlchemy extension.",
      "Requires users to adapt patterns to their application architecture."
    ],
    "use_cases": [
      {
        "title": "Design Async Database Access",
        "description": "Create clear SQLAlchemy async session patterns for web requests and background tasks.",
        "target_user": "Backend engineers"
      },
      {
        "title": "Plan Safer Migrations",
        "description": "Structure Alembic migrations for schema changes, data backfills, and production rollout steps.",
        "target_user": "Platform engineers"
      },
      {
        "title": "Improve Transaction Boundaries",
        "description": "Choose transaction, savepoint, and locking patterns for consistency in business workflows.",
        "target_user": "Application architects"
      }
    ],
    "prompt_templates": [
