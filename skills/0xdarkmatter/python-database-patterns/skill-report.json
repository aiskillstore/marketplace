      },
      {
        "title": "Review Migration Strategy",
        "scenario": "Advanced request for production migration planning.",
        "prompt": "Use this skill to review my Alembic migration plan for [change]. Identify lock risks, rollback limits, and safer rollout steps."
      },
      {
        "title": "Refactor Data Layer",
        "scenario": "Advanced request for architecture improvements.",
        "prompt": "Use this skill to refactor my database code toward repository and unit of work patterns. Explain transaction boundaries and testing impacts."
      }
    ],
    "output_examples": [
      {
        "input": "Design async SQLAlchemy access for a FastAPI users service.",
        "output": [
          "A session factory design with per-request lifecycle guidance.",
          "A dependency pattern that commits, rolls back, and closes sessions consistently.",
          "Notes about eager loading and avoiding async lazy loading failures."
        ]
      },
      {
        "input": "Plan a migration that adds a required phone column to users.",
        "output": [
          "A staged migration plan that starts with a nullable column.",
          "A separate backfill step for existing rows.",
          "A later constraint change after data quality is verified."
        ]
      },
      {
        "input": "Improve transaction safety for an order creation workflow.",
        "output": [
          "A transaction boundary around related repository operations.",
          "Savepoint guidance for optional steps that may fail independently.",
          "Retry guidance for serialization conflicts and deadlocks."
        ]
      }
    ],
    "best_practices": [
      "Use SQLAlchemy 2.0 style queries and typed mapped columns for new code.",
      "Keep session lifetime explicit and tied to request, task, or unit of work boundaries.",
      "Stage production migrations to reduce table locks and rollback risk."
    ],
    "anti_patterns": [
      "Do not keep long-lived sessions shared across unrelated requests or tasks.",
      "Do not rely on async lazy loading for relationships in request handlers.",
      "Do not place real credentials in example code, logs, or migration files."
    ],
