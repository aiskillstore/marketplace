  "content": {
    "user_title": "Plan Reliable Tests Across Your Codebase",
    "value_statement": "This skill helps teams choose test strategies, mocks, data fixtures, coverage gates, and CI patterns without mixing test scopes. It gives Claude, Codex, and Claude Code structured guidance for unit, integration, end-to-end, TDD, and pipeline testing.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "testing patterns",
      "test pyramid",
      "TDD workflow",
      "mocking strategy",
      "test data factories",
      "CI testing",
      "coverage checks"
    ],
    "actual_capabilities": [
      "Explains unit, integration, and end-to-end test boundaries with a test pyramid model.",
      "Provides TDD cycle guidance, naming conventions, and Arrange-Act-Assert examples.",
      "Compares stubs, mocks, spies, fakes, and dummies for dependency isolation.",
      "Recommends fixture, factory, builder, and object mother patterns for test data.",
      "Shows CI testing patterns for sharding, caching, reports, branch protection, and secrets.",
      "Includes a Bash coverage helper for pytest projects."
    ],
    "limitations": [
      "Framework-specific syntax is limited to short examples, mostly Python and GitHub Actions.",
      "The coverage helper assumes pytest, coverage.py, and a src package layout.",
      "It does not replace project-specific test architecture decisions.",
      "It does not execute tests unless a user or agent runs the included script."
    ],
    "use_cases": [
      {
        "title": "Refactor Tests Around Boundaries",
        "description": "Map an existing test suite into unit, integration, and end-to-end layers before refactoring.",
        "target_user": "Backend developer"
      },
      {
        "title": "Design CI Test Gates",
        "description": "Plan pipeline stages, caching, sharding, reports, and branch protection for faster feedback.",
        "target_user": "QA engineer"
      },
      {
        "title": "Standardize Team Testing Practices",
        "description": "Create shared guidance for naming, mocks, fixtures, TDD flow, and coverage expectations.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Identify Test Types",
        "scenario": "Beginner planning for a new feature.",
        "prompt": "Review this feature and classify needed unit, integration, and end-to-end tests. Explain the boundary for each test type."
      },
      {
        "title": "Design Test Data",
        "scenario": "Intermediate setup for repeatable tests.",
        "prompt": "Suggest fixtures, factories, or builders for this domain model. Keep each test independent and explain cleanup needs."
      },
      {
        "title": "Improve Mocking Strategy",
        "scenario": "Intermediate review of fragile tests.",
        "prompt": "Review these tests for over-mocking, deep mocking, and long setup. Recommend simpler boundaries and test doubles."
      },
      {
        "title": "Audit CI Testing Pipeline",
        "scenario": "Advanced review of release confidence.",
        "prompt": "Evaluate this CI testing pipeline for stage order, parallelization, flaky test handling, coverage reporting, branch protection, and secret usage."
      }
    ],
    "output_examples": [
      {
        "input": "A checkout service depends on tax, inventory, payment, and email systems.",
        "output": [
          "Unit tests cover price rules, validation, and state transitions with service boundaries mocked.",
          "Integration tests use a real database and fake external payment and email providers.",
          "End-to-end tests cover only the successful purchase and the most important failure path."
        ]
      },
      {
        "input": "A team has slow tests, unclear fixtures, and many flaky pipeline failures.",
        "output": [
          "Move deterministic business logic tests closer to unit level.",
          "Replace shared mutable fixtures with factories or builders.",
          "Shard long test groups and quarantine flaky tests with visible tracking."
        ]
      },
      {
        "input": "A developer wants to use TDD for a discount calculation feature.",
        "output": [
          "List expected behaviors before implementation.",
          "Start with the simplest failing case and write minimal production logic.",
          "Refactor names and structure only after the test passes."
        ]
      }
    ],
    "best_practices": [
      "Keep most tests at the unit level and reserve end-to-end tests for critical journeys.",
      "Mock only external boundaries, such as databases, queues, payment providers, and email services.",
      "Use deterministic fixtures and seed random data when randomness is useful."
    ],
    "anti_patterns": [
      "Testing private implementation details instead of observable behavior.",
      "Building mocks that duplicate production logic or make setup longer than the test.",
      "Sharing mutable test data across tests and creating order dependencies."
    ],
    "faq": [
      {
        "question": "Does this skill support only Python?",
        "answer": "No. The principles are language-agnostic, but several examples use Python and GitHub Actions."
      },
      {
        "question": "Can it write complete tests for my project?",
        "answer": "It guides test design and examples. Project-specific assertions still need your code context."
      },
      {
        "question": "Does it run the coverage script automatically?",
        "answer": "No. The included script runs only when a user or agent explicitly executes it."
      },
      {
        "question": "How should I use it with Claude Code or Codex?",
        "answer": "Ask for a test plan, mock review, fixture strategy, or CI pipeline audit for your repository."
      },
      {
        "question": "Can it help with CI pipelines?",
        "answer": "Yes. It covers pipeline stages, caching, sharding, reports, branch protection, and test secrets."
      },
      {
        "question": "Does it cover security tests?",
        "answer": "It marks auth and permission checks as important. It is not a full security testing methodology."
      }
    ]
