  "content": {
    "user_title": "Analyze Code Size and Semantic Diffs",
    "value_statement": "Teams need quick visibility into repository size, language mix, and change impact. This skill guides Claude, Codex, and Claude Code to use tokei and difftastic for local code statistics and semantic diffs.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code statistics",
      "tokei",
      "difftastic",
      "semantic diff",
      "line counts",
      "repository analysis",
      "codebase metrics"
    ],
    "actual_capabilities": [
      "Run tokei examples for total lines, language breakdowns, and compact summaries.",
      "Filter code counts by language, path, hidden files, ignored files, and directory depth.",
      "Use tokei JSON output with jq for totals, per-file reports, CI checks, and history tracking.",
      "Run difftastic examples for side-by-side, inline, context-limited, and language-forced diffs.",
      "Configure difftastic with Git external diff, git difftool, repository settings, and config files.",
      "Compare files, directories, branches, commits, and staged changes."
    ],
    "limitations": [
      "Requires tokei and difftastic to be installed outside the skill.",
      "Commands inspect local files and repository history, so users should review paths before execution.",
      "Statistics depend on tool language detection and project ignore rules.",
      "It does not upload, store, or visualize metrics by itself."
    ],
    "use_cases": [
      {
        "title": "Measure repository size",
        "target_user": "Engineering manager",
        "description": "Get a fast language and line-count summary before planning work or reporting project scope."
      },
      {
        "title": "Review semantic changes",
        "target_user": "Code reviewer",
        "description": "Compare files, branches, or commits with syntax-aware diffs that reduce formatting noise."
      },
      {
        "title": "Track code growth in CI",
        "target_user": "DevOps engineer",
        "description": "Build local scripts that capture code totals, compare thresholds, and preserve simple history."
      }
    ],
    "prompt_templates": [
      {
        "title": "Count this repository",
        "scenario": "Beginner repository overview",
        "prompt": "Use the code-stats skill to run a safe tokei summary for the current repository. Exclude generated folders such as node_modules, dist, and vendor. Explain the main language totals in plain text."
      },
      {
        "title": "Compare two files semantically",
        "scenario": "Intermediate file review",
        "prompt": "Use difftastic through the code-stats skill to compare OLD_FILE and NEW_FILE in inline mode. Highlight semantic changes and ignore formatting-only differences."
      },
      {
        "title": "Prepare a language breakdown",
        "scenario": "Advanced metrics report",
        "prompt": "Use tokei JSON output and jq to produce a language breakdown for src and tests. Sort by code lines and include totals, file counts, and notable exclusions."
      },
      {
        "title": "Audit branch growth and changes",
        "scenario": "Advanced branch assessment",
        "prompt": "Use the advanced code-stats workflows to compare main and FEATURE_BRANCH. Run tokei before and after, then use difftastic for important changed files. Summarize size growth and semantic impact."
      }
    ],
    "output_examples": [
      {
        "input": "How big is this TypeScript project?",
        "output": "A concise summary showing total code, comment, and blank lines, plus the dominant TypeScript and JavaScript totals."
      },
      {
        "input": "Compare old.ts and new.ts.",
        "output": "A semantic diff summary that separates moved code, renamed symbols, and formatting-only changes."
      },
      {
        "input": "Can we enforce code size limits in CI?",
        "output": "A CI-oriented plan that measures total code lines, compares them with a threshold, and reports when the limit is exceeded."
      }
    ],
    "best_practices": [
      "Review command targets before running tokei or difftastic on large directories.",
      "Exclude generated, vendored, build, and dependency folders for meaningful counts.",
      "Use JSON output for automation and plain text summaries for human review."
    ],
    "anti_patterns": [
      "Do not run global Git configuration changes without explicit user approval.",
      "Do not include secrets, ignored directories, or hidden files unless the user requests them.",
      "Do not treat line counts as the only measure of code quality or review complexity."
    ],
    "faq": [
      {
        "question": "Does this skill install tokei or difftastic?",
        "answer": "No. The tools must already be installed through a package manager or language toolchain."
      },
      {
        "question": "Can it analyze private repositories?",
        "answer": "Yes, when run locally with permission. The skill does not send repository data to an external service."
      },
      {
        "question": "Does it count generated files?",
        "answer": "It can, but the recommended workflow excludes generated, dependency, and build folders for clearer metrics."
      },
      {
        "question": "Can it compare Git branches?",
        "answer": "Yes. The difftastic guidance covers Git diffs, commits, staged changes, and branch comparisons."
      },
      {
        "question": "Is semantic diffing the same as line diffing?",
        "answer": "No. Semantic diffing uses language structure to reduce noise from formatting and moved code."
      },
      {
        "question": "Should I enable global Git configuration?",
        "answer": "Only do so after confirming that difftastic should affect Git diffs across your user account."
      }
    ]
