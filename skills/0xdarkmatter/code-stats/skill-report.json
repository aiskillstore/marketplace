      {
        "title": "Review Refactors",
        "description": "Compare before and after code with semantic diffs that reduce formatting noise.",
        "target_user": "Code reviewers"
      },
      {
        "title": "Track Project Growth",
        "description": "Create repeatable local reports for codebase size, language mix, and growth over time.",
        "target_user": "Open source maintainers"
      }
    ],
    "prompt_templates": [
