        "input": "Summarize this repository's code size by language.",
        "output": [
          "A language table with file counts, code lines, comment lines, blank lines, and totals.",
          "A short note identifying the largest languages and any excluded generated directories."
        ]
      },
      {
        "input": "Compare this refactor with the previous commit.",
        "output": [
          "A semantic change summary that separates moved code from logic changes.",
          "A reviewer-focused list of files that need the most attention."
        ]
      },
      {
        "input": "Track codebase growth over time.",
        "output": [
          "A repeatable local workflow for collecting totals and storing historical snapshots.",
          "A plain-language explanation of trends, thresholds, and exclusions."
        ]
      }
    ],
    "best_practices": [
      "Confirm the target path, branch, or commit range before running analysis commands.",
      "Exclude dependency caches, build output, and generated files when measuring application code.",
      "Use semantic diffs for refactors where formatting changes hide meaningful logic changes."
