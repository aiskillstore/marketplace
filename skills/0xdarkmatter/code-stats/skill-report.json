        "prompt": "Use code-stats to summarize this repository by language. Include files, code lines, comments, blanks, and total lines."
      },
      {
        "title": "Compare Two Files Semantically",
        "scenario": "Basic semantic diff",
        "prompt": "Use code-stats to compare these two files with difftastic. Explain the functional changes and ignore formatting-only noise."
      },
      {
        "title": "Review Refactor Impact",
        "scenario": "Intermediate code review",
        "prompt": "Use code-stats to compare the current branch against main. Summarize moved code, changed logic, and large file-level changes."
      },
      {
        "title": "Create a Size Gate Report",
        "scenario": "Advanced automation planning",
        "prompt": "Use code-stats to design a local CI size report. Include language totals, excluded paths, and a threshold for maximum code lines."
      }
