    "actual_capabilities": [
      "Counts files, total lines, code lines, comments, and blanks by language with tokei.",
      "Filters statistics by language, path, depth, hidden files, ignored files, and excluded directories.",
      "Uses compact, JSON, and YAML output modes for reporting and automation workflows.",
      "Compares files, directories, branches, commits, and staged changes with AST-aware diffs.",
      "Explains refactor impact by reducing whitespace and formatting noise in diffs.",
      "Provides CI and history-tracking examples for repository growth monitoring."
    ],
    "limitations": [
      "Requires the tokei and difftastic command-line tools to be installed locally.",
      "Can only analyze files and Git history available in the current workspace.",
      "Language counts and semantic diffs depend on each tool's parser support.",
      "Does not measure code quality, complexity, test coverage, or security posture."
