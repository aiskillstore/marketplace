  "content": {
    "user_title": "Streamline Git Workflows with CLI Tools",
    "value_statement": "Git workflows can become slow when staging, reviewing, rebasing, and opening pull requests use separate tools. This skill gives direct Git, GitHub CLI, lazygit, and delta guidance in one place.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "git workflow skill",
      "GitHub CLI automation",
      "lazygit assistant",
      "delta diff viewer",
      "interactive rebase help",
      "git stash workflows",
      "pull request workflow"
    ],
    "actual_capabilities": [
      "Lists lazygit actions for staging, commits, pushes, pulls, branch work, rebase, and stash tasks.",
      "Guides GitHub CLI pull request, issue, repository, workflow, and run inspection commands.",
      "Shows delta-based diff viewing and optional pager configuration.",
      "Covers interactive rebase patterns, including squash, reorder, edit, split, autosquash, and recovery.",
      "Documents stash, bisect, cherry-pick, worktree, reflog, and conflict handling workflows."
    ],
