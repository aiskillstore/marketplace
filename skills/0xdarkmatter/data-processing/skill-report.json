  "content": {
    "user_title": "Process JSON, YAML, and TOML Data",
    "value_statement": "Structured configuration data can be hard to inspect across JSON, YAML, and TOML files. This skill guides jq and yq queries for extraction, filtering, conversion, and updates.",
    "seo_keywords": [
      "Claude data processing",
      "Codex JSON jq",
      "Claude Code YAML yq",
      "jq patterns",
      "yq patterns",
      "JSON transformation",
      "YAML querying",
      "TOML conversion",
      "Docker Compose analysis",
      "Kubernetes manifest queries"
    ],
    "actual_capabilities": [
      "Extract fields and nested values from JSON with jq.",
      "Filter, map, sort, group, and aggregate JSON records.",
      "Query YAML for Docker Compose, Kubernetes, and GitHub Actions files.",
      "Read TOML data and convert TOML to JSON with yq.",
      "Provide patterns for package.json, tsconfig, ESLint, and Prettier files.",
      "Show yq in-place edit patterns for YAML updates."
    ],
    "limitations": [
      "Requires jq and yq to be installed in the user environment.",
      "Examples are command-line guidance and do not validate every input file.",
      "Network examples should only run after user approval.",
      "In-place yq edits can change files and should be reviewed first."
    ],
    "use_cases": [
      {
        "title": "Inspect Application Config",
        "description": "Extract names, versions, scripts, dependencies, and compiler settings from common project configuration files.",
        "target_user": "Application developer"
      },
      {
        "title": "Review DevOps Manifests",
        "description": "Query Docker Compose, Kubernetes, and GitHub Actions files to find services, images, jobs, and labels.",
        "target_user": "DevOps engineer"
      },
      {
        "title": "Transform Data Exports",
        "description": "Filter records, reshape fields, aggregate values, and format results for easier review.",
        "target_user": "Data analyst"
      }
    ],
    "prompt_templates": [
      {
        "title": "Read a Field",
        "scenario": "Beginner query for a single value.",
        "prompt": "Show me a jq command to print the name and version from package.json."
      },
      {
        "title": "Filter Records",
        "scenario": "Intermediate filtering for JSON arrays.",
        "prompt": "Create a jq query that lists active users with their id, name, and email from data.json."
      },
      {
        "title": "Inspect Manifests",
        "scenario": "Advanced YAML review for deployment files.",
        "prompt": "Use yq patterns to list all container images and labels from a Kubernetes deployment manifest."
