  "content": {
    "user_title": "Clarify Ambiguous Government Service Questions",
    "value_statement": "Government service users often ask incomplete questions that cannot route to the right workflow. This skill identifies the missing detail and asks one precise follow-up question.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "government service chatbot",
      "ambiguous question detection",
      "clarification prompts",
      "public service support",
      "Chinese government services",
      "service intake automation",
      "question disambiguation"
    ],
    "actual_capabilities": [
      "Classifies government service questions as ambiguous or ready for processing.",
      "Identifies missing details such as subject, certificate name, policy type, or service step.",
      "Selects the highest-priority missing element before asking a follow-up.",
      "Generates one concise clarification question in a polite government service tone.",
      "Uses included rules and examples for common Chinese public service scenarios."
    ],
    "limitations": [
      "Designed for Chinese government service intake, not general customer support.",
      "Does not verify current laws, fees, eligibility, or local policy changes.",
      "Does not search external systems or connect to government databases.",
      "May need local service catalogs for unusual or region-specific terms."
    ],
    "use_cases": [
      {
        "title": "Route Citizen Service Questions",
        "description": "Detect unclear intake questions before routing them to a government service workflow.",
        "target_user": "Government service chatbot teams"
      },
      {
        "title": "Standardize Clarification Replies",
        "description": "Create consistent follow-up questions for agents handling incomplete service requests.",
        "target_user": "Public service contact center managers"
      },
      {
        "title": "Test Intake Classification Rules",
        "description": "Compare edge cases against documented ambiguity rules and example responses.",
        "target_user": "AI workflow designers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check One Question",
        "scenario": "Beginner review of a single user question.",
        "prompt": "Use this skill to review the question: \"我要办证\". If it is ambiguous, provide one clarification question."
      },
      {
        "title": "Identify Missing Details",
        "scenario": "Analyze why a service question cannot be routed yet.",
        "prompt": "Review this government service question: \"营业执照需要什么材料\". Identify the missing detail and ask one follow-up question."
      },
      {
        "title": "Handle Edge Cases",
        "scenario": "Decide whether a partially specific service phrase is enough.",
        "prompt": "Apply the ambiguity rules to this question: \"餐饮类的许可证\". Decide if clarification is needed and ask only one question."
      },
      {
        "title": "Audit Intake Examples",
        "scenario": "Advanced batch review of several intake questions.",
        "prompt": "Review these service questions for ambiguity: \"许可证怎么办\", \"企业投资项目备案\", and \"政策补贴领取\". For each ambiguous item, give one targeted follow-up."
      }
    ],
    "output_examples": [
      {
        "input": "User asks: 我要办证",
        "output": "请问您需要办理的是什么类型的证件呢？"
      },
      {
        "input": "User asks: 食品经营许可证办理",
        "output": "This question is specific enough for direct service processing."
      },
      {
        "input": "User asks: 政策补贴领取",
        "output": "请问您需要领取的是哪项政策补贴呢？"
      }
    ],
    "best_practices": [
      "Use the skill before routing a question to a specific service workflow.",
      "Ask about the highest-priority missing detail first.",
      "Keep the generated follow-up to one clear question."
    ],
    "anti_patterns": [
      "Do not ask several clarification questions in one response.",
      "Do not use generic replies such as asking users to describe everything again.",
      "Do not treat vague words like certificate or subsidy as specific service names."
    ],
