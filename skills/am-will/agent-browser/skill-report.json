  "content": {
    "user_title": "Automate browser tasks with structured commands",
    "value_statement": "Browser tasks can be slow and difficult to repeat by hand. Agent Browser provides commands for navigation, interaction, inspection, and visual capture.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "browser automation",
      "headless browser",
      "web UI testing",
      "web extraction",
      "form automation",
      "Agent Browser"
    ],
    "actual_capabilities": [
      "Open pages and navigate backward, forward, or reload.",
      "Click, fill, select, check, drag, and upload through page selectors.",
      "Create page snapshots and extract text, HTML, attributes, titles, and URLs.",
      "Capture screenshots and export pages as PDF files.",
      "Use isolated named sessions and machine-readable snapshot output.",
      "Wait for selectors, text, URLs, or page-load states."
    ],
    "limitations": [
      "It requires the Agent Browser CLI and its browser dependencies.",
      "Page refs change after navigation and require a new snapshot.",
      "Authentication flows and third-party websites can change without notice.",
      "Using a real browser profile can expose cookies, tokens, and account access."
    ],
    "use_cases": [
      {
        "title": "Test a web form",
        "description": "Navigate a staging page, fill fields, submit the form, and verify the result.",
        "target_user": "QA engineer"
      },
      {
        "title": "Inspect page content",
        "description": "Capture a structured snapshot and extract selected text from a public webpage.",
        "target_user": "Researcher"
      },
      {
        "title": "Debug a user interface",
        "description": "Open a local or test site, inspect element states, and capture a screenshot for review.",
        "target_user": "Web developer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Open and inspect a page",
        "scenario": "Beginner",
        "prompt": "Open https://example.com, create an interactive snapshot, and list the visible links."
      },
      {
        "title": "Test a form flow",
        "scenario": "Intermediate",
        "prompt": "Open our staging signup page, fill the approved test data, submit it, and report the visible result. Do not use real customer data."
      },
      {
        "title": "Extract selected content",
        "scenario": "Intermediate",
        "prompt": "Open this public page, capture a snapshot, and extract the heading and text from the main content area."
      },
      {
        "title": "Run a guarded UI check",
        "scenario": "Advanced",
        "prompt": "Use an isolated session to test the approved staging URL. Capture snapshots before and after each action, and ask before uploading files or changing account settings."
      }
    ],
    "output_examples": [
      {
        "input": "Inspect the example page and list its main links.",
        "output": [
          "Page title: Example Domain",
          "Visible link: More information",
          "Snapshot captured successfully."
        ]
      },
      {
        "input": "Test the staging login form with approved test credentials.",
        "output": [
          "Form fields were filled.",
          "Submission completed.",
          "Result page displayed the expected test account message."
        ]
      },
      {
        "input": "Capture a screenshot after the dashboard loads.",
        "output": "The dashboard loaded and a full-page screenshot was saved for review."
      }
    ],
    "best_practices": [
      "Use isolated sessions for testing and public-page tasks.",
      "Create a fresh snapshot after every navigation.",
      "Ask for confirmation before uploads, account changes, or authenticated actions."
    ],
    "anti_patterns": [
      "Do not attach automation to a personal Chrome profile by default.",
      "Do not use real customer data in form tests.",
      "Do not run page JavaScript or upload files without clear approval."
    ],
    "faq": [
      {
        "question": "What does Agent Browser do?",
        "answer": "It provides command-line browser automation for navigation, interaction, inspection, and screenshots."
      },
      {
        "question": "Which tools can use this skill?",
        "answer": "The skill supports Claude, Codex, and Claude Code."
      },
      {
        "question": "Can it test web forms?",
        "answer": "Yes. It can fill, submit, and inspect forms with approved test data."
      },
      {
        "question": "Why should I create snapshots?",
        "answer": "Snapshots provide current page refs for reliable element selection."
      },
      {
        "question": "Can it use a logged-in browser session?",
        "answer": "It can, but this may expose cookies and account access. Use an isolated profile unless you explicitly approve it."
      },
      {
        "question": "Can it upload files?",
        "answer": "Yes. Confirm the exact files and destination before using upload actions."
      }
    ]
