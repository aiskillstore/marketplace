  "content": {
    "user_title": "Improve Vue Testing Practices",
    "value_statement": "Vue test suites often fail because async rendering, mocks, and E2E setup use inconsistent patterns. This skill gives practical Vue testing guidance for Vitest, Vue Test Utils, and Playwright.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Vue testing",
      "Vitest",
      "Vue Test Utils",
      "Playwright E2E",
      "Pinia testing",
      "async component testing",
      "component test best practices"
    ],
    "actual_capabilities": [
      "Recommends Vitest setup patterns for Vue 3 projects.",
      "Explains blackbox component testing with Vue Test Utils.",
      "Guides async component, Suspense, and flushPromises testing.",
      "Covers Pinia store setup and composable wrapper patterns.",
      "Compares Playwright and Cypress for Vue E2E testing.",
      "Warns against snapshot-only tests and brittle implementation assertions."
    ],
    "limitations": [
      "Does not run tests or inspect live project output by itself.",
      "Examples focus on Vue 3 and may need adaptation for Vue 2.",
      "Nuxt and custom build systems may require extra configuration.",
      "Does not replace official release notes for breaking changes."
    ],
    "use_cases": [
      {
        "title": "Set Up a Vue Test Stack",
        "description": "Choose Vitest, Vue Test Utils, jsdom or happy-dom, and basic scripts for a new Vue 3 project.",
        "target_user": "Vue developer"
      },
      {
        "title": "Stabilize Component Tests",
        "description": "Fix brittle tests by using user-visible behavior, async waits, Pinia setup, and reliable selectors.",
        "target_user": "Frontend maintainer"
      },
      {
        "title": "Plan E2E Coverage",
        "description": "Design Playwright coverage for login flows, product flows, browser projects, and local dev server integration.",
        "target_user": "QA engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose a Test Setup",
        "scenario": "Beginner project setup",
        "prompt": "Recommend a Vue 3 testing setup for my app. Include unit tests, component tests, E2E tests, and when to use each tool."
      },
      {
        "title": "Fix a Flaky Async Test",
        "scenario": "Intermediate debugging",
        "prompt": "Review this Vue component test failure. Explain whether I need nextTick, flushPromises, Suspense, or a different assertion strategy."
      },
      {
        "title": "Refactor Brittle Tests",
        "scenario": "Advanced component testing",
        "prompt": "Help refactor these Vue Test Utils tests so they check behavior instead of private state, internal methods, or full snapshots."
      },
      {
        "title": "Design an E2E Strategy",
        "scenario": "Advanced test architecture",
        "prompt": "Create a Playwright strategy for this Vue app. Cover browser projects, CI behavior, selectors, page objects, and test boundaries."
      }
    ],
    "output_examples": [
      {
        "input": "A Vue 3 team asks whether to use Jest, Vitest, Cypress, or Playwright.",
        "output": "The response recommends Vitest for unit and component tests, Vue Test Utils for mounting, and Playwright for new E2E coverage."
      },
      {
        "input": "A component test fails before an async component renders.",
        "output": "The response explains the async rendering issue, recommends Suspense or flushPromises, and suggests checking loading and final states separately."
      },
      {
        "input": "A test suite relies on full snapshots and wrapper internals.",
        "output": "The response proposes behavior-focused assertions, visible selectors, emitted event checks, and small snapshots only when useful."
      }
    ],
    "best_practices": [
      "Prefer behavior-focused assertions over private state checks.",
      "Await Vue updates and unresolved promises before final assertions.",
      "Use Playwright for cross-browser E2E coverage in new Vue apps."
    ],
    "anti_patterns": [
      "Do not rely on snapshot-only tests for core behavior.",
      "Do not test implementation details that change during refactors.",
      "Do not mount async setup components without Suspense support."
    ],
    "faq": [
      {
        "question": "Does this skill support Vue 3?",
        "answer": "Yes. The guidance focuses on Vue 3, Vitest, Vue Test Utils, and modern Vue testing patterns."
      },
      {
        "question": "Can it help choose between Vitest and Jest?",
        "answer": "Yes. It explains why Vitest fits Vite-based Vue projects and when Jest may still be reasonable."
      },
      {
        "question": "Does it cover end-to-end testing?",
        "answer": "Yes. It includes Playwright setup guidance, browser projects, local server configuration, and selector patterns."
      },
      {
        "question": "Can it debug flaky async component tests?",
        "answer": "Yes. It covers flushPromises, nextTick, Suspense wrappers, and async setup testing patterns."
      },
      {
        "question": "Does it generate runnable tests automatically?",
        "answer": "No. It provides guidance and examples, but the user must adapt them to the project."
      },
      {
        "question": "Is this useful for Pinia and composables?",
        "answer": "Yes. It includes patterns for Pinia store setup and helper wrappers for composables with lifecycle hooks."
