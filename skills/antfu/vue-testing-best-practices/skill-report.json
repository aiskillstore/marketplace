  "content": {
    "user_title": "Build Reliable Vue Tests",
    "value_statement": "Vue tests often fail because asynchronous rendering, framework internals, and test-runner configuration are handled incorrectly. This skill provides focused patterns for Vitest, Vue Test Utils, Pinia, Suspense, Teleport, and Playwright.",
    "seo_keywords": [
      "Vue testing",
      "Vitest",
      "Vue Test Utils",
      "Playwright",
      "component testing",
      "E2E testing",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Guides Vitest configuration for Vue 3 projects, including DOM environments, coverage, setup files, and CI behavior.",
      "Shows black-box component tests based on rendered output, user interactions, emitted events, props, and slots.",
      "Explains reliable async testing with awaited triggers, flushPromises, Suspense wrappers, and dynamic components.",
      "Covers Pinia setup, lifecycle-dependent composable wrappers, Teleport handling, and browser-versus-node runner choices.",
      "Provides Playwright setup, cross-browser projects, local server integration, page objects, screenshots, and stable selectors.",
      "Helps replace snapshot-only tests with focused behavioral assertions and small regression snapshots."
    ],
    "limitations": [
      "Provides reference guidance and examples; it does not execute tests or modify projects independently.",
      "Assumes Vue 3 and may require adaptation for Vue 2, Nuxt-specific, or non-Vite projects.",
      "Example component names, routes, credentials, and ports are placeholders that must match the target application.",
      "Does not guarantee coverage, accessibility, or browser compatibility; teams must validate tests in their own environments."
    ],
    "use_cases": [
      {
        "title": "Stabilize component tests",
        "description": "Apply async waits, black-box assertions, Pinia setup, and Teleport handling to reduce brittle Vue component tests.",
        "target_user": "Vue application developers"
      },
      {
        "title": "Design a Vue test strategy",
        "description": "Choose Vitest, DOM runners, Playwright projects, selector conventions, and snapshot boundaries for a new or migrated suite.",
        "target_user": "Frontend technical leads"
      },
      {
        "title": "Review testing pull requests",
        "description": "Check Vue tests for implementation coupling, missing awaits, weak assertions, and incomplete end-to-end coverage before merge.",
        "target_user": "Code reviewers and maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a component test",
        "prompt": "Write Vitest and Vue Test Utils tests for [component]. Cover visible output, props, user interactions, and emitted events. Avoid implementation details.",
        "scenario": "Beginner component testing"
      },
      {
        "title": "Fix an asynchronous test",
        "prompt": "Diagnose this flaky Vue test: [test and component context]. Identify missing awaits, nextTick, flushPromises, Suspense, or dynamic-import handling. Return a corrected approach.",
        "scenario": "Intermediate test debugging"
      },
      {
        "title": "Plan store and composable tests",
        "prompt": "Create a focused test plan for [Pinia store or composable]. Include setup, lifecycle or injection requirements, mocking boundaries, behavior assertions, and cleanup.",
        "scenario": "Advanced integration planning"
      },
      {
        "title": "Design a complete testing strategy",
        "prompt": "Audit [Vue project or test suite]. Recommend Vitest configuration, runner environments, component patterns, Playwright coverage, selector policy, snapshot limits, and CI priorities.",
        "scenario": "Advanced suite architecture"
      }
    ],
    "output_examples": [
      {
        "input": "A modal test cannot find content rendered through Teleport.",
        "output": [
          "Stub Teleport for isolated component tests that only verify modal behavior.",
          "Query document.body when the test must include the real teleport target.",
          "Unmount attached wrappers after each test to prevent DOM leakage."
        ]
      },
      {
        "input": "An asynchronous component test asserts before data appears.",
        "output": [
          "Await user interactions and Vue updates before checking rendered output.",
          "Use flushPromises when unresolved promises control the component state.",
          "Mount async setup components within Suspense and verify loading and resolved states."
        ]
      },
      {
        "input": "A suite relies on full-component snapshots for most coverage.",
        "output": [
          "Replace primary snapshots with assertions for visible content, events, and interactions.",
          "Keep small snapshots only for stable structures where regression detection adds value.",
          "Review snapshot changes alongside behavioral tests instead of updating them automatically."
        ]
      }
    ],
    "best_practices": [
      "Assert user-visible behavior and public component contracts before checking implementation details.",
      "Await every Vue update, triggered interaction, and unresolved promise before asserting asynchronous results.",
      "Keep end-to-end selectors stable and validate critical flows across required browsers in CI."
    ],
    "anti_patterns": [
      "Reading component internals or calling private methods instead of simulating user behavior.",
      "Using full-component snapshots as the only proof of correctness.",
      "Mixing unit and end-to-end responsibilities without clear setup, isolation, cleanup, or selector conventions."
    ],
    "faq": [
      {
        "question": "Does this skill recommend Vitest for Vue projects?",
        "answer": "Yes. It prioritizes Vitest for Vue 3 and Vite projects while acknowledging migration cases where Jest may remain appropriate."
      },
      {
        "question": "Can it help configure Playwright?",
        "answer": "Yes. It covers local server integration, browser projects, CI settings, selectors, page objects, screenshots, and common commands."
      },
      {
        "question": "Does it produce project-specific tests?",
        "answer": "It can draft tests from supplied context, but component APIs, routes, selectors, and fixtures must be adapted and verified."
      },
      {
        "question": "Does it support Vue 2?",
        "answer": "The guidance targets Vue 3. Vue 2 projects may need different utilities, configuration, and component patterns."
      },
      {
        "question": "How does it handle asynchronous rendering?",
        "answer": "It explains awaited interactions, nextTick, flushPromises, Suspense wrappers, dynamic components, loading states, and rejected promises."
      },
      {
        "question": "Does the skill install dependencies or run tests?",
        "answer": "No. It provides guidance and examples. The user or host agent must perform project changes and test execution."
      }
    ]
  },
