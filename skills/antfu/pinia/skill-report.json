  "content": {
    "user_title": "Build Pinia Stores for Vue",
    "value_statement": "Vue state management can become hard to structure as apps grow. This skill gives Pinia patterns for stores, plugins, testing, SSR, Nuxt, and HMR.",
    "seo_keywords": [
      "Pinia",
      "Vue state management",
      "Vue stores",
      "Nuxt Pinia",
      "Pinia testing",
      "TypeScript stores",
      "Claude",
      "Codex",
      "Claude Code",
      "Vue SSR"
    ],
    "actual_capabilities": [
      "Explains setup stores and options stores for Pinia projects.",
      "Guides state, getters, actions, subscriptions, and storeToRefs usage.",
      "Covers Pinia plugins, custom properties, and devtools visibility.",
      "Shows testing patterns with createTestingPinia, mocked actions, and plugins.",
      "Describes SSR, Nuxt integration, hydration, and HMR patterns."
    ],
    "limitations": [
      "It is reference guidance, not an executable Pinia runtime.",
      "It does not replace project-specific architecture review.",
      "Examples assume Vue and Pinia project context.",
      "It may not cover Pinia releases after v3.0.4."
    ],
    "use_cases": [
      {
        "title": "Create Vue stores",
        "description": "Design type-safe Pinia stores with clear state, getters, and actions.",
        "target_user": "Vue application developers"
      },
      {
        "title": "Improve testing coverage",
        "description": "Plan store and component tests using Pinia testing utilities and mocked actions.",
        "target_user": "Frontend test engineers"
      },
      {
        "title": "Prepare SSR and Nuxt apps",
        "description": "Apply Pinia patterns for hydration, request isolation, Nuxt plugins, and safe store usage.",
        "target_user": "Nuxt and SSR maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Define a simple store",
        "scenario": "Beginner store creation",
        "prompt": "Help me design a Pinia store for this Vue feature. Include state, getters, actions, and when to use storeToRefs."
      },
      {
        "title": "Refactor store usage",
        "scenario": "Intermediate component cleanup",
        "prompt": "Review this component's Pinia usage. Suggest safer destructuring, clearer actions, and any reactivity issues."
      },
      {
        "title": "Plan store tests",
        "scenario": "Testing workflow",
        "prompt": "Create a testing approach for these Pinia stores. Include unit tests, createTestingPinia usage, mocked actions, and plugin setup."
      },
      {
        "title": "Audit SSR architecture",
        "scenario": "Advanced SSR and Nuxt review",
        "prompt": "Review my Pinia SSR or Nuxt architecture. Check hydration, per-request store isolation, plugins, and store usage outside components."
      }
    ],
    "output_examples": [
      {
        "input": "A developer asks how to structure a cart store.",
        "output": "A concise store plan with state fields, derived getters, action responsibilities, and component usage notes."
      },
      {
        "input": "A tester asks how to mock store actions in component tests.",
        "output": "A testing checklist covering fresh Pinia instances, mocked actions, plugin setup, and assertions for component behavior."
      },
      {
        "input": "A Nuxt maintainer asks why SSR state leaks between users.",
        "output": "A review explaining per-request Pinia creation, hydration order, and store access rules outside components."
      }
    ],
    "best_practices": [
      "Prefer setup stores when logic needs composables, watchers, or complex derived state.",
      "Use storeToRefs when destructuring state or getters from a store.",
      "Create a fresh Pinia instance per request in SSR applications."
    ],
    "anti_patterns": [
      "Do not destructure state directly from a store without preserving reactivity.",
      "Do not read another store's state during setup in both stores.",
      "Do not share a single Pinia instance across SSR requests."
    ],
    "faq": [
      {
        "question": "What is this skill for?",
        "answer": "It helps Claude, Codex, and Claude Code answer Pinia implementation questions for Vue projects."
      },
      {
        "question": "Does it support Nuxt?",
        "answer": "Yes. It includes Nuxt plugin guidance, auto-import notes, SSR behavior, and hydration practices."
      },
      {
        "question": "Can it help with testing?",
        "answer": "Yes. It covers createTestingPinia, mocked actions, plugin setup, and store tests."
      },
      {
        "question": "Does it generate runnable projects?",
        "answer": "No. It provides implementation guidance and examples for existing Vue and Pinia projects."
      },
      {
        "question": "Which Pinia version is referenced?",
        "answer": "The skill states it is based on Pinia v3.0.4, generated on January 28, 2026."
