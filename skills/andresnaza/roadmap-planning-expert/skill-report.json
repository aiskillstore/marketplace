  "content": {
    "user_title": "Build a Practical Product Roadmap",
    "value_statement": "Teams can lose focus when plans mix strategy, delivery details, and uncertain estimates. This skill guides a collaborative process for turning goals into sized epics, milestones, sprints, and capacity plans.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "roadmap planning",
      "sprint planning",
      "capacity planning",
      "milestone estimation",
      "product roadmap",
      "quarterly planning"
    ],
    "actual_capabilities": [
      "Frames work as quarters, epics, milestones, and sprints.",
      "Uses a documented point-based capacity model for two-week sprints.",
      "Guides collaborative quarterly, epic, and sprint planning conversations.",
      "Recommends splitting milestones larger than 25 points.",
      "Documents a roadmap file layout for configuration, quarters, epics, sprints, and templates.",
      "Describes how epics and milestones map to ClickUp tasks and subtasks."
    ],
    "limitations": [
      "It provides planning guidance, not detailed technical specifications.",
      "Capacity estimates use fixed assumptions and need adjustment for each team.",
      "It does not track pull requests, quality assurance, or delivery execution.",
      "ClickUp synchronization requires the separate ClickUp integration commands."
    ],
    "use_cases": [
      {
        "title": "Plan a quarterly roadmap",
        "description": "Convert strategic goals into a small set of rough-sized epics and sequence them across six sprints.",
        "target_user": "Product managers"
      },
      {
        "title": "Prepare a sprint plan",
        "description": "Select milestones that fit team availability, point capacity, and a buffer for unexpected work.",
        "target_user": "Engineering managers"
      },
      {
        "title": "Break down an initiative",
        "description": "Turn a large initiative into meaningful milestones that are suitable for capacity planning.",
        "target_user": "Technical leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a roadmap",
        "scenario": "Beginner",
        "prompt": "Help me plan a roadmap for the next quarter. Ask me about our goals before proposing epics."
      },
      {
        "title": "Size an epic",
        "scenario": "Intermediate",
        "prompt": "Help me split this epic into two to four milestones and estimate each one: improve account onboarding."
      },
      {
        "title": "Plan a sprint",
        "scenario": "Intermediate",
        "prompt": "Plan our next two-week sprint. We have three developers, one developer is unavailable for three days, and we need a 15 percent buffer."
      },
      {
        "title": "Balance a quarter",
        "scenario": "Advanced",
        "prompt": "Review these proposed milestones for the quarter. Identify capacity conflicts, oversized milestones, and a practical sprint sequence."
      }
    ],
    "output_examples": [
      {
        "input": "Plan a two-week sprint for two developers with 15 percent buffer.",
        "output": [
          "Available capacity: 34 points after the buffer.",
          "Select milestones totaling no more than 34 points.",
          "Keep a small reserve for urgent work."
        ]
      },
      {
        "input": "Break down an epic to improve reporting.",
        "output": [
          "Milestone 1: Define report goals and data sources.",
          "Milestone 2: Build core report views.",
          "Milestone 3: Validate results and refine the experience."
        ]
      }
    ],
    "best_practices": [
      "Define goals before creating epics or assigning dates.",
      "Use milestones as meaningful checkpoints, not copies of issue tracker tasks.",
      "Review capacity and availability before committing work to a sprint."
    ],
    "anti_patterns": [
      "Do not use the roadmap as a detailed specification or pull request tracker.",
      "Do not place milestones larger than 25 points into a sprint without splitting them.",
      "Do not treat point estimates as guarantees when availability or scope is uncertain."
    ],
    "faq": [
      {
        "question": "What planning levels does this skill use?",
        "answer": "It organizes work into quarters, epics, milestones, and two-week sprints."
      },
      {
        "question": "How much capacity does one developer have?",
        "answer": "The documented default is 20 points per two-week sprint before the buffer."
      },
      {
        "question": "Why use a capacity buffer?",
        "answer": "The recommended 15 percent buffer leaves room for unexpected work and uncertainty."
      },
      {
        "question": "When should I split a milestone?",
        "answer": "Split milestones estimated above 25 points before assigning them to a sprint."
      },
      {
        "question": "Does it replace an issue tracker?",
        "answer": "No. It focuses on strategic planning and recommends using delivery tools for detailed execution tracking."
      },
      {
        "question": "Can it work with ClickUp?",
        "answer": "It documents a mapping from epics to ClickUp tasks and milestones to subtasks through separate sync commands."
      }
    ]
