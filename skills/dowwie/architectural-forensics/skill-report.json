    "user_title": "Analyze Agent Framework Architecture",
    "value_statement": "Agent framework design is hard to compare because behavior spans code structure and reasoning patterns. This skill guides Claude, Codex, and Claude Code through a staged architecture forensics workflow.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "agent framework analysis",
      "architectural forensics",
      "AI agent architecture",
      "codebase mapping",
      "framework comparison",
      "reference architecture",
      "technical due diligence"
    ],
    "actual_capabilities": [
      "Coordinates phased analysis of engineering chassis, cognitive architecture, and synthesis outputs.",
      "Uses codebase maps and clustered file reading to keep agent context bounded.",
      "Defines roles for orchestrator, framework, skill, reader, and synthesis agents.",
      "Produces framework summaries, comparison matrices, anti-pattern catalogs, and reference architecture drafts.",
      "Supports resumable work with manifest and per-framework state file guidance."
    ],
    "limitations": [
      "Requires access to the target repository and related analysis skills.",
      "Does not include the external codebase mapping script referenced in the workflow.",
      "Findings depend on source quality, repository size, and generated map accuracy.",
      "Manual review is still needed for framework-specific design tradeoffs."
    ],
    "use_cases": [
      {
        "title": "Evaluate Framework Candidates",
        "description": "Compare agent frameworks before adopting one for a platform or product team.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Design A New Agent Runtime",
        "description": "Extract reusable patterns and avoid known architecture problems during system design.",
        "target_user": "Platform architects"
      },
      {
        "title": "Document Technical Due Diligence",
        "description": "Create evidence-based architecture reports for acquisition, vendor, or open source reviews.",
        "target_user": "Technical evaluators"
      }
    ],
    "prompt_templates": [
      {
        "title": "Map One Framework",
        "scenario": "Beginner single-framework review",
        "prompt": "Analyze the agent framework at [path]. Create a concise architecture summary with engineering chassis, cognitive architecture, and key tradeoffs."
      },
      {
        "title": "Compare Two Frameworks",
        "scenario": "Intermediate framework selection",
        "prompt": "Compare [framework A] and [framework B]. Focus on execution engines, memory, tool interfaces, and error handling. Recommend patterns to reuse."
      },
      {
        "title": "Audit One Subsystem",
        "scenario": "Advanced focused architecture review",
        "prompt": "Study the tool interface in [framework]. Cite files and summarize schema generation, dispatch behavior, error feedback, and extension points."
      },
      {
        "title": "Build Reference Architecture",
        "scenario": "Advanced multi-framework synthesis",
        "prompt": "Analyze [framework list], build a comparison matrix, identify anti-patterns, and draft a reference architecture for a new agent framework."
      }
    ],
    "output_examples": [
      {
        "input": "Analyze a single Python agent framework for architecture patterns.",
        "output": "A framework summary with engineering decisions, cognitive patterns, notable strengths, risks, and recommendations for reuse."
      },
      {
        "input": "Compare three agent frameworks before choosing a foundation.",
        "output": "A decision matrix, anti-pattern catalog, and recommended reference architecture for the planned system."
      },
      {
        "input": "Review how one framework implements tool calling.",
        "output": "A focused subsystem report covering schema design, dispatch flow, error handling, and developer experience."
      }
    ],
    "best_practices": [
      "Start with a fresh codebase map so agents analyze current files.",
      "Keep framework outputs separated to preserve evidence and avoid cross-contamination.",
      "Review generated recommendations before turning them into implementation plans."
    ],
    "anti_patterns": [
      "Do not use the synthesis phase before individual framework summaries are complete.",
      "Do not treat generated architecture advice as a substitute for source review.",
      "Do not compare frameworks without normalizing versions, languages, and use cases."
    ],
    "faq": [
      {
        "question": "What does this skill analyze?",
        "answer": "It analyzes agent frameworks, including execution flow, component models, memory, tools, and multi-agent coordination."
      },
      {
        "question": "Does it write production code?",
        "answer": "No. It produces architecture reports, comparison artifacts, and reference design guidance."
      },
      {
        "question": "Can it compare multiple frameworks?",
        "answer": "Yes. The workflow includes per-framework analysis and a synthesis phase for cross-framework comparison."
      },
      {
        "question": "Does it need repository access?",
        "answer": "Yes. It needs access to the target framework source and generated codebase map."
      },
      {
        "question": "Is this only for Python projects?",
        "answer": "No. The guidance names Python examples, but the architecture workflow can apply to other languages."
      },
      {
        "question": "How should results be used?",
        "answer": "Use results as structured evidence for architecture decisions, then validate recommendations with engineers."
      }
