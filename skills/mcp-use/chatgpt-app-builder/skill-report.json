    "actual_capabilities": [
      "Explains when to use widgets, tools-only flows, fullscreen, inline, and picture-in-picture display modes.",
      "Shows mcp-use server.tool patterns that return widget responses with props and text or object output.",
      "Documents React widget exports, McpUseProvider usage, useWidget hooks, loading states, and tool calls.",
      "Covers widget state, LLM-visible context, follow-up messages, theme handling, locale, safe area, and device adaptation.",
      "Documents CSP metadata, Apps SDK metadata formats, external domains, and migration from legacy metadata fields."
    ],
    "limitations": [
