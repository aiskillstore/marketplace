  "content": {
    "user_title": "Improve Developer Documentation Quality",
    "value_statement": "Weak documentation slows onboarding and makes code harder to maintain. This skill guides README, JSDoc, and inline comment reviews with practical standards.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "documentation review",
      "README best practices",
      "JSDoc comments",
      "inline code comments",
      "developer onboarding",
      "technical writing",
      "code maintainability"
    ],
    "actual_capabilities": [
      "Reviews comments for the WHY not WHAT principle.",
      "Checks README files for purpose, problem, installation, usage, and contribution guidance.",
      "Provides JSDoc guidance for parameters, returns, errors, examples, related APIs, and deprecation notes.",
      "Identifies obvious comments, stale comments, magic numbers, commented-out code, and scaffold README text.",
      "Supplies focused review questions for documentation feedback."
    ],
    "limitations": [
      "Does not generate project-specific facts without source material.",
      "Does not validate whether README commands actually run.",
      "Does not replace security, legal, or API correctness review.",
      "Does not include automation scripts or parsers."
    ],
    "use_cases": [
      {
        "title": "Review README readiness",
        "description": "Check that a README explains purpose, installation, quick start, and contribution flow before release.",
        "target_user": "Open source maintainer"
      },
      {
        "title": "Improve API comments",
        "description": "Revise JSDoc so exported functions explain parameters, returns, errors, examples, and intent.",
        "target_user": "Library author"
      },
      {
        "title": "Coach code reviews",
        "description": "Use focused questions to teach when comments add context and when code should stand alone.",
        "target_user": "Engineering mentor"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic README Review",
        "scenario": "Beginner review for a small project README.",
        "prompt": "Review this README against the five essentials: purpose, problem, installation, quick start, and contribution guidance. List missing sections and concrete fixes."
      },
      {
        "title": "Inline Comment Cleanup",
        "scenario": "Intermediate review for noisy code comments.",
        "prompt": "Review these inline comments. Flag comments that only repeat the code. Keep comments that explain intent, constraints, or business context."
      },
      {
        "title": "JSDoc Completeness Check",
        "scenario": "Intermediate review for exported API documentation.",
        "prompt": "Evaluate this API documentation for JSDoc completeness. Check parameters, returns, errors, examples, related APIs, and deprecation notes."
      },
      {
        "title": "Repository Documentation Plan",
        "scenario": "Advanced review for a repository-wide documentation pass.",
        "prompt": "Create a documentation review plan for this repository. Prioritize README gaps, exported API docs, inline comments, and stale documentation risks."
      }
    ],
    "output_examples": [
      {
        "input": "A README only contains a project name and a default scaffold sentence.",
        "output": [
          "Add a one-sentence purpose statement.",
          "Explain the problem the project solves.",
          "Add installation and quick start steps that a new developer can follow."
        ]
      },
      {
        "input": "Inline comments restate assignments, loops, and obvious property reads.",
        "output": [
          "Remove comments that repeat visible behavior.",
          "Keep comments only where they explain intent, constraints, or unusual decisions."
        ]
      },
      {
        "input": "An exported utility has parameter names but no usage guidance.",
        "output": [
          "Add parameter and return descriptions.",
          "Add an example outcome in prose.",
          "Document errors or constraints that callers must handle."
        ]
      }
    ],
    "best_practices": [
      "Document why decisions exist when code already shows behavior.",
      "Keep README steps copy-paste ready and tested by a new developer.",
      "Update comments when behavior changes, or remove comments that no longer add context."
    ],
    "anti_patterns": [
      "Adding comments that restate variable names, loops, or assignments.",
      "Leaving commented-out code instead of relying on version history.",
      "Publishing scaffold README text that does not explain real purpose or setup."
    ],
    "faq": [
      {
        "question": "Can this skill write a full README?",
        "answer": "Yes. It can draft a README when you provide project purpose, install steps, usage examples, and contribution rules."
      },
      {
        "question": "Does it run documentation tests?",
        "answer": "No. It gives review guidance but does not execute commands or verify examples."
      },
      {
        "question": "Which tools can use it?",
        "answer": "It is compatible with Claude, Codex, and Claude Code skill workflows."
      },
      {
        "question": "Can it review comments in any language?",
        "answer": "Yes. The principles apply broadly, but language-specific tags should follow the project standard."
      },
      {
        "question": "Does it replace a technical review?",
        "answer": "No. It improves clarity and maintainability but does not prove API behavior or security correctness."
      },
      {
        "question": "How should I provide context?",
        "answer": "Share the README, comments, target audience, and any known setup rules before asking for review."
      }
    ]
