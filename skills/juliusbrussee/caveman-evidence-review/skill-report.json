  "content": {
    "user_title": "Review Caveman Cloud Evidence",
    "value_statement": "LLM cost and quality changes are difficult to explain from aggregates alone. This skill produces bounded, trace-supported Caveman Cloud reviews without changing experiments.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Caveman Cloud",
      "LLM cost analysis",
      "trace analytics",
      "Cave Score",
      "verified savings",
      "LLM observability"
    ],
    "actual_capabilities": [
      "Reviews Caveman Cloud costs, scores, workflows, plans, and verified savings.",
      "Searches traces within bounded time windows and explicit filters.",
      "Compares suspect cohorts with controls or earlier periods.",
      "Inspects representative trace metadata, spans, latency, status, tokens, cache state, optimizers, and model routes.",
      "Separates measured costs, inferred headroom, verified savings, and evidence costs.",
      "Reports supported findings, unresolved explanations, and one next read-only check."
    ],
    "limitations": [
      "Requires an authenticated Caveman account and selected project.",
      "Does not start, approve, cancel, or roll back experiments.",
      "Does not retrieve prompt or completion payloads unless the user explicitly requests payload review.",
      "Cannot prove causality from aggregates or a single trace."
    ],
    "use_cases": [
      {
        "title": "Investigate spend changes",
        "description": "Compare cost reports and trace cohorts to identify workflows, models, or retries associated with an LLM spend change.",
        "target_user": "FinOps analyst"
      },
      {
        "title": "Review reliability evidence",
        "description": "Examine errors, latency, status classes, and representative spans within a bounded production window.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Validate optimization results",
        "description": "Keep inferred headroom separate from verified ledger savings and identify the evidence supporting each result.",
        "target_user": "AI product manager"
      }
    ],
    "prompt_templates": [
      {
