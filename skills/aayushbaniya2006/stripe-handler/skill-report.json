    "actual_capabilities": [
      "Explains when to use this skill instead of plan or credit handlers.",
      "Provides a server-side Stripe Checkout Session pattern for custom products.",
      "Shows metadata-based routing for checkout.session.completed webhook events.",
      "Demonstrates dispatching payment fulfillment work to Inngest.",
      "Documents local Stripe CLI webhook testing commands and required environment variables."
    ],
    "limitations": [
      "Does not replace the host application Stripe configuration.",
      "Does not cover standard subscription plan or credit package flows.",
      "Requires developers to validate webhook signatures and protect secrets.",
      "Examples must be adapted to each database schema and fulfillment model."
