# --- Secrets ---
# Never commit API keys or credential files.
*.env
.env
.env.*
*api*key*
*apikey*
secrets/
secret.txt

# --- Backups & temp ---
*.bak
*.tmp
*.temp
*~

# --- Generated media (keep curated demo assets; ignore ad-hoc generations) ---
# Downloaded/generated outputs that you don't want in the repo:
outputs/
generated/
downloads/
*.mp4
*.mov
*.webm
# ...but keep committed demo assets:
!docs/images/*.png
!docs/images/*.jpg
!docs/images/*.gif
!examples/*.png
!examples/*.jpg
!examples/*.gif

# --- OS junk ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- PowerShell ---
*.ps1.bak
PSSessionConfig_*.xml

# --- Personal release notes (not part of the public repo) ---
PUBLISH-NOTES.md
RELEASE-CHECKLIST.md
