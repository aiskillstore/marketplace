    "actual_capabilities": [
      "Checks staged file state with `git status --short`.",
      "Reviews staged file impact with `git diff --cached --stat`.",
      "Analyzes staged patches using `git diff --cached`.",
      "Chooses a conventional commit type and scope from change intent.",
      "Identifies likely breaking changes and can offer an alternative message."
    ],
    "limitations": [
      "Requires repository access and at least one staged change.",
      "Generates recommendations but does not create commits.",
      "Evaluates staged changes only, excluding unstaged and untracked work.",
      "Scope and breaking-change detection depend on evidence in the diff and may need review."
    ],
    "use_cases": [
