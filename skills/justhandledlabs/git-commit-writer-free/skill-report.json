        "description": "Choose an accurate type and scope for staged dependency, build, or repository maintenance changes.",
        "target_user": "Repository maintainer"
      },
      {
        "title": "Flag a breaking release change",
        "description": "Detect evidence of public contract changes and recommend a breaking conventional commit marker.",
        "target_user": "Release engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Write a staged commit message",
        "prompt": "Write a conventional commit message for my staged changes.",
        "scenario": "Use after staging a focused set of files."
      },
      {
