    "anti_patterns": [
      "Do not request a message before staging changes.",
      "Do not mix unrelated staged work and expect one precise scope.",
      "Do not accept a breaking marker without public contract evidence."
    ],
    "faq": [
      {
        "question": "Does this skill create the Git commit?",
        "answer": "No. It recommends commit text but does not run `git commit`."
      },
      {
        "question": "Does it include unstaged changes?",
        "answer": "No. It analyzes only changes reported by the cached Git diff."
      },
      {
        "question": "Which commit format does it use?",
        "answer": "It uses conventional commit types with an optional lowercase scope and breaking marker."
      },
      {
        "question": "How does it choose a scope?",
        "answer": "It derives a concise scope from shared paths, project domains, and the main intent."
      },
      {
        "question": "How does it detect breaking changes?",
        "answer": "It checks for public API, schema, configuration, CLI, and documented compatibility changes."
      },
      {
        "question": "What happens when nothing is staged?",
