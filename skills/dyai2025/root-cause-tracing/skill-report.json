    "user_title": "Trace Root Causes in Complex Bugs",
    "value_statement": "Complex bugs often appear far from their original trigger. This skill guides backward tracing, targeted instrumentation, and test isolation to find the source.",
    "seo_keywords": [
      "Claude root cause tracing",
      "Codex debugging skill",
      "Claude Code debugging",
      "root cause analysis",
      "bug tracing",
      "test pollution detection",
      "stack trace instrumentation",
      "debugging workflow",
      "AI coding assistant"
    ],
    "actual_capabilities": [
      "Explains when to trace backward from a deep failure instead of patching the symptom.",
      "Provides a step-by-step workflow for following callers, inputs, and invalid state.",
      "Shows how to add stack trace instrumentation before a problematic operation.",
      "Includes a shell helper that runs matched npm tests to identify unwanted state creation.",
      "Recommends validation and defense layers after the original trigger is fixed."
    ],
    "limitations": [
      "Requires developer judgment to choose safe commands and interpret stack traces.",
      "The helper script assumes an npm test workflow and may not fit every project.",
      "Examples focus on TypeScript and Node.js debugging patterns.",
      "Does not automatically analyze logs, source files, or test output without user-provided context."
    ],
    "use_cases": [
      {
        "title": "Trace a Deep Runtime Failure",
        "description": "Follow a failure from the visible error back through callers until the first invalid input is found.",
        "target_user": "Application developers"
      },
      {
        "title": "Identify a Polluting Test",
        "description": "Run tests in isolation to find which test creates unexpected files or persistent state.",
        "target_user": "QA engineers and test maintainers"
      },
      {
        "title": "Add Defensive Validation",
        "description": "Turn a traced root cause into source-level validation and guardrails across the call chain.",
        "target_user": "Technical leads and maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Trace a Visible Error",
        "scenario": "Beginner debugging session",
        "prompt": "Use root-cause-tracing for this error: [paste symptom]. Walk backward through likely callers and identify the earliest input to inspect."
      },
      {
        "title": "Plan Instrumentation",
        "scenario": "Intermediate stack tracing",
        "prompt": "Use root-cause-tracing to plan safe instrumentation for this failing operation: [operation]. Include what to log and what to avoid logging."
      },
      {
        "title": "Find Test Pollution",
        "scenario": "Advanced test isolation",
        "prompt": "Use root-cause-tracing to identify which test creates [file or state]. Suggest a safe isolation workflow before running commands."
      },
      {
        "title": "Design Source Fixes",
        "scenario": "Maintainer remediation",
        "prompt": "Use root-cause-tracing on this call chain: [call chain]. Propose a source fix and defense layers that prevent recurrence."
      }
    ],
    "output_examples": [
      {
        "input": "A test suite leaves a .git directory inside a package folder.",
        "output": "Immediate cause: a git initialization used the wrong working directory. Trace callers until the empty project directory value is introduced."
      },
      {
        "input": "A database opens in the project root instead of a temporary directory.",
        "output": "Start at the open call. Record the directory argument, caller stack, and test setup timing. Fix the first invalid path source."
      },
      {
        "input": "A failing operation only appears after the full test suite runs.",
        "output": "Run focused test groups, watch for the unwanted state, and stop at the first reproducing test. Then inspect that test setup path."
      }
    ],
    "best_practices": [
      "Start with the exact symptom, then move one caller up at a time.",
      "Log only the context needed to prove data flow, and avoid secrets.",
      "Fix the original trigger, then add validation at important boundaries."
    ],
    "anti_patterns": [
      "Patching only the line where the error appears.",
