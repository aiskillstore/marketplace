  "content": {
    "user_title": "Trace Bugs to Their Root Cause",
    "value_statement": "Deep failures often hide the original trigger behind many layers of calls. This skill guides Claude Code, Claude, and Codex through backward tracing, targeted instrumentation, and source-level fixes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "root cause analysis",
      "debugging workflow",
      "stack trace debugging",
      "test pollution",
      "instrumentation",
      "defense in depth",
      "bug tracing"
    ],
    "actual_capabilities": [
      "Guides backward tracing from a visible symptom to the original caller or invalid value.",
      "Shows when to add temporary stack trace logging for hard-to-follow execution paths.",
      "Explains how to identify tests that create unwanted files or state.",
      "Includes a shell helper for running tests one by one to find pollution sources.",
      "Encourages fixing the source cause and adding validation at multiple layers."
    ],
    "limitations": [
      "Does not automatically prove the root cause without project-specific investigation.",
      "The helper script assumes an npm test command and may need changes for other test runners.",
      "Manual instrumentation can add noisy logs if it is not removed after debugging.",
      "It is focused on code execution paths, not production observability or incident response."
    ],
    "use_cases": [
      {
        "title": "Find the first bad caller",
        "description": "Trace a runtime failure backward through the call chain until the first invalid value or caller is found.",
        "target_user": "Application developer"
      },
      {
        "title": "Locate test pollution",
        "description": "Run tests in isolation to find which test creates unwanted files, directories, or shared state.",
        "target_user": "Test maintainer"
      },
      {
        "title": "Add defensive checks after a fix",
        "description": "Pair the root-cause fix with validations that stop the same class of bug from reaching dangerous operations.",
        "target_user": "Code reviewer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a root-cause trace",
        "scenario": "Beginner debugging of a deep error.",
        "prompt": "Use root-cause-tracing to help me debug this error. Start from the symptom, identify the immediate cause, then trace backward until we find the first bad input."
      },
      {
        "title": "Instrument a confusing path",
        "scenario": "The call chain is unclear.",
        "prompt": "Use root-cause-tracing to decide where to add temporary stack trace logging. Keep the instrumentation minimal and tell me what evidence to collect."
      },
      {
        "title": "Find a polluting test",
        "scenario": "A file or state appears during test runs.",
        "prompt": "Use root-cause-tracing to find which test creates this unwanted state. Explain how to isolate the polluter and how to confirm the result."
      },
      {
        "title": "Fix source and add defenses",
        "scenario": "Advanced remediation after the root cause is known.",
        "prompt": "Use root-cause-tracing to propose a source-level fix for this bug, then add only the validation layers needed to prevent the bad value from reaching the dangerous operation again."
      }
    ],
    "output_examples": [
      {
        "input": "A command runs in the repository root even though it should run in a temporary directory.",
        "output": [
          "Immediate cause: the command receives an empty working directory.",
          "Trace target: find who passed the empty value.",
          "Likely fix: validate the directory at the source and before the command runs."
        ]
      },
      {
        "input": "A .git directory appears after the test suite runs.",
        "output": [
          "Check whether the directory exists before each test.",
          "Run suspected tests one at a time.",
          "Stop at the first test that creates the directory and trace its setup path."
        ]
      },
      {
        "input": "The stack trace does not show the bad caller clearly.",
        "output": "Add temporary logging immediately before the dangerous operation. Include the argument value, current working directory, environment label, and a captured stack trace."
      }
    ],
    "best_practices": [
      "Start with the exact symptom, then move one caller or value source backward at a time.",
      "Add temporary instrumentation as close as possible to the dangerous operation.",
      "Fix the original trigger first, then add narrow validations at critical boundaries."
    ],
    "anti_patterns": [
      "Do not patch only the line where the error appears if the invalid value came from earlier code.",
      "Do not add broad logging everywhere when one targeted stack trace can show the path.",
      "Do not keep temporary debug output after the root cause has been confirmed."
    ],
    "faq": [
      {
        "question": "What problem does this skill solve?",
        "answer": "It helps trace a visible failure back to the first bad input, caller, or test setup that caused it."
      },
      {
        "question": "Does it run commands automatically?",
        "answer": "The Markdown guidance does not run commands automatically. The included helper script is executable and should be run only in trusted projects."
      },
      {
        "question": "Can it help with flaky tests?",
        "answer": "Yes, when flakiness comes from shared state or files created by another test. It is less useful for timing-only failures."
      },
      {
        "question": "Does it replace a debugger?",
        "answer": "No. It gives a tracing method that can work with logs, stack traces, tests, or a debugger."
      },
      {
        "question": "Why fix the source instead of the symptom?",
        "answer": "A symptom fix can hide the failure while the bad value continues to move through the system."
      },
      {
        "question": "When should I stop tracing backward?",
        "answer": "Stop when you find the earliest code that creates or accepts the wrong value, then fix that boundary."
      }
    ]
