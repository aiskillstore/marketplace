    "actual_capabilities": [
      "Reviews staged diffs before drafting a commit message.",
      "Checks current git status for repository context.",
      "Uses recent commits to match local message style.",
      "Suggests concise first lines under 72 characters.",
      "Supports feat, fix, docs, test, style, chore, and refactor types.",
      "Asks for user approval before executing a commit."
    ],
    "limitations": [
      "Requires a git repository with staged changes.",
      "Does not stage files or split changes automatically.",
      "May need user guidance when staged changes mix unrelated concerns.",
      "Commit execution depends on user approval and local git configuration."
    ],
    "use_cases": [
      {
        "title": "Draft Daily Commits",
        "description": "Generate a clear message after staging one logical code change.",
        "target_user": "Individual developer"
      },
      {
        "title": "Keep Team Style Consistent",
        "description": "Match recent repository commit style across shared project work.",
        "target_user": "Tech lead"
      },
      {
        "title": "Label Documentation Updates",
        "description": "Create simple commit messages for documentation-only changes.",
        "target_user": "Documentation maintainer"
      }
    ],
    "prompt_templates": [
