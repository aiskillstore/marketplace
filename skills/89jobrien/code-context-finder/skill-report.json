    "user_title": "Find Code Context Faster",
    "value_statement": "Developers often lose time tracing why code exists and what depends on it. This skill prompts Claude, Codex, or Claude Code to gather related graph knowledge, callers, imports, and tests before changes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code context finder",
      "code relationship analysis",
      "knowledge graph search",
      "impact analysis",
      "refactoring support",
      "test discovery",
      "developer productivity"
    ],
    "actual_capabilities": [
      "Detects moments when extra context is useful, such as refactors, errors, new files, and architecture decisions.",
      "Guides knowledge graph searches for prior decisions, project context, owners, and related concepts.",
      "Provides grep and find patterns for imports, callers, tests, routes, APIs, database queries, and configuration references.",
      "Includes a Python script that reports imports, dependents, callers, and tests for Python targets.",
      "Suggests concise context summaries that combine graph notes with code relationship results."
    ],
    "limitations": [
      "It depends on available memory graph data and repository files.",
      "Search results may miss dynamic imports, generated code, or language patterns outside the references.",
      "The helper script focuses on Python relationships.",
      "It can surface sensitive file names, so review commands before scanning private repositories."
    ],
    "use_cases": [
      {
        "title": "Refactor Shared Python Modules",
        "description": "Map imports, callers, and tests before changing a shared module.",
        "target_user": "Backend developer"
      },
      {
        "title": "Understand Unfamiliar Repositories",
        "description": "Combine graph notes and code searches to learn module purpose and dependencies.",
        "target_user": "New team member"
      },
      {
        "title": "Review Architecture Decisions",
        "description": "Find prior decisions and related implementations before choosing a design path.",
        "target_user": "Tech lead"
      }
    ],
