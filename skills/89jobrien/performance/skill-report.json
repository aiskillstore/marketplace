    "user_title": "Optimize Application Performance",
    "value_statement": "Slow applications reduce reliability and user trust. This skill helps Claude, Codex, and Claude Code find bottlenecks and plan measurable fixes.",
    "seo_keywords": [
      "Claude performance analysis",
      "Codex optimization skill",
      "Claude Code load testing",
      "performance audit",
      "Core Web Vitals",
      "React optimization",
      "database performance",
      "API latency",
      "capacity planning",
      "memory leak analysis"
    ],
    "actual_capabilities": [
      "Analyze application latency, throughput, error rates, CPU usage, and memory usage.",
      "Identify database issues such as slow queries, missing indexes, and N+1 query patterns.",
      "Create load testing and stress testing plans for APIs and services.",
      "Recommend React rendering, memoization, bundle size, and Core Web Vitals improvements.",
      "Prepare performance reports with bottlenecks, root causes, expected impact, and monitoring guidance."
    ],
    "limitations": [
      "It needs measurements, logs, traces, or source code for reliable conclusions.",
      "It cannot prove production impact without running controlled tests.",
      "Load testing requires explicit authorization and safe target limits.",
      "It does not replace an APM, profiler, database monitor, or browser lab tool."
    ],
    "use_cases": [
      {
        "title": "Diagnose Slow APIs",
        "description": "Review endpoint metrics, query behavior, and code paths to find the highest impact latency fixes.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Improve Web Vitals",
        "description": "Find React rendering, bundle, image, and layout issues that affect page speed and user experience.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Plan Capacity Tests",
        "description": "Design authorized load tests with realistic traffic phases, thresholds, and monitoring requirements.",
        "target_user": "Site reliability engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find Basic Bottlenecks",
        "scenario": "Beginner performance review",
        "prompt": "Analyze this application for performance bottlenecks. Focus on response time, CPU, memory, and database queries. Return prioritized fixes with expected impact."
      },
      {
        "title": "Review React Performance",
        "scenario": "Frontend optimization",
        "prompt": "Review this React app for unnecessary renders, heavy components, bundle size issues, and Core Web Vitals risks. Suggest measurable improvements."
      },
      {
        "title": "Design a Load Test",
        "scenario": "Authorized API testing",
        "prompt": "Create a load test plan for this API. Include target environment, user profile, phases, thresholds, metrics, and stop conditions."
      },
      {
        "title": "Build an Optimization Roadmap",
        "scenario": "Advanced performance program",
        "prompt": "Use these metrics, traces, and code notes to produce a performance roadmap. Rank fixes by impact, effort, risk, and validation method."
      }
    ],
    "output_examples": [
      {
        "input": "An API endpoint has high p95 latency during peak traffic.",
        "output": "A report that identifies likely bottlenecks, explains root causes, ranks fixes, and lists metrics to confirm improvement."
      },
      {
        "input": "A React dashboard feels slow after adding charts.",
        "output": "A focused review of render frequency, bundle weight, lazy loading options, and Core Web Vitals risks."
      },
      {
        "input": "A team needs to validate capacity before a launch.",
        "output": "An authorized test plan with traffic phases, success thresholds, monitoring needs, rollback criteria, and reporting sections."
      }
    ],
    "best_practices": [
      "Start with baseline metrics before proposing optimizations.",
      "Run load tests only on authorized local, staging, or owned production targets.",
      "Verify each fix with before and after measurements."
    ],
    "anti_patterns": [
      "Optimizing code before measuring the real bottleneck.",
      "Running stress tests against third-party or unknown targets.",
      "Adding React memoization everywhere without checking render cost."
    ],
    "faq": [
      {
        "question": "Can this skill run production load tests?",
        "answer": "It can help design them, but execution should require explicit authorization, safe limits, and monitoring."
      },
      {
        "question": "Does it support frontend performance work?",
        "answer": "Yes. It covers React rendering, bundle size, lazy loading, and Core Web Vitals analysis."
      },
      {
        "question": "Can it diagnose database latency?",
        "answer": "Yes. It can review slow queries, missing indexes, N+1 patterns, locks, and connection pool behavior."
      },
      {
        "question": "What data improves its recommendations?",
        "answer": "Provide metrics, traces, logs, profiler output, database plans, code snippets, and recent deployment context."
      },
      {
        "question": "Will it guarantee a faster application?",
        "answer": "No. It proposes likely fixes, but teams must validate changes with controlled measurements."
      },
      {
        "question": "Is this useful for capacity planning?",
        "answer": "Yes. It can define traffic profiles, success thresholds, resource signals, and reporting structure."
      }
