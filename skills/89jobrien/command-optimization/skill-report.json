  "content": {
    "user_title": "Design Better CLI Commands",
    "value_statement": "CLI tools often grow inconsistent options, weak help text, and unclear errors. This skill helps Claude, Codex, and Claude Code design command structures, arguments, examples, and documentation.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "CLI command design",
      "command-line interface",
      "argument parsing",
      "developer automation",
      "CLI best practices",
      "command documentation",
      "developer experience"
    ],
    "actual_capabilities": [
      "Designs action-oriented command names and usage patterns.",
      "Defines arguments, flags, defaults, and option descriptions.",
      "Improves validation, error messages, and help text.",
      "Creates examples for common and advanced command flows.",
      "Drafts slash command templates with workflow sections."
    ],
    "limitations": [
      "Does not execute or test commands by itself.",
      "Needs project conventions before recommending final names.",
      "Cannot verify dependencies without repository context.",
      "Generated commands still need security review before use."
    ],
    "use_cases": [
      {
        "title": "Shape New Developer Commands",
        "target_user": "Application developer",
        "description": "Create clear commands for generators, checks, builds, migrations, and other project tasks."
      },
      {
        "title": "Standardize Automation Workflows",
        "target_user": "DevOps engineer",
        "description": "Align task commands around consistent names, options, dry-run behavior, and useful output."
      },
      {
        "title": "Improve Tool Documentation",
        "target_user": "Technical writer",
        "description": "Turn command behavior into concise usage text, option tables, examples, and error guidance."
      }
    ],
    "prompt_templates": [
      {
        "title": "Design a New Command",
        "scenario": "Beginner command planning",
        "prompt": "Design a CLI command for [task]. Include the name, usage, required arguments, common options, examples, and help text."
      },
      {
        "title": "Improve Existing UX",
        "scenario": "Intermediate command review",
        "prompt": "Review this command interface: [command details]. Suggest clearer names, safer defaults, validation rules, and error messages."
      },
      {
        "title": "Create a Slash Command Template",
        "scenario": "Experienced workflow authoring",
        "prompt": "Create a Claude Code slash command template for [workflow]. Include frontmatter, arguments, allowed tools, steps, and output format."
      },
      {
        "title": "Standardize a Command Suite",
        "scenario": "Advanced command governance",
        "prompt": "Audit this command suite: [commands]. Propose a naming taxonomy, shared option rules, migration plan, and documentation updates."
      }
    ],
    "output_examples": [
      {
        "input": "Create a command to generate React components.",
        "output": "A response that proposes a clear generator name, required component input, path options, test options, and concise help text."
      },
      {
        "input": "Improve a database migration command.",
        "output": "A response that separates create, run, status, rollback, and target-version flows with safer defaults and clearer errors."
      },
      {
        "input": "Design a slash command for dependency audits.",
        "output": "A response that defines arguments, allowed tools, current-state checks, review steps, and a focused report format."
      }
    ],
    "best_practices": [
      "Start with the user task, then choose the command name.",
      "Use dry-run and confirmation for destructive operations.",
      "Document one simple example before advanced options."
    ],
    "anti_patterns": [
      "Using vague verbs like run, make, or do without context.",
      "Adding flags that change behavior without clear help text.",
      "Skipping validation for files, permissions, and required inputs."
    ],
    "faq": [
      {
        "question": "Does this skill run commands?",
        "answer": "No. It helps design and document commands. A user or tool must implement and test them."
      },
      {
        "question": "Can it help with Claude Code slash commands?",
        "answer": "Yes. It can draft slash command templates with arguments, allowed tools, workflow steps, and output formats."
      },
      {
        "question": "Does it choose an argument parser library?",
        "answer": "It can compare parser needs and suggest patterns. Final library selection depends on your project stack."
      },
      {
        "question": "Can it improve existing commands?",
        "answer": "Yes. Provide the current command, options, errors, and expected users for a focused review."
      },
      {
        "question": "Is it limited to JavaScript projects?",
        "answer": "No. The design guidance applies to most CLI tools, scripts, and developer automation workflows."
      },
      {
        "question": "What context should I provide?",
        "answer": "Provide the task, target users, project conventions, destructive actions, and any required inputs or outputs."
      }
    ]
  },
