  "content": {
    "user_title": "Improve Evidence-Based Reasoning",
    "value_statement": "Complex reviews and decisions often fail when claims outrun evidence. This skill provides verification workflows, hypothesis testing, and self-correction prompts.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "meta-cognitive reasoning",
      "evidence-based analysis",
      "hypothesis testing",
      "code review reasoning",
      "debugging workflow",
      "decision framework",
      "verification checklist"
    ],
    "actual_capabilities": [
      "Prompts users to show evidence before making claims.",
      "Guides multiple hypothesis generation before conclusions.",
      "Adds temporal checks for package, API, and tool versions.",
      "Structures self-correction when earlier analysis was wrong.",
      "Provides review workflows for code, architecture, and documentation."
    ],
    "limitations": [
      "It does not verify facts without access to authoritative sources.",
      "It cannot replace domain expertise for legal, medical, or financial decisions.",
      "It may slow simple tasks that need quick execution.",
      "It relies on the agent to follow the reasoning workflow."
    ],
    "use_cases": [
      {
        "title": "Review Code Changes",
        "description": "Engineers can require evidence for every finding before changing code.",
        "target_user": "Software engineers"
      },
      {
        "title": "Debug Complex Failures",
        "description": "Support teams can compare possible causes before choosing a fix.",
        "target_user": "Support engineers"
      },
      {
        "title": "Assess Technical Decisions",
        "description": "Technical leads can weigh assumptions, evidence, and tradeoffs before approving plans.",
        "target_user": "Technical leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Verify a Claim",
        "scenario": "Beginner",
        "prompt": "Use meta-cognitive reasoning to verify this claim before accepting it: [claim]. Show evidence first, then interpret it."
      },
      {
        "title": "Compare Hypotheses",
        "scenario": "Intermediate",
        "prompt": "Analyze this issue with at least three hypotheses: [issue]. Identify the evidence that would confirm or reject each one."
      },
      {
        "title": "Review With Evidence",
        "scenario": "Advanced",
        "prompt": "Review this change for correctness and risk. Cite specific evidence for every finding, and separate observation from assessment."
      },
      {
        "title": "Recover From an Error",
        "scenario": "Expert",
        "prompt": "Reassess my previous conclusion about [topic]. State the claim, check evidence, explain any error, and give the corrected action."
      }
    ],
    "output_examples": [
      {
        "input": "A reviewer says a new package version is invalid.",
        "output": "The response verifies the registry or lockfile first, then states whether the version exists and whether action is needed."
      },
      {
        "input": "Several tests fail with similar timeout messages.",
        "output": "The response lists competing causes, names the evidence needed, and avoids blaming one dependency before checking timing and scope."
      },
      {
        "input": "Documentation appears repetitive across files.",
        "output": "The response checks whether duplication is copies, generated content, or linked files before suggesting consolidation."
      }
    ],
    "best_practices": [
      "Use the skill before high-impact reviews, not after conclusions are formed.",
      "Provide files, logs, or source links so evidence can be checked.",
      "Ask for separate observation, mechanism, and assessment sections."
    ],
    "anti_patterns": [
      "Asking for a final verdict without providing evidence sources.",
      "Using the skill to justify a decision already made.",
      "Skipping verification because an issue matches a familiar pattern."
    ],
    "faq": [
      {
        "question": "Does this skill execute commands automatically?",
        "answer": "No. It describes verification workflows. The active agent decides which tools are available and appropriate."
      },
      {
        "question": "Is it only for software tasks?",
        "answer": "No. It also supports documentation, research, planning, and decision analysis."
      },
      {
        "question": "Can it verify current package versions?",
        "answer": "It can guide verification, but it needs access to current sources or lockfiles."
      },
      {
        "question": "How does it help code reviews?",
        "answer": "It asks for file-level evidence, competing explanations, and clear separation between facts and judgments."
      },
      {
        "question": "Will it make simple tasks slower?",
        "answer": "Sometimes. Use it when accuracy matters more than speed."
      },
      {
        "question": "Does it replace expert judgment?",
        "answer": "No. It structures reasoning, but experts still own domain-specific conclusions."
      }
    ]
  },
