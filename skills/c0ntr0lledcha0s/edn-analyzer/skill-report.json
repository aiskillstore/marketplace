  "content": {
    "user_title": "Analyze Logseq EDN Templates",
    "value_statement": "Logseq EDN templates can be large and hard to inspect manually. This skill summarizes structure, validates relationships, and compares template variants.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "EDN analyzer",
      "Logseq templates",
      "database graph",
      "template validation",
      "orphan detection",
      "property analysis",
      "Clojure EDN"
    ],
    "actual_capabilities": [
      "Counts classes, properties, property types, and cardinality values in Logseq EDN templates.",
      "Maps class hierarchies and property-to-class relationships.",
      "Finds orphaned classes, orphaned properties, duplicate titles, and missing required fields.",
      "Checks ID formats, broken references, cardinality values, and circular relationship risks.",
      "Compares template variants and reports size, module, class, and property differences."
    ],
    "limitations": [
      "It is designed for documented Logseq EDN template structures, not arbitrary database formats.",
      "Large templates may require focused analysis to keep reports readable.",
      "It needs access to the template files the user wants analyzed.",
      "It does not automatically repair templates unless the user asks for changes."
    ],
    "use_cases": [
      {
        "title": "Audit a Logseq Template Release",
        "description": "Review a template before publishing by checking counts, required fields, references, and orphaned items.",
        "target_user": "Template maintainer"
      },
      {
        "title": "Compare Product Variants",
        "description": "Compare full, CRM, research, content, or events variants to explain what each build includes.",
        "target_user": "Product builder"
      },
      {
        "title": "Understand a Graph Schema",
        "description": "Summarize classes, properties, inheritance, and module distribution for onboarding or documentation.",
        "target_user": "Documentation writer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Template Summary",
        "scenario": "Beginner overview of one template file.",
        "prompt": "Analyze this Logseq EDN template and summarize total classes, properties, property types, and any obvious issues."
      },
      {
        "title": "Find Quality Issues",
        "scenario": "Focused validation for maintainers.",
        "prompt": "Check this template for orphaned classes, orphaned properties, duplicate titles, missing fields, and broken references."
      },
      {
        "title": "Compare Two Variants",
        "scenario": "Intermediate comparison across builds.",
        "prompt": "Compare these two Logseq EDN template variants and explain class, property, module, and feature differences."
      },
      {
        "title": "Plan Schema Cleanup",
        "scenario": "Advanced maintenance planning.",
        "prompt": "Analyze module balance, large classes, reusable properties, and inheritance depth, then recommend a cleanup plan."
      }
    ],
    "output_examples": [
      {
        "input": "Analyze a full Logseq EDN template.",
        "output": "A concise report with total classes, total properties, property type counts, cardinality distribution, and notable warnings."
      },
      {
        "input": "Find orphaned classes and properties.",
        "output": "A prioritized issue list naming each orphaned item, its likely module, and a suggested parent or class assignment."
      },
      {
        "input": "Compare the full and CRM templates.",
        "output": "A side-by-side summary of class counts, property counts, included modules, excluded modules, and variant-specific features."
      }
    ],
    "best_practices": [
      "Provide the exact EDN files or module folders to analyze.",
      "Ask for one analysis goal at a time when templates are large.",
      "Review suggested fixes before applying changes to template files."
    ],
    "anti_patterns": [
      "Do not use it for unrelated EDN data without explaining the expected structure.",
      "Do not rely on counts alone when validating schema quality.",
      "Do not apply generated fixes without checking downstream template variants."
    ],
    "faq": [
      {
        "question": "What does this skill analyze?",
        "answer": "It analyzes Logseq EDN database graph templates, including classes, properties, relationships, modules, and variants."
      },
      {
        "question": "Can it compare two template files?",
        "answer": "Yes. It can compare counts, modules, unique classes, unique properties, and variant-specific features."
      },
      {
        "question": "Can it find broken references?",
        "answer": "Yes. It can look for properties that reference missing classes and classes with missing parent references."
      },
      {
        "question": "Does it edit templates automatically?",
        "answer": "No. It reports issues first and only edits files when the user asks for a concrete change."
      },
      {
        "question": "Which tools can use it?",
        "answer": "The report lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "Is it useful for very large templates?",
        "answer": "Yes. Focused prompts work best for very large files because they keep the analysis clear."
      }
    ]
