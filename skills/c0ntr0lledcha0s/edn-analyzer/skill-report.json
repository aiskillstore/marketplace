  "content": {
    "user_title": "Analyze Logseq EDN Templates",
    "value_statement": "Large Logseq database templates are hard to review by hand. This skill summarizes EDN structure, quality issues, and variant differences.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "EDN analyzer",
      "Logseq template analysis",
      "Logseq graph templates",
      "database graph audit",
      "orphaned classes",
      "property distribution",
      "template comparison"
    ],
    "actual_capabilities": [
      "Counts classes, properties, modules, cardinality values, and property types in EDN templates.",
      "Maps class hierarchies and property-to-class relationships for Logseq database graphs.",
      "Finds orphaned classes, orphaned properties, duplicate titles, missing fields, and reference problems.",
      "Compares full and focused template variants to show size and feature differences.",
      "Produces tables, issue lists, and actionable recommendations with file locations when available.",
      "Supports local grep and Babashka examples for users who choose command-line analysis."
    ],
    "limitations": [
      "It depends on readable EDN files and cannot analyze missing or proprietary data.",
      "It does not guarantee Logseq runtime compatibility without testing in Logseq.",
      "Line numbers may require direct file reads because generated EDN can be large.",
      "Command examples require user approval and a trusted local workspace."
    ],
    "use_cases": [
      {
        "title": "Audit a Large Template",
        "description": "Review a Logseq ontology for counts, structure, orphaned items, and missing required fields before release.",
        "target_user": "Data model maintainer"
      },
      {
        "title": "Compare Template Variants",
        "description": "Compare full, CRM, research, content, or event templates to understand feature and size differences.",
        "target_user": "Template author"
      },
      {
        "title": "Clean Graph Imports",
        "description": "Find inconsistent properties, duplicate titles, and broken references before importing a template into Logseq.",
        "target_user": "Knowledge manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Template Summary",
        "scenario": "Start with a high-level view of one EDN template.",
        "prompt": "Analyze [template path] and summarize total classes, properties, property types, and cardinality distribution."
      },
      {
        "title": "Quality Check",
        "scenario": "Find structural problems before publishing a template.",
        "prompt": "Review [template path] for orphaned classes, orphaned properties, duplicates, and missing required fields. Include file locations when available."
      },
      {
        "title": "Variant Comparison",
        "scenario": "Understand differences between two template builds.",
        "prompt": "Compare [full template path] with [variant template path]. Show included modules, excluded modules, size differences, and unique classes."
      },
      {
        "title": "Architecture Audit",
        "scenario": "Plan a refactor for a large Logseq template system.",
        "prompt": "Audit [template path] for module balance, hierarchy depth, property reuse, and type consistency. Prioritize fixes by impact."
      }
    ],
    "output_examples": [
      {
        "input": "Analyze the full Logseq EDN template.",
        "output": [
          "Summary table with total classes, total properties, file size, and line count.",
          "Distribution section for property types and cardinality values.",
          "Issue section that flags orphaned items or confirms no issues were found."
        ]
      },
      {
        "input": "Compare the full template with the CRM template.",
        "output": [
          "Side-by-side comparison of size, class count, property count, and modules.",
          "List of modules included in CRM and modules excluded from CRM.",
          "Short explanation of why the CRM variant is smaller and focused."
        ]
      },
      {
        "input": "Find orphaned properties in this template.",
        "output": [
          "List of unused properties with names and available locations.",
          "Suggested classes for each orphaned property when context supports a fix.",
          "Note when no orphaned properties are found."
        ]
      }
    ],
    "best_practices": [
      "Start with a summary report before asking for targeted fixes.",
      "Provide both full and variant template paths when requesting comparisons.",
      "Review suggested edits manually before changing source templates."
    ],
    "anti_patterns": [
      "Do not run command examples in untrusted repositories.",
      "Do not assume generated counts are current after files change.",
      "Do not ask for automatic fixes without reviewing the issue list."
    ],
    "faq": [
      {
        "question": "What files does this skill analyze?",
        "answer": "It analyzes EDN template files and related module files for Logseq database graphs."
      },
      {
        "question": "Can it compare template variants?",
        "answer": "Yes. Provide two template paths, and it can compare size, modules, classes, properties, and unique features."
      },
      {
        "question": "Does it modify files?",
        "answer": "It can suggest fixes, but file changes should be requested explicitly and reviewed."
      },
      {
        "question": "Does it require command-line tools?",
        "answer": "No. It can use file reading first. Command examples are optional for local workflows."
      },
      {
        "question": "Can it find broken references?",
        "answer": "Yes. It can check class and property references for missing targets when the needed data is available."
      },
