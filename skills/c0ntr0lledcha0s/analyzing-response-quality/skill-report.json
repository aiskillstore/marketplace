  "content": {
    "user_title": "Analyze Claude Response Quality",
    "value_statement": "AI responses can miss requirements, errors, or security concerns. This skill provides structured scoring, gap analysis, and recommendations for better Claude outputs.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "response quality",
      "AI output review",
      "quality analysis",
      "self review",
      "code review checklist",
      "prompt evaluation",
      "completion scoring"
    ],
    "actual_capabilities": [
      "Maps a user request to requirements and checks whether each requirement was addressed.",
      "Scores correctness, completeness, clarity, efficiency, security, and usability on a 1 to 5 scale.",
      "Identifies critical, important, and minor quality issues with impact and recommended fixes.",
      "Provides gap analysis for missing functionality, documentation, validation, and optimization.",
      "Includes templates and examples for structured quality reports."
    ],
    "limitations": [
      "It does not verify live facts unless the agent uses separate research tools.",
      "It cannot execute scripts through the skill metadata because only Read, Grep, and Glob are allowed.",
      "Scores are guidance and still depend on reviewer judgment and available context.",
      "The documentation marks validation scripts as planned, so manual analysis remains primary."
    ],
    "use_cases": [
      {
        "title": "Review Complex Answers",
        "description": "Check whether a long Claude response fully addresses a multi-part request before final delivery.",
        "target_user": "AI assistant operators"
      },
      {
        "title": "Audit Generated Code",
        "description": "Evaluate generated code for missing error handling, security issues, and maintainability risks.",
        "target_user": "Software developers"
      },
      {
        "title": "Standardize QA Reviews",
        "description": "Use a repeatable report format to compare response quality across tasks and reviewers.",
        "target_user": "Team leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Quick Response Review",
        "scenario": "Beginner review",
        "prompt": "Review this Claude response for correctness, completeness, and clarity. List the main strengths, gaps, and next steps: [paste response]"
      },
      {
        "title": "Score Each Quality Dimension",
        "scenario": "Structured review",
        "prompt": "Use the quality scoring framework to rate this response from 1 to 5 for each dimension. Explain each score with evidence: [paste response]"
      },
      {
        "title": "Compare Against Requirements",
        "scenario": "Requirement coverage review",
        "prompt": "Compare this response against the original request. Identify addressed requirements, missing requirements, edge cases, and recommended fixes: [paste request and response]"
      },
      {
        "title": "Full Quality Audit",
        "scenario": "Advanced audit",
        "prompt": "Perform a full quality audit of this Claude output against the original prompt, artifacts, and acceptance criteria. Provide scores, evidence, issue severity, and prioritized remediation."
      }
    ],
    "output_examples": [
      {
        "input": "A Claude answer explains async and await but omits error handling.",
        "output": [
          "Completeness is reduced because error handling is missing.",
          "Recommendation: add failure handling, parallel operation guidance, and common mistakes."
        ]
      },
      {
        "input": "A generated login feature includes password storage and database queries.",
        "output": [
          "Security is weak because password hashing and query safety need review.",
          "Critical fixes should be prioritized before documentation or polish items."
        ]
      },
      {
        "input": "A final project response claims completion but does not mention tests.",
        "output": [
          "Requirement coverage is incomplete because verification evidence is absent.",
          "Next step: add test results, known limitations, and unresolved risks."
        ]
      }
    ],
    "best_practices": [
      "Start by listing the user requirements before scoring the response.",
      "Cite specific evidence for each issue and explain user impact.",
      "Separate critical blockers from minor polish so priorities stay clear."
    ],
    "anti_patterns": [
      "Giving only a single overall score without evidence.",
      "Treating missing context as a failure without stating assumptions.",
      "Marking issues as critical when they do not affect correctness, safety, or task completion."
    ],
    "faq": [
      {
        "question": "Does this skill replace human review?",
        "answer": "No. It structures review and highlights risks, but final judgment stays with the reviewer."
      },
      {
        "question": "Can it review code responses?",
        "answer": "Yes. It includes code quality, security, error handling, and maintainability checks."
      },
      {
        "question": "Does it run automated tests?",
        "answer": "No. The skill metadata allows only Read, Grep, and Glob. Test execution needs separate tool permission."
      },
      {
        "question": "What outputs does it produce?",
        "answer": "It produces scores, requirement coverage, issue lists, gap analysis, and prioritized recommendations."
      },
      {
        "question": "Can it evaluate non-code explanations?",
        "answer": "Yes. It can review clarity, completeness, examples, tone, and usefulness."
      },
      {
        "question": "How should I use the scores?",
        "answer": "Use scores to compare dimensions and guide fixes. Do not treat them as absolute proof of quality."
      }
    ]
