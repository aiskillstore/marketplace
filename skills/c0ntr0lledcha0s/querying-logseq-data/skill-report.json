        "target_user": "Logseq users"
      },
      {
        "title": "Develop plugin data features",
        "description": "Prepare parameterized Datascript queries for plugin features that read structured Logseq data.",
        "target_user": "Logseq plugin developers"
      },
      {
        "title": "Improve slow query designs",
        "description": "Review clause order, pull attributes, and filters to reduce unnecessary work in large graphs.",
        "target_user": "Knowledge graph maintainers"
      }
