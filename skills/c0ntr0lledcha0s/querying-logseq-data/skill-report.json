    "actual_capabilities": [
      "Builds Datalog queries with find, input, and where clauses for Logseq DB graphs.",
      "Explains pull syntax, nested references, reverse references, and selective attributes.",
      "Creates queries using filters, negation, alternatives, aggregations, and reusable rules.",
      "Demonstrates recursive queries for block descendants and class relationships.",
      "Converts simple Logseq queries into full Datalog and advanced query blocks.",
      "Provides parameterized Datascript query patterns for Logseq plugin development."
    ],
    "limitations": [
      "The examples target Logseq DB graphs and may not match older Markdown graph schemas.",
