    "user_title": "Write Clear Technical Documentation",
    "value_statement": "Technical documentation is hard to keep clear, complete, and consistent. This skill helps Claude, Codex, and Claude Code write README files, API references, docstrings, and code comments.",
    "seo_keywords": [
      "Claude documentation skill",
      "Codex documentation writing",
      "Claude Code docstrings",
      "technical documentation",
      "README generator",
      "API documentation",
      "JSDoc templates",
      "Python docstrings",
      "developer docs",
      "code comments"
    ],
    "actual_capabilities": [
      "Creates README outlines with installation, usage, API, configuration, contributing, and license sections.",
      "Provides JSDoc, Python, Go, and Rust documentation templates.",
      "Documents functions, classes, modules, parameters, return values, errors, and examples.",
      "Supplies checklists for clarity, formatting, completeness, links, edge cases, and limitations.",
      "Guides common patterns for options objects, callbacks, and generic types."
    ],
    "limitations": [
      "It does not execute or test example code by itself.",
      "It needs source files or project context for accurate documentation.",
      "Templates may need adjustment for team style guides.",
      "It does not publish documentation sites or manage hosting."
    ],
    "use_cases": [
      {
        "title": "Create a README for a new project",
        "description": "Turn project context into a structured README with setup, usage, examples, configuration, and contribution guidance.",
