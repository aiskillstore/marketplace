    "actual_capabilities": [
      "Explains the Datascript entity-attribute-value model used by Logseq DB graphs.",
      "Describes Logseq value types, reference attributes, and cardinality choices.",
      "Maps common built-in classes and their inheritance relationships.",
      "Explains property namespaces, configuration keys, and Malli validation flow.",
      "Provides adaptable templates for user classes and typed properties."
    ],
    "limitations": [
      "The included references may not reflect changes in later Logseq releases.",
      "The skill does not connect to a graph or inspect live database entities.",
