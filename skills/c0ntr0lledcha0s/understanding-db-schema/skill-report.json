  "content": {
    "user_title": "Understand Logseq Database Schema",
    "value_statement": "Logseq DB graphs can be hard to model when classes, properties, and references overlap. This skill explains the Datascript schema and gives practical patterns for schema design.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Logseq DB schema",
      "Datascript schema",
      "Logseq properties",
      "Datalog queries",
      "Logseq classes",
      "knowledge graph modeling",
      "schema validation"
    ],
    "actual_capabilities": [
      "Explains Datascript EAV attributes, value types, and cardinality used by Logseq DB graphs.",
      "Maps built-in classes such as Page, Tag, Task, Asset, Journal, Query, and Template.",
      "Describes property types, closed values, schema classes, and UI placement options.",
      "Provides reusable templates for custom Logseq classes and custom properties.",
      "Explains node, page, block, tag, parent, and reference relationships.",
      "Links users to Logseq database documentation, DeepWiki notes, and community FAQ resources."
    ],
    "limitations": [
      "It does not execute Datalog queries or inspect a user graph.",
      "It does not modify Logseq files or migrate databases.",
      "It focuses on Logseq DB version concepts, not every legacy graph behavior.",
      "Linked resources may change after the skill is published."
    ],
    "use_cases": [
      {
        "title": "Design a Logseq Knowledge Model",
        "description": "Plan classes, properties, cardinality, and references before adding structured data to a graph.",
        "target_user": "Logseq power user"
      },
      {
        "title": "Build Plugin Data Structures",
        "description": "Understand which namespaces and property patterns fit plugin-defined schema extensions.",
        "target_user": "Logseq plugin developer"
      },
      {
        "title": "Debug Schema Behavior",
        "description": "Trace how built-in classes, property types, and validation rules affect stored entities.",
        "target_user": "Technical support engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Explain a Property Type",
        "scenario": "Beginner user learning Logseq properties.",
        "prompt": "Explain how the Logseq number property type works, including cardinality and closed values."
      },
      {
        "title": "Choose a Class Structure",
        "scenario": "User planning a new structured graph.",
        "prompt": "Help me design Logseq classes and properties for books, authors, ratings, and reading status."
      },
      {
        "title": "Compare Entity Relationships",
        "scenario": "User deciding between links, tags, pages, and blocks.",
        "prompt": "Compare block tags, block refs, parent blocks, and pages in the Logseq DB node model."
      },
      {
        "title": "Review a Schema Plan",
        "scenario": "Advanced user validating a schema before implementation.",
        "prompt": "Review this Logseq schema plan for class inheritance, property cardinality, and validation risks."
      }
    ],
    "output_examples": [
      {
        "input": "I want a rating property with five choices.",
        "output": "Use a number property with single cardinality and closed values from one to five. Keep the title user friendly."
      },
      {
        "input": "Why are pages and blocks both called nodes?",
        "output": "The DB model treats both as node entities. Pages are unique by title and tags, while blocks sit inside page hierarchy."
      },
      {
        "input": "How should a Book class relate to Author?",
        "output": "Create a Book class and attach an author property. Use a node reference when Author should be a reusable entity."
      }
    ],
    "best_practices": [
      "Validate property type and cardinality before adding data to a live graph.",
      "Use built-in classes when they already match the entity purpose.",
      "Keep user-defined and plugin-defined namespaces distinct."
    ],
    "anti_patterns": [
      "Do not treat every page title as a stable unique identifier.",
      "Do not use text properties when a node reference is required.",
      "Do not mix plugin schema names into user namespaces."
    ],
    "faq": [
      {
        "question": "Does this skill read my Logseq graph?",
        "answer": "No. It provides schema guidance from included references and does not inspect local graph data."
      },
      {
