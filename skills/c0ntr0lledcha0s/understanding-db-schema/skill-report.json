  "content": {
    "user_title": "Explain Logseq Datascript Schemas",
    "value_statement": "Logseq DB graphs can be hard to model because classes, properties, and nodes share entities. This skill explains the schema and guides class, property, and query design.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Logseq database schema",
      "Datascript schema",
      "Logseq DB",
      "knowledge graph modeling",
      "Logseq properties",
      "Datalog queries",
      "Logseq classes"
    ],
    "actual_capabilities": [
      "Explain Logseq DB entity, attribute, and value concepts.",
      "Describe built-in classes and inheritance relationships.",
      "Compare property types, validators, cardinality, and closed values.",
      "Provide templates for user classes and typed properties.",
      "Clarify node, page, block, tag, and reference relationships.",
      "Point to public Logseq schema resources when extra context is needed."
    ],
    "limitations": [
      "Does not connect to a user graph or inspect private data.",
      "Does not execute migrations or modify database files.",
      "May need current Logseq docs for version-specific behavior.",
      "Examples are educational and require local validation before production use."
    ],
    "use_cases": [
      {
        "title": "Design plugin data models",
        "description": "Plan classes, properties, and references before writing Logseq plugin code.",
        "target_user": "Logseq plugin developer"
      },
      {
        "title": "Model custom knowledge systems",
        "description": "Choose property types and class inheritance for structured Logseq graphs.",
        "target_user": "Knowledge base architect"
      },
      {
        "title": "Explain DB concepts to teams",
        "description": "Translate Logseq schema terms into clear guidance for documentation and onboarding.",
        "target_user": "Technical writer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Explain the schema basics",
        "scenario": "Beginner orientation",
        "prompt": "Explain how Logseq stores pages, blocks, tags, and properties in its Datascript schema."
      },
      {
        "title": "Choose a property type",
        "scenario": "Property design",
        "prompt": "Help me choose a Logseq property type and cardinality for this data: [describe the data]."
      },
      {
        "title": "Design a class model",
        "scenario": "Schema modeling",
        "prompt": "Design a Logseq class model for [domain]. Include classes, property types, inheritance, and reference relationships."
      },
      {
        "title": "Review schema assumptions",
        "scenario": "Advanced validation",
        "prompt": "Review this proposed Logseq DB model for class inheritance, property cardinality, and validation risks: [describe model]."
      }
    ],
    "output_examples": [
      {
        "input": "I need a property for project priority with fixed choices.",
        "output": [
          "Use a number or default property based on how users sort priority.",
          "Set one value per item unless multiple priorities are valid.",
          "Use closed values to limit entries to the accepted priority set."
        ]
      },
      {
        "input": "How are pages, blocks, and tags related in Logseq DB?",
        "output": "Pages and blocks are both nodes. Tags classify nodes, and references connect nodes through Datascript attributes."
      },
      {
        "input": "Review my Book class idea before I implement it.",
        "output": [
          "Start with a Book class that extends the root class.",
          "Use typed properties for author, ISBN, rating, and status.",
          "Check cardinality before adding closed values or references."
        ]
      }
    ],
    "best_practices": [
      "Start with the built-in class hierarchy before defining custom classes.",
      "Choose property cardinality before adding closed values or validators.",
      "Validate examples against the target Logseq DB version."
    ],
    "anti_patterns": [
      "Treating pages and blocks as unrelated data models.",
      "Using text properties for dates, nodes, or boolean values.",
      "Copying schema examples without checking inheritance and cardinality."
    ],
    "faq": [
      {
        "question": "Can this skill read my Logseq graph?",
        "answer": "No. It provides schema guidance and examples, but it does not inspect private graph data."
      },
      {
        "question": "Does it require network access?",
        "answer": "No for core reference content. It may point to public docs when a user asks for current details."
      },
      {
        "question": "Can it create schema files?",
        "answer": "It can provide templates and guidance, but it does not write database files by itself."
      },
      {
        "question": "Does it support Claude Code and Codex?",
        "answer": "Yes. The report lists Claude, Codex, and Claude Code as supported tools."
      },
      {
        "question": "Can it help with Datalog queries?",
        "answer": "Yes. It can explain relationships and query patterns at a conceptual level."
      },
      {
        "question": "How should I use the templates?",
        "answer": "Adapt the class and property templates, then validate them against your Logseq version."
