  "content": {
    "user_title": "Automate Marketplace Plugin Releases",
    "value_statement": "Marketplace maintainers must release plugins without mixing versions across a shared repository. This skill guides validation, version updates, tags, pushes, and GitHub releases for one plugin at a time.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "plugin marketplace release",
      "marketplace plugin versioning",
      "GitHub release automation",
      "Claude plugin validate",
      "independent plugin versioning",
      "release notes workflow",
      "marketplace.json"
    ],
    "actual_capabilities": [
      "Explains how to release a named plugin with patch, minor, or major version bumps.",
      "Guides validation of one plugin or all plugins before release.",
      "Describes coordinated updates to marketplace and plugin version metadata.",
      "Documents plugin-specific git tags and GitHub release creation.",
      "Shows how release notes and installation instructions are assembled.",
      "Covers troubleshooting for common release errors."
    ],
    "limitations": [
      "Requires the referenced release and validation scripts to exist in the marketplace project.",
      "Requires GitHub CLI authentication and access to push tags and releases.",
      "Does not replace human review of generated release notes or repository changes.",
      "Does not provide the release script source code in this skill package."
    ],
    "use_cases": [
      {
        "title": "Release One Plugin",
        "target_user": "Marketplace maintainer",
        "description": "Create a patch, minor, or major release for one plugin while leaving other plugins unchanged."
      },
      {
        "title": "Validate Before Publishing",
        "target_user": "Plugin author",
        "description": "Run validation checks before publishing a plugin update to reduce failed releases."
      },
      {
        "title": "Maintain Version Documentation",
        "target_user": "Documentation owner",
        "description": "Keep marketplace README version tables and plugin badges aligned with each release."
      }
    ],
    "prompt_templates": [
      {
        "title": "List Plugin Versions",
        "scenario": "Beginner check before release",
        "prompt": "Show me how to list every plugin in this marketplace and summarize the current versions before I choose a release target."
      },
      {
        "title": "Prepare Patch Release",
        "scenario": "Routine bug fix release",
        "prompt": "Guide me through a patch release for the selected plugin. Include validation, version changes, tag naming, and confirmation points."
      },
      {
        "title": "Create Minor Release Notes",
        "scenario": "Feature release with documentation",
        "prompt": "Help me prepare a minor plugin release with concise release notes, installation instructions, and a changelog summary."
      },
      {
        "title": "Audit Multi-Plugin Release Impact",
        "scenario": "Advanced release planning",
        "prompt": "Review this marketplace release plan and identify which files, tags, README sections, and GitHub release steps should change for one plugin only."
      }
    ],
    "output_examples": [
      {
        "input": "Release the ghe plugin with a patch bump for an avatar loading fix.",
        "output": "The assistant identifies the target plugin, confirms the current and new versions, describes validation, and prepares a release summary."
      },
      {
        "input": "List all marketplace plugins before deciding what to release.",
        "output": [
          "The assistant explains how to display plugin names.",
          "It summarizes versions and source locations.",
          "It asks which plugin should be released."
        ]
      },
      {
        "input": "Troubleshoot a failed plugin validation during release.",
        "output": "The assistant points to plugin manifest or structure issues and recommends fixing validation errors before publishing."
      }
    ],
    "best_practices": [
      "Review the working tree and generated release notes before confirming a release.",
      "Validate the target plugin before changing versions, tags, or remote releases.",
      "Use plugin-specific tags so independent plugin versions remain clear."
    ],
    "anti_patterns": [
      "Do not release from a plugin subdirectory when the script expects the marketplace root.",
      "Do not publish with unresolved validation errors or unclear release notes.",
      "Do not use a shared marketplace version when plugins are released independently."
