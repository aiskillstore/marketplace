        "prompt": "Use low-frequency-thread-monitor to read the final review, verify named artifacts only as needed, and separate review results from approval."
      },
      {
        "title": "Multi-Window Governance",
        "scenario": "A controller manages worker, reviewer, and routing steps.",
        "prompt": "Use low-frequency-thread-monitor to classify each thread state, minimize transcript reads, and recommend only the next authorized action from current facts."
      }
    ],
    "output_examples": [
