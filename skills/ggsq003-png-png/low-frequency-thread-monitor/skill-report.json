        "target_user": "Codex controller operator",
        "description": "Monitor a background worker without closing the controller or interrupting active work."
      },
      {
        "title": "Track Review Completion",
        "target_user": "Code reviewer",
        "description": "Schedule checks for a reviewer thread and absorb the final report before deciding next steps."
      },
      {
        "title": "Coordinate Long Research",
        "target_user": "Research coordinator",
        "description": "Use wider intervals for long-running research while still catching final packaging quickly."
      }
