    "prompt_templates": [
      {
        "title": "Review Naming",
        "scenario": "Beginner",
        "prompt": "Review this TypeScript file for unclear names. Suggest clearer names and explain each change briefly."
      },
      {
        "title": "Reduce Duplication",
        "scenario": "Intermediate",
        "prompt": "Find repeated logic in this module. Propose shared helpers or constants that keep behavior unchanged."
      },
      {
        "title": "Simplify Flow",
        "scenario": "Advanced",
        "prompt": "Analyze this function for nested conditionals, mixed abstraction levels, and unnecessary configuration. Return a prioritized cleanup plan."
      },
      {
        "title": "Refactor Architecture",
        "scenario": "Expert",
        "prompt": "Review this feature folder for clean code, dependency injection, error handling, and testability. Propose staged refactors with risks."
      }
    ],
    "output_examples": [
      {
        "input": "A service with duplicated fetch handling and generic error messages.",
        "output": [
          "Extract one fetch helper for response checks.",
          "Use typed error results for network and validation failures.",
          "Keep user and order calls as small wrappers."
        ]
      },
      {
        "input": "A long order-processing function with nested conditions.",
        "output": [
          "Replace nested branches with guard clauses.",
          "Move pricing, validation, and persistence into separate functions.",
          "Add tests before changing behavior."
        ]
      },
      {
        "input": "A project folder organized only by technical layer.",
        "output": [
          "Group files by feature when changes usually happen by feature.",
          "Keep shared utilities small and dependency-free.",
          "Use clear exports to reduce import noise."
        ]
      }
    ],
    "best_practices": [
      "Ask for behavior-preserving changes before requesting large refactors.",
      "Provide real project constraints so recommendations fit the codebase style.",
      "Review generated suggestions with tests and code owners."
    ],
    "anti_patterns": [
      "Requesting broad rewrites without explaining the current behavior.",
