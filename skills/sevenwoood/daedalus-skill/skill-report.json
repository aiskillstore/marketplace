  "content": {
    "user_title": "Turn Product Ideas Into PRDs",
    "value_statement": "Early product ideas are often vague, risky, and hard to turn into a clear plan. Daedalus guides a structured conversation that defines scope, flags risks, compares references, and produces a PRD.",
    "seo_keywords": [
      "Daedalus skill",
      "product requirements document",
      "PRD generator",
      "idea validation",
      "product discovery",
      "Claude",
      "Codex",
      "Claude Code",
      "no-code prototyping",
      "scope planning"
    ],
    "actual_capabilities": [
      "Runs a staged product discovery conversation with clear turn triggers.",
      "Tracks idea summary, preferences, core value, selected path, must-have features, and reminded risks.",
      "Provides threshold assessment, competitor references, compliance prompts, and launch clarity checks in round three.",
      "Helps define V1 scope with up to three must-have features and delayed items.",
      "Generates a Markdown PRD with pain points, scope, risks, action plan, and toolchain recommendations.",
      "Supports save-and-resume summaries and simpler choices when user replies are short."
    ],
    "limitations": [
      "It does not write production code or build user interfaces.",
      "Risk notes are informational and do not replace legal or security review.",
      "Competitor examples are built-in references and may need current market research.",
      "Progress recovery depends on the user saving and pasting the generated summary."
    ],
    "use_cases": [
      {
        "title": "Shape A Founder Idea",
        "description": "Turn a rough startup idea into a scoped first version with costs, risks, and a PRD.",
        "target_user": "Nontechnical founders"
      },
      {
        "title": "Prepare Discovery Notes",
        "description": "Convert early stakeholder input into clearer product direction, feature boundaries, and follow-up questions.",
        "target_user": "Product managers"
      },
      {
        "title": "Plan A Small MVP",
        "description": "Compare lightweight, medium, and full build paths before choosing a practical first experiment.",
        "target_user": "Indie builders"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start From A Vague Idea",
        "scenario": "Beginner idea clarification",
        "prompt": "I have a vague product idea: [describe it]. Guide me through the first Daedalus questions and help me find the core pain point."
      },
      {
        "title": "Define Scope And Risks",
        "scenario": "Intermediate scope control",
        "prompt": "My idea now includes [features]. Help me choose the V1 must-have features, delayed features, and risks I should understand."
      },
      {
        "title": "Generate A PRD",
        "scenario": "Ready to document the product",
        "prompt": "Use our conversation summary to create the final PRD. Include pain points, user profile, scope, risks, first actions, and toolchain recommendations."
      },
      {
        "title": "Stress Test The Plan",
        "scenario": "Advanced product review",
        "prompt": "Review this PRD as a product reviewer. Find unclear assumptions, high-cost features, compliance risks, and a smaller V0.1 path."
      }
    ],
    "output_examples": [
      {
        "input": "A nontechnical founder describes an app for sharing quiet city spots.",
        "output": [
          "Daedalus asks scenario questions before discussing technical form.",
          "It extracts the core pain, preferred experience, and possible product direction.",
          "It later recommends a lightweight validation path and a narrow V1 scope."
        ]
      },
      {
        "input": "A product manager says the idea is ready and asks to start building.",
        "output": [
          "The skill returns a structured PRD with pain points, user profile, design principles, and feature boundaries.",
          "It includes compliance and safety notes, a first action plan, and tool recommendations."
        ]
      }
    ],
    "best_practices": [
      "Begin with one real user scenario before listing features.",
      "Keep V1 to three must-have features or fewer.",
      "Save the progress snapshot before ending a long discovery session."
    ],
    "anti_patterns": [
      "Do not treat its risk notes as formal legal advice.",
      "Do not ask it to replace engineering implementation work.",
      "Do not skip boundary definition before generating the final PRD."
    ],
    "faq": [
      {
        "question": "What does Daedalus create?",
        "answer": "It creates a structured PRD from a guided product discovery conversation."
      },
      {
        "question": "Does it write application code?",
        "answer": "No. It recommends tools and next steps, but it does not build production code."
      },
      {
        "question": "Can nontechnical users use it?",
        "answer": "Yes. The flow explains costs, tool choices, and build paths in plain language."
      },
      {
        "question": "How does it handle risks?",
        "answer": "It flags common compliance and product security risks based on the described features."
      },
      {
        "question": "Can I resume later?",
        "answer": "Yes. Ask for a saved progress summary, then paste it into a future session."
      },
      {
        "question": "Which AI tools support it?",
        "answer": "The report declares support for Claude, Codex, and Claude Code."
      }
    ]
  },
