  "content": {
    "user_title": "Manage Azure Storage Services",
    "value_statement": "Choosing the right Azure Storage service can be hard when options overlap. This skill gives service guidance, MCP and CLI workflows, and SDK references for common storage tasks.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Azure Storage",
      "Blob Storage",
      "Azure Files",
      "Queue Storage",
      "Table Storage",
      "Data Lake Storage",
      "Azure SDK"
    ],
    "actual_capabilities": [
      "Compares Blob Storage, File Shares, Queue Storage, Table Storage, and Data Lake use cases.",
      "Lists Azure MCP storage commands for accounts, containers, blobs, downloads, and uploads.",
      "Provides Azure CLI fallback commands for account, container, and blob operations.",
      "Explains storage account tiers, blob access tiers, and redundancy options.",
      "References SDK package names and quick starts across Python, TypeScript, .NET, Java, Go, and Rust.",
      "Links to Microsoft documentation for Blob Storage, Azure Files, and Queue Storage."
    ],
    "limitations": [
      "It provides guidance and examples, not a complete Azure management interface.",
      "MCP coverage is focused on storage accounts, containers, and blobs.",
      "Examples use placeholders and require valid Azure permissions and account names.",
      "It does not verify live costs, quotas, policies, or access controls."
    ],
    "use_cases": [
      {
        "title": "Select a storage service",
        "description": "Compare Azure Storage options for objects, file shares, queues, NoSQL tables, or analytics workloads.",
        "target_user": "Cloud architect"
      },
      {
        "title": "Inspect blob resources",
        "description": "Use MCP or Azure CLI guidance to list accounts, containers, and blobs before operational work.",
        "target_user": "Cloud operations engineer"
      },
      {
        "title": "Plan SDK integration",
        "description": "Find package names, authentication patterns, and quick starts for Azure Storage application code.",
        "target_user": "Application developer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose a service",
        "scenario": "Beginner planning question",
        "prompt": "Help me choose the best Azure Storage service for my workload. My data type is [type], access pattern is [pattern], and durability need is [need]."
      },
      {
        "title": "Inspect blobs",
        "scenario": "Basic operations with MCP or CLI fallback",
        "prompt": "Guide me through listing storage accounts, containers, and blobs for account [account] and container [container]. Prefer Azure MCP when available."
      },
      {
        "title": "Design storage lifecycle",
        "scenario": "Cost and retention planning",
        "prompt": "Create an Azure Blob Storage tiering and lifecycle plan for data accessed [frequency] and retained for [duration]. Include redundancy guidance."
      },
      {
        "title": "Plan SDK implementation",
        "scenario": "Advanced application integration",
        "prompt": "Design an Azure Storage SDK integration for [language] that uses Entra ID, handles large files, manages errors, and avoids storing account keys."
      }
    ],
    "output_examples": [
      {
        "input": "Which service should host nightly backups and static web assets?",
        "output": "Use Blob Storage. Choose Hot or Cool tiers based on access frequency, and add lifecycle rules for older backup data."
      },
      {
        "input": "I need to inspect a container and download one blob.",
        "output": [
          "Check whether Azure MCP is enabled.",
          "List storage accounts, then containers, then blobs in the selected container.",
          "Download only the requested blob to an approved local path."
        ]
      },
      {
        "input": "How should my Python app upload large files to Azure Storage?",
        "output": "Use the Blob Storage SDK with DefaultAzureCredential. Prefer streaming or chunked transfer patterns and set overwrite behavior explicitly."
      }
    ],
    "best_practices": [
      "Prefer Entra ID and managed identities instead of connection strings or account keys.",
      "Use streaming or chunked transfer patterns for large files.",
      "Choose redundancy, access tiers, and lifecycle rules before production deployment."
    ],
    "anti_patterns": [
      "Do not store storage keys, connection strings, or SAS tokens in prompts or source files.",
      "Do not use Archive tier for data that needs immediate access.",
      "Do not read large files fully into memory when streaming APIs are available."
    ],
    "faq": [
      {
        "question": "Does this skill manage all Azure Storage services?",
        "answer": "It covers Blob Storage, File Shares, Queue Storage, Table Storage, and Data Lake guidance. MCP examples focus mainly on blob operations."
      },
      {
        "question": "Can it run Azure CLI commands for me?",
        "answer": "It provides CLI fallback examples. Any command execution depends on the host tool, user approval, and local Azure authentication."
      },
      {
        "question": "Does it include SDK guidance?",
        "answer": "Yes. It lists packages and quick starts for several languages, including Python, TypeScript, .NET, Java, Go, and Rust."
      },
      {
        "question": "Does it store credentials?",
        "answer": "No. The examples prefer DefaultAzureCredential or Entra ID patterns and use placeholder account names."
      },
      {
        "question": "Can it estimate Azure Storage costs?",
        "answer": "It explains tiers and redundancy choices. It does not calculate live pricing or inspect billing data."
      },
      {
        "question": "Is it useful without Azure MCP?",
        "answer": "Yes. It includes Azure CLI fallback commands and SDK references for manual or application-based workflows."
      }
    ]
  },
