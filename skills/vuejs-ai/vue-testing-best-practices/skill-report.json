  "content": {
    "user_title": "Improve Vue Testing Practices",
    "value_statement": "Vue teams often struggle with brittle component tests, async rendering, and E2E setup choices. This skill gives practical Vue testing patterns for Vitest, Vue Test Utils, Pinia, Teleport, Suspense, and Playwright.",
    "seo_keywords": [
      "Vue testing",
      "Vue 3 testing",
      "Vitest",
      "Vue Test Utils",
      "Playwright E2E",
      "component testing",
      "async components",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Explains Vitest setup choices for Vue 3 and Vite projects.",
      "Shows blackbox component testing patterns with Vue Test Utils.",
      "Covers async component tests with flushPromises and Suspense.",
      "Guides Pinia store setup and Teleport testing edge cases.",
      "Recommends Playwright configuration and locator patterns for E2E tests.",
      "Warns against snapshot-only tests and fragile implementation checks."
    ],
    "limitations": [
      "It does not execute tests or modify project files by itself.",
      "Examples are generic and may need project-specific adaptation.",
      "It focuses on Vue 3 and Vite, not legacy Vue 2 setups.",
      "It does not replace official documentation for exact version changes."
    ],
    "use_cases": [
      {
        "title": "Set Up Vue Unit Tests",
        "description": "Choose Vitest settings, DOM environment, setup files, and scripts for a Vue 3 project.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Fix Brittle Component Tests",
        "description": "Replace implementation-focused assertions with user-visible behavior, emitted events, and stable selectors.",
        "target_user": "QA engineer"
      },
      {
        "title": "Plan E2E Coverage",
        "description": "Design Playwright tests for login flows, product flows, browsers, retries, and CI behavior.",
        "target_user": "Test automation lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review My Test Setup",
        "scenario": "Beginner setup review",
        "prompt": "Review my Vue test setup. Recommend Vitest, Vue Test Utils, environment, scripts, and setup files. Note any risky assumptions."
      },
      {
        "title": "Improve Component Coverage",
        "scenario": "Component test planning",
        "prompt": "Analyze this Vue component test plan. Suggest behavior-focused assertions, useful selectors, async waits, and cases that avoid implementation details."
      },
      {
        "title": "Debug Async Rendering",
        "scenario": "Async component failures",
        "prompt": "Help debug this flaky Vue test. Focus on async setup, Suspense, Teleport, Pinia setup, flushPromises, and event timing."
      },
      {
        "title": "Design Full Test Strategy",
        "scenario": "Advanced test architecture",
        "prompt": "Create a Vue testing strategy for this application. Cover unit, component, composable, store, async, visual, and Playwright E2E coverage."
      }
    ],
    "output_examples": [
      {
        "input": "A Vue component test fails before async content appears.",
        "output": [
          "Identify missing waits around asynchronous rendering.",
          "Recommend flushPromises after mounting the component.",
          "Suggest testing loading, success, and error states separately."
        ]
      },
      {
        "input": "A team relies on large snapshots for component coverage.",
        "output": [
          "Explain why snapshot-only checks give weak confidence.",
          "Recommend visible text, emitted events, accessibility queries, and focused snapshots.",
          "Flag dynamic content that makes snapshots unstable."
        ]
      },
      {
        "input": "A project needs browser-level Vue E2E tests.",
        "output": [
          "Recommend Playwright for cross-browser coverage.",
          "Outline dev server integration, retries, traces, and stable locators.",
          "Separate critical user flows from lower-value visual checks."
        ]
      }
    ],
    "best_practices": [
      "Test visible behavior, public events, and user interactions before internal component state.",
      "Await Vue updates, promises, and browser actions before making assertions.",
      "Use stable selectors and accessible queries that match how users interact."
    ],
    "anti_patterns": [
      "Do not rely on full-component snapshots as the only proof of correctness.",
      "Do not call private methods or inspect internal state unless no public signal exists.",
      "Do not ignore async setup, Teleport, Suspense, or store setup in test fixtures."
    ],
    "faq": [
      {
        "question": "Does this skill write tests for me?",
        "answer": "It provides patterns, review guidance, and example approaches. You still adapt the advice to your application."
      },
      {
        "question": "Which tools does it focus on?",
        "answer": "It focuses on Vitest, Vue Test Utils, Testing Library, Pinia test setup, and Playwright."
      },
      {
        "question": "Can it help with flaky async tests?",
        "answer": "Yes. It explains flushPromises, nextTick, Suspense wrappers, async setup, and reliable assertion timing."
      },
      {
        "question": "Does it cover Vue 2?",
        "answer": "Only lightly. The guidance is mainly for Vue 3 projects using Vite and modern testing tools."
      },
      {
        "question": "Can it replace official documentation?",
        "answer": "No. It summarizes best practices and points to official documentation for exact API details."
      },
      {
        "question": "Is Playwright always required?",
        "answer": "No. The skill recommends Playwright for new E2E suites, but existing Cypress teams may keep Cypress."
      }
    ]
