  "content": {
    "user_title": "Create Clear Internal Communications",
    "value_statement": "Internal updates often become unclear, too long, or hard to act on. This skill helps Claude, Codex, and Claude Code draft structured reports, announcements, newsletters, and change communications.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "internal communications",
      "status report template",
      "company newsletter template",
      "all-company announcement",
      "team update writing",
      "change management communication",
      "policy announcement template"
    ],
    "actual_capabilities": [
      "Draft weekly, monthly, and quarterly status reports with summaries, metrics, blockers, and next steps.",
      "Create company newsletter copy and HTML newsletter structure using the included example template.",
      "Write all-company announcements with context, timelines, action items, and FAQ sections.",
      "Adapt tone and formality for executives, engineers, operations teams, and company-wide audiences.",
      "Plan change management, incident, recognition, and policy communications using documented workflows.",
      "Suggest measurement methods for engagement, comprehension, sentiment, and follow-through."
    ],
    "limitations": [
      "It does not send messages, publish newsletters, or connect to communication platforms.",
      "It depends on the user for accurate dates, metrics, audience details, and approval requirements.",
      "It cannot verify legal, HR, or compliance wording without qualified review.",
      "It provides templates and guidance, not organization-specific communication policy."
    ],
    "use_cases": [
      {
        "title": "Prepare Executive Status Updates",
        "target_user": "Engineering managers",
        "description": "Turn project progress, blockers, and metrics into concise updates for leaders and stakeholders."
      },
      {
        "title": "Publish Company Newsletters",
        "target_user": "People operations teams",
        "description": "Create recurring newsletters that combine announcements, recognition, events, and learning resources."
      },
      {
        "title": "Communicate Process Changes",
        "target_user": "Operations leaders",
        "description": "Explain policy or workflow changes with rationale, effective dates, required actions, and support resources."
      }
    ],
    "prompt_templates": [
      {
        "title": "Draft a Simple Team Update",
        "scenario": "Beginner prompt for a short recurring update.",
        "prompt": "Create a team update for [team]. Include wins, current priorities, blockers, next steps, and owners. Use a concise, semi-formal tone."
      },
      {
        "title": "Create a Status Report",
        "scenario": "Intermediate prompt for stakeholder reporting.",
        "prompt": "Write a [weekly/monthly] status report for [project]. Use these facts: [facts]. Include metrics, risks, help needed, and upcoming priorities."
      },
      {
        "title": "Plan a Policy Announcement",
        "scenario": "Advanced prompt for a sensitive organization-wide change.",
        "prompt": "Draft a policy announcement for [change]. Include background, effective date, affected groups, required actions, timeline, FAQ, and review checkpoints."
      },
      {
        "title": "Build a Change Communication Sequence",
        "scenario": "Advanced prompt for multi-step communication planning.",
        "prompt": "Design a communication plan for [change]. Include pre-announcement alignment, launch message, follow-up cadence, feedback channels, success metrics, and owner assignments."
      }
    ],
    "output_examples": [
      {
        "input": "A product team needs a weekly update with two wins, one blocker, and next week priorities.",
        "output": "A concise status report with an executive summary, key wins, blocker owner, mitigation plan, and clear priorities for the next week."
      },
      {
        "input": "HR needs to announce a new hybrid work policy that starts next quarter.",
        "output": "An announcement with the policy summary, rationale, effective date, employee actions, manager guidance, timeline, and FAQ prompts."
      },
      {
        "input": "Leadership wants a monthly company newsletter with milestones, recognition, and events.",
        "output": "A structured newsletter draft with leadership note, company updates, team spotlights, new hires, upcoming events, and closing reminders."
      }
    ],
    "best_practices": [
      "Lead with the most important information, then add context and supporting details.",
      "Name owners, deadlines, and action items so readers know what to do next.",
      "Match the channel, tone, and length to the audience and message urgency."
    ],
    "anti_patterns": [
      "Do not hide decisions, risks, or deadlines near the end of a long message.",
      "Do not use vague ownership, unclear timelines, or action items without context.",
      "Do not reuse the same tone for policy changes, incidents, celebrations, and chat updates."
    ],
    "faq": [
      {
        "question": "Can this skill write full internal messages?",
        "answer": "Yes. It can draft status reports, announcements, newsletters, policy updates, team updates, and recognition messages from your inputs."
      },
      {
        "question": "Does it publish messages automatically?",
        "answer": "No. It creates drafts, templates, plans, and review checklists. A user must send or publish the final communication."
      },
      {
        "question": "Can it adjust tone for different audiences?",
        "answer": "Yes. It includes guidance for executive, team, company-wide, formal, semi-formal, and informal communication contexts."
      },
      {
        "question": "Does it include measurement guidance?",
        "answer": "Yes. It includes references for engagement, comprehension, sentiment, behavioral follow-through, and communication audits."
      },
      {
        "question": "Is it suitable for incident communications?",
        "answer": "Yes. It includes guidance for incident updates, post-incident summaries, timelines, impact statements, and action items."
      },
      {
        "question": "What information should I provide?",
        "answer": "Provide the audience, purpose, facts, dates, metrics, owners, required actions, tone, and any approval constraints."
      }
    ]
  },
