    "actual_capabilities": [
      "Separates pure combat calculations from workflow state updates.",
      "Defines a five-step damage pipeline for hit checks, base damage, elements, critical hits, and defense.",
      "Explains mitigation order for invulnerability, reflection, curse, shield, and guts survival.",
      "Guides creation of status effects, damage over time effects, and combat phases.",
      "Provides TypeScript-oriented interface and function patterns for SHINOBI WAY combat code."
    ],
    "limitations": [
      "Focused on the SHINOBI WAY combat architecture and naming conventions.",
