  "content": {
    "user_title": "Manage Implementation Contracts",
    "value_statement": "Parallel coding tasks often drift when interfaces are unclear. This skill guides agents to define, store, implement, verify, and revise shared contracts.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "implementation contracts",
      "software interface contracts",
      "parallel coding tasks",
      "contract lifecycle management",
      "task dependency management",
      "software architecture workflow",
      "contract verification"
    ],
    "actual_capabilities": [
      "Defines cross-task interface contracts during architecture design.",
      "Stores compact contract files under memory/contracts for shared access.",
      "Guides implementers to read contracts before coding and report their role.",
      "Checks provider and consumer behavior against contract specifications.",
      "Supports modify, extend, or reject decisions when contract changes are requested.",
      "Documents interface, data structure, API, and event contract formats."
    ],
    "limitations": [
      "It does not run tests or enforce contracts automatically.",
      "It depends on accurate task descriptions and contract definitions.",
      "It is for software implementation contracts, not legal agreements.",
      "It requires workspace access to read, write, and glob contract files."
    ],
    "use_cases": [
      {
        "title": "Define Shared Interfaces",
        "description": "Create clear contracts before separate implementation tasks begin.",
        "target_user": "Software architects"
      },
      {
        "title": "Coordinate Parallel Work",
        "description": "Materialize contract files so providers and consumers share one source of truth.",
        "target_user": "Task executors"
      },
      {
        "title": "Resolve Contract Blocks",
        "description": "Review requested changes, assess affected tasks, and choose a compatible resolution.",
        "target_user": "Implementation leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Identify Needed Contracts",
        "scenario": "Beginner planning",
        "prompt": "Review this design and list every cross-task dependency that needs a contract. For each contract, name the provider, consumers, and purpose."
      },
      {
        "title": "Create Contract Files",
        "scenario": "Executor setup",
        "prompt": "Turn these approved contract descriptions into compact contract files under memory/contracts. Include version, status, source design, definition, consumers, and history."
      },
      {
        "title": "Verify Implementation Fit",
        "scenario": "Implementation review",
        "prompt": "Compare this implementation report with the relevant contracts. Identify missing methods, unsupported consumer usage, type mismatches, and required follow-up work."
      },
      {
