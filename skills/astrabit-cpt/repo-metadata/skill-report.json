  "content": {
    "user_title": "Generate Repository Metadata",
    "value_statement": "Service catalog metadata is hard to keep consistent across repositories. This skill analyzes repo structure and creates catalog-info.yaml guidance for service catalogs.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "catalog-info.yaml",
      "Backstage catalog",
      "repository metadata",
      "service catalog",
      "architecture documentation",
      "dependency mapping",
      "AI coding skills"
    ],
    "actual_capabilities": [
      "Generates catalog-info.yaml metadata using Astrabit and Backstage-style component fields.",
      "Detects runtime and framework from package files such as package.json, pyproject.toml, and go.mod.",
      "Scans source patterns for HTTP clients, Kafka usage, gRPC clients, and database libraries.",
      "Infers component type as service, gateway, worker, library, frontend, or database.",
      "Provides example metadata templates for gateway, worker, library, and full component files.",
      "Outputs YAML or JSON from a local script for review before adding metadata."
    ],
    "limitations": [
      "Domain and owner may remain unknown and need user input.",
      "Relationship detection uses simple pattern matching and can miss dynamic integrations.",
      "Generated metadata should be reviewed before it is written to a repository.",
      "The local script does not validate metadata against a formal schema."
    ],
    "use_cases": [
      {
        "title": "Create service catalog entries",
        "target_user": "Platform engineer",
        "description": "Generate consistent component metadata when onboarding repositories into a service catalog."
      },
      {
        "title": "Document service dependencies",
        "target_user": "Service owner",
        "description": "Map runtime, framework, dependencies, APIs, events, and routes for one repository."
      },
      {
        "title": "Prepare architecture reviews",
        "target_user": "Architecture lead",
        "description": "Standardize repository metadata before comparing services across teams."
      }
    ],
    "prompt_templates": [
      {
        "title": "Create Basic Metadata",
        "scenario": "Beginner repository onboarding",
        "prompt": "Generate catalog-info.yaml metadata for this repository. Inspect README, package files, and obvious integrations. Ask me for unknown owner or domain."
      },
      {
        "title": "Review Existing Metadata",
        "scenario": "Check a current catalog entry",
        "prompt": "Review the existing catalog-info.yaml. Check required fields, service type, owner, domain, dependencies, APIs, events, and routes."
      },
      {
        "title": "Detect Integrations",
        "scenario": "Improve inferred dependencies",
        "prompt": "Analyze this repository for service catalog metadata. Cross-check code patterns, documentation, and package files. Explain each inferred dependency and missing field."
      },
      {
        "title": "Prepare Catalog Update",
        "scenario": "Advanced metadata and documentation alignment",
        "prompt": "Generate or update catalog-info.yaml for this repository and align README and INTEGRATIONS.md references. Present changes for review before writing files."
      }
    ],
    "output_examples": [
      {
        "input": "Generate metadata for a NestJS API gateway repository.",
        "output": "A reviewed component summary identifies gateway type, Node.js runtime, NestJS framework, platform ownership, downstream service dependencies, and route entries."
      },
      {
        "input": "Review my existing worker metadata before publication.",
        "output": "The review flags missing owner, incomplete Kafka consumer topics, and a domain value that needs confirmation."
      },
      {
        "input": "Create service catalog metadata for a shared library.",
        "output": "The generated recommendation classifies the repository as a library, records SDK-style APIs, and avoids service routes or event consumers."
      }
    ],
    "best_practices": [
      "Review inferred owner, domain, and lifecycle with the responsible team.",
      "Confirm dependencies and API relationships against source code and current documentation.",
      "Run generation from the intended repository root and review output before writing files."
    ],
    "anti_patterns": [
      "Do not accept unknown owner or domain for production catalog entries.",
      "Do not treat pattern-based integration detection as a complete dependency inventory.",
      "Do not publish metadata that conflicts with README, INTEGRATIONS.md, or architecture documentation."
    ],
    "faq": [
      {
        "question": "What file does this skill help create?",
        "answer": "It helps create catalog-info.yaml files for repository metadata and service catalog workflows."
      },
      {
        "question": "Does it follow Backstage conventions?",
        "answer": "Yes. It uses Backstage-style component metadata with Astrabit-specific catalog extensions."
      },
      {
        "question": "Can it detect every dependency automatically?",
        "answer": "No. It uses pattern detection, so owners should verify dependencies and integration details."
      },
      {
        "question": "Does it choose owner and domain automatically?",
        "answer": "It can infer values from repository names, but unknown or important values need human review."
      },
      {
        "question": "Can Claude, Codex, or Claude Code use it?",
        "answer": "Yes. The skill metadata lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "Should generated metadata be reviewed before publishing?",
        "answer": "Yes. Review service type, ownership, dependencies, APIs, events, and routes before committing metadata."
      }
