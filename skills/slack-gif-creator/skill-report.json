  "content": {
    "user_title": "Create Slack-Ready Animated GIFs",
    "value_statement": "Slack GIFs can fail when dimensions, file size, or frame timing are wrong. This skill helps create, optimize, and validate GIFs for Slack.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Slack GIF creator",
      "Slack animated GIF",
      "Slack emoji GIF",
      "Pillow GIF builder",
      "GIF optimization",
      "animation easing",
      "Slack emoji validation"
    ],
    "actual_capabilities": [
      "Builds GIFs from Pillow or NumPy frames with a reusable GIFBuilder class.",
      "Optimizes Slack emoji GIFs to 128 by 128 pixels and reduced color counts.",
      "Validates GIF dimensions, frame count, duration, and file size details.",
      "Provides easing helpers for bounce, elastic, back, and arc motion effects.",
      "Includes drawing helpers for gradients, circles, stars, and centered text.",
      "Documents Slack-specific animation constraints and file size tradeoffs."
    ],
    "limitations": [
      "It does not include prebuilt animation templates or a bundled asset library.",
      "It requires local Python dependencies, including Pillow, imageio, and NumPy.",
      "Text drawing uses the default Pillow font unless custom font logic is added.",
      "It creates files only through local Python code that the user runs."
    ],
    "use_cases": [
      {
        "title": "Team Reaction Emoji",
        "target_user": "Team administrators",
        "description": "Create small animated emoji GIFs that meet Slack dimension and color requirements."
      },
      {
        "title": "Product Launch Animation",
        "target_user": "Marketing teams",
        "description": "Build short branded message GIFs with polished motion, gradients, and optimized file size."
      },
      {
        "title": "Design Prototype Motion",
        "target_user": "Designers and prototypers",
        "description": "Explore bounce, pulse, slide, fade, and particle effects before producing a final GIF."
      }
    ],
