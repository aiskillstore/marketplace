      },
      {
        "title": "Custom Motion System",
        "scenario": "Advanced request for complex animation behavior.",
        "prompt": "Create a Slack GIF with a bouncing logo, particle burst, and fade out. Explain the frame choices and validation results."
      }
    ],
    "output_examples": [
      {
        "input": "Create a Slack emoji GIF of a spinning blue star.",
        "output": "A 128 by 128 animated GIF with a blue star, smooth rotation, reduced colors, and a Slack validation summary."
      },
      {
        "input": "Make a launch announcement GIF for Slack.",
        "output": "A short message GIF with gradient background, animated shapes, optimized frame count, and file size guidance."
      },
      {
        "input": "Can you make this uploaded image bounce as a Slack emoji?",
        "output": "An emoji-sized GIF derived from the image, using bounce easing and a report on dimensions, frames, and duration."
      }
    ],
    "best_practices": [
      "Use 128 by 128 pixels for emoji GIFs and validate the result before upload.",
      "Keep emoji animations under three seconds with moderate frame counts.",
      "Use fewer colors and duplicate frame removal when file size is too large."
    ],
    "anti_patterns": [
