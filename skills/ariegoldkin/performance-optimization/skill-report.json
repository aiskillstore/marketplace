  "content": {
    "user_title": "Improve application performance across your stack",
    "value_statement": "Slow applications are difficult to diagnose when bottlenecks span the database, API, cache, and browser. This skill provides practical patterns and checklists to identify and improve common performance issues.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "performance optimization",
      "database query optimization",
      "Redis caching",
      "React performance",
      "API optimization",
      "Core Web Vitals",
      "Prometheus metrics"
    ],
    "actual_capabilities": [
      "Defines Core Web Vitals and backend response-time targets.",
      "Provides database patterns for indexes, N+1 queries, pagination, and connection pooling.",
      "Shows cache-aside, cache invalidation, and memoization examples.",
      "Includes React code splitting, memoization, virtualization, and layout batching patterns.",
      "Covers API field selection, compression, ETags, and pagination.",
      "Supplies a monitoring checklist and Prometheus metrics reference."
    ],
    "limitations": [
      "Does not profile a running application or collect production telemetry.",
      "Examples require adaptation for the application framework and data model.",
      "Does not replace load testing, security review, or database backup procedures.",
      "Performance targets are general guidance and may not fit every workload."
    ],
    "use_cases": [
      {
        "title": "Investigate slow database requests",
        "description": "Use query, index, pagination, and pooling patterns to plan improvements for slow data access.",
        "target_user": "Backend developers"
      },
      {
        "title": "Reduce browser loading and rendering cost",
        "description": "Apply code splitting, memoization, virtualization, and Web Vitals checks to a React frontend.",
        "target_user": "Frontend developers"
      },
      {
        "title": "Prepare a release performance checklist",
        "description": "Review API, caching, bundle, database, and monitoring readiness before a high-traffic launch.",
        "target_user": "Engineering leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find a likely bottleneck",
        "scenario": "Beginner",
        "prompt": "My application feels slow. Help me classify the likely bottleneck as database, API, frontend, network, CPU, or memory. Ask for the minimum measurements needed."
      },
      {
        "title": "Improve a slow query",
        "scenario": "Intermediate",
        "prompt": "Review this query plan and suggest safe index, N+1, pagination, or pooling improvements. Explain the expected trade-offs and validation steps: [paste plan]."
      },
      {
        "title": "Design a cache strategy",
        "scenario": "Intermediate",
        "prompt": "Design a cache-aside strategy for [resource]. Include cache keys, TTL selection, invalidation events, consistency trade-offs, and metrics to monitor."
      },
      {
        "title": "Create a performance improvement plan",
        "scenario": "Advanced",
        "prompt": "Create a prioritized full-stack performance plan for this system: [architecture and metrics]. Cover database, cache, API, frontend, and monitoring. Include baselines, success criteria, risks, and rollout steps."
      }
    ],
    "output_examples": [
      {
        "input": "A dashboard takes three seconds to load and renders a list of 10,000 records.",
        "output": [
          "Measure API latency, query time, bundle size, and render duration first.",
          "Use pagination or virtualization for the list, then compare render time against the baseline.",
          "Set a target and monitor the affected Web Vitals after release."
        ]
      },
      {
        "input": "Database requests show repeated queries for related records.",
        "output": [
          "Identify the repeated relation lookup as a possible N+1 query.",
          "Test eager loading or a join, then compare query count and total duration.",
          "Confirm that the added index and query shape do not regress writes."
        ]
      }
    ],
    "best_practices": [
      "Capture a baseline before changing code, queries, or infrastructure.",
      "Change one bottleneck at a time and measure the resulting latency, throughput, and resource use.",
      "Validate optimizations with representative traffic and production monitoring."
    ],
    "anti_patterns": [
      "Do not add caching without defining invalidation and consistency requirements.",
      "Do not add indexes without checking query plans and write overhead.",
      "Do not optimize based only on intuition or a synthetic local workload."
    ],
    "faq": [
      {
        "question": "Does this skill run performance tests?",
        "answer": "No. It provides analysis guidance, patterns, and checklists. You must run profiling and load-testing tools in your environment."
      },
      {
        "question": "Which application layers does it cover?",
        "answer": "It covers database access, caching, frontend rendering, API responses, and monitoring."
      },
      {
        "question": "Is the caching example production-ready?",
        "answer": "It is a starting pattern. Define authorization, invalidation, error handling, connection configuration, and data consistency for your application."
      },
      {
        "question": "Can it help with React applications?",
        "answer": "Yes. It includes examples for lazy loading, memoization, virtualization, and avoiding layout thrashing."
      },
      {
        "question": "Can it diagnose a specific slow query?",
        "answer": "Yes. Provide the query plan, schema context, workload, and relevant metrics for targeted guidance."
      },
      {
        "question": "Does it guarantee performance improvements?",
        "answer": "No. Results depend on workload, architecture, infrastructure, and validation against a measured baseline."
      }
    ]
