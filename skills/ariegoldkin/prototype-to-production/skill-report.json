    "value_statement": "Prototype handoff often leaves teams with static HTML and unclear component boundaries. This skill turns prototypes into typed, accessible components with reusable design tokens.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "prototype to production",
      "HTML to React",
      "Figma export conversion",
