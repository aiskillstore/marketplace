    "user_title": "Convert Prototypes into Frontend Components",
    "value_statement": "Teams often spend time rebuilding prototype markup into maintainable components. This skill turns HTML, CSS, and Figma exports into typed frontend components with tokens and accessibility guidance.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "prototype to production",
      "React components",
      "TypeScript components",
      "design tokens",
      "Figma export",
      "HTML to React",
      "frontend automation"
    ],
    "actual_capabilities": [
      "Detects HTML, super-design, and Figma export inputs from file patterns.",
      "Maps project framework, TypeScript, and styling signals from package files.",
      "Extracts colors, typography, spacing, radius, shadows, and animation tokens.",
      "Generates React and TypeScript component templates with typed props and refs.",
      "Converts common HTML attributes, events, forms, lists, images, and accessibility patterns.",
      "Provides integration guidance for file placement, imports, dependencies, and usage."
    ],
    "limitations": [
      "It provides guidance and templates, but it does not run visual diff testing.",
      "Non-React output requires adaptation because React and TypeScript are the documented default.",
      "Extracted design tokens still need human review for naming and brand accuracy.",
      "It does not validate asset licenses or third-party design rights."
    ],
    "use_cases": [
      {
        "title": "Convert a Prototype Screen",
        "target_user": "Frontend developer",
        "description": "Turn a static HTML or super-design screen into typed React components that match the target project."
      },
      {
        "title": "Start a Design System Pass",
        "target_user": "Design systems engineer",
        "description": "Extract repeated colors, spacing, typography, and variants from prototypes before creating shared component APIs."
      },
      {
        "title": "Productionize a Proof of Concept",
        "target_user": "Product engineer",
        "description": "Refactor prototype markup into maintainable components with accessibility, props, and integration notes."
      }
    ],
    "prompt_templates": [
      {
        "title": "Convert One Prototype",
        "scenario": "Beginner conversion from one source file.",
        "prompt": "Use prototype-to-production on this HTML file. Identify the main components and create React TypeScript output that follows the project style."
      },
      {
        "title": "Extract Design Tokens",
        "scenario": "Intermediate token discovery before component work.",
        "prompt": "Analyze this prototype CSS and inline styling. Summarize reusable colors, typography, spacing, radius, shadow, and animation tokens."
      },
      {
        "title": "Build Variant Components",
        "scenario": "Advanced conversion for repeated UI patterns.",
        "prompt": "Find repeated buttons, cards, and form controls in this prototype. Create component APIs with variants, sizes, disabled states, and loading states."
      },
      {
        "title": "Plan Production Integration",
        "scenario": "Advanced handoff for an existing codebase.",
        "prompt": "Convert this prototype for the current repository. Include component placement, imports, dependencies, accessibility checks, and follow-up review steps."
      }
    ],
    "output_examples": [
      {
        "input": "A super-design screen with a header, product cards, and action buttons.",
        "output": [
          "A component breakdown with Header, ProductCard, Button, and PageSection.",
          "A token summary for primary colors, spacing values, shadows, and radius values.",
          "Integration notes for file placement, imports, and accessibility review."
        ]
      },
      {
        "input": "A Figma export with absolute positioning and repeated form controls.",
        "output": [
          "A recommendation to replace absolute layout with responsive component structure.",
          "Reusable input, label, helper text, and form field component definitions.",
          "Notes about keyboard behavior, labels, and error state handling."
        ]
      },
      {
        "input": "A legacy HTML mockup with inline styles and simple interactions.",
        "output": [
          "A conversion plan for attributes, event handlers, lists, forms, and images.",
          "A styling plan that moves repeated values into reusable tokens.",
          "A review checklist for responsive layout and visual parity."
        ]
      }
    ],
    "best_practices": [
      "Provide source prototype files and target project conventions together.",
      "Ask for token extraction before final component generation.",
      "Review accessibility and interaction states before merging generated components."
    ],
    "anti_patterns": [
      "Do not treat prototype class names as final production APIs.",
      "Do not skip human review for responsive behavior and visual parity.",
      "Do not convert large pages into one monolithic component."
    ],
    "faq": [
      {
        "question": "Does this skill only support React?",
        "answer": "React and TypeScript are the documented default. Other frameworks need adaptation from the generated guidance."
      },
      {
        "question": "Can it use Figma exports?",
        "answer": "Yes. It can analyze Figma export patterns and recommend reusable component structure."
      },
      {
        "question": "Does it install dependencies?",
        "answer": "No. It provides conversion guidance, templates, and integration notes for the current project."
      },
      {
        "question": "Does it verify visual accuracy?",
        "answer": "No. Visual parity still requires browser review, design review, or screenshot testing."
      },
      {
        "question": "Can it extract design tokens?",
        "answer": "Yes. It includes a token template for colors, typography, spacing, radius, shadows, and animation."
      },
      {
        "question": "Is it safe for proprietary prototypes?",
        "answer": "Use it with normal repository privacy controls. Review generated components before sharing or publishing them."
      }
    ]
