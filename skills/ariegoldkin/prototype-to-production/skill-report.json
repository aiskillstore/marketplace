        "input": "Extract the visual language from three prototype screens.",
        "output": [
          "A consolidated set of color, typography, spacing, radius, shadow, and animation tokens.",
          "Semantic names connect raw values to interface roles such as brand, text, background, border, and feedback."
        ]
      },
