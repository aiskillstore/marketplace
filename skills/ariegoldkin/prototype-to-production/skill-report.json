        "scenario": "A team wants consistent styles before component generation."
      },
      {
        "title": "Integrate a prototype across a codebase",
        "prompt": "Review the prototype and target project. Detect the stack, decompose the interface, extract tokens, and generate accessible components with placement and dependency guidance.",
        "scenario": "An experienced team needs a full production conversion plan."
      }
    ],
    "output_examples": [
