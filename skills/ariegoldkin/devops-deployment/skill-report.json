  "content": {
    "user_title": "Build reliable DevOps deployment workflows",
    "value_statement": "Teams need consistent guidance for building, testing, and deploying applications. This skill provides DevOps patterns and starter templates for CI/CD, containers, Kubernetes, GitOps, and Terraform.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "DevOps deployment",
      "CI/CD pipeline",
      "Docker",
      "Kubernetes",
      "Terraform AWS",
      "GitOps ArgoCD",
      "GitHub Actions"
    ],
    "actual_capabilities": [
      "Explains a six-stage CI/CD workflow for linting, testing, scanning, building, and deployment.",
      "Provides a multi-stage Node.js Dockerfile and a local Docker Compose development setup.",
      "Provides Kubernetes deployment, service, ingress, autoscaling, and security-context examples.",
      "Provides Helm values and an ArgoCD application template for GitOps deployments.",
      "Provides Terraform examples for an AWS VPC, EKS cluster, and RDS database.",
      "Provides a deployment checklist and rollout strategy guidance."
    ],
    "limitations": [
      "Templates use placeholder names, endpoints, and infrastructure settings that require project-specific review.",
      "The GitHub Actions deployment steps are placeholders and do not perform a real cluster deployment.",
      "The Terraform example is AWS-specific and does not include all required supporting resources.",
      "The skill does not replace security, cost, or compliance review before production use."
    ],
    "use_cases": [
      {
        "title": "Create a delivery pipeline",
        "description": "Adapt the CI/CD stages for a service that needs tests, scans, image publishing, and environment gates.",
        "target_user": "Application developer"
      },
      {
        "title": "Prepare Kubernetes deployment files",
        "description": "Use the manifest and Helm patterns to define secure workloads, services, ingress, and resource limits.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Plan AWS infrastructure",
        "description": "Review the VPC, EKS, and RDS example when starting an AWS infrastructure design.",
        "target_user": "Cloud architect"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a CI/CD plan",
        "scenario": "Beginner",
        "prompt": "Create a simple CI/CD plan for my Node.js service. Include linting, tests, security scanning, image building, and a staging approval step."
      },
      {
        "title": "Containerize an application",
        "scenario": "Intermediate",
        "prompt": "Adapt the Docker guidance for my Node.js application. Recommend a multi-stage build, a non-root runtime user, and a health check."
      },
      {
        "title": "Design Kubernetes resources",
        "scenario": "Intermediate",
        "prompt": "Draft Kubernetes deployment guidance for my API. Include rolling updates, resource requests and limits, a service, ingress, and a restrictive security context."
      },
      {
        "title": "Review production rollout",
        "scenario": "Advanced",
        "prompt": "Review this production rollout plan against the deployment checklist. Identify missing rollback, monitoring, secrets, and approval controls."
      }
    ],
    "output_examples": [
      {
        "input": "I need a CI/CD pipeline for a Node.js API.",
        "output": [
          "A staged pipeline outline for linting, tests, vulnerability scanning, container builds, staging, and production.",
          "A list of repository settings and environment approvals to configure before enabling deployment."
        ]
      },
      {
        "input": "How should I deploy my service to Kubernetes?",
        "output": [
          "A deployment plan with rolling update settings, health checks, resource limits, and a non-root security context.",
          "A checklist for validating the release and preparing a rollback."
        ]
      },
      {
        "input": "Help me plan AWS infrastructure for this service.",
        "output": [
          "A Terraform-oriented plan covering VPC networking, private EKS nodes, an RDS database, state storage, and locking.",
          "Questions to resolve for regions, CIDR ranges, access controls, backups, and costs."
        ]
      }
    ],
    "best_practices": [
      "Review every template value, secret reference, network rule, and permission before deployment.",
      "Pin CI actions and infrastructure module versions to reviewed immutable revisions.",
      "Test rollout and rollback procedures in a non-production environment before release."
    ],
    "anti_patterns": [
      "Do not copy example credentials or expose development databases in a production environment.",
      "Do not enable production deployment without environment protection, monitoring, and a rollback plan.",
      "Do not treat the included Terraform configuration as a complete production infrastructure design."
    ],
    "faq": [
      {
        "question": "What does this skill cover?",
        "answer": "It covers CI/CD, Docker, Kubernetes, Helm, ArgoCD, Terraform, and deployment checklists."
      },
      {
        "question": "Can I use the GitHub Actions file directly?",
        "answer": "Use it as a starting point. Configure repository permissions, deployment commands, and pinned action revisions first."
      },
      {
        "question": "Does it deploy to Kubernetes automatically?",
        "answer": "No. The deployment commands are placeholders that require your cluster and release tooling."
      },
      {
        "question": "Is the Terraform file production-ready?",
        "answer": "No. It is an AWS example that needs environment-specific resources, access controls, and cost review."
      },
      {
        "question": "How should I manage secrets?",
        "answer": "Store secrets in a managed secret system and reference them at runtime. Do not commit real credentials."
      },
      {
        "question": "Which tools can use this skill?",
        "answer": "It supports Claude, Codex, and Claude Code."
      }
    ]
