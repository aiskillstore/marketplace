      {
        "title": "Review Kubernetes readiness",
        "scenario": "Manifest review",
        "prompt": "Use the devops-deployment skill to review my Kubernetes deployment plan. Check probes, resources, rolling update settings, ingress, TLS, and security context choices."
      },
      {
        "title": "Design a GitOps infrastructure rollout",
        "scenario": "Advanced deployment design",
        "prompt": "Use the devops-deployment skill to design a GitOps rollout for an AWS EKS service managed with Terraform and ArgoCD. Include environments, approvals, rollback, and secret handling."
