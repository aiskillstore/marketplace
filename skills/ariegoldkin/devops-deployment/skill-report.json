    "user_title": "Build Deployment Pipelines",
    "value_statement": "Teams need repeatable deployment patterns that cover build, test, release, and rollback steps. This skill gives Claude, Codex, and Claude Code structured templates for CI/CD, containers, Kubernetes, GitOps, and Terraform.",
    "seo_keywords": [
      "Claude DevOps deployment",
      "Codex CI/CD pipeline",
      "Claude Code Kubernetes",
      "Docker deployment templates",
      "Terraform AWS infrastructure",
      "GitOps ArgoCD workflow",
      "CI/CD automation",
      "container deployment",
      "Kubernetes manifests",
      "deployment best practices"
    ],
    "actual_capabilities": [
      "Explains CI/CD pipeline stages for linting, testing, security scans, image builds, and deployments.",
      "Provides Docker and Docker Compose templates for Node.js application packaging and local services.",
      "Provides Kubernetes manifest patterns for deployments, services, ingress, probes, resources, and security contexts.",
      "Provides Terraform examples for AWS VPC, EKS, and RDS infrastructure.",
      "Describes GitOps deployment with ArgoCD sync, pruning, self-healing, and retry behavior.",
      "Includes deployment checklists for pre-deployment, active deployment, and post-deployment validation."
    ],
    "limitations": [
      "Templates use placeholders and must be adapted before production use.",
      "It does not deploy infrastructure or run cloud commands by itself.",
      "It focuses on common Node.js, Kubernetes, AWS, and GitHub Actions patterns.",
      "Security settings still require review against each organization policy."
    ],
    "use_cases": [
      {
        "title": "Create a CI/CD baseline",
        "description": "Generate a staged pipeline for linting, tests, security scanning, container builds, and environment deployments.",
        "target_user": "DevOps engineer"
      },
      {
        "title": "Containerize an application",
        "description": "Use multi-stage Docker patterns and local compose services to prepare an application for container deployment.",
        "target_user": "Backend developer"
      },
      {
        "title": "Plan Kubernetes rollout",
        "description": "Draft manifests and rollout checks for a service that needs probes, resources, ingress, and security context settings.",
        "target_user": "Platform engineer"
      }
    ],
