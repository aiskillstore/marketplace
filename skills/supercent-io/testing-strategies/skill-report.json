    "user_title": "Plan Reliable Testing Strategies",
    "value_statement": "Software teams need clear test coverage before releases and refactors. This skill helps Claude, Codex, and Claude Code plan practical testing layers, tools, and quality gates.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "test pyramid",
      "unit testing",
      "integration testing",
      "E2E testing",
      "TDD",
      "Playwright",
      "Jest"
    ],
    "actual_capabilities": [
      "Defines unit, integration, and E2E test coverage goals.",
      "Explains test pyramid ratios for balanced feedback speed.",
      "Provides TypeScript examples for Jest, Supertest, and Playwright.",
      "Structures test plans with coverage goals, tools, and CI execution rules.",
      "Lists test isolation, deterministic execution, and naming practices."
    ],
    "limitations": [
      "Does not execute tests or inspect runtime results by itself.",
      "Examples focus on common TypeScript, Jest, Supertest, and Playwright workflows.",
      "Requires project context to choose exact coverage goals and tooling.",
      "Does not replace specialized security, performance, or accessibility testing."
    ],
    "use_cases": [
      {
        "title": "Plan New Project Coverage",
        "description": "Create a balanced test strategy before implementation starts, including test layers, coverage goals, and tool choices.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Stabilize Bug-Prone Features",
        "description": "Identify missing unit, integration, and E2E tests around areas that often regress.",
        "target_user": "QA engineers"
      },
      {
        "title": "Prepare CI Quality Gates",
        "description": "Define when tests should run in CI and what failures should block pull requests or releases.",
        "target_user": "DevOps engineers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Basic Test Plan",
        "scenario": "Beginner request for a small feature.",
        "prompt": "Use the testing-strategies skill to create a test plan for a small web feature. Include unit, integration, and E2E coverage."
      },
      {
        "title": "Find Coverage Gaps",
        "scenario": "Intermediate request for an existing module.",
        "prompt": "Review this module description and propose missing unit and integration tests. Include coverage goals and the main risk areas."
      },
      {
        "title": "Design CI Test Gates",
        "scenario": "Advanced request for release automation.",
        "prompt": "Plan a CI testing workflow for a service with API, database, and browser flows. Define triggers, tools, and failure gates."
      },
      {
        "title": "Plan Legacy Refactor Tests",
        "scenario": "Advanced request for a risky migration.",
        "prompt": "Create a testing strategy for refactoring a legacy checkout system. Include characterization tests, mocks, contracts, and rollout safeguards."
      }
    ],
    "output_examples": [
      {
        "input": "Need tests for a new user registration feature.",
        "output": [
          "Unit tests cover validation, duplicate email handling, and password rules.",
          "Integration tests verify database writes and API status codes.",
          "E2E tests cover signup success, invalid email errors, and dashboard redirect."
        ]
      },
      {
        "input": "Need a safer refactor plan for payment logic.",
        "output": [
          "Start with characterization tests for current payment outcomes.",
          "Add focused unit tests for discount, tax, and failure rules.",
          "Use integration tests for payment provider boundaries before release."
        ]
      },
      {
        "input": "Need CI checks before each release.",
        "output": [
          "Run unit tests on every commit and pull request.",
          "Run integration tests on every pull request with isolated test data.",
          "Run E2E tests against staging before deployment approval."
        ]
      }
    ],
    "best_practices": [
      "Start with the test pyramid and keep most checks at the unit level.",
      "Use deterministic tests with isolated data and explicit setup.",
      "Map tests to business risks, not only to code coverage numbers."
    ],
    "anti_patterns": [
      "Relying on slow E2E tests for every small behavior.",
      "Using production databases, services, or credentials in automated tests.",
      "Adding sleeps or fixed timeouts instead of reliable synchronization."
    ],
