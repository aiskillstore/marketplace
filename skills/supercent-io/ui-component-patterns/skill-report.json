    "user_title": "Build Reusable React UI Components",
    "value_statement": "Frontend teams often repeat component decisions across projects. This skill guides Claude, Codex, and Claude Code to design reusable React components with clear props.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "React components",
      "UI component patterns",
      "TypeScript props",
      "design systems",
      "compound components",
      "frontend architecture",
      "component library"
    ],
    "actual_capabilities": [
      "Designs TypeScript props for reusable React components.",
      "Explains composition and compound component patterns.",
      "Separates UI behavior into custom hooks.",
      "Suggests file structures for component libraries.",
      "Adds accessibility, memoization, and performance guidance.",
      "Provides examples for Button, Card, Dropdown, Modal, Accordion, and polymorphic components."
    ],
    "limitations": [
      "Focuses on React and TypeScript examples, not other UI frameworks.",
      "Provides guidance and examples, not a packaged component library.",
      "Does not run tests, lint components, or inspect runtime behavior.",
      "External references are documentation links only."
    ],
    "use_cases": [
      {
        "title": "Create a Component Library",
        "target_user": "Frontend engineer",
        "description": "Plan reusable components with typed props, file structure, examples, and accessibility requirements."
      },
      {
        "title": "Standardize a Design System",
        "target_user": "Design system maintainer",
        "description": "Define consistent patterns for variants, composition, state ownership, and documentation."
      },
      {
        "title": "Refactor Repeated UI",
        "target_user": "Product developer",
        "description": "Convert repeated interface blocks into shared components with clearer APIs and custom hooks."
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a Typed Button",
        "scenario": "Beginner component design",
        "prompt": "Create a typed React Button component plan with variants, sizes, loading state, disabled state, and accessibility notes. Keep the API simple."
      },
      {
        "title": "Refactor Layout Components",
        "scenario": "Intermediate reuse planning",
        "prompt": "Refactor duplicated card layouts into reusable compound components. Explain the props, children slots, and recommended file structure."
      },
      {
        "title": "Design Flexible Data Components",
        "scenario": "Advanced component API design",
        "prompt": "Design a Dropdown component for typed item data. Include render props, selection behavior, keyboard accessibility, and performance considerations."
      },
      {
        "title": "Audit a Design System API",
        "scenario": "Advanced design system review",
        "prompt": "Audit this component API for composition, prop overload, state ownership, ref forwarding, accessibility, and testing gaps. Recommend specific improvements."
      }
    ],
    "output_examples": [
      {
        "input": "I need a reusable Button and Card for a dashboard.",
        "output": [
          "Defines clear props for variants, sizes, loading, disabled state, and class overrides.",
          "Separates Card into header, body, and footer parts for composition.",
          "Adds accessibility notes for labels, keyboard use, and disabled behavior."
        ]
      },
      {
        "input": "Our modal logic is repeated across several pages.",
        "output": [
          "Moves open, close, and toggle behavior into a custom hook.",
          "Keeps the modal component focused on structure, events, and accessible labels.",
          "Suggests tests for state changes, close actions, and keyboard behavior."
        ]
      },
      {
        "input": "Review a component API before adding it to a design system.",
        "output": [
          "Checks whether props are clear, typed, and limited to real use cases.",
          "Identifies where composition is better than more configuration options.",
          "Lists documentation, Storybook, and performance considerations."
        ]
      }
    ],
    "best_practices": [
      "Start with a small typed prop API before adding variants or advanced composition.",
      "Use composition, context, or custom hooks when props become hard to manage.",
      "Include accessibility, file organization, tests, and documentation in each component plan."
    ],
    "anti_patterns": [
      "Do not add many boolean props when a variant or composition model is clearer.",
      "Do not place API calls or complex business rules inside presentational components.",
      "Do not optimize with memoization before identifying real render pressure."
    ],
