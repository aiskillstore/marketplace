  "content": {
    "user_title": "Maintain Release Changelogs",
    "value_statement": "Release updates are hard to track when changes are scattered across tickets and commits. This skill organizes changelogs, release notes, and migration guidance into clear user-facing documents.",
    "seo_keywords": [
      "Claude changelog maintenance",
      "Codex changelog maintenance",
      "Claude Code release notes",
      "AI changelog generator",
      "release notes assistant",
      "semantic versioning guide",
      "Keep a Changelog",
      "migration guide writing",
      "software release documentation",
      "CHANGELOG.md workflow"
    ],
    "actual_capabilities": [
      "Structures CHANGELOG.md with Unreleased, version, date, and change category sections.",
      "Applies Semantic Versioning rules to classify major, minor, and patch releases.",
      "Drafts user-friendly release notes that explain new features, fixes, and security updates.",
      "Builds migration guide sections for breaking API and authentication changes.",
      "Separates developer changelogs, release notes, and migration documents by audience."
    ],
    "limitations": [
      "It does not inspect git history unless the agent separately gathers repository context.",
      "It cannot verify release dates, issue IDs, or version tags without project data.",
      "It provides documentation guidance, not release automation or deployment execution.",
      "It may need product context to translate technical changes for users."
    ],
    "use_cases": [
      {
        "title": "Prepare Product Release Notes",
        "description": "Convert technical changes into user-facing notes before a public launch.",
        "target_user": "Product manager"
      },
      {
        "title": "Maintain Developer Changelogs",
        "description": "Organize fixes, features, and breaking changes into a consistent CHANGELOG.md file.",
        "target_user": "Software developer"
      },
      {
        "title": "Document Breaking Changes",
        "description": "Create migration guidance for API changes, authentication updates, or removed behavior.",
        "target_user": "Technical writer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create Basic Changelog",
        "scenario": "Beginner",
        "prompt": "Create a CHANGELOG.md entry for these changes: [paste changes]. Use Keep a Changelog categories and an Unreleased section."
      },
      {
        "title": "Prepare Release Notes",
        "scenario": "Intermediate",
        "prompt": "Turn this changelog section into user-facing release notes for version [version]. Highlight features, fixes, security updates, and upgrade steps."
      },
      {
        "title": "Classify Version Impact",
        "scenario": "Advanced",
        "prompt": "Review these planned changes and recommend the Semantic Versioning bump. Explain breaking changes, backward-compatible features, and patch fixes."
      },
      {
        "title": "Build Migration Package",
        "scenario": "Advanced release planning",
        "prompt": "Create a release documentation package for version [version]. Include changelog entries, release notes, and a migration guide for breaking changes."
      }
    ],
    "output_examples": [
      {
        "input": "A team ships two-factor authentication, dashboard improvements, and password reset fixes for version 1.2.0.",
        "output": [
          "Changelog sections grouped under Added, Changed, Fixed, and Security.",
          "Release notes that explain the feature value and list key fixes."
        ]
      },
      {
        "input": "An API removes Basic Auth and changes the user list response.",
        "output": "Migration guidance with changed behavior, replacement steps, and a deprecation timeline."
      },
      {
        "input": "A release contains one new endpoint, two bug fixes, and no breaking changes.",
        "output": "Suggested minor version bump with concise changelog entries and user-facing release notes."
      }
    ],
    "best_practices": [
      "Update changelogs during development, not only after a release is finished.",
      "Write entries from the user impact first, then add technical detail when needed.",
      "Document breaking changes with migration steps and deprecation timelines."
    ],
    "anti_patterns": [
      "Do not paste raw git commit logs as release notes.",
      "Do not group all work under vague entries like bug fixes or improvements.",
      "Do not publish breaking changes without upgrade instructions."
    ],
    "faq": [
      {
        "question": "Does this skill follow Keep a Changelog?",
        "answer": "Yes. It uses Added, Changed, Deprecated, Removed, Fixed, and Security sections."
      },
      {
        "question": "Can it recommend a version bump?",
        "answer": "Yes. It applies Semantic Versioning rules to classify major, minor, and patch changes."
      },
      {
        "question": "Can it generate migration guides?",
        "answer": "Yes. It can outline breaking changes, replacement behavior, and upgrade steps."
      },
      {
        "question": "Does it read my repository automatically?",
        "answer": "No. The agent needs relevant changes, commits, issues, or files before drafting accurate content."
      },
      {
        "question": "Is it suitable for user-facing release notes?",
        "answer": "Yes. It helps translate technical changes into release notes focused on user impact."
      },
      {
        "question": "Does it deploy or tag releases?",
        "answer": "No. It only guides documentation for changelogs, release notes, and migration guides."
      }
    ]
  },
