  "content": {
    "user_title": "Implement Frontend State Management",
    "value_statement": "Users often struggle to choose between local state, global stores, and server data caching. This skill gives React patterns for Context, Zustand, Redux Toolkit, and TanStack Query.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "state management",
      "React Context",
      "Redux Toolkit",
      "Zustand",
      "TanStack Query",
      "frontend state",
      "global state"
    ],
    "actual_capabilities": [
      "Classifies local and global state needs for React components.",
      "Shows Context patterns for authentication state and provider hooks.",
      "Provides Zustand store structure for shopping cart state.",
      "Provides Redux Toolkit slice and store examples for larger apps.",
      "Explains TanStack Query usage for server data caching."
    ],
    "limitations": [
      "Does not execute code or install packages by itself.",
      "Examples assume React and TypeScript projects.",
      "Does not replace security review for authentication flows.",
      "Does not design backend APIs or database schemas."
    ],
    "use_cases": [
      {
        "title": "Choose a State Tool",
        "description": "Compare local state, Context, Zustand, Redux Toolkit, and TanStack Query for a feature.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Refactor Props Drilling",
        "description": "Move deeply passed data into scoped global state with clear provider boundaries.",
        "target_user": "React maintainer"
      },
      {
        "title": "Standardize Team Patterns",
        "description": "Create consistent rules for stores, actions, selectors, and server data caching.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose a State Scope",
        "prompt": "Review this component flow and tell me which state should stay local and which should become shared: [describe flow].",
        "scenario": "Beginner planning"
      },
      {
        "title": "Add Context State",
        "prompt": "Design a React Context pattern for [domain state]. Include provider boundaries, hook names, and update actions.",
        "scenario": "Simple global state"
      },
      {
        "title": "Create a Zustand Store",
        "prompt": "Plan a Zustand store for [feature]. Include state shape, actions, persistence needs, and selective subscriptions.",
        "scenario": "Medium complexity state"
      },
      {
        "title": "Compare Advanced Architecture",
        "prompt": "Assess this application state architecture: [summary]. Recommend Redux Toolkit, Zustand, Context, or TanStack Query with migration steps.",
        "scenario": "Advanced architecture review"
      }
    ],
    "output_examples": [
      {
        "input": "A product list needs a shared cart across pages.",
        "output": [
          "Recommends Zustand for medium complexity shared state.",
          "Defines cart items, actions, derived totals, and persistence needs.",
          "Warns to subscribe only to state slices each component uses."
        ]
      },
      {
        "input": "A settings menu passes theme through many components.",
        "output": [
          "Recommends React Context for lightweight shared preferences.",
          "Places the provider near the application shell.",
          "Keeps unrelated form state local to each component."
        ]
      },
      {
        "input": "A user profile page fetches and updates API data.",
        "output": [
          "Recommends TanStack Query for server state and cache invalidation.",
          "Separates API data from client-only UI state.",
          "Describes loading, error, update, and refresh behavior."
        ]
      }
    ],
    "best_practices": [
      "Keep state local until multiple components need the same source.",
      "Use selective subscriptions to reduce unnecessary renders.",
      "Store derived values as calculations instead of separate state."
    ],
    "anti_patterns": [
      "Do not make every value global state.",
      "Do not duplicate the same data across stores and components.",
      "Do not mutate state directly outside supported toolkit helpers."
    ],
    "faq": [
      {
        "question": "Which tools does this skill cover?",
        "answer": "It covers React Context, Zustand, Redux Toolkit, and TanStack Query patterns."
      },
      {
        "question": "Can it help choose between local and global state?",
        "answer": "Yes. It starts with state scope and then maps each need to a suitable tool."
      },
      {
