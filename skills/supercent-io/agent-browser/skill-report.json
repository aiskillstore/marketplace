  "content": {
    "user_title": "Automate Browser Checks for AI Agents",
    "value_statement": "AI agents need repeatable browser actions that provide evidence, not fragile manual steps. This skill guides Claude, Codex, and Claude Code through deterministic navigation, snapshots, screenshots, and form workflows.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "browser automation",
      "agent-browser",
      "web app testing",
      "form automation",
      "screenshot capture",
      "web scraping",
      "AI agent verification"
    ],
    "actual_capabilities": [
      "Opens websites with agent-browser and waits for page load states.",
      "Uses accessibility snapshot refs such as @e1 for deterministic clicks and form fills.",
      "Captures screenshots, annotated screenshots, PDFs, and text snapshots.",
      "Compares snapshots or screenshots against baselines for verification.",
      "Manages isolated browser sessions and saved authentication state.",
      "Applies content boundaries, output limits, domain allowlists, and action policies."
    ],
    "limitations": [
      "Requires the agent-browser CLI and browser dependencies to be installed.",
      "Snapshot refs become stale after navigation or significant DOM changes.",
      "Browser actions can affect real websites, so users must scope domains and permissions.",
      "Authentication state files must be protected outside the skill."
    ],
    "use_cases": [
      {
        "title": "Verify a Web Release",
        "description": "Run a repeatable browser flow after deployment and capture snapshots or screenshots as evidence.",
        "target_user": "Frontend engineer"
      },
      {
        "title": "Automate Form Workflows",
        "description": "Open a form, identify fields with refs, fill values, submit, and verify the resulting page state.",
        "target_user": "QA analyst"
      },
      {
        "title": "Collect Page Evidence",
        "description": "Capture a page snapshot, screenshot, or PDF for research, support, or compliance review.",
        "target_user": "Operations specialist"
      }
    ],
    "prompt_templates": [
      {
        "title": "Open and Inspect a Page",
        "scenario": "Beginner page review",
        "prompt": "Open the target URL, wait until the page is stable, take an interactive snapshot, and summarize the main visible elements."
      },
      {
        "title": "Complete a Form Safely",
        "scenario": "Guided form automation",
        "prompt": "Open this form, snapshot the page, identify the needed fields by ref, fill the provided values, submit, and verify the result."
      },
      {
        "title": "Compare Before and After States",
        "scenario": "Regression verification",
        "prompt": "Capture a baseline snapshot, perform the requested browser action, capture the new state, and explain the differences with evidence."
      },
      {
        "title": "Run a Scoped Authenticated Check",
        "scenario": "Advanced secured workflow",
        "prompt": "Use the existing authentication state, restrict navigation to approved domains, complete the workflow, and capture only the minimum evidence needed."
      }
    ],
    "output_examples": [
      {
        "input": "Verify that the contact form loads and exposes the expected fields.",
        "output": "The result describes the loaded page, lists the detected name, email, and message fields, and notes that a fresh snapshot was captured."
      },
      {
        "input": "Check whether the pricing page changed after a release.",
        "output": "The result explains the baseline capture, the new capture, and the visible differences that need review."
      },
      {
        "input": "Capture evidence for a support case.",
        "output": "The result states where the screenshot and page snapshot were saved and summarizes the relevant visible content."
      }
    ],
    "best_practices": [
      "Take a fresh snapshot after each navigation, submit, modal change, or major DOM update.",
      "Use domain allowlists and action policies before running sensitive or authenticated workflows.",
      "Capture explicit evidence after every important action instead of relying on assumptions."
    ],
    "anti_patterns": [
      "Do not reuse snapshot refs after navigation or a significant page update.",
      "Do not pass secrets directly in prompts or commit saved authentication files.",
      "Do not run broad browser actions on untrusted domains without scoped permissions."
    ],
    "faq": [
      {
        "question": "What does this skill help an AI agent do?",
        "answer": "It helps an agent drive a browser through navigation, snapshots, form actions, captures, and verification steps."
      },
      {
        "question": "Does it require a separate tool?",
        "answer": "Yes. The agent-browser CLI and its browser dependencies must be installed in the environment."
      },
      {
        "question": "How are page elements selected?",
        "answer": "The skill recommends interactive snapshots that expose stable refs such as @e1 for clicks and form inputs."
      },
      {
        "question": "Can it work with authenticated pages?",
        "answer": "Yes, but users should prefer saved state, protected credentials, domain allowlists, and scoped action policies."
      },
      {
        "question": "Can it capture visual evidence?",
        "answer": "Yes. It documents screenshots, annotated screenshots, PDFs, snapshots, and visual diff workflows."
      },
      {
        "question": "What is the main safety concern?",
        "answer": "Browser automation can affect real sites, so users should limit domains, actions, output volume, and credential exposure."
      }
    ]
