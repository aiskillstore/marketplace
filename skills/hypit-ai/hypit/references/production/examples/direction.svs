<?svml using="@hypit/text/svs@1"?>
<sheet version="1" id="performance">
  text-template.performance { separator: paragraph; }
  text-template.performance.block.direction {
    kind: slot;
    order: 10;
    slot: direction;
  }
  text-template.performance.block.dialogue {
    kind: slot;
    order: 20;
    slot: dialogue;
  }
</sheet>
