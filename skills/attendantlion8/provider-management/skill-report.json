  "content": {
    "user_title": "Manage AI Provider Priority and Fallback",
    "value_statement": "Juggling many AI providers means managing separate keys, subscriptions, and usage limits by hand. This skill centralizes provider priority, authentication, and usage limits so requests automatically route to the best available provider and fall back when one runs out.",
    "seo_keywords": [
      "AI provider management",
      "model fallback",
      "provider priority",
      "OAuth authentication",
      "API key management",
      "usage limits",
      "Claude",
      "Codex",
      "Claude Code",
      "multi-provider routing"
    ],
    "actual_capabilities": [
      "Configure authentication for providers using subscription tokens, OAuth 2.0, or direct API keys.",
      "Set and reorder provider priority so requests prefer subscriptions, then OAuth, then API keys.",
      "Define daily and monthly usage limits per provider to control spending.",
      "Automatically fall back to the next available provider when one is over its limit or unavailable.",
      "Display a usage dashboard and current authentication status for each provider.",
      "Map a canonical model name to the correct provider-specific model identifier."
    ],
    "limitations": [
      "The skill documents commands and configuration; it does not itself send model requests.",
      "Users must supply their own valid credentials for each provider they want to use.",
      "Automatic fallback depends on accurate usage limits being configured by the user.",
      "OAuth token refresh depends on the provider supporting a valid refresh flow."
    ],
    "use_cases": [
      {
        "title": "Reduce cost with subscription-first routing",
        "description": "Prefer a paid subscription plan for routine requests and fall back to metered API keys only when the subscription is exhausted.",
        "target_user": "Individual developer with both a subscription and API access"
      },
      {
        "title": "Keep a service running during provider outages",
        "description": "Configure two or three authentication methods per vendor so an outage or limit on one path does not stop the application.",
        "target_user": "Platform engineer running a production AI service"
      },
      {
        "title": "Control team spending with usage limits",
        "description": "Set conservative daily and monthly limits on each provider and monitor consumption through the status dashboard.",
        "target_user": "Engineering manager overseeing a shared AI budget"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check provider status",
        "prompt": "Show me the current authentication status and usage for all my configured providers.",
        "scenario": "Beginner: reviewing the current setup"
      },
      {
        "title": "Add an API key",
        "prompt": "Set up API key authentication for the anthropic-api provider using my key.",
        "scenario": "Beginner: adding a first credential"
      },
      {
        "title": "Set provider priority",
        "prompt": "Set my provider priority so the Anthropic subscription is used first, then the Anthropic API, then Bedrock.",
        "scenario": "Intermediate: ordering fallback paths"
      },
      {
        "title": "Configure limits and fallback",
        "prompt": "Configure a daily limit of one million tokens on the anthropic-api provider and confirm automatic fallback is enabled.",
        "scenario": "Advanced: budget control with automatic failover"
      }
    ],
    "output_examples": [
      {
        "input": "Show me the current authentication status for all providers.",
        "output": "A summary listing each configured provider, its authentication method (subscription, OAuth, or API key), and whether it is currently valid."
      },
      {
        "input": "Set my provider priority to subscription first, then API, then Bedrock.",
        "output": "A confirmation of the new priority order, showing subscription at the highest priority and Bedrock as the final fallback."
      },
      {
        "input": "Show my usage dashboard.",
        "output": "A dashboard showing daily and monthly token usage for each provider against its configured limits."
      }
    ],
    "best_practices": [
      "Configure a subscription as the highest-priority method, then OAuth, then API keys, to match cost and features.",
      "Set conservative usage limits (for example, eighty percent of the real cap) so fallback happens before a hard limit is reached.",
      "Keep two or three authentication methods per vendor so one failure does not stop requests."
    ],
    "anti_patterns": [
      "Do not rely on a single provider with no fallback method configured.",
      "Do not pass secret keys as command-line arguments in shared or logged shells.",
      "Do not set usage limits equal to the exact provider cap, which leaves no room for fallback."
    ],
    "faq": [
      {
        "question": "What authentication methods does this skill support?",
        "answer": "It supports subscription tokens, OAuth 2.0 tokens, and direct API keys. Subscriptions have the highest priority and API keys the lowest."
      },
      {
        "question": "How does automatic fallback work?",
        "answer": "When a provider is unavailable or over its configured usage limit, the system selects the next provider in the priority order that still has capacity."
      },
      {
        "question": "Where are my credentials stored?",
        "answer": "The skill documents a configuration directory under your home folder, with a separate file for stored credentials. Review the documented file permissions before storing secrets."
      },
      {
        "question": "Does the skill send model requests itself?",
        "answer": "No. It manages provider priority, authentication, and limits. Model requests are made by the tool that uses this configuration."
      },
      {
        "question": "Do OAuth tokens refresh automatically?",
        "answer": "The documentation states tokens refresh automatically shortly before expiry when the provider supports a valid refresh flow. A manual refresh command is also available."
      },
      {
        "question": "Which providers and models are supported?",
        "answer": "The documentation lists major model families including Claude, GPT, Gemini, Grok, Llama, DeepSeek, Mistral, Cohere, and Qwen, across providers such as direct APIs, Bedrock, Vertex, and OpenRouter."
      }
    ]
  },
