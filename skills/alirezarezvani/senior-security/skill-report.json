  "content": {
    "user_title": "Strengthen Application Security Reviews",
    "value_statement": "Security reviews often lack consistent checklists and reusable workflows. This skill provides security review scaffolds, reference guidance, and simple reporting scripts for Claude, Codex, and Claude Code.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "security engineering skill",
      "application security audit",
      "threat modeling",
      "penetration testing workflow",
      "security architecture review",
      "cryptography implementation guidance",
      "AppSec automation"
    ],
    "actual_capabilities": [
      "Provides entry points for threat modeling, security auditing, and penetration testing planning.",
      "Validates a target path before running each included Python scaffold script.",
      "Generates a simple status report with target, status, and finding count.",
      "Can print results as JSON or write them to a user-selected output file.",
      "Includes reference guides for architecture patterns, penetration testing, and cryptography topics."
    ],
    "limitations": [
      "The included scripts are scaffolds and do not detect real vulnerabilities by default.",
      "Penetration testing workflows require written authorization and a defined scope.",
      "The reference guides are generic placeholders and need project-specific detail.",
      "This skill does not replace expert security review or formal compliance assessment."
    ],
    "use_cases": [
      {
        "title": "Start a Threat Model",
        "description": "Create a structured first pass over assets, trust boundaries, and likely abuse cases.",
        "target_user": "Security engineer"
      },
      {
        "title": "Standardize AppSec Reviews",
        "description": "Use one repeatable workflow for lightweight application security checks across repositories.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Prepare an Authorized Test",
        "description": "Organize scope, assumptions, and report structure before an approved penetration test.",
        "target_user": "AppSec consultant"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review a Service",
        "scenario": "Beginner application security review",
        "prompt": "Use senior-security to review this service at a high level. Identify assets, trust boundaries, common risks, and next review steps."
      },
      {
        "title": "Create a Threat Model",
        "scenario": "Intermediate design review",
        "prompt": "Build a threat model for this architecture. Cover entry points, data stores, actor goals, mitigations, and open security questions."
      },
      {
        "title": "Plan an Authorized Test",
        "scenario": "Penetration testing preparation",
        "prompt": "Prepare a penetration testing plan for this approved scope. Include boundaries, test phases, expected evidence, and reporting format."
      },
      {
        "title": "Assess Crypto Design",
        "scenario": "Advanced cryptography review",
        "prompt": "Review this cryptography design. Check key handling, algorithm choices, rotation, storage, failure modes, and operational monitoring."
      }
    ],
    "output_examples": [
      {
        "input": "Review a backend service before release.",
        "output": [
          "Summary of exposed entry points and sensitive data paths.",
          "List of likely threats, missing controls, and review questions.",
          "Suggested next actions for owners and security reviewers."
        ]
      },
      {
        "input": "Prepare a scoped penetration testing plan.",
        "output": [
          "Testing objective, approved target list, and explicit exclusions.",
          "Phased workflow for discovery, validation, evidence capture, and reporting.",
          "Safety notes for rate limits, test accounts, and rollback coordination."
        ]
      },
      {
        "input": "Assess a cryptography implementation proposal.",
        "output": [
          "Review of key generation, storage, rotation, and recovery assumptions.",
          "Questions about algorithm choice, library use, and misuse resistance.",
          "Recommended controls for logging, monitoring, and incident response."
        ]
      }
    ],
    "best_practices": [
      "Define authorization, scope, and expected output before using security workflows.",
      "Treat script output as a starting point and verify findings manually.",
      "Store generated reports in a controlled project directory with appropriate access controls."
    ],
    "anti_patterns": [
      "Do not run penetration testing steps against systems without explicit approval.",
      "Do not treat placeholder script results as a complete security assessment.",
      "Do not copy environment templates over real configuration files without review."
    ],
    "faq": [
      {
        "question": "Does this skill run real vulnerability scans?",
        "answer": "No. The included scripts are scaffolds that produce simple reports and need implementation for real scanning."
      },
      {
        "question": "Can I use it with Claude, Codex, and Claude Code?",
        "answer": "Yes. The report lists support for Claude, Codex, and Claude Code workflows."
      },
      {
        "question": "Is the penetration testing guidance safe to use anywhere?",
        "answer": "No. Use it only on systems where you have written authorization and a defined scope."
      },
      {
        "question": "What files can the scripts write?",
        "answer": "They can write a JSON report only when a user provides an output path."
      },
      {
        "question": "Does it replace a security engineer?",
        "answer": "No. It helps organize review work, but expert validation is still required."
