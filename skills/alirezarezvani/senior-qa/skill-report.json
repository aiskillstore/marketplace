    "user_title": "Improve QA Coverage for Web Apps",
    "value_statement": "Modern teams need clear test strategy and practical automation without slowing delivery. This skill helps Claude, Codex, and Claude Code plan tests, review coverage, and scaffold QA workflows.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "QA testing",
      "test automation",
      "coverage analysis",
      "E2E testing",
      "React testing",
      "Next.js testing",
      "quality assurance"
    ],
    "actual_capabilities": [
      "Explains QA strategy, test automation patterns, and best practices for web application teams.",
      "Provides three Python CLI wrappers for test suite generation, coverage analysis, and E2E scaffolding workflows.",
      "Validates a target path and prints a basic status report with target and finding count.",
      "Can write a local JSON report when the user provides an output path.",
      "Documents setup, quality check, troubleshooting, and common project commands for QA work."
    ],
    "limitations": [
      "The included scripts contain placeholder analysis logic and do not generate real tests by themselves.",
      "The skill does not run test suites, inspect coverage files, or integrate with CI services automatically.",
      "Examples focus on React, Next.js, Node.js, and general web QA workflows.",
      "Users must adapt recommendations and commands to their repository, framework, and security rules."
    ],
    "use_cases": [
      {
        "target_user": "QA Lead",
        "title": "Plan Release Test Strategy",
        "description": "Create a focused test plan for critical paths, regression risks, manual checks, and automation priorities before a release."
      },
      {
        "target_user": "Frontend Developer",
        "title": "Review Component Coverage",
        "description": "Identify missing component, integration, and user-flow tests for a React or Next.js feature branch."
      },
      {
        "target_user": "Automation Engineer",
        "title": "Start E2E Workflow Design",
        "description": "Outline E2E scenarios, test data needs, selectors, and maintenance risks before building Playwright or Cypress tests."
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a QA Checklist",
        "scenario": "Beginner request for a small feature or bug fix.",
        "prompt": "Create a QA checklist for this feature. Include functional checks, edge cases, regression areas, and test data needs."
      },
      {
        "title": "Map Test Coverage",
        "scenario": "Intermediate request for improving existing tests.",
        "prompt": "Review this module and map the important unit, integration, and E2E coverage gaps. Prioritize risks before test volume."
      },
      {
        "title": "Design Automation Strategy",
        "scenario": "Advanced request for a team-level automation plan.",
        "prompt": "Design a test automation strategy for this web app. Include layers, ownership, CI expectations, flaky test controls, and reporting."
      },
      {
        "title": "Audit Release Readiness",
        "scenario": "Advanced request before production release.",
        "prompt": "Audit release readiness from a senior QA perspective. Assess critical paths, coverage risks, observability, rollback checks, and manual signoff."
      }
    ],
    "output_examples": [
      {
        "input": "A product team asks for a checkout release QA plan.",
        "output": "A prioritized release checklist covering payment flows, validation errors, account states, browser coverage, rollback checks, and final signoff criteria."
      },
      {
        "input": "A developer asks where to add tests for a new dashboard filter.",
        "output": "A coverage map separating pure filter logic, component behavior, API error states, accessibility checks, and one high-value E2E scenario."
      },
      {
        "input": "An automation engineer asks how to reduce flaky E2E tests.",
        "output": "A stabilization plan covering deterministic data, resilient selectors, network waits, isolation rules, retry policy, and ownership for recurring failures."
      }
    ],
    "best_practices": [
      "Ask for target framework, test runner, and risk areas before producing a test plan.",
      "Treat script output as a starting report, then inspect application code and coverage artifacts.",
      "Prioritize user-visible behavior, critical paths, and regressions over broad but shallow coverage targets."
    ],
    "anti_patterns": [
      "Do not run generated commands against production systems without project owner approval.",
      "Do not assume placeholder script results prove that a project is well tested.",
      "Do not copy environment setup commands without checking local secret handling rules."
    ],
