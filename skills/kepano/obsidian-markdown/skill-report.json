      },
      {
        "title": "Standardize project documentation",
        "description": "Project teams can apply consistent properties, task lists, status fields, and internal links across notes.",
        "target_user": "Project managers"
      },
      {
        "title": "Convert Markdown for a vault",
        "description": "Writers can adapt plain Markdown into Obsidian Flavored Markdown without losing headings, tables, or links.",
