    "value_statement": "PyTorch operators may reject uint16, uint32, and uint64 tensors when dispatch macros omit unsigned types. This skill guides precise AT_DISPATCH_V2 updates for complete unsigned type coverage.",
    "seo_keywords": [
      "PyTorch uint support",
      "AT_DISPATCH_V2",
      "unsigned integer tensors",
      "uint16",
      "uint32",
      "uint64",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Identifies whether an operator already uses AT_DISPATCH_V2.",
      "Explains PyTorch unsigned and integral dispatch type groups.",
      "Chooses between explicit unsigned types and AT_INTEGRAL_TYPES_V2.",
      "Updates multiple CPU or CUDA dispatch sites consistently.",
      "Checks for existing uint support before proposing changes."
    ],
    "limitations": [
      "Old dispatch macros require conversion with a separate skill first.",
      "The skill cannot prove that operator arithmetic supports unsigned values.",
      "It does not compile PyTorch or run functional tests.",
      "It covers uint16, uint32, and uint64, not the kByte uint8 type."
    ],
