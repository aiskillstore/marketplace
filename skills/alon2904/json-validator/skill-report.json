  "content": {
    "user_title": "Validate and Repair JSON Data",
    "value_statement": "Invalid or inconsistent JSON can break APIs, configurations, and data workflows. This skill identifies errors, explains corrections, and produces clean structured output.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "JSON validator",
      "JSON formatter",
      "JSON repair",
      "JSON syntax checker",
      "JSON to YAML",
      "JSON structure analysis"
    ],
    "actual_capabilities": [
      "Identifies common JSON syntax errors and explains their locations.",
      "Formats valid JSON with consistent two-space indentation.",
      "Suggests corrections for trailing commas, quotes, keys, comments, and invalid values.",
      "Converts JSON to YAML, TOML, CSV, or XML while preserving data types.",
      "Summarizes keys, value types, nesting depth, array sizes, and repeated structures."
    ],
    "limitations": [
      "It does not verify data against a formal JSON Schema.",
      "CSV conversion may require decisions about nested objects and arrays.",
      "Key sorting and other structural changes require user confirmation.",
      "Validation quality depends on receiving the complete source data."
    ],
    "use_cases": [
      {
        "title": "Repair API Payloads",
        "description": "Locate syntax errors in request or response bodies and receive corrected JSON with concise explanations.",
        "target_user": "Application developers"
      },
      {
        "title": "Clean Configuration Files",
        "description": "Validate and format configuration data before deployment or version control review.",
        "target_user": "DevOps engineers"
      },
      {
        "title": "Inspect Data Structures",
        "description": "Summarize unfamiliar JSON datasets and identify inconsistent fields, types, or nesting.",
        "target_user": "Data analysts"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check JSON Syntax",
        "prompt": "Validate this JSON. List each error with its line number and explain the required correction: {{json_data}}",
        "scenario": "Beginner syntax validation"
      },
      {
        "title": "Format Valid JSON",
        "prompt": "Validate and format this JSON with two-space indentation. Preserve key order and all value types: {{json_data}}",
        "scenario": "Readable formatting"
      },
      {
        "title": "Repair and Explain",
        "prompt": "Repair this JSON. Show a concise issue list, explain every change, and ask before altering valid structure: {{json_data}}",
        "scenario": "Guided error correction"
      },
      {
        "title": "Analyze and Convert",
        "prompt": "Analyze this JSON structure, report types and nesting, then convert it to {{target_format}}. Explain any flattening decisions: {{json_data}}",
        "scenario": "Advanced structure analysis and conversion"
      }
    ],
    "output_examples": [
      {
        "input": "Validate a payload containing a trailing comma after its final property.",
        "output": "Validation failed on the affected line. Remove the final comma, then validate the corrected payload."
      },
      {
        "input": "Analyze a customer export with records, contact fields, and optional metadata.",
        "output": [
          "Top-level type: array",
          "Each item is a customer object",
          "Metadata is optional and nested",
          "Contact fields use inconsistent value types"
        ]
      },
      {
        "input": "Convert a flat JSON user list to YAML.",
        "output": "A YAML user sequence is returned with identifiers and names preserved in their original types."
      }
    ],
    "best_practices": [
      "Provide complete input so error locations and nesting can be assessed accurately.",
      "Validate before formatting or converting the data.",
      "Confirm optional changes such as key sorting, comment removal, or nested-data flattening."
    ],
    "anti_patterns": [
      "Do not treat repaired output as schema-compliant without a separate schema check.",
      "Do not flatten nested data without defining how arrays and objects should map.",
      "Do not replace the original file until the corrected output has been reviewed."
    ],
    "faq": [
