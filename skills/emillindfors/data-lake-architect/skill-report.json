    "user_title": "Design Reliable Data Lakes",
    "value_statement": "Large data lakes can become slow, expensive, and hard to govern without clear architecture choices. This skill guides partitioning, storage layout, schema evolution, table formats, retention, and cost-aware lakehouse design.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "data lake architecture",
      "lakehouse design",
      "Parquet optimization",
      "Iceberg tables",
      "partitioning strategy",
      "schema evolution",
      "cloud storage layout"
    ],
    "actual_capabilities": [
      "Recommends raw, processed, and curated storage layouts for data lakes.",
      "Chooses partitioning strategies based on query patterns, data volume, and cardinality.",
      "Explains file sizing, compaction, compression, and row group trade-offs.",
      "Compares raw Parquet and Iceberg for schema evolution and operational needs.",
      "Reviews architecture against storage, partitioning, performance, operations, and cost checklists.",
      "Provides practical guidance for retention tiers and lifecycle policies."
    ],
    "limitations": [
      "Does not deploy cloud infrastructure or modify storage systems directly.",
      "Does not run benchmark tests against a live data lake.",
      "Requires user-provided workload, query, and volume details for precise recommendations.",
      "Focuses on architecture guidance, not full application implementation."
    ],
    "use_cases": [
      {
        "title": "Plan a New Lakehouse",
        "description": "Design a layered storage model, table format choice, and partitioning approach before ingestion starts.",
        "target_user": "Data platform architect"
      },
      {
        "title": "Fix Slow Analytical Queries",
        "description": "Review file sizes, partition granularity, compression, and metadata design to reduce query latency.",
        "target_user": "Analytics engineer"
      },
      {
        "title": "Control Data Lake Costs",
        "description": "Create retention tiers, compression choices, and compaction practices for lower storage and scan costs.",
        "target_user": "Data engineering manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review My Layout",
        "scenario": "Beginner review of an existing folder structure.",
        "prompt": "Review this data lake layout and suggest improvements for raw, processed, and curated zones. Ask for any missing details first."
      },
      {
        "title": "Choose Partitions",
        "scenario": "Intermediate partition planning for analytical tables.",
        "prompt": "Help me choose partition columns for a table with these query patterns, daily volume, and cardinality details. Explain the trade-offs."
      },
      {
        "title": "Select a Table Format",
        "scenario": "Advanced decision between Parquet and Iceberg.",
        "prompt": "Compare raw Parquet and Iceberg for my workload. Consider schema evolution, concurrent writers, update needs, metadata cost, and team operations."
      },
      {
        "title": "Audit a Lakehouse Architecture",
        "scenario": "Advanced end-to-end architecture assessment.",
        "prompt": "Audit this lakehouse architecture for scalability, cost, retention, compaction, schema evolution, and query performance. Return prioritized recommendations."
      }
    ],
    "output_examples": [
      {
        "input": "We ingest 500 GB of events daily and query by date and event type.",
        "output": "Use daily time partitions first, then consider event type only if cardinality is controlled and filters are consistent. Target 100 MB to 1 GB files and monitor small file growth."
      },
      {
        "input": "Our schema changes often and several services write to the same table.",
        "output": "Prefer Iceberg because it supports schema evolution, concurrent writes, snapshot isolation, and partition evolution. Budget for metadata operations and operational learning."
      },
      {
        "input": "Our data lake has many tiny files and slow queries.",
        "output": "Prioritize compaction, larger writer batches, and partition simplification. Check whether hourly partitions can become daily partitions without hurting common queries."
      }
    ],
    "best_practices": [
      "Start with query patterns, data volume, and retention needs before choosing partitions.",
      "Keep raw data immutable so pipelines can reprocess history when logic changes.",
      "Use file size, compression, and compaction targets as operational requirements."
    ],
    "anti_patterns": [
      "Do not partition by high-cardinality fields unless a clear bucketing strategy exists.",
      "Do not mix raw source data and curated business tables in the same storage zone.",
      "Do not choose Iceberg only for trend alignment without operational ownership."
    ],
    "faq": [
      {
        "question": "Can this skill design a complete lakehouse architecture?",
        "answer": "Yes. It can propose storage zones, table formats, partitioning, retention tiers, and performance practices from your requirements."
      },
      {
        "question": "Does it support both Parquet and Iceberg guidance?",
        "answer": "Yes. It explains when raw Parquet is enough and when Iceberg provides better operational behavior."
      },
      {
        "question": "Can it optimize an existing data lake?",
        "answer": "Yes. Share the current layout, table sizes, query patterns, and pain points for a focused review."
      },
      {
        "question": "Does it execute commands or change data?",
        "answer": "No. The skill provides architecture guidance and uses read-only analysis tools."
