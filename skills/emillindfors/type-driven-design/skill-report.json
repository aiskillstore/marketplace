  "content": {
    "user_title": "Design Safer Rust APIs with Types",
    "value_statement": "Rust APIs can allow invalid states or swapped values when invariants stay in runtime logic. This skill shows how to encode invariants with newtypes, typestate, builders, phantom types, and session types.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Rust type-driven design",
      "Rust typestate pattern",
      "Rust newtype pattern",
      "compile-time guarantees",
      "phantom types Rust",
      "session types Rust",
      "safe Rust APIs"
    ],
    "actual_capabilities": [
      "Explains newtype wrappers for domain identifiers, units, validated values, and positive numbers.",
      "Shows typestate examples for connection and request workflows.",
      "Demonstrates builder patterns that require fields at compile time.",
      "Covers phantom types for type-safe identifiers and relationships.",
      "Introduces session types for authentication and transaction protocols.",
      "Provides trade-offs for when type-driven design is useful."
    ],
    "limitations": [
      "Focuses on Rust examples and does not provide language-agnostic implementations.",
      "Uses illustrative snippets that may need imports, real error types, and project-specific validation.",
      "Does not run compilers or test generated code by itself.",
      "May add API complexity when state spaces are highly dynamic."
    ],
    "use_cases": [
      {
        "title": "Prevent API Misuse",
        "description": "Design library APIs that make invalid method order and missing required values impossible to compile.",
        "target_user": "Rust library maintainers"
      },
      {
        "title": "Model Domain Invariants",
        "description": "Represent identifiers, units, and validated values with distinct types instead of shared primitive values.",
        "target_user": "Backend Rust developers"
      },
      {
        "title": "Teach Safer Rust Patterns",
        "description": "Explain type-level techniques with before-and-after examples that show compile-time guarantees.",
        "target_user": "Technical leads and educators"
      }
    ],
    "prompt_templates": [
      {
        "title": "Model a Newtype",
        "scenario": "Beginner request for safer domain values.",
        "prompt": "I have [value type] used for [domain meaning]. Show a Rust newtype design that prevents value mix-ups, with constructors and usage examples."
      },
      {
        "title": "Add Typestate to a Workflow",
        "scenario": "Intermediate request for state transition safety.",
        "prompt": "Refactor this Rust workflow into a typestate API. The states are [states], and the allowed transitions are [transitions]. Explain the compile-time guarantees."
      },
      {
        "title": "Build a Compile-Time Builder",
        "scenario": "Advanced request for required field enforcement.",
        "prompt": "Design a Rust builder for [configuration object] where [required fields] must be set before build is available. Include optional fields and trade-offs."
      },
      {
        "title": "Design a Session Protocol",
        "scenario": "Advanced request for protocol enforcement.",
        "prompt": "Create a session-type design for [protocol]. The protocol must enforce [authentication, transaction, cleanup, or other steps] at compile time."
      }
    ],
    "output_examples": [
      {
        "input": "I need to stop UserId and OrderId from being mixed in service calls.",
        "output": [
          "The skill recommends separate newtype wrappers around the shared identifier representation.",
          "It explains constructors, accessors, and function signatures that reject the wrong identifier type.",
          "It notes where conversions and display behavior should be implemented."
        ]
      },
      {
        "input": "My request builder allows POST requests without a body.",
        "output": [
          "The skill maps the builder into method and body states.",
          "It makes send available only for valid state combinations.",
          "It explains why invalid request sequences fail during compilation."
        ]
      },
      {
        "input": "I want to model a database session with authentication and transactions.",
        "output": [
          "The skill identifies session states and allowed transitions.",
          "It separates methods by state so unauthenticated sessions cannot start transactions.",
          "It describes the ergonomics and complexity trade-offs of this design."
        ]
      }
    ],
    "best_practices": [
      "Start with invariants that cause real bugs when they are only checked at runtime.",
      "Keep marker types and constructors small so the public API stays readable.",
      "Explain compile-time failures clearly so callers understand how to reach valid states."
    ],
    "anti_patterns": [
      "Do not use typestate for every boolean or minor validation rule.",
      "Do not expose unchecked constructors that bypass the invariant encoded by the type.",
      "Do not hide complex generic errors from users without examples or type aliases."
    ],
    "faq": [
      {
        "question": "What Rust patterns does this skill cover?",
        "answer": "It covers newtypes, typestate, compile-time builders, phantom types, session types, and type-level invariants."
      },
      {
        "question": "Can it help refactor an existing Rust API?",
        "answer": "Yes. Provide the current API, invalid states, and desired transitions, then ask for a type-driven redesign."
      },
      {
        "question": "Does the skill execute Rust code?",
        "answer": "No. It provides design guidance and examples, but it does not compile or run code by itself."
      },
      {
        "question": "When should I avoid type-driven design?",
        "answer": "Avoid it when states are highly dynamic or when the added generic complexity outweighs the safety benefit."
      },
      {
        "question": "Is this useful for beginners?",
        "answer": "Yes. The skill starts with simple newtype examples before moving to typestate and session types."
      },
      {
        "question": "How should I use it with Claude, Codex, or Claude Code?",
        "answer": "Share your Rust API goal, invariants, and invalid operations. Ask for a design that makes those invalid operations unrepresentable."
      }
    ]
