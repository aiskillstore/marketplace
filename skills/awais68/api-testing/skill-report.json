    "actual_capabilities": [
      "Creates pytest fixtures for FastAPI TestClient, auth headers, and in-memory SQLite sessions.",
      "Shows unit and integration test examples for CRUD endpoints, validation, pagination, updates, and deletes.",
      "Provides Playwright E2E setup with browser projects and local dev server settings.",
      "Defines page object patterns for reusable frontend test actions.",
      "Includes CI workflow examples for backend and frontend test runs."
    ],
    "limitations": [
