  "content": {
    "user_title": "Create Clear Conventional Git Commits",
    "value_statement": "Inconsistent commits make project history difficult to review and maintain. This skill analyzes changes, stages logical groups, and creates standardized Conventional Commit messages.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Git commit",
      "Conventional Commits",
      "commit message generator",
      "Git staging",
      "semantic commits",
      "developer workflow"
    ],
    "actual_capabilities": [
      "Inspects staged changes, working tree changes, and repository status.",
      "Infers a Conventional Commit type, scope, and concise description.",
      "Stages specific files, matching patterns, or selected patches.",
      "Creates single-line or multiline commits with bodies and footers.",
      "Formats breaking changes and issue references using established conventions."
    ],
    "limitations": [
      "Requires Git, Bash access, and an existing repository.",
      "Does not push commits or change remote branches.",
      "Warns about secrets but does not provide a dedicated secret scanner.",
      "Cannot guarantee that repository hooks will accept the generated commit."
    ],
    "use_cases": [
      {
        "title": "Commit a focused feature",
        "description": "Review changes, stage related files, and create a clear feature commit.",
        "target_user": "Application developer"
      },
      {
        "title": "Standardize project history",
        "description": "Apply consistent types, scopes, descriptions, and issue references across contributions.",
        "target_user": "Repository maintainer"
      },
      {
        "title": "Document a breaking change",
        "description": "Create a commit with a breaking-change marker, explanatory body, and footer.",
        "target_user": "Release engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Commit staged changes",
        "prompt": "Review my staged changes, propose a Conventional Commit message, and create the commit.",
        "scenario": "Use when the correct files are already staged."
      },
