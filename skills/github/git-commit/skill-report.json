  "content": {
    "user_title": "Create Clear Conventional Git Commits",
    "value_statement": "Unclear commits make reviews and release history harder to understand. This skill analyzes repository changes, stages selected files, and creates a Conventional Commit message.",
    "seo_keywords": [
      "Claude git commit skill",
      "Codex git commit workflow",
      "Claude Code conventional commits",
      "Conventional Commits",
      "git staging automation",
      "commit message generator",
      "semantic commit messages",
      "git diff analysis",
      "developer productivity"
    ],
    "actual_capabilities": [
      "Inspect staged changes, working tree changes, and concise repository status.",
      "Choose a Conventional Commit type, optional scope, and concise description from the diff.",
      "Stage specific files, matching paths, or interactively selected changes.",
      "Create single-line or multi-line local commits with optional body and footer text.",
      "Apply documented safeguards against destructive commands, skipped hooks, and committing secrets."
    ],
    "limitations": [
      "The skill requires a local Git repository with Git and Bash available.",
      "It creates local commits but does not push branches or open pull requests.",
      "The secret warning is not an automated secret scanner and cannot guarantee detection.",
      "Broad staging patterns can include unintended files, so users must review the staged diff."
    ],
    "use_cases": [
      {
        "title": "Prepare a focused feature commit",
        "description": "Analyze completed feature changes, stage the related files, and create a clear Conventional Commit.",
        "target_user": "Application developers"
      },
      {
        "title": "Standardize team commit history",
        "description": "Generate consistent commit types, scopes, descriptions, bodies, and issue references across a repository.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Commit documentation maintenance",
        "description": "Separate documentation updates from code changes and record them with an accurate docs commit.",
        "target_user": "Technical writers"
