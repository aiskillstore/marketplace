  "content": {
    "user_title": "Refactor Code Safely",
    "value_statement": "Large codebases become hard to change when structure, names, and responsibilities drift. This skill guides safe refactoring steps that preserve behavior while improving maintainability.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code refactoring",
      "safe refactoring",
      "extract method",
      "code smells",
      "type safety",
      "design patterns",
      "maintainable code"
    ],
    "actual_capabilities": [
      "Identify common code smells such as long methods, duplicated code, and large modules.",
      "Guide extract method, extract class, rename, and parameter object refactorings.",
      "Recommend guard clauses, domain types, named constants, and stronger public API types.",
      "Show when to apply strategy and chain of responsibility patterns during cleanup.",
      "Provide a safe process that emphasizes tests, small changes, and version control."
    ],
    "limitations": [
      "It does not guarantee behavior preservation without project tests.",
      "It does not replace architectural review for large rewrites or major migrations.",
      "It provides examples and process guidance, not project-specific performance proof.",
      "It assumes the agent can inspect the target codebase before choosing changes."
    ],
    "use_cases": [
      {
        "title": "Incremental Cleanup",
        "target_user": "Application developer",
        "description": "Clean up confusing functions, names, and duplicated logic while keeping existing behavior stable."
      },
      {
        "title": "Type Safety Improvement",
        "target_user": "TypeScript maintainer",
        "description": "Replace loose values with domain types, explicit interfaces, and clearer return structures."
      },
      {
        "title": "Legacy Module Decomposition",
        "target_user": "Technical lead",
        "description": "Break large modules into focused services before adding new features or tests."
      }
    ],
    "prompt_templates": [
      {
        "title": "Find Refactoring Targets",
        "scenario": "Beginner review of a confusing file.",
        "prompt": "Review this file for refactoring opportunities. Identify the top three code smells and explain the safest first change."
      },
      {
        "title": "Extract Small Functions",
        "scenario": "Improve a long function without changing behavior.",
        "prompt": "Refactor this long function into smaller focused functions. Preserve behavior and list the tests I should run afterward."
      },
      {
        "title": "Improve Type Safety",
        "scenario": "Reduce loose types in an existing module.",
        "prompt": "Refactor this module to improve type safety. Prefer domain types, explicit interfaces, and clear return values."
      },
      {
        "title": "Plan a Pattern-Based Refactor",
        "scenario": "Advanced cleanup of repeated conditional logic.",
        "prompt": "Analyze this conditional-heavy code and propose a step-by-step refactor using an appropriate design pattern. Keep each step reversible."
      }
    ],
    "output_examples": [
      {
        "input": "A checkout function mixes validation, pricing, inventory, shipment creation, and notifications.",
        "output": [
          "Primary smell: long method with mixed responsibilities.",
          "Recommended change: extract validation, pricing, inventory, shipping, and notification steps.",
          "Verification: run existing checkout tests after each extraction."
        ]
      },
      {
        "input": "Several services repeat membership discount logic with slightly different names.",
        "output": [
          "Primary smell: duplicated business rules.",
          "Recommended change: centralize discount rate selection behind one named function or service.",
          "Verification: add tests for each membership level before replacing callers."
        ]
      },
      {
        "input": "A module uses many status numbers and string flags across public functions.",
        "output": [
          "Primary smell: primitive obsession and magic values.",
          "Recommended change: introduce named constants, domain types, and explicit public interfaces.",
          "Verification: check public API compatibility and update callers in small batches."
        ]
      }
    ],
    "best_practices": [
      "Add or identify tests before changing production behavior.",
      "Make one small refactor at a time and verify after each step.",
      "Prefer clear names and simple structure before introducing design patterns."
    ],
    "anti_patterns": [
      "Do not mix feature changes with refactoring work.",
      "Do not refactor critical production code without a verification path.",
      "Do not introduce abstractions unless they remove real duplication or complexity."
    ],
    "faq": [
      {
        "question": "What does this skill help refactor?",
        "answer": "It helps improve functions, modules, types, naming, conditionals, duplicated logic, and selected design patterns."
      },
      {
        "question": "Does it change application behavior?",
        "answer": "The skill is designed for behavior-preserving changes. Tests are still required to verify that outcome."
      },
      {
        "question": "Can it handle large rewrites?",
        "answer": "It is best for gradual improvement. Large rewrites need separate planning and broader architectural review."
      },
      {
        "question": "Which tools can use it?",
        "answer": "The report lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "Does it run commands automatically?",
        "answer": "No. The skill document gives refactoring guidance and examples. It does not contain executable scripts."
      },
      {
        "question": "How should users apply it safely?",
        "answer": "Start with tests, change one concern at a time, and commit at safe points."
      }
