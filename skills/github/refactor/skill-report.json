  "content": {
    "user_title": "Refactor Code Safely",
    "value_statement": "Messy code slows feature work and raises maintenance risk. This skill guides small, tested refactors that improve structure without changing behavior.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code refactoring",
      "safe refactor",
      "code quality",
      "maintainability",
      "type safety",
      "design patterns",
      "technical debt"
    ],
    "actual_capabilities": [
      "Identifies common code smells such as long functions, duplication, large classes, and magic values.",
      "Suggests behavior-preserving refactors like extract method, extract class, guard clauses, and parameter objects.",
      "Guides type-safety improvements for public APIs, nullable values, and domain-specific value objects.",
      "Provides safe refactoring steps that emphasize tests, commits, and small reversible changes.",
      "Explains when design patterns such as strategy or validator chains can reduce conditional complexity."
    ],
    "limitations": [
      "It is documentation only and does not include executable tools or automated code modification scripts.",
      "It depends on existing tests or user-provided context to verify behavior preservation.",
      "It gives general refactoring guidance, not project-specific architecture guarantees.",
      "Large rewrites and repository-wide migrations are outside its intended scope."
    ],
    "use_cases": [
      {
        "title": "Clean Existing Feature Code",
        "description": "Refactor a hard-to-read feature while preserving current behavior and tests.",
        "target_user": "Application developers"
      },
      {
        "title": "Prepare Code for a New Feature",
        "description": "Reduce duplication and clarify module boundaries before assigning follow-up feature work.",
        "target_user": "Tech leads"
      },
      {
        "title": "Review Refactoring Pull Requests",
        "description": "Check whether a refactor stayed small, tested, and behavior preserving.",
        "target_user": "Code reviewers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Beginner: Clean One Function",
        "scenario": "Single function cleanup",
        "prompt": "Refactor this function for readability. Preserve behavior, explain each change, and tell me what tests should pass."
      },
      {
        "title": "Intermediate: Remove Duplication",
        "scenario": "Shared logic extraction",
        "prompt": "Find repeated logic in this code and propose a small refactor. Keep public behavior and names stable unless a rename is necessary."
      },
      {
        "title": "Advanced: Add Type Safety",
        "scenario": "Typed API improvement",
        "prompt": "Improve type safety in this module. Introduce clear domain types, remove weak types, and list behavior checks for the refactor."
      },
      {
        "title": "Expert: Plan a Refactor Series",
        "scenario": "Multi-step architecture cleanup",
        "prompt": "Plan a sequence of small refactors for this component. Separate each step, define test checkpoints, and call out risks before implementation."
      }
    ],
    "output_examples": [
      {
        "input": "A long order-processing function mixes validation, pricing, inventory updates, and notifications.",
        "output": "A staged refactor plan that separates responsibilities, names the extracted steps, and lists tests to run after each change."
      },
      {
        "input": "Several services repeat user validation rules with slightly different error handling.",
        "output": [
          "A shared validation boundary is recommended.",
          "Duplicate checks are grouped by responsibility.",
          "Behavior checks cover required fields, invalid values, and existing error messages."
        ]
      },
      {
        "input": "A shipping calculator uses many conditionals for delivery methods.",
        "output": "A recommendation to use a strategy-based design, with migration steps and behavior checks for each method."
      }
    ],
    "best_practices": [
      "Commit a stable baseline before starting a refactor.",
      "Make one behavior-preserving change at a time and run focused tests after each step.",
      "Use clear names and domain types only when they make behavior easier to understand."
    ],
    "anti_patterns": [
      "Mixing feature changes with refactoring in the same task.",
      "Refactoring critical production code before adding basic test coverage.",
      "Applying design patterns where a small extraction or rename would solve the problem."
    ],
    "faq": [
      {
        "question": "Does this skill rewrite an entire repository?",
        "answer": "No. It focuses on gradual, scoped refactors that preserve behavior."
      },
      {
        "question": "Does it require tests?",
        "answer": "Tests are strongly recommended because behavior preservation must be verified."
      },
      {
        "question": "Can it improve TypeScript code?",
        "answer": "Yes. It includes guidance for interfaces, union types, nullable values, and domain-specific types."
