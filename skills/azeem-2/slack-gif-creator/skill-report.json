  "content": {
    "user_title": "Create optimized GIFs for Slack",
    "value_statement": "Slack GIFs can look rough or exceed practical size limits when frames and colors are not planned carefully. This skill provides Pillow-based utilities and guidance to create, optimize, and validate polished animations.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Slack GIF creator",
      "animated GIF",
      "Pillow animation",
      "GIF optimization",
      "Slack emoji GIF",
      "image processing",
      "GIF validation"
    ],
    "actual_capabilities": [
      "Creates GIF frame sequences with Pillow image primitives.",
      "Builds GIFs at configurable dimensions and frame rates with GIFBuilder.",
      "Applies easing guidance for motion such as bounce, fade, slide, and pulse.",
      "Provides helpers for blank frames, gradients, circles, stars, and text.",
      "Optimizes GIF output through color reduction, duplicate-frame removal, and emoji mode.",
      "Checks GIFs against documented Slack-oriented requirements with local validators."
    ],
    "limitations": [
      "It does not include pre-made graphics or rigid animation templates.",
      "It relies on locally installed Pillow, imageio, and numpy dependencies.",
      "It does not upload GIFs to Slack or use Slack APIs.",
      "Text rendering uses Pillow defaults and does not provide reliable emoji font rendering."
    ],
    "use_cases": [
      {
        "title": "Create a team emoji animation",
        "description": "Design a compact looping GIF with clear shapes and reduced colors for a Slack workspace.",
        "target_user": "Community manager"
      },
      {
        "title": "Prepare a product announcement GIF",
        "description": "Animate a simple product concept with smooth motion and export it at message-friendly dimensions.",
        "target_user": "Product marketer"
      },
      {
        "title": "Validate a generated GIF",
        "description": "Check dimensions and emoji suitability before sharing a locally generated GIF with colleagues.",
        "target_user": "Developer"
      }
    ],
