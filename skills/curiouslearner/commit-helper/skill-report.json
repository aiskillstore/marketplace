  "content": {
    "user_title": "Generate Conventional Commit Messages",
    "value_statement": "Writing clear commit messages from staged changes can slow down reviews. This skill inspects Git context and proposes concise conventional commit messages.",
    "seo_keywords": [
      "Claude commit message skill",
      "Codex git commit helper",
      "Claude Code conventional commits",
      "conventional commit generator",
      "git commit message assistant",
      "staged diff summary",
      "commit scope suggestion",
      "developer productivity",
      "AI commit messages",
      "repository commit style"
    ],
    "actual_capabilities": [
      "Reviews staged changes with git diff --staged.",
      "Checks recent commit style with git log --oneline -10.",
      "Classifies changes using conventional commit types.",
      "Suggests an optional scope for the affected component.",
      "Produces subject, body, and footer text when useful."
    ],
    "limitations": [
      "Requires staged Git changes to generate the best result.",
      "Does not create commits or modify repository files by itself.",
      "Cannot verify issue numbers or release policy without project context.",
      "May need user review for large or mixed changes."
    ],
    "use_cases": [
      {
        "title": "Prepare Feature Commits",
        "description": "Turn staged feature work into a concise conventional commit message with scope and body.",
        "target_user": "Application developers"
      },
      {
        "title": "Clean Up Bug Fix History",
        "description": "Summarize a focused fix so reviewers can understand the user impact quickly.",
        "target_user": "Maintainers"
      },
      {
        "title": "Match Team Commit Style",
        "description": "Use recent commit history to align wording with an existing repository convention.",
        "target_user": "Engineering teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Message",
        "scenario": "Beginner: create a standard message",
        "prompt": "Use commit-helper to review my staged changes and suggest one conventional commit message."
      },
      {
        "title": "Add Scope",
        "scenario": "Intermediate: target a component",
        "prompt": "Use commit-helper with scope api and generate a concise message for my staged changes."
      },
      {
        "title": "Force Type",
        "scenario": "Intermediate: guide the commit type",
        "prompt": "Use commit-helper with type fix. Include a short body only if it improves clarity."
      },
      {
        "title": "History Aligned",
        "scenario": "Advanced: match repository style",
        "prompt": "Use commit-helper to compare staged changes with recent commit style, then propose three ranked messages."
      }
    ],
    "output_examples": [
      {
        "input": "Staged changes add token refresh behavior in the authentication module.",
        "output": "feat(auth): add token refresh flow\n\nImprove session continuity by refreshing expired tokens before user requests fail."
      },
      {
        "input": "Staged changes fix null email validation errors.",
        "output": "fix(validation): handle null email values\n\nReturn a failed validation result instead of throwing on empty input."
      },
      {
        "input": "Staged changes update API documentation for version 2 endpoints.",
        "output": "docs(api): update v2 endpoint documentation"
      }
    ],
    "best_practices": [
      "Stage only related changes before asking for a commit message.",
      "Review the proposed subject for accuracy before committing.",
      "Include issue references only when the repository expects them."
    ],
    "anti_patterns": [
      "Do not use it to summarize unstaged or unrelated work.",
      "Do not accept a generated message without checking the actual diff.",
      "Do not force a commit type that misrepresents the change."
    ],
    "faq": [
      {
        "question": "Does this skill make the commit for me?",
        "answer": "No. It suggests commit message text. You decide whether to run Git commands."
      },
      {
        "question": "Which commit style does it use?",
        "answer": "It follows conventional commit types such as feat, fix, docs, test, chore, ci, and revert."
      },
      {
        "question": "Can it add a scope?",
        "answer": "Yes. It can infer a scope or use one you provide, such as api or auth."
      },
      {
        "question": "Does it need staged changes?",
        "answer": "Staged changes give the most accurate result because the skill reviews the staged diff."
      },
      {
        "question": "Can it include issue references?",
        "answer": "Yes. It can include issue references when you provide the relevant issue details."
      },
      {
        "question": "Does it work with Claude Code and Codex?",
        "answer": "Yes. The skill metadata lists Claude, Codex, and Claude Code support."
      }
    ]
