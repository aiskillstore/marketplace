  "content": {
    "user_title": "Review Code for Quality and Security",
    "value_statement": "Code reviews can miss security, testing, and maintainability issues when reviewers lack time. This skill guides Claude, Codex, and Claude Code through a structured review with prioritized findings.",
    "seo_keywords": [
      "AI code review",
      "Claude",
      "Codex",
      "Claude Code",
      "security review",
      "pull request review",
      "code quality",
      "best practices",
      "testing coverage",
      "performance review"
    ],
    "actual_capabilities": [
      "Reviews code quality, readability, naming, structure, and comments.",
      "Checks security risks such as injection, XSS, authorization, and data exposure.",
      "Evaluates performance concerns including query efficiency, resource use, and caching opportunities.",
      "Assesses test presence, edge cases, coverage, and mock usage.",
      "Produces prioritized review reports with issue severity, impact, and recommendations.",
      "Uses a checklist covering security, quality, performance, testing, and best practices."
    ],
    "limitations": [
      "It depends on the code and project context provided to the assistant.",
      "It does not replace automated tests, static analyzers, or dependency scanners.",
      "It may miss vulnerabilities that require runtime behavior or production data.",
      "Its examples are illustrative and must be adapted to each codebase."
    ],
    "use_cases": [
      {
        "title": "Pre-merge pull request review",
        "target_user": "Application developers",
        "description": "Review changed files before requesting team feedback, with attention to correctness, security, and tests."
      },
      {
        "title": "Team review standardization",
        "target_user": "Engineering leads",
        "description": "Apply a shared review structure across services so feedback is consistent and prioritized."
      },
      {
        "title": "Security-focused code pass",
        "target_user": "Security-minded maintainers",
        "description": "Check authentication, validation, injection, secret handling, and exposed data before release."
      }
    ],
    "prompt_templates": [
      {
        "title": "Review one file",
        "scenario": "Beginner review of a single file",
        "prompt": "@code-reviewer UserService.js\nReview this file for correctness, readability, security, and missing tests. Return prioritized findings with clear fixes."
      },
      {
        "title": "Review a feature change",
        "scenario": "Intermediate review of changed implementation files",
        "prompt": "@code-reviewer src/auth/\nReview this authentication change. Focus on input validation, authorization checks, error handling, and test coverage."
      },
      {
        "title": "Review for release readiness",
        "scenario": "Advanced review before deployment",
        "prompt": "@code-reviewer --severity critical\nReview the release branch for blocking issues. Prioritize security vulnerabilities, data loss risks, breaking changes, and logic errors."
      },
      {
        "title": "Run a focused security review",
        "scenario": "Advanced review for sensitive flows",
        "prompt": "@code-reviewer --focus security\nReview payment and account flows for injection, secret exposure, authentication gaps, authorization bypasses, and unsafe logging."
      }
    ],
    "output_examples": [
      {
        "input": "Review an authentication handler before merge.",
        "output": "Critical finding: unvalidated input reaches a database query. Recommendation: use parameterized queries and add regression tests."
      },
      {
        "input": "Review a user service with new profile logic.",
        "output": "Major finding: missing null handling can crash profile reads. Recommendation: validate the response shape before accessing nested fields."
      },
      {
        "input": "Review a release branch for quality issues.",
        "output": "Summary: no blocking security issue found. Remaining work includes naming cleanup, stronger edge-case tests, and query optimization."
      }
    ],
    "best_practices": [
      "Provide the relevant files, diff, tests, and expected behavior for better findings.",
      "Ask for a focused review when security, performance, or testing risk is highest.",
      "Treat findings as review input and verify important issues with project tools."
    ],
    "anti_patterns": [
      "Do not ask for a broad review without giving files, context, or goals.",
      "Do not accept suggested fixes without checking framework conventions and tests.",
      "Do not use the skill as the only security control before release."
    ],
    "faq": [
      {
        "question": "What does this skill review?",
        "answer": "It reviews code quality, security, performance, testing, documentation, and best-practice concerns."
      },
      {
        "question": "Can it review pull requests?",
        "answer": "Yes. Provide the changed files or diff and ask for prioritized review findings."
      },
      {
        "question": "Does it run tests automatically?",
        "answer": "No. It can recommend tests, but test execution depends on the assistant tools and project setup."
      },
      {
        "question": "Is it a replacement for security scanning?",
        "answer": "No. Use it with static analysis, dependency scanning, tests, and human review."
      },
      {
        "question": "Which tools can use it?",
        "answer": "The report lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "How should findings be handled?",
        "answer": "Fix critical and major issues first, then verify changes with tests and project-specific checks."
      }
