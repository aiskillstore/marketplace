  "content": {
    "user_title": "Build Data Quality Checks",
    "value_statement": "Unreliable tables can break analytics, reporting, and downstream products. This skill helps define Great Expectations suites, dbt tests, data contracts, and automated validation pipelines.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "data quality validation",
      "Great Expectations",
      "dbt tests",
      "data contracts",
      "SodaCL checks",
      "data pipeline testing",
      "quality monitoring"
    ],
    "actual_capabilities": [
      "Explains completeness, uniqueness, validity, consistency, and timeliness checks for data tables.",
      "Provides Great Expectations suite and checkpoint patterns for warehouse validation.",
      "Shows dbt generic, singular, relationship, freshness, and accepted value tests.",
      "Outlines data contract fields, ownership, schema rules, quality checks, and service levels.",
      "Describes an automated Python validation pipeline that summarizes failed expectations."
    ],
    "limitations": [
      "Does not run data quality checks by itself.",
      "Requires users to adapt examples to their warehouse, schema, and orchestration system.",
      "Does not replace privacy review for columns marked as PII.",
      "Does not include production deployment code for every data platform."
    ],
    "use_cases": [
      {
        "title": "Create Warehouse Validation",
        "description": "Design Great Expectations suites and checkpoints for critical warehouse tables before downstream jobs consume them.",
        "target_user": "Data engineer"
      },
      {
        "title": "Strengthen dbt Test Coverage",
        "description": "Add schema, relationship, freshness, range, and business rule tests to improve dbt model reliability.",
        "target_user": "Analytics engineer"
      },
      {
        "title": "Define Data Contracts",
        "description": "Document ownership, schema requirements, PII flags, quality checks, and service levels for shared datasets.",
        "target_user": "Data platform lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a Quality Checklist",
        "scenario": "Beginner planning for one important table.",
        "prompt": "Help me create a data quality checklist for a table named [table]. Include completeness, uniqueness, validity, and freshness checks."
      },
      {
        "title": "Design dbt Tests",
        "scenario": "Intermediate dbt model testing.",
        "prompt": "Review these dbt models and recommend schema, relationship, accepted value, freshness, and custom tests for each critical column."
      },
      {
        "title": "Build Expectations Suite",
        "scenario": "Advanced Great Expectations implementation.",
        "prompt": "Create a Great Expectations validation plan for [dataset]. Include suite structure, checkpoint behavior, failure handling, and reporting requirements."
      },
      {
        "title": "Establish Data Contracts",
        "scenario": "Advanced cross-team governance.",
        "prompt": "Draft a data contract strategy for [domain]. Include ownership, schema rules, PII handling, quality checks, service levels, and versioning."
      }
    ],
    "output_examples": [
      {
        "input": "A data engineer asks for validation checks for an orders table.",
        "output": "A prioritized checklist covering primary keys, foreign keys, order status values, amount ranges, row counts, and daily freshness."
      },
      {
        "input": "An analytics engineer wants stronger dbt tests for customer models.",
        "output": "A test plan with unique identifiers, required email fields, accepted segment values, relationship checks, and a custom business rule."
      },
      {
        "input": "A platform lead needs a data contract for a shared dataset.",
        "output": "A contract outline with owner, purpose, schema fields, PII classification, quality expectations, availability target, and freshness target."
      }
    ],
    "best_practices": [
      "Start with checks for critical columns, primary keys, foreign keys, and freshness requirements.",
      "Keep thresholds documented and revisit them when data volume or business rules change.",
      "Route failures to clear owners with enough detail to reproduce and fix the issue."
    ],
    "anti_patterns": [
      "Testing every column equally without considering business impact.",
      "Ignoring warning trends until they become pipeline failures.",
      "Hardcoding thresholds without baselines, ownership, or review dates."
    ],
    "faq": [
      {
        "question": "Which tools does this skill cover?",
        "answer": "It covers Great Expectations, dbt tests, data contracts, SodaCL-style checks, and automated validation pipeline patterns."
      },
      {
        "question": "Can it run checks on my warehouse?",
        "answer": "No. It provides implementation guidance and examples. You must connect and run tools in your own environment."
      },
      {
        "question": "Does it support PII governance?",
        "answer": "It shows how to label PII in contracts, but it does not perform privacy classification or legal review."
      },
      {
        "question": "Is it useful for dbt projects?",
        "answer": "Yes. It includes examples for schema tests, relationship tests, accepted values, freshness checks, and custom SQL tests."
      },
      {
        "question": "How should failures be handled?",
        "answer": "Failures should alert an owner, include failed expectations, and stop downstream jobs when critical data is invalid."
      },
      {
        "question": "Can teams use it with Claude, Codex, and Claude Code?",
        "answer": "Yes. The skill is compatible with Claude, Codex, and Claude Code for planning and implementation guidance."
      }
    ]
  },
