    "user_title": "Debug Software Issues Systematically",
    "value_statement": "Bugs waste time when investigation is ad hoc. This skill guides Claude, Codex, and Claude Code through reproduction, evidence gathering, profiling, and root cause analysis.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "debugging strategies",
      "root cause analysis",
      "performance profiling",
      "production debugging",
      "software troubleshooting",
      "developer workflow",
      "bug investigation"
    ],
    "actual_capabilities": [
      "Provides a phased workflow for reproducing bugs, gathering facts, forming hypotheses, and verifying fixes.",
      "Lists debugging techniques for JavaScript, TypeScript, Python, and Go codebases.",
      "Explains profiling approaches for CPU, memory, browser performance, and application bottlenecks.",
      "Guides regression investigation with Git bisect and working-versus-broken comparisons.",
      "Offers checklists for intermittent bugs, production incidents, performance problems, and common coding mistakes."
    ],
    "limitations": [
      "It does not run debuggers, profilers, or tests by itself.",
      "It cannot diagnose a defect without code, logs, reproduction steps, or environment details.",
      "It gives general techniques rather than framework-specific fixes for every technology.",
      "Production debugging guidance still requires local safety controls and access approvals."
    ],
    "use_cases": [
      {
        "title": "Triage a New Bug Report",
        "description": "Turn vague symptoms into reproduction steps, evidence, hypotheses, and a verification plan.",
        "target_user": "Application developer"
      },
      {
        "title": "Investigate a Performance Regression",
        "description": "Choose profiling tools, compare working and broken versions, and focus work on measured bottlenecks.",
        "target_user": "Backend or frontend engineer"
      },
      {
        "title": "Handle a Production Incident",
        "description": "Collect safe evidence, reproduce locally, avoid risky production changes, and document the root cause.",
        "target_user": "On-call engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a Bug Investigation",
        "scenario": "Beginner request with limited context",
        "prompt": "Help me debug this issue systematically. I will share the symptom, expected behavior, actual behavior, environment, and recent changes."
      },
      {
        "title": "Build a Reproduction Plan",
        "scenario": "A bug is reported but not isolated",
        "prompt": "Create a minimal reproduction plan for this bug. Ask for missing details, identify variables to control, and define verification steps."
      },
      {
        "title": "Profile a Slow Workflow",
        "scenario": "A user-facing action is slow",
        "prompt": "Help me investigate this performance issue. Suggest measurements, likely bottlenecks, profiling tools, and a before-and-after validation plan."
      },
      {
        "title": "Run Root Cause Analysis",
        "scenario": "Advanced investigation after data is collected",
        "prompt": "Analyze these logs, stack traces, recent changes, and reproduction notes. Rank likely root causes and propose experiments to prove or disprove each one."
      }
    ],
    "output_examples": [
      {
        "input": "A checkout flow fails for some users after the latest release.",
        "output": [
          "Reproduction matrix covering browser, user role, cart contents, payment method, and deployment version.",
          "Initial hypotheses ranked by recent changes, affected scope, and failure point.",
          "Experiment plan with one variable changed at a time and clear pass or fail criteria."
        ]
      },
      {
        "input": "An API endpoint became slower after a database migration.",
        "output": [
          "Profiling plan that separates application time, database time, network time, and serialization time.",
          "Comparison checklist for query plans, indexes, data size, dependency versions, and cache behavior.",
          "Validation steps for measuring latency before and after the fix."
        ]
      }
    ],
    "best_practices": [
      "Start with a reliable reproduction before changing code.",
      "Change one variable at a time and record each result.",
      "Verify the fix with tests, logs, or measurements that match the original symptom."
    ],
    "anti_patterns": [
      "Making several fixes at once before understanding the cause.",
      "Ignoring full error messages, stack traces, logs, or recent changes.",
      "Leaving temporary debug logging, breakpoints, or profiling hooks in production code."
    ],
