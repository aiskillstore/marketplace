        "description": "Create typography, color, spacing, and icon rules before a new interface is built.",
        "target_user": "Design system maintainer"
      },
      {
        "title": "Improve Interface Consistency",
        "description": "Audit screens for visual hierarchy, token drift, inconsistent spacing, and weak contrast.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Prepare Accessible UI Guidelines",
        "description": "Document readable type, accessible color pairs, touch targets, and icon usage for product teams.",
        "target_user": "Product designer"
      }
    ],
    "prompt_templates": [
