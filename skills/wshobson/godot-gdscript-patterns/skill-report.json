    "actual_capabilities": [
      "Explains Godot 4 architecture with nodes, scenes, resources, signals, and groups.",
      "Shows typed GDScript examples for player control, state machines, and autoload singletons.",
      "Demonstrates resource-based data, object pooling, components, scene management, and save systems.",
      "Provides performance guidance for cached references, pooling, allocation control, and processing flags.",
      "Lists practical do and do-not guidance for maintainable Godot projects."
    ],
    "limitations": [
