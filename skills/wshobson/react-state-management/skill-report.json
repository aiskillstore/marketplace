  "content": {
    "user_title": "Choose React State Management Patterns",
    "value_statement": "React teams often mix local, global, and server state without clear boundaries. This skill helps apply Redux Toolkit, Zustand, Jotai, and React Query patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "React state management",
      "Redux Toolkit",
      "Zustand",
      "Jotai",
      "React Query",
      "server state",
      "optimistic updates"
    ],
    "actual_capabilities": [
      "Compares local, global, server, URL, and form state categories.",
      "Shows a Zustand store with devtools, persistence, actions, and selectors.",
      "Outlines Redux Toolkit store setup, typed hooks, slices, and async thunks.",
      "Demonstrates Jotai atoms for stored, derived, async, and write-only state.",
      "Explains React Query keys, query hooks, mutations, optimistic updates, and rollback.",
      "Provides guidance for combining client state with server state and migrating from legacy Redux."
    ],
    "limitations": [
      "It is a documentation skill, not a runnable React project.",
