        "description": "Turn a feature idea into an iOS screen structure with suitable navigation, layout, and controls.",
        "target_user": "iOS developer"
      },
      {
        "title": "Review Interface Quality",
        "description": "Check a proposed mobile interface against HIG expectations, accessibility needs, and adaptive layout behavior.",
        "target_user": "Product designer"
      },
      {
        "title": "Standardize SwiftUI Patterns",
        "description": "Create shared guidance for common app components such as lists, settings, forms, cards, and error states.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
