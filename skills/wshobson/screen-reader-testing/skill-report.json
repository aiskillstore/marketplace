      "TalkBack testing",
      "WCAG accessibility",
      "ARIA live regions"
    ],
    "actual_capabilities": [
      "Identifies priority screen reader and browser combinations for practical coverage.",
      "Provides keyboard commands for VoiceOver, NVDA, JAWS, and TalkBack testing.",
      "Supplies checklists and scripts for headings, landmarks, forms, tables, and dynamic content.",
      "Shows accessible examples for buttons, form errors, modals, live regions, and tab interfaces.",
      "Guides debugging of accessible names, roles, states, and visibility."
    ],
    "limitations": [
      "It does not automate screen readers or run tests by itself.",
      "It requires access to the target platforms, browsers, and assistive technology.",
      "Its examples need adaptation for each application and component library.",
      "It does not replace testing with assistive technology users or a formal WCAG audit."
    ],
    "use_cases": [
      {
        "title": "Validate a Release Candidate",
        "description": "Run focused screen reader checks before shipping a web application update.",
        "target_user": "Frontend developers"
      },
      {
        "title": "Build Regression Test Scripts",
        "description": "Create repeatable manual scripts for headings, forms, dialogs, and dynamic announcements.",
        "target_user": "QA engineers"
      },
      {
        "title": "Document Accessibility Defects",
        "description": "Capture expected announcements, actual screen reader behavior, and clear remediation notes.",
        "target_user": "Accessibility specialists"
      }
    ],
    "prompt_templates": [
      {
        "title": "Run a Basic Review",
        "scenario": "Beginner check of a page with one screen reader.",
        "prompt": "Guide me through a basic screen reader review for this page using VoiceOver or NVDA. Focus on page title, headings, landmarks, links, and form labels."
      },
      {
        "title": "Debug a Form Issue",
        "scenario": "Intermediate review of labels, required fields, and errors.",
        "prompt": "Help me test this form with a screen reader. Check whether labels, required states, instructions, invalid entries, and error messages are announced correctly."
      },
      {
        "title": "Plan Cross-Platform Coverage",
        "scenario": "Intermediate planning for release testing.",
        "prompt": "Create a screen reader test plan for a release candidate. Include priority browser combinations, test tasks, expected announcements, and defect notes."
      },
      {
        "title": "Audit a Dynamic Widget",
        "scenario": "Advanced review of custom interactive components.",
        "prompt": "Analyze this modal, tab interface, or live region for screen reader behavior. Define keyboard steps, expected announcements, focus handling, and likely failures."
      }
    ],
    "output_examples": [
      {
        "input": "Review a checkout form with required fields and validation errors.",
        "output": [
          "Test sequence covering field navigation, label announcements, required state, invalid input, submission, error announcement, and focus placement.",
          "Expected screen reader output for each step, plus a defect list for missing labels or disconnected error text."
        ]
      },
      {
        "input": "Plan screen reader coverage for a new account settings page.",
        "output": [
          "Priority matrix for NVDA with Firefox, VoiceOver with Safari, and mobile VoiceOver or TalkBack.",
          "Checklist covering page title, landmarks, headings, controls, dialogs, and dynamic save status messages."
        ]
      },
      {
        "input": "Debug a tab component that sounds confusing in screen readers.",
        "output": [
          "Keyboard test steps for tab movement, selection state, panel announcement, and focus order.",
          "Recommended fixes for missing labels, incorrect selected state, or hidden panel content."
        ]
      }
    ],
    "best_practices": [
      "Test with real screen readers, not only automated scanners or browser accessibility trees.",
      "Start with semantic HTML before adding ARIA roles, states, or live regions.",
