  "content": {
    "user_title": "Design Better REST and GraphQL APIs",
    "value_statement": "Teams often ship APIs with inconsistent resources, errors, pagination, and versioning. This skill provides REST and GraphQL patterns, review checklists, and templates for durable developer-facing APIs.",
    "seo_keywords": [
      "API design principles",
      "REST API design",
      "GraphQL schema design",
      "OpenAPI review",
      "FastAPI template",
      "Claude",
      "Codex",
      "Claude Code",
      "developer API standards",
      "API versioning"
    ],
    "actual_capabilities": [
      "Explains REST resource collection patterns and HTTP method semantics.",
      "Covers pagination, filtering, error handling, HATEOAS, and status-code guidance.",
      "Guides GraphQL schema-first design, resolver patterns, mutations, and DataLoader usage.",
      "Includes a FastAPI REST template and an API design checklist.",
      "Helps compare versioning strategies, documentation practices, and developer experience tradeoffs."
    ],
    "limitations": [
      "Does not connect to services or validate a live API automatically.",
      "Example code must be adapted and reviewed before production use.",
      "Security guidance is architectural and does not replace a threat model.",
      "Does not run load tests or benchmark API performance."
    ],
    "use_cases": [
      {
        "title": "Plan New API Resources",
        "description": "Define resource names, methods, status codes, errors, pagination, and versioning before implementation begins.",
        "target_user": "Backend developer"
      },
      {
        "title": "Set Team API Standards",
        "description": "Create consistent design rules for REST and GraphQL APIs across services and teams.",
        "target_user": "API architect"
      },
      {
        "title": "Review Developer Documentation",
        "description": "Check whether API docs explain auth, errors, examples, pagination, and migration paths clearly.",
        "target_user": "Technical writer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review A REST API Plan",
        "scenario": "Beginner review before implementation.",
        "prompt": "Review this REST API plan for resource names, HTTP methods, status codes, pagination, and error responses. List the highest priority changes first."
      },
      {
        "title": "Design A GraphQL Schema",
        "scenario": "Intermediate schema design for a domain model.",
        "prompt": "Design a GraphQL schema for this domain. Include types, queries, mutations, pagination choices, error patterns, and DataLoader guidance."
      },
      {
        "title": "Choose REST Or GraphQL",
        "scenario": "Advanced architecture decision.",
        "prompt": "Evaluate whether this product area should use REST, GraphQL, or both. Consider clients, caching, versioning, performance, and developer experience."
      },
      {
        "title": "Create API Governance Rules",
        "scenario": "Advanced standards and review process.",
        "prompt": "Create team standards for API naming, versioning, authentication, rate limits, documentation, migrations, and review gates. Include pull request review criteria."
      }
    ],
    "output_examples": [
      {
        "input": "A team wants a user management API before implementation.",
        "output": [
          "Recommended resource model with collection and item endpoints.",
          "Pagination and filtering rules for list operations.",
          "Consistent error response guidance for validation and authorization failures."
        ]
      },
      {
        "input": "A GraphQL schema has slow nested order lookups.",
        "output": [
          "Resolver design review focused on N+1 risks.",
          "Batch loading recommendation for relationship fields.",
          "Pagination guidance for high-cardinality nested data."
        ]
      },
      {
        "input": "An API review board needs shared standards.",
        "output": [
          "Checklist for resource naming, versioning, errors, auth, rate limits, and documentation.",
          "Review questions that teams can apply before release."
        ]
      }
    ],
    "best_practices": [
      "Start with resources, methods, errors, pagination, and auth before writing implementation code.",
      "Review example templates for environment-specific security settings before deployment.",
      "Use DataLoaders or batching for GraphQL fields that traverse relationships."
    ],
    "anti_patterns": [
      "Copying sample server defaults directly into production.",
      "Designing endpoints around verbs instead of resource names.",
      "Adding GraphQL relationships without a batching plan."
    ],
    "faq": [
