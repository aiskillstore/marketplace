{
  "name": "sitemapkit-mcp",
  "version": "1.1.0",
  "description": "MCP server for XML sitemap discovery, parsing and URL extraction with the SitemapKit API",
  "keywords": [
    "mcp",
    "sitemap",
    "seo",
    "crawler",
    "model-context-protocol",
    "sitemap-parser",
    "url-extractor",
    "ai-agents",
    "llm-tools"
  ],
  "license": "MIT",
  "homepage": "https://sitemapkit.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/0nl1n1n/sitemapkit-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/0nl1n1n/sitemapkit-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "sitemapkit-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  }
}
