  "content": {
    "user_title": "Create ralph-tui JSON Task Files",
    "value_statement": "Teams often need a clean task file before ralph-tui can execute a PRD. This skill converts requirements into structured user stories with dependencies and quality gates.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "ralph-tui",
      "prd.json",
      "PRD conversion",
      "JSON task planning",
      "user stories",
      "acceptance criteria",
      "quality gates"
    ],
    "actual_capabilities": [
      "Extracts quality gates from PRD text or asks when gates are missing.",
      "Converts PRD user stories into a flat prd.json structure.",
      "Adds acceptance criteria, priorities, passes flags, and notes fields.",
      "Builds dependency order with dependsOn story references.",
      "Suggests the default output path for ralph-tui task files.",
      "Warns against schema patterns that ralph-tui rejects."
    ],
    "limitations": [
      "It does not execute ralph-tui or validate task completion.",
      "It depends on clear PRD content for accurate story extraction.",
      "It does not resolve unclear product decisions without user input.",
      "It is designed for the bundled JSON tracker workflow."
    ],
    "use_cases": [
      {
        "title": "Prepare Feature PRDs",
        "description": "Convert a feature PRD into stories that ralph-tui can process in dependency order.",
        "target_user": "Product engineers"
      },
      {
        "title": "Standardize Task Files",
        "description": "Create consistent prd.json files with required fields and quality gates across projects.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Split Large Initiatives",
        "description": "Break broad requirements into smaller stories that fit one ralph-tui iteration.",
        "target_user": "Technical product managers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create Basic Task File",
        "scenario": "Beginner conversion from one PRD.",
        "prompt": "Convert this PRD into a ralph-tui prd.json task file. Use clear user stories, acceptance criteria, and dependencies."
      },
      {
        "title": "Add Quality Gates",
        "scenario": "Include repository checks in every story.",
        "prompt": "Create prd.json from this PRD. Add the listed quality gates to every story and include UI verification where relevant."
      },
      {
        "title": "Refine Story Size",
        "scenario": "Improve an existing draft before execution.",
        "prompt": "Review this draft task plan for ralph-tui. Split stories that are too large and keep dependencies accurate."
      },
      {
        "title": "Convert Complex Roadmap",
        "scenario": "Advanced conversion with phases and dependencies.",
        "prompt": "Flatten this phased roadmap into ralph-tui user stories. Preserve delivery order, quality gates, and acceptance criteria."
      }
    ],
    "output_examples": [
      {
        "input": "A PRD for adding task priority with type checking, linting, and browser verification gates.",
        "output": [
          "A flat ralph-tui task file is produced for the feature.",
          "Database, display, and filter stories are ordered by dependency.",
          "Each story includes clear acceptance criteria and relevant quality gates."
        ]
      },
      {
        "input": "A broad dashboard PRD that includes backend work, UI work, and final integration.",
        "output": [
          "The work is split into small stories for schema, queries, components, and polish.",
          "Later UI stories depend on earlier backend stories.",
          "Vague criteria are rewritten as verifiable outcomes."
        ]
      },
      {
        "input": "A PRD without a Quality Gates section.",
        "output": [
          "The assistant asks which commands or checks must pass.",
          "If approved, sensible default checks are added as acceptance criteria.",
          "The final task file stays compatible with the JSON tracker."
        ]
      }
    ],
    "best_practices": [
      "Provide the full PRD and any required quality gates before conversion.",
      "Keep each user story small enough for one ralph-tui iteration.",
      "Review dependencies before running ralph-tui against the generated task file."
    ],
    "anti_patterns": [
      "Do not wrap the task data in extra root objects.",
      "Do not combine an entire feature into one large story.",
      "Do not use vague acceptance criteria that cannot be verified."
    ],
    "faq": [
      {
        "question": "What does this skill create?",
        "answer": "It creates a ralph-tui compatible prd.json task file from product requirement text."
      },
      {
        "question": "Does it run ralph-tui for me?",
        "answer": "No. It prepares the task file that ralph-tui can use later."
      },
      {
        "question": "Can it use quality gates from my PRD?",
        "answer": "Yes. It extracts quality gates and appends them to each relevant user story."
      },
      {
        "question": "What happens if quality gates are missing?",
        "answer": "The skill asks for the required checks or suggests sensible defaults for confirmation."
      },
      {
        "question": "Can it handle phased roadmaps?",
        "answer": "Yes. It flattens phases into ordered user stories with dependencies."
      },
