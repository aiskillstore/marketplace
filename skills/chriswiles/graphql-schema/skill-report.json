    "user_title": "Create GraphQL Operations with Generated Types",
    "value_statement": "GraphQL client work often creates duplicate operations, weak error handling, and stale generated types. This skill guides consistent .gql files, Apollo generated hooks, codegen steps, and mutation UI safeguards.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "GraphQL schema",
      "Apollo Client",
      "GraphQL codegen",
      "generated hooks",
