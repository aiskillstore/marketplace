  "content": {
    "user_title": "Build Resilient React UI States",
    "value_statement": "React interfaces often fail to show clear loading, error, empty, and submission states. This skill gives practical patterns for predictable async UI behavior.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "React UI patterns",
      "loading states",
      "error handling",
      "data fetching",
      "empty states",
      "optimistic updates",
      "form submissions"
    ],
    "actual_capabilities": [
      "Explains when to show loading indicators when cached data already exists.",
      "Defines an error handling hierarchy for forms, pages, and recoverable failures.",
      "Shows button loading and disabled state patterns for async operations.",
      "Provides empty state patterns for lists, searches, and first-use flows.",
      "Outlines a form submission flow with validation, mutation, and feedback.",
      "Includes a checklist for loading, error, empty, and mutation states."
    ],
    "limitations": [
      "It does not provide runnable package code or installed React components.",
      "It does not inspect a project for missing UI states automatically.",
      "It focuses on client UI behavior, not backend error design.",
      "Examples are TypeScript and TSX oriented and may need adaptation."
    ],
