      "network topology",
      "technical documentation"
    ],
    "actual_capabilities": [
      "Provides a dark visual design system for architecture diagrams.",
      "Defines colors for frontend, backend, database, cloud, security, message bus, and generic components.",
      "Includes SVG patterns for arrows, component boxes, boundaries, legends, and message buses.",
      "Supplies a standalone HTML template with inline CSS and SVG examples.",
      "Gives layout guidance for spacing, legends, cards, and footer metadata."
    ],
    "limitations": [
      "It produces static HTML diagrams, not interactive diagram editors.",
      "It requires manual customization of component names, positions, and relationships.",
      "The default template loads Google Fonts unless the link is removed or self-hosted.",
      "It does not validate architecture correctness or cloud configuration security."
    ],
    "use_cases": [
      {
        "title": "Document a Service Architecture",
        "description": "Create a dark HTML diagram that shows services, databases, queues, and user flows for a design review.",
        "target_user": "Software architects"
      },
      {
        "title": "Prepare Cloud Review Diagrams",
        "description": "Show regions, load balancers, storage, security groups, and data paths before an infrastructure review.",
        "target_user": "DevOps engineers"
      },
      {
        "title": "Explain Security Boundaries",
        "description": "Map identity providers, trust zones, encrypted links, and sensitive stores for a security discussion.",
        "target_user": "Security teams"
      }
    ],
    "prompt_templates": [
