    "faq": [
      {
        "question": "What does this skill create?",
        "answer": "It creates standalone HTML files with inline SVG architecture diagrams and dark styling."
      },
      {
        "question": "Does it need JavaScript?",
        "answer": "No. The template uses HTML, CSS, and inline SVG. CSS animation is optional."
      },
      {
        "question": "Can I use it with Claude, Codex, and Claude Code?",
        "answer": "Yes. The report lists Claude, Codex, and Claude Code as supported tools."
      },
