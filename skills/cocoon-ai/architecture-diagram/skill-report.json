        "title": "Customize a Cloud Diagram",
        "scenario": "Intermediate cloud documentation",
        "prompt": "Use the architecture-diagram skill to build a dark SVG diagram for [cloud system]. Include regions, security groups, storage, and legends."
      },
      {
        "title": "Map Security and Data Flows",
        "scenario": "Advanced security review",
        "prompt": "Create an HTML diagram for [system]. Highlight authentication, encrypted traffic, trust boundaries, message buses, and data stores."
      },
      {
        "title": "Convert Requirements Into a Diagram",
        "scenario": "Advanced architecture planning",
        "prompt": "Read these architecture notes and produce a polished standalone HTML diagram. Resolve layout conflicts, extend the viewBox, and include summary cards: [notes]"
      }
    ],
    "output_examples": [
