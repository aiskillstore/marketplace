  "content": {
    "user_title": "Trace Federal Acquisition Policy with Evidence",
    "value_statement": "Federal acquisition policy changes across codified rules, deviations, notices, and guidance. This skill produces dated, sourced analysis with explicit status and decision boundaries.",
    "seo_keywords": [
      "federal acquisition policy",
      "FAR research",
      "DFARS analysis",
      "agency deviations",
      "acquisition rulemaking",
      "public comments",
      "policy impact brief",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Explains current FAR, DFARS, and agency-supplement text using published federal sources.",
      "Determines documented agency policy status for a specified FAR part and date.",
      "Compares codified text, RFO model text, and agency-issued deviations.",
      "Traces proposed rules, final rules, effective dates, withdrawals, and corrections.",
      "Analyzes defined samples of public comments while preserving coverage limitations.",
      "Builds and validates a DOCX Acquisition Policy Impact Brief from an approved research record."
    ],
    "limitations": [
      "It does not provide legal advice or procurement-specific applicability determinations.",
      "Complete research depends on the required federal MCP servers and their available operations.",
      "It does not select clauses, execute market research, price acquisitions, or pursue opportunities.",
      "Formal briefs require Python, python-docx, LibreOffice, and manual visual review."
    ],
    "use_cases": [
      {
        "title": "Verify Agency Policy Status",
        "description": "Compare codified rules and agency deviations for a defined procurement date and FAR part.",
        "target_user": "Contracting policy analyst"
      },
      {
        "title": "Assess Regulatory Change",
        "description": "Trace a rulemaking timeline and summarize documented operational effects for an industry audience.",
        "target_user": "Industry compliance team"
      },
      {
        "title": "Review Public Comments",
        "description": "Analyze a bounded comment sample with recorded search terms, coverage, exclusions, and limitations.",
        "target_user": "Public-interest researcher"
      }
    ],
    "prompt_templates": [
      {
        "title": "Explain a Current Rule",
        "prompt": "Explain FAR 15.404-1 as of 2026-08-24. Distinguish codified requirements from guidance and cite official sources.",
        "scenario": "Beginner lookup of a specific codified provision"
      },
      {
        "title": "Determine Agency Status",
        "prompt": "Determine documented policy status for [agency], FAR Part [number], as of [date]. Ask for missing procurement dates before retrieval.",
        "scenario": "Agency-specific status review"
      },
      {
        "title": "Compare Policy Layers",
        "prompt": "Compare eCFR text, RFO model text, and [agency] deviation for FAR Part [number]. Preserve scope, effective dates, exclusions, and conflicts.",
        "scenario": "Multi-source deviation analysis"
      },
      {
        "title": "Analyze Comments and Brief",
        "prompt": "Analyze comments for docket [ID] using an approved sample, then prepare a neutral Acquisition Policy Impact Brief with evidence IDs and limitations.",
        "scenario": "Advanced public-comment analysis and formal reporting"
      }
    ],
    "output_examples": [
      {
        "input": "Explain the current FAR rule for a cited provision as of a specified date.",
        "output": [
          "Documented status: Current codified text as of the requested date.",
          "Authority layers: Codified text is separated from later notices and guidance.",
          "Limitations: Procurement-specific applicability remains with authorized officials."
        ]
      },
      {
        "input": "Compare an agency deviation with RFO model text and the eCFR baseline.",
        "output": [
          "Comparison: Each source is listed with scope, effective date, and exclusions.",
          "Status: Model text is not treated as operative without agency adoption.",
          "Conflict handling: Material disagreements remain documented and unresolved."
        ]
      },
      {
        "input": "Prepare an Acquisition Policy Impact Brief from approved findings.",
        "output": "A validated DOCX brief presents the executive summary, status, timeline, impacts, evidence register, limitations, and reserved determinations."
      }
    ],
    "best_practices": [
      "Provide the exact question, as-of date, agency, FAR part, and relevant procurement dates.",
      "Approve the source plan before multi-source analysis or formal brief generation.",
      "Review evidence, conflicts, limitations, and status classifications before approving a brief."
    ],
    "anti_patterns": [
      "Do not send private, proprietary, classified, credential-bearing, or source-selection information to public research tools.",
      "Do not treat model deviations, proposed rules, or future-effective rules as current agency policy.",
      "Do not use sampled public comments as authority, consensus, or a representative survey."
    ],
    "faq": [
      {
        "question": "Which acquisition sources does this skill use?",
        "answer": "It uses eCFR, Federal Register, Regulations.gov, and Acquisition.gov capabilities when required by the selected mode."
      },
      {
        "question": "Can it determine which clause applies to my procurement?",
        "answer": "No. Clause selection and procurement-specific applicability determinations remain outside this skill."
      },
      {
        "question": "Can it analyze an agency deviation?",
        "answer": "Yes. It preserves the deviation scope, effective date, exclusions, transition rules, and supersession language."
      },
      {
        "question": "Does it analyze public comments?",
        "answer": "Yes. It records search terms, sample methods, reviewed counts, coverage, exclusions, and limitations."
      },
      {
        "question": "Can it create a formal report?",
        "answer": "Yes. It can generate a validated DOCX Acquisition Policy Impact Brief after the research record and findings receive approval."
      },
      {
        "question": "What happens when required tools are unavailable?",
        "answer": "It reports the missing capability and offers a narrower product supported by available official sources."
      }
    ]
  },
