    "faq": [
      {
        "question": "What does pytest-recording add to pytest?",
        "answer": "It integrates VCR.py so tests can record HTTP interactions as cassettes and replay them later."
      },
      {
        "question": "Where are cassettes stored?",
        "answer": "The documented default is tests/cassettes, organized by test module and test name."
      },
      {
        "question": "Which recording mode should I use first?",
        "answer": "Use once to create missing cassettes while preserving existing recordings."
      },
      {
        "question": "How do I prevent credential leaks?",
        "answer": "Filter sensitive headers and query parameters, sanitize responses, and inspect cassette contents before committing them."
      },
      {
        "question": "Why does a recorded request fail to match?",
        "answer": "The current method, URL fields, or query values may differ from the criteria stored in the cassette."
      },
