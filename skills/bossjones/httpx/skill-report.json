    "actual_capabilities": [
      "Creates synchronous and asynchronous HTTPX request patterns.",
      "Configures basic, bearer, and custom authentication.",
      "Implements streaming downloads and uploads.",
      "Adds timeout, status, request error, and retry handling.",
      "Builds reusable synchronous and asynchronous API client classes.",
      "Shows connection pooling, HTTP/2 installation, and WebSocket integration."
    ],
    "limitations": [
      "Provides guidance and examples but does not execute or verify requests.",
