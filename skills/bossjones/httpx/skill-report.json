    "output_examples": [
      {
        "input": "Create a synchronous client for a bearer-authenticated user API.",
        "output": "A reusable client design with a base URL, authorization header, timeout, status checks, typed methods, and deterministic cleanup."
      },
      {
        "input": "Download a large archive without loading it into memory.",
        "output": "A streaming workflow that reads response chunks, writes them incrementally, checks failures, and closes network and file resources."
      },
      {
        "input": "Fetch several profile endpoints concurrently.",
        "output": "An asynchronous client workflow that reuses connections, gathers requests, preserves per-request errors, and closes the client."
      }
    ],
    "best_practices": [
      "Reuse a client instance to benefit from connection pooling.",
      "Set explicit connect, read, write, and pool timeouts.",
