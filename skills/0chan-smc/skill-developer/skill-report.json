      },
      {
        "title": "Add Hooks and Commands",
        "prompt": "Use this guide to plan hooks, agents, and slash commands for a team workflow. Include where each component belongs.",
        "scenario": "Advanced workflow design"
      },
      {
        "title": "Audit an Existing Skill System",
        "prompt": "Use this guide to review an existing Claude Code skill setup. Find missing trigger coverage, over-triggering risks, and documentation gaps.",
        "scenario": "Advanced review"
      }
    ],
    "output_examples": [
      {
        "input": "I need a skill for frontend standards.",
        "output": "A concise implementation plan with the skill name, purpose, suggested trigger keywords, file patterns, and documentation sections."
      },
      {
        "input": "Our skill triggers too often in test files.",
        "output": "A troubleshooting checklist that narrows path exclusions, refines prompt triggers, and lowers priority when activation is optional."
      },
      {
        "input": "We want a command for release checks.",
        "output": "A workflow outline showing the command purpose, related agent responsibilities, hook points, and testing steps."
      }
    ],
    "best_practices": [
      "Keep each skill focused on one workflow or domain.",
      "Use specific file and prompt triggers to avoid unnecessary activation.",
      "Document enforcement and priority choices so teams understand activation behavior."
    ],
