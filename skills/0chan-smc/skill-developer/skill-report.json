      "developer workflow"
    ],
    "actual_capabilities": [
      "Explains when to create skills, hooks, agents, slash commands, and trigger rules.",
      "Shows the expected directory layout for Claude Code skill files and resources.",
      "Describes skill-rules.json fields for enforcement, priority, file triggers, and prompt triggers.",
      "Provides examples for path patterns, exclusions, content patterns, and intent patterns.",
      "Gives checklists for integrating new skills and troubleshooting activation problems."
    ],
    "limitations": [
      "It is documentation only and does not generate files by itself.",
      "It does not validate configuration files or run automated tests.",
      "It focuses on Claude Code workflows, not general plugin systems.",
      "Examples require adaptation to each repository structure."
    ],
    "use_cases": [
      {
        "title": "Create a Team Skill",
        "description": "Plan a focused Claude Code skill with clear purpose, structure, resources, and activation rules.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Configure Activation Rules",
        "description": "Define prompt triggers, file triggers, enforcement, and priority for a repeatable developer workflow.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Troubleshoot Skill Triggers",
        "description": "Diagnose missing activations, broad matches, and path exclusion problems in an existing setup.",
        "target_user": "Developer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Basic Skill",
        "prompt": "Use the skill-developer guide to outline a new Claude Code skill for my repository. Include name, description, files, and trigger ideas.",
