  "content": {
    "user_title": "Build Claude Code Skills",
    "value_statement": "Teams need consistent guidance when creating AI workflow components. This skill explains how to structure Claude Code skills, triggers, hooks, agents, and commands.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "skill development",
      "AI skill marketplace",
      "Claude Code hooks",
      "agent configuration",
      "slash commands",
      "skill triggers",
      "workflow automation"
    ],
    "actual_capabilities": [
      "Explains how to create a skill directory and SKILL.md file.",
      "Documents skill-rules.json fields for prompt and file triggers.",
      "Compares suggest, block, and warn enforcement modes.",
      "Shows examples for path patterns, exclusions, and content patterns.",
      "Provides checklists for adding and testing new skills.",
      "Covers related workflow components such as hooks, agents, and commands."
    ],
    "limitations": [
      "It is documentation only and does not generate files by itself.",
      "Examples focus on Claude Code conventions and may need project-specific changes.",
      "It does not validate regular expressions or trigger behavior automatically.",
      "It does not include a complete hook or agent implementation template."
    ],
    "use_cases": [
      {
        "title": "Create a Team Skill",
        "target_user": "Engineering lead",
        "description": "Define a reusable Claude Code skill with clear activation rules and project-specific guidance."
      },
      {
        "title": "Tune Trigger Rules",
        "target_user": "Developer experience engineer",
        "description": "Adjust prompt triggers, file triggers, exclusions, priority, and enforcement to reduce unwanted activations."
      },
      {
        "title": "Document Workflow Components",
        "target_user": "Tooling maintainer",
        "description": "Prepare consistent documentation for skills, hooks, agents, slash commands, and related workflow settings."
      }
    ],
    "prompt_templates": [
      {
        "title": "Plan a Basic Skill",
        "scenario": "Beginner skill creation",
        "prompt": "Use the skill-developer guidance to outline a new Claude Code skill for my project. Include name, purpose, when to use it, and the first SKILL.md sections."
      },
      {
        "title": "Draft Trigger Rules",
        "scenario": "Add activation settings",
        "prompt": "Help me design skill-rules.json triggers for a skill about [topic]. Include prompt keywords, intent patterns, path patterns, exclusions, priority, and enforcement."
      },
      {
        "title": "Review Skill Activation",
        "scenario": "Debug trigger behavior",
        "prompt": "Review these skill trigger rules and explain why the skill may over-trigger or fail to trigger. Suggest focused corrections."
      },
      {
        "title": "Design a Workflow Suite",
        "scenario": "Advanced Claude Code infrastructure planning",
        "prompt": "Design a coordinated Claude Code workflow using skills, hooks, agents, and slash commands for [workflow]. Include component boundaries and testing steps."
      }
    ],
    "output_examples": [
      {
        "input": "Create a frontend review skill for a React app.",
        "output": "A structured plan with the skill name, use conditions, suggested SKILL.md sections, trigger keywords, file patterns, exclusions, and activation priority."
      },
      {
        "input": "My skill triggers on too many files.",
        "output": "A focused troubleshooting report that recommends narrower path patterns, stronger exclusions, more specific keywords, and lower priority where appropriate."
      },
      {
        "input": "Plan skills, hooks, and commands for release checks.",
        "output": "A workflow outline that separates documentation guidance, automated checks, specialized agents, slash commands, and validation steps."
      }
    ],
    "best_practices": [
      "Keep the main SKILL.md concise and move detailed references into resources.",
      "Use specific triggers and exclusions that match the real project structure.",
      "Test activation rules after each change and document expected behavior."
    ],
    "anti_patterns": [
      "Do not use broad keywords that trigger the skill for unrelated work.",
      "Do not put every detail in the main skill file when references would be clearer.",
      "Do not set blocking enforcement without a clear guardrail reason."
    ],
    "faq": [
      {
        "question": "What does this skill help create?",
        "answer": "It helps plan and document Claude Code skills, hooks, agents, slash commands, and activation rules."
      },
      {
        "question": "Does it create files automatically?",
