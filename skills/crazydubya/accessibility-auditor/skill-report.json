  "content": {
    "user_title": "Audit Web Accessibility Faster",
    "value_statement": "Accessibility defects can block users and delay release reviews. This skill guides Claude, Codex, and Claude Code through WCAG-focused checks and practical fixes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "accessibility audit",
      "WCAG 2.1 AA",
      "ARIA review",
      "keyboard navigation",
      "screen reader testing",
      "frontend accessibility",
      "axe Lighthouse"
    ],
    "actual_capabilities": [
      "Reviews semantic HTML, heading order, landmarks, and proper button or link usage.",
      "Checks ARIA roles, labels, live regions, and descriptions for common UI patterns.",
      "Evaluates keyboard access, tab order, focus indicators, modal focus, and skip links.",
      "Reviews image alt text, form labels, errors, and status announcements.",
      "Provides WCAG 2.1 AA checklist coverage for perceivable, operable, understandable, and robust requirements.",
      "Suggests automated checks with Lighthouse, axe, pa11y, and jest-axe."
    ],
    "limitations": [
      "It reviews source and guidance; it does not run browser or screen reader tests by itself.",
      "It cannot certify legal compliance or replace an accessibility specialist.",
      "Automated tool commands require local setup, network approval, and package review.",
      "The checklist targets WCAG 2.1 AA, not every WCAG 2.2 criterion."
    ],
    "use_cases": [
      {
        "title": "Audit a UI Component",
        "description": "Review a component before merge and get prioritized accessibility fixes.",
        "target_user": "Frontend engineer"
      },
      {
        "title": "Validate a Release Flow",
        "description": "Check keyboard paths, labels, contrast, and status messages before launch.",
        "target_user": "QA accessibility tester"
      },
      {
        "title": "Improve Shared Widgets",
        "description": "Review buttons, modals, tabs, forms, and live regions for reusable patterns.",
        "target_user": "Design system maintainer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review a Component",
        "scenario": "Beginner component audit",
        "prompt": "Audit the selected component for WCAG 2.1 AA issues. Focus on semantic HTML, labels, alt text, and clear fixes."
      },
      {
        "title": "Check Keyboard Behavior",
        "scenario": "Intermediate interaction review",
        "prompt": "Review this interaction for keyboard access and focus behavior. Identify blockers, explain user impact, and suggest implementation changes."
      },
      {
        "title": "Plan an Audit",
        "scenario": "Advanced release preparation",
        "prompt": "Create an accessibility audit plan for this flow. Include manual tests, automated checks, expected evidence, and risk priorities."
      },
      {
        "title": "Review a Custom Widget",
        "scenario": "Advanced ARIA pattern review",
        "prompt": "Review this custom widget against ARIA authoring patterns. Verify roles, states, properties, keyboard controls, and screen reader announcements."
      }
    ],
    "output_examples": [
      {
        "input": "Audit a signup form with unlabeled fields and color-only errors.",
        "output": [
          "Fields need visible labels or accessible names.",
          "Color-only errors need text and an alert relationship.",
          "Fix priority is high because users may miss required corrections."
        ]
      },
      {
        "input": "Review a modal dialog for keyboard support.",
        "output": [
          "Move focus into the dialog when it opens.",
          "Trap focus until close, then return focus to the trigger.",
          "Add a clear accessible name and Escape key behavior."
        ]
      },
      {
        "input": "Prepare an accessibility checklist for a dashboard release.",
        "output": [
          "Cover headings, landmarks, contrast, forms, keyboard paths, and live updates.",
          "Run automated checks, then verify results with keyboard and screen reader testing."
        ]
      }
    ],
    "best_practices": [
      "Share the component, user flow, and expected assistive technology behavior.",
      "Ask for severity, user impact, and specific remediation steps.",
      "Combine automated scans with keyboard-only and screen reader testing."
    ],
    "anti_patterns": [
      "Treating an automated score as full accessibility compliance.",
      "Adding ARIA before checking whether native HTML solves the problem.",
      "Running optional external audit commands without approving packages and target URLs."
    ],
    "faq": [
      {
        "question": "Which standards does it use?",
        "answer": "It focuses on WCAG 2.1 Level AA and common ARIA guidance."
      },
      {
        "question": "Can it run accessibility tools?",
        "answer": "The skill documents Lighthouse, axe, pa11y, and jest-axe, but it does not execute them automatically."
      },
      {
        "question": "Does it certify compliance?",
        "answer": "No. It supports review and remediation, but legal certification needs qualified human assessment."
      },
      {
        "question": "What inputs work best?",
        "answer": "Provide component code, templates, styles, screenshots, and the main user flow."
      },
      {
        "question": "Does it support screen readers?",
        "answer": "It checks screen reader considerations and suggests manual tests with NVDA, JAWS, VoiceOver, or similar tools."
      },
      {
