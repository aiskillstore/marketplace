  "content": {
    "user_title": "Improve Test Coverage",
    "value_statement": "Coverage reports can be hard to turn into useful test work. This skill reads coverage gaps and recommends concrete tests for the files and branches that matter most.",
    "seo_keywords": [
      "Claude test coverage",
      "Codex test coverage",
      "Claude Code test coverage",
      "coverage analysis",
      "test gap analysis",
      "unit test suggestions",
      "Jest coverage",
      "pytest coverage",
      "Go test coverage",
      "quality assurance"
    ],
    "actual_capabilities": [
      "Detects common test frameworks across JavaScript, Python, Ruby, Go, and Java projects.",
      "Locates common coverage report outputs such as lcov.info, coverage.json, .coverage, and coverage.out.",
      "Summarizes overall coverage, file-level gaps, and missing line ranges when reports are available.",
      "Prioritizes untested code paths by business impact, risk, complexity, and ease of adding tests.",
      "Suggests specific test cases for happy paths, errors, edge cases, and integration behavior.",
      "Provides optional test stub templates for JavaScript, Python, and Go."
    ],
    "limitations": [
      "It needs existing source files and preferably a generated coverage report to produce precise recommendations.",
      "It cannot guarantee that suggested tests compile without project-specific imports and fixtures.",
      "It does not replace human judgment about which behavior is important to test.",
      "It may need user approval before running local coverage commands or writing test stubs."
    ],
    "use_cases": [
      {
        "title": "Plan Coverage Improvements",
        "description": "Identify the files and branches that should receive new tests before a quality sprint.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Add Missing Unit Tests",
        "description": "Turn uncovered lines from a coverage report into clear test cases with inputs and expected behavior.",
        "target_user": "Application developers"
      },
      {
        "title": "Review Risky Untested Code",
        "description": "Prioritize gaps in authentication, payments, validation, and other critical paths before release.",
        "target_user": "QA engineers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find Coverage Gaps",
        "scenario": "Beginner request with an existing report.",
        "prompt": "Analyze my coverage report and list the files with the largest gaps. Explain which tests I should add first."
      },
      {
        "title": "Suggest Unit Tests",
        "scenario": "Focused request for one source file.",
        "prompt": "Review this source file and its uncovered lines. Suggest unit tests with inputs, expected results, and covered branches."
      },
      {
        "title": "Prioritize Critical Paths",
        "scenario": "Release preparation for risky code.",
        "prompt": "Compare the uncovered code against authentication, payment, and validation flows. Rank the missing tests by release risk."
      },
      {
        "title": "Create Test Stubs",
        "scenario": "Advanced request for implementation support.",
        "prompt": "Use the current framework to draft test stubs for the highest-priority gaps. Include TODO comments for project-specific fixtures."
      }
    ],
    "output_examples": [
      {
        "input": "A Jest coverage report shows low branch coverage in a validator module.",
        "output": "The skill reports overall coverage, identifies the validator as high priority, and suggests invalid email, empty input, and special character tests."
      },
      {
        "input": "A Python service has uncovered error handlers after running pytest coverage.",
        "output": "The skill lists missing exception paths, recommends pytest cases for failure inputs, and notes any fixtures needed before implementation."
      },
      {
        "input": "A Go package has a coverage.out file and several untested table-driven cases.",
        "output": "The skill summarizes Go coverage, highlights functions below target coverage, and proposes table rows for boundary and error cases."
      }
    ],
    "best_practices": [
      "Generate a fresh coverage report before asking for detailed recommendations.",
      "Review existing tests so suggested cases do not duplicate current coverage.",
      "Prioritize tests for behavior, critical paths, and error handling before simple coverage percentage gains."
    ],
    "anti_patterns": [
      "Do not chase 100 percent coverage without considering business value.",
      "Do not accept generated stubs without replacing placeholders and validating imports.",
      "Do not run coverage commands on untrusted repositories without reviewing project scripts first."
    ],
    "faq": [
      {
        "question": "Which coverage tools can it understand?",
        "answer": "It describes workflows for Jest, Vitest, Mocha, pytest, coverage.py, Go coverage, JUnit, and JaCoCo."
      },
      {
        "question": "Does it run tests automatically?",
        "answer": "The skill can suggest coverage commands, but command execution should be confirmed by the user in each project."
      },
      {
        "question": "Can it create new test files?",
        "answer": "It can draft stubs when requested, but placeholders must be adapted to the project before use."
      },
      {
        "question": "Does it need a coverage report?",
        "answer": "A report gives the most accurate output. Without one, it can still inspect code and suggest likely missing tests."
      },
      {
        "question": "Can it prioritize tests by risk?",
        "answer": "Yes. It focuses first on critical business logic, security-sensitive code, error handling, and complex branches."
