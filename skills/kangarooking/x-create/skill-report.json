    "user_title": "Create X Posts and Threads",
    "value_statement": "Writing consistent X content is hard when each post needs a clear hook, style, and format. This skill drafts tweets, threads, and replies from a persona and post patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "X post generator",
      "Twitter thread writer",
      "social media prompts",
      "tweet templates",
      "viral post patterns",
      "AI writing assistant",
      "Chinese X content"
    ],
    "actual_capabilities": [
      "Drafts short X posts, multi-post threads, and replies.",
      "Supports high-value, sharp opinion, trending comment, story insight, and tech analysis styles.",
      "Uses a saved profile to match account focus, audience, and tone.",
      "Checks optional template examples before using default post patterns.",
      "Suggests posting time, image ideas, and expected engagement."
    ],
    "limitations": [
      "It does not publish to X by itself.",
      "Output quality depends on the user profile and reference templates.",
      "Trending comments need current event details from the user.",
      "Users should not store secrets in profile or template files."
    ],
    "use_cases": [
      {
        "title": "Founder Launch Thread",
        "description": "Turn a product update into a clear X thread with a strong opening and practical details.",
        "target_user": "Startup founders"
      },
      {
        "title": "Creator Daily Posts",
        "description": "Create short posts that match a saved tone and repeatable content style.",
        "target_user": "Independent creators"
      },
      {
        "title": "Technical Commentary",
        "description": "Explain a technical trend with a structured angle, examples, and a concise takeaway.",
        "target_user": "Developer advocates"
      }
    ],
    "prompt_templates": [
      {
        "title": "Draft a Short Post",
        "prompt": "Create a short X post about [topic] for my audience. Use a clear hook and concise ending.",
        "scenario": "Beginner short post"
      },
      {
        "title": "Build a Practical Thread",
        "prompt": "Create a 5-post X thread about [topic] using the high-value style. Keep each post focused and actionable.",
        "scenario": "Intermediate thread creation"
      },
      {
        "title": "Write a Sharp Reply",
        "prompt": "Draft a sharp-opinion reply to this post: [paste post]. Match my profile, add one strong argument, and avoid insults.",
        "scenario": "Advanced reply writing"
      },
      {
        "title": "Compare Thread Variants",
        "prompt": "Create two variants for a tech-analysis thread on [topic]. Compare hooks, structure, posting time, and expected engagement.",
        "scenario": "Advanced content testing"
      }
    ],
    "output_examples": [
      {
        "input": "Create a short post about using AI to summarize meetings.",
        "output": "A concise X post with a pain-focused opening, three practical tips, and a useful closing line."
      },
      {
        "input": "Create a thread about a new AI coding feature.",
        "output": [
          "Five numbered thread entries with a clear hook and technical explanation.",
          "A final post with a takeaway, discussion prompt, and publishing suggestion."
        ]
      },
      {
        "input": "Reply to a trending post about remote work.",
        "output": "A brief reply that adds one perspective, explains the tradeoff, and invites discussion."
      }
    ],
    "best_practices": [
      "Complete onboarding before asking for production content.",
      "Provide one topic, target audience, and desired post type in each request.",
      "Add three to five reference posts when you want a specific voice."
    ],
    "anti_patterns": [
      "Asking for a viral post without a topic or audience.",
      "Treating engagement predictions as guaranteed performance.",
      "Saving private credentials or confidential strategy notes as style examples."
