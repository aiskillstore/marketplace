        "title": "Choose a Production Topology",
        "description": "Compare supervisor, swarm, and hierarchy patterns before adding agents to a workflow.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Reduce Coordination Failures",
        "description": "Add consensus, circuit breakers, and checkpoints to prevent drift and repeated failures.",
        "target_user": "Platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose an Architecture",
        "scenario": "Beginner pattern selection",
        "prompt": "Use the multi-agent patterns skill to assess this workflow: [describe workflow]. Recommend single agent, supervisor, swarm, or hierarchy. Explain the tradeoffs."
      },
      {
