  "content": {
    "user_title": "Evaluate LLM Outputs with Reliable Judge Rubrics",
    "value_statement": "LLM evaluation can drift when rubrics, metrics, and bias checks are unclear. This skill gives practical patterns for judge prompts, pairwise reviews, scoring calibration, and reliability monitoring.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "LLM evaluation",
      "LLM-as-judge",
      "rubric calibration",
      "pairwise comparison",
      "bias mitigation",
      "confidence scoring",
      "automated quality assessment"
    ],
    "actual_capabilities": [
      "Design direct scoring prompts with criteria, weights, evidence, and structured outputs.",
      "Build pairwise comparison workflows with position swapping and consistency checks.",
      "Create scoring rubrics with levels, characteristics, edge cases, and strictness settings.",
      "Choose validation metrics such as precision, recall, F1, kappa, and rank correlation.",
      "Identify position, length, verbosity, authority, and self-enhancement bias risks.",
      "Plan evaluation pipelines with human review, confidence calibration, and quality monitoring."
    ],
    "limitations": [
      "It does not call model APIs or run evaluations by itself.",
      "It requires representative examples and human judgments for strong calibration.",
      "Metric thresholds must be validated on the target dataset.",
      "It does not replace safety review for high-stakes deployment decisions."
    ],
    "use_cases": [
      {
        "title": "Benchmark prompt changes",
        "description": "Create scoring rubrics and comparison flows for prompt iterations before release.",
        "target_user": "Prompt engineer"
      },
      {
        "title": "Compare model candidates",
        "description": "Use pairwise judging and position swapping to compare model outputs with less bias.",
        "target_user": "AI product team"
      },
      {
        "title": "Monitor judge reliability",
        "description": "Select metrics that track agreement, score drift, and bias patterns over time.",
        "target_user": "Evaluation lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a basic scoring rubric",
        "scenario": "Beginner rubric design for one evaluation criterion.",
        "prompt": "Create a 1 to 5 scoring rubric for [criterion]. Include clear level descriptions, observable traits, and edge cases."
      },
      {
        "title": "Design a direct scoring judge",
        "scenario": "Evidence-based evaluation of one response.",
        "prompt": "Design an LLM-as-judge prompt for [task]. Use criteria, weights, evidence requirements, score justifications, and one improvement per criterion."
      },
      {
        "title": "Compare two responses fairly",
        "scenario": "Pairwise comparison with position bias mitigation.",
        "prompt": "Build a pairwise evaluation workflow for responses A and B. Include swapped positions, tie handling, confidence scoring, and final decision rules."
      },
      {
        "title": "Audit an evaluation system",
        "scenario": "Advanced review of reliability, bias, and metric coverage.",
        "prompt": "Review this evaluation design: [design]. Find risks in rubric clarity, judge bias, confidence calibration, metric choice, and human validation."
      }
    ],
    "output_examples": [
      {
        "input": "A team needs to score factual accuracy for support answers.",
        "output": "The skill produces criteria for factual correctness, evidence grounding, completeness, and unsupported claims. It recommends evidence-first scoring and human spot checks for calibration."
      },
      {
        "input": "Two model responses must be compared for clarity and usefulness.",
        "output": "The skill recommends two judge passes with swapped positions. A consistent winner receives averaged confidence, while disagreement becomes a tie."
      },
      {
        "input": "An existing judge gives high scores to long responses.",
        "output": "The skill identifies length bias and suggests length-neutral instructions, conciseness criteria, and correlation monitoring."
      }
    ],
    "best_practices": [
      "Require evidence before numeric scores so judgments can be audited.",
      "Use position swapping for pairwise comparisons to reduce order effects.",
      "Validate automated scores against human judgments before relying on them."
    ],
    "anti_patterns": [
      "Using one vague quality score for several unrelated criteria.",
      "Treating longer answers as better without a conciseness criterion.",
      "Deploying judge prompts without regression tests or bias monitoring."
    ],
    "faq": [
      {
        "question": "What type of evaluations does this skill cover?",
        "answer": "It covers LLM-as-judge scoring, pairwise comparison, rubric design, confidence scoring, and bias mitigation."
      },
      {
        "question": "Can it run model evaluations automatically?",
        "answer": "No. It provides design patterns, examples, and guidance for building evaluation workflows."
      },
      {
        "question": "Does it support pairwise model comparison?",
        "answer": "Yes. It explains position swapping, winner mapping, tie handling, and confidence aggregation."
      },
      {
        "question": "How does it address evaluator bias?",
        "answer": "It covers position, length, verbosity, authority, and self-enhancement bias with mitigation techniques."
      },
      {
        "question": "Which metrics does it recommend?",
        "answer": "It maps use cases to precision, recall, F1, kappa, Spearman correlation, Kendall tau, and agreement rate."
      },
      {
        "question": "Is human review still needed?",
        "answer": "Yes. Human judgments are needed to calibrate rubrics, validate thresholds, and review uncertain cases."
      }
    ]
  },
