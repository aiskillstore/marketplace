    "user_title": "Design Reliable Agent Tools",
    "value_statement": "Ambiguous tools cause routing errors, malformed calls, and failed recovery. This skill provides practical patterns for clear schemas, descriptions, responses, and tool catalogs.",
    "seo_keywords": [
      "Claude tool design",
      "Codex tool design",
      "Claude Code tools",
      "MCP tool schemas",
      "agent tool descriptions",
      "tool response formats",
      "tool error recovery",
      "agent tool evaluation",
      "tool catalog consolidation"
    ],
    "actual_capabilities": [
      "Structures tool descriptions around purpose, activation conditions, inputs, outputs, and errors.",
      "Builds in-memory tool specifications with parameters, return metadata, triggers, examples, and error definitions.",
      "Renders structured Markdown descriptions from tool specifications.",
      "Scores descriptions for clarity, completeness, accuracy, actionability, and naming consistency.",
      "Creates recoverable error-message templates for validation, missing records, and rate limits.",
      "Guides MCP namespacing, tool consolidation, response formats, and sandboxed architectural reduction."
    ],
    "limitations": [
      "The evaluator uses simple text heuristics and does not measure real agent success.",
      "The utility does not register tools, run MCP servers, or call external services.",
      "Generated descriptions still require review against the implemented API behavior.",
      "Command-tool examples require a correctly isolated sandbox and separate security controls."
    ],
    "use_cases": [
      {
        "title": "Define a new agent tool",
        "description": "Create a complete description, schema, response shape, and recovery contract before implementation.",
        "target_user": "Agent application developers"
      },
      {
        "title": "Audit an MCP catalog",
        "description": "Identify overlapping purposes, naming collisions, inconsistent parameters, and unclear selection guidance.",
        "target_user": "MCP server maintainers"
      },
      {
        "title": "Improve failed tool calls",
        "description": "Use observed failures to clarify descriptions, constraints, examples, and retry guidance.",
        "target_user": "AI quality engineers"
      }
    ],
    "prompt_templates": [
