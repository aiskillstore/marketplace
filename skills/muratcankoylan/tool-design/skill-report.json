        "title": "Rewrite one tool description",
        "prompt": "Rewrite this tool description. State what it does, when to use it, accepted inputs, returned data, and recoverable errors: {description}",
        "scenario": "Beginner review of one existing tool"
      },
      {
        "title": "Design a complete tool contract",
        "prompt": "Design an agent tool for {workflow}. Include a verb-noun name, typed parameters, defaults, response formats, examples, errors, and retry guidance.",
        "scenario": "Creating a new agent-facing tool"
      },
      {
        "title": "Audit a tool catalog",
        "prompt": "Audit these tools for overlapping activation scenarios, inconsistent names, schema conflicts, namespace collisions, missing errors, and oversized responses: {catalog}",
        "scenario": "Improving routing across multiple tools"
      },
      {
        "title": "Evaluate architectural reduction",
        "prompt": "Compare specialized tools with a sandboxed primitive-tool design for {system}. Assess safety boundaries, routing accuracy, token cost, maintenance, and evaluation criteria.",
        "scenario": "Advanced architecture decision with explicit controls"
      }
    ],
    "output_examples": [
      {
        "input": "Review a customer lookup tool with an unclear description and generic errors.",
        "output": [
          "Purpose: Retrieve one customer record by a validated customer identifier.",
          "Use when: A request needs account details, status, or identity verification.",
          "Recovery: Name the invalid field, expected format, valid example, and retry action."
        ]
      },
      {
        "input": "Audit search_orders and find_orders in the same catalog.",
        "output": "The tools have overlapping activation scenarios. Merge them or define distinct data sources, filters, return shapes, and selection rules."
      },
      {
        "input": "Assess a catalog with inconsistent customer identifiers.",
        "output": "Standardize on customer_id across tool names, parameters, examples, responses, and errors. Add compatibility handling before removing older identifiers."
      }
    ],
    "best_practices": [
      "Describe purpose, activation conditions, parameters, returns, and errors as one self-contained contract.",
      "Use consistent verb-noun names, parameter terms, namespaces, and response fields across the catalog.",
      "Test representative requests and revise descriptions using observed routing and call failures."
    ],
    "anti_patterns": [
      "Do not publish vague descriptions that force the agent to guess scope or input formats.",
      "Do not create overlapping narrow tools when one workflow tool has a clearer purpose.",
      "Do not expose unrestricted command execution without isolation, least privilege, and explicit safety controls."
    ],
    "faq": [
      {
        "question": "Does this skill create working MCP servers?",
        "answer": "No. It guides interface design and provides local description utilities, but it does not implement or run an MCP server."
      },
      {
        "question": "Can it evaluate an existing tool description?",
        "answer": "Yes. The included evaluator checks five textual criteria, but real agent tests remain necessary."
      },
      {
        "question": "Does the Python utility access the network?",
        "answer": "No. It uses standard Python data structures, regular expressions, JSON formatting, and console output."
      },
      {
        "question": "When should tools be consolidated?",
        "answer": "Consolidate tools with overlapping selection scenarios or sequential steps. Keep tools separate when behaviors or independent calling needs differ."
      },
      {
        "question": "How should MCP tools be named?",
        "answer": "Use fully qualified server and tool names. Apply consistent verb-noun conventions and audit provider namespaces for collisions."
      },
      {
        "question": "Are command-tool examples safe by default?",
        "answer": "No. They require a real sandbox, limited data access, restricted privileges, monitoring, and separate security review."
      }
    ]
