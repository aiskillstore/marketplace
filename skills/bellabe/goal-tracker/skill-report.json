  "content": {
    "user_title": "Track Goal Progress and Gaps",
    "value_statement": "Goal work can drift when progress, gaps, and thread outcomes are scattered. This skill derives goal state and recommends next actions from execution records.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "goal tracker",
      "goal progress",
      "progress review",
      "operational goals",
      "goal management",
      "trajectory projection",
      "gap analysis"
    ],
    "actual_capabilities": [
      "Derives goal state from active goal files, linked threads, and artifacts.",
      "Aggregates active, completed, and blocked thread counts for execution status.",
      "Calculates metric gaps, trends, trajectory, projected completion, and risk level.",
      "Updates goal state sections with metrics, execution counts, trajectory, and logs.",
      "Generates progress reports with gaps, recommended actions, subgoal status, and next milestones.",
      "Checks autonomy mode before recommending or creating gap-closing threads."
    ],
    "limitations": [
      "Requires goal files and thread metadata to follow the LeanOS structure.",
      "Cannot verify outcomes that are not recorded in threads or artifacts.",
      "Should not modify objectives, success criteria, or goals without confirmation.",
      "Auto-created threads depend on the configured autonomy mode."
    ],
    "use_cases": [
      {
        "title": "Daily Progress Review",
        "description": "Operators get an on-demand status view across active goals before prioritizing work.",
        "target_user": "Operators"
      },
      {
        "title": "Goal Risk Triage",
        "description": "Founders identify off-track metrics, stale data, and urgent gaps before planning sessions.",
        "target_user": "Founders"
      },
      {
        "title": "Thread Completion Update",
        "description": "Project leads update goal metrics and subgoal status when execution threads finish learning.",
        "target_user": "Project leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Review Active Goals",
        "scenario": "Beginner status check",
        "prompt": "Review my active goals. Show status, progress, key gaps, recommended actions, subgoal status, and next milestone."
      },
      {
        "title": "Update a Goal State",
        "scenario": "Intermediate goal maintenance",
        "prompt": "Update the state section for goal [goal id] using linked threads and recent artifacts. Include metrics, trajectory, and a log entry."
      },
      {
        "title": "Prioritize Gap Actions",
        "scenario": "Advanced planning review",
        "prompt": "Compare all active goals against deadlines and success criteria. Rank gaps by urgency, explain risks, and propose actions by autonomy mode."
      },
      {
        "title": "Process Thread Completion",
        "scenario": "Advanced execution workflow",
        "prompt": "After thread [thread name] reaches Stage 6, update the linked goal, verify success criteria, and suggest follow-on work."
      }
    ],
    "output_examples": [
      {
        "input": "Review all active goals before planning.",
        "output": "A snapshot showing each goal status, key metrics, trajectory, gaps, recommended actions, and next milestone."
      },
      {
        "input": "Thread campaign-q1 completed Stage 6.",
        "output": "The linked goal is updated with new metrics, subgoal status, and a log entry. Follow-on actions are suggested when gaps remain."
      },
      {
        "input": "Goal has no linked threads.",
        "output": "A warning explains that execution is not activated and recommends creating initial threads for the first subgoal."
      }
    ],
    "best_practices": [
      "Keep thread status and Stage 6 learning current before running a review.",
      "Use ask mode for high-impact actions or unclear gap-closing work.",
      "Review stale data warnings before making planning decisions."
    ],
    "anti_patterns": [
      "Using the skill when goals have no linked threads or recorded outcomes.",
      "Treating projected completion as certain when source metrics are stale.",
      "Allowing auto mode for actions that need budget, legal, or strategic approval."
    ],
    "faq": [
      {
        "question": "Does this skill store daily snapshots?",
        "answer": "No. It computes snapshots on demand and uses goal files as persistent state."
      },
      {
        "question": "Can it create new threads?",
        "answer": "Yes, when the goal autonomy mode allows it. Ask mode presents recommendations first."
      },
      {
        "question": "Does it change success criteria?",
        "answer": "No. The skill explicitly avoids modifying goal objectives or success criteria."
      },
      {
        "question": "What data does it need?",
        "answer": "It needs goal files, linked thread state, Stage 6 learning, and relevant artifacts."
      },
      {
        "question": "How does it detect risk?",
        "answer": "It compares current metrics, target values, deadlines, and trends to project trajectory."
