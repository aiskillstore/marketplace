  "content": {
    "user_title": "Build Reliable LLM Evaluation Systems",
    "value_statement": "LLM evaluation is hard to make consistent across teams and models. This skill helps design judge prompts, rubrics, metrics, and bias checks for repeatable assessments.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "LLM-as-judge",
      "model evaluation",
      "evaluation rubrics",
      "pairwise comparison",
      "bias mitigation",
      "automated assessment",
      "quality scoring"
    ],
    "actual_capabilities": [
      "Explains when to use direct scoring, pairwise comparison, and reference-based evaluation.",
      "Provides prompt structures for evidence-based scoring and response comparison.",
      "Shows position swapping and other bias mitigation patterns for pairwise judging.",
      "Maps evaluation task types to precision, recall, kappa, and rank correlation metrics.",
      "Includes Python examples for scoring, rubric generation, confidence calibration, and output formatting.",
      "Recommends validation against human judgments and monitoring for systematic disagreement."
    ],
    "limitations": [
      "Does not provide a hosted evaluator or a complete production service.",
      "Requires adaptation to each domain, dataset, model, and scoring policy.",
      "Automated judging still needs human validation for high-stakes decisions.",
      "Example code is instructional and may need dependencies before production use."
    ],
    "use_cases": [
      {
        "title": "Evaluate Prompt Changes",
        "description": "Compare outputs from prompt variants with pairwise judging and position bias checks.",
        "target_user": "Prompt engineers"
      },
      {
        "title": "Create Scoring Rubrics",
        "description": "Define clear score levels, edge cases, and evidence requirements for consistent reviews.",
        "target_user": "Evaluation leads"
      },
      {
        "title": "Monitor Judge Reliability",
        "description": "Select agreement metrics and track gaps between automated scores and human decisions.",
        "target_user": "Data scientists"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose an Evaluation Method",
        "scenario": "Beginner planning task",
        "prompt": "Help me choose an evaluation method for this task: [task]. Explain whether direct scoring, pairwise comparison, or reference-based evaluation fits best."
      },
      {
        "title": "Draft a Simple Rubric",
        "scenario": "Intermediate rubric design",
        "prompt": "Create a 1 to 5 rubric for [criterion] in [domain]. Include level descriptions, observable signals, and edge case guidance."
      },
      {
        "title": "Design Pairwise Comparison",
        "scenario": "Advanced comparison workflow",
        "prompt": "Design a pairwise evaluation workflow for two model responses. Include position swapping, tie handling, confidence scoring, and failure cases."
      },
      {
        "title": "Audit an Evaluation Pipeline",
        "scenario": "Expert reliability review",
        "prompt": "Review this evaluation pipeline: [pipeline]. Identify bias risks, missing metrics, weak prompts, validation gaps, and concrete improvements."
      }
    ],
    "output_examples": [
      {
        "input": "Compare two chatbot answers for clarity and helpfulness.",
        "output": "A pairwise evaluation plan with swapped response order, clear criteria, tie rules, and confidence calibration."
      },
      {
        "input": "Build a rubric for code readability in pull request reviews.",
        "output": "A five-level rubric with observable traits, scoring guidelines, and edge cases for generated or domain-specific code."
      },
      {
        "input": "Measure whether an automated judge agrees with human reviewers.",
        "output": "A metric selection plan using agreement rates, kappa, rank correlation, and analysis of systematic disagreements."
      }
    ],
    "best_practices": [
      "Require evidence and justification before every score.",
      "Swap response positions during pairwise comparisons and map winners back correctly.",
      "Validate automated judgments against human review before using them for decisions."
    ],
    "anti_patterns": [
      "Using a single broad criterion that mixes several quality dimensions.",
      "Treating one model judge as final without calibration or review.",
      "Comparing responses once without checking position, length, or verbosity bias."
    ],
    "faq": [
      {
        "question": "What does this skill help evaluate?",
        "answer": "It helps evaluate LLM outputs, prompts, model changes, rubrics, and automated judge behavior."
      },
      {
        "question": "Does it run evaluations automatically?",
        "answer": "No. It provides methods, prompts, metrics, and example patterns for building evaluation workflows."
      },
      {
        "question": "Can it compare two model responses?",
        "answer": "Yes. It explains pairwise comparison with position swapping, confidence scoring, and tie handling."
      },
      {
        "question": "Does it cover bias mitigation?",
        "answer": "Yes. It covers position, length, verbosity, self-enhancement, and authority bias."
      },
      {
        "question": "Which tools can use this skill?",
        "answer": "The report lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "Is human review still needed?",
        "answer": "Yes. Human validation is important when results affect quality gates, safety, or user-facing decisions."
