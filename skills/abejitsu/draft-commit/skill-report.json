        "description": "Draft conventional commit messages that match project rules for type, scope, and supporting context.",
        "target_user": "Tech lead"
      },
      {
        "title": "Document maintenance work",
        "description": "Summarize staged documentation, cleanup, or configuration changes so history remains easy to scan.",
        "target_user": "Documentation maintainer"
      }
    ],
