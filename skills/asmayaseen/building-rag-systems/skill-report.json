        "prompt": "Use this skill to improve Qdrant retrieval for [use case]. Include payload indexes, filter logic, and context expansion rules."
      },
      {
        "title": "Review A RAG Architecture",
        "scenario": "Advanced architecture review",
        "prompt": "Use this skill to review my RAG design. Identify ingestion gaps, retrieval risks, scaling issues, and missing production controls."
      }
    ],
    "output_examples": [
      {
        "input": "Design ingestion for a Markdown course corpus.",
        "output": "The result recommends crawler, frontmatter parser, semantic chunker, embedding batcher, and Qdrant uploader stages."
      },
      {
        "input": "Improve retrieval for tenant-specific learning content.",
        "output": "The result defines required book and hardware filters, optional content filters, and context expansion from neighboring chunks."
      },
      {
        "input": "Reduce reindexing cost after documentation changes.",
        "output": "The result uses file hashes, stored payload metadata, and targeted deletes or uploads for changed files."
      }
    ],
    "best_practices": [
      "Index every Qdrant payload field used in filters.",
      "Use stable content hashes for chunk IDs and change detection.",
      "Add authentication and tenant checks around every retrieval endpoint."
    ],
    "anti_patterns": [
      "Using fixed character chunks without semantic boundaries.",
      "Running full reindexing when only a few files changed.",
      "Trusting request-supplied tenant IDs without authorization checks."
    ],
    "faq": [
