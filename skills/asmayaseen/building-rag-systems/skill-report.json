    "user_title": "Build Production RAG Systems",
    "value_statement": "Production RAG systems need reliable ingestion, chunking, filtering, and updates. This skill guides Claude, Codex, and Claude Code through practical Qdrant patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "RAG systems",
      "Qdrant vector search",
      "semantic chunking",
      "document ingestion",
      "filtered retrieval",
      "incremental indexing",
      "OpenAI embeddings"
    ],
    "actual_capabilities": [
      "Designs ingestion pipelines for Markdown document collections.",
      "Explains semantic chunking with section boundaries and overlap.",
      "Shows incremental indexing with content hashes and change detection.",
      "Defines Qdrant payload indexes for filtered retrieval.",
      "Guides context expansion through previous and next chunk links.",
      "Provides verification guidance for the included skill files."
    ],
    "limitations": [
      "Does not provide a complete deployable RAG application.",
      "Examples assume Qdrant, OpenAI embeddings, and Python patterns.",
      "Authentication, authorization, and secret management must be added by the user.",
      "Performance values are guidance and must be tested on real data."
    ],
    "use_cases": [
      {
        "title": "Plan A Document Ingestion Pipeline",
        "description": "Map documents into chunks, embeddings, payload metadata, and Qdrant upload steps.",
        "target_user": "AI application developer"
      },
      {
        "title": "Improve Retrieval Filters",
        "description": "Add tenant, module, chapter, hardware, and proficiency filters to vector search.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Design Incremental Reindexing",
        "description": "Use file hashes and Qdrant payloads to update only changed documents.",
        "target_user": "Data platform engineer"
      }
    ],
    "prompt_templates": [
      {
