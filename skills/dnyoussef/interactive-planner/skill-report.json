    "user_title": "Plan Requirements with Interactive Questions",
    "value_statement": "Ambiguous project requests often lead to missing requirements and rework. This skill guides Claude, Codex, and Claude Code through structured question batches.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "interactive planner",
      "requirements gathering",
      "project scoping",
      "planning questions",
      "multi-select prompts",
      "software specifications",
      "AI planning skill"
    ],
    "actual_capabilities": [
      "Designs four-question batches for project scoping.",
      "Guides multi-select choices for non-exclusive decisions.",
      "Covers scope, architecture, user experience, quality, and constraints.",
      "Synthesizes answers into an actionable project specification.",
      "Defines input and output contracts for planning sessions.",
      "Includes example question sets for localization and OAuth work."
    ],
    "limitations": [
      "It does not implement code or run tests.",
      "It requires user responses to complete planning.",
      "It works best when an interactive question tool is available.",
      "It can be excessive for simple tasks with clear requirements."
    ],
    "use_cases": [
      {
        "title": "Scope a New Product Feature",
        "target_user": "Product manager",
        "description": "Collect feature goals, user needs, constraints, and success criteria before development starts."
      },
      {
        "title": "Clarify Technical Architecture",
        "target_user": "Software engineer",
        "description": "Ask structured questions about frameworks, storage, authentication, testing, and deployment choices."
      },
      {
        "title": "Prepare Client Project Briefs",
        "target_user": "Consultant",
        "description": "Turn a broad client request into a clear specification with assumptions and open questions."
      }
    ],
