{
  "_comment": "SYNTHETIC example config for the contract layer. Paths are relative to this file.",
  "packages": [
    "packages/*"
  ],
  "protoPaths": [
    "proto"
  ],
  "prefixes": [
    "/api/v1"
  ],
  "infra": [
    "valkey-cart",
    "kafka"
  ],
  "services": {
    "frontend": {
      "repo": "services/frontend"
    },
    "checkout": {
      "repo": "services/checkout"
    },
    "cart": {
      "repo": "services/cart"
    },
    "currency": {
      "repo": "services/currency"
    },
    "payment": {
      "repo": "services/payment"
    },
    "shipping": {
      "repo": "services/shipping"
    },
    "quote": {
      "repo": "services/quote",
      "openapi": "openapi.json"
    },
    "email": {
      "repo": "services/email"
    },
    "accounting": {
      "repo": "services/accounting"
    },
    "product-catalog": {
      "repo": "services/product-catalog"
    }
  }
}
