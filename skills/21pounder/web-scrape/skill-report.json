    "faq": [
      {
        "question": "What does this skill scrape?",
        "answer": "It scrapes visible page content from a URL and turns it into cleaner markdown, JSON, text, or a screenshot."
      },
      {
        "question": "Does it require Playwright?",
        "answer": "Yes. The documented workflow depends on Playwright browser MCP tools for navigation, snapshots, scrolling, and screenshots."
      },
      {
        "question": "Can it scrape dynamic pages?",
        "answer": "Yes. The scroll option helps load lazy content before the page snapshot is captured."
      },
