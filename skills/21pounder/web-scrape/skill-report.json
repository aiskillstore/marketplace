  "content": {
    "user_title": "Extract Clean Web Content",
    "value_statement": "Web pages often include navigation, ads, and dynamic content that obscure useful information. This skill guides Claude, Codex, or Claude Code to capture pages and return clean content.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "web scraping skill",
      "content extraction",
      "Playwright scraping",
      "markdown extraction",
      "page snapshot",
      "web research automation",
      "HTML cleanup"
    ],
    "actual_capabilities": [
      "Navigates to a user-provided web page with Playwright browser tools.",
      "Waits for initial rendering before capturing a page snapshot.",
      "Optionally scrolls pages to trigger lazy-loaded content.",
      "Optionally saves full-page screenshots.",
      "Formats extracted content as markdown, JSON, or plain text.",
      "Filters common page noise such as navigation, footers, ads, and sidebars."
    ],
    "limitations": [
      "Requires available Playwright browser MCP tools.",
      "Cannot bypass CAPTCHA, paywalls, blocked pages, or access restrictions.",
      "May miss content hidden behind complex interactions unless requested.",
      "Must be used only with permission and relevant site policies."
    ],
    "use_cases": [
