        "title": "Research Article Extraction",
        "description": "Capture a readable article with title, source, author, date, and body content.",
        "target_user": "Researchers and analysts"
      },
      {
        "title": "Product Page Review",
        "description": "Extract prices, availability, descriptions, and specifications from public product pages.",
        "target_user": "Product managers and ecommerce analysts"
      },
      {
        "title": "Documentation Capture",
        "description": "Preserve headings, lists, and code-oriented structure from public documentation pages.",
        "target_user": "Engineers and technical writers"
      }
    ],
    "prompt_templates": [
