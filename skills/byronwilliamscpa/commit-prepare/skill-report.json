      "repository automation"
    ],
    "actual_capabilities": [
      "Reviews Git status plus staged and unstaged diffs for commit context.",
      "Classifies changes using conventional commit types and optional scopes.",
      "Drafts commit subjects, bodies, and footers, including breaking change notes.",
      "Helps choose whether to stage all changes or selected files.",
      "Shows the proposed commit message before executing any commit.",
      "Suggests post-commit checks such as viewing the latest commit and remaining changes."
    ],
    "limitations": [
      "Requires a local Git repository and shell access to inspect changes.",
      "Cannot infer product intent that is not visible in the diff or user context.",
      "Does not verify remote CI status, branch policy, or reviewer requirements.",
      "Multi-line commit execution still requires careful shell quoting review."
    ],
    "use_cases": [
