  "content": {
    "user_title": "Prepare Conventional Git Commits",
    "value_statement": "Writing clear commit messages from mixed changes can slow development. This skill reviews Git changes and prepares conventional commits for confirmation.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "git commit assistant",
      "conventional commits",
