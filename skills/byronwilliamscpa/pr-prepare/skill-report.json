  "content": {
    "user_title": "Prepare GitHub Pull Request Descriptions",
    "value_statement": "PR descriptions take time when changes span several files. This skill gathers git context and turns it into a structured GitHub-ready draft.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "pull request preparation",
      "PR description generator",
      "GitHub PR template",
      "code review workflow",
      "git diff summary",
      "conventional commit titles",
      "developer productivity"
    ],
    "actual_capabilities": [
      "Uses git status, git log, and git diff to inspect branch changes.",
      "Summarizes modified components, purpose, impact, and testing needs.",
      "Creates a GitHub-ready PR description with summary, changes, impact, testing, and notes.",
      "Suggests conventional commit style PR titles.",
      "Reminds users about CodeRabbit placeholders and GitHub CLI PR creation options."
    ],
    "limitations": [
      "Assumes main as the default base branch unless adjusted.",
      "Does not create or submit pull requests by itself.",
      "Depends on accessible git history and diff information.",
      "Does not verify test results unless output is available."
    ],
    "use_cases": [
      {
        "title": "Prepare a Feature PR",
        "description": "Turn a completed feature branch into a clear PR title and description for reviewers.",
        "target_user": "Application developer"
      },
      {
        "title": "Standardize Team PRs",
        "description": "Create consistent PR sections for summary, changes, impact, testing, and notes.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Review Diff Scope",
        "description": "Understand changed files and risks before opening a pull request.",
        "target_user": "Code reviewer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Draft a PR Description",
        "prompt": "Prepare the PR description for my current branch.",
        "scenario": "Beginner request for a complete PR draft."
      },
      {
        "title": "Compare Against Main",
        "prompt": "Compare my branch with main and draft a PR title and description.",
        "scenario": "Standard workflow using the default base branch."
      },
      {
        "title": "Include Testing Notes",
        "prompt": "Prepare a PR description and include testing notes from the commands I already ran.",
        "scenario": "Intermediate workflow with validation details."
      },
      {
        "title": "Analyze a Complex PR",
        "prompt": "Analyze the branch diff, group changes by component, call out risks, and produce a concise GitHub PR draft.",
        "scenario": "Advanced workflow for larger branches."
      }
    ],
    "output_examples": [
      {
        "input": "Prepare the PR for this branch.",
        "output": "A suggested PR title, a short summary, grouped changes, impact notes, a testing checklist, and follow-up notes."
      },
      {
        "input": "Create a PR description for my authentication changes.",
        "output": "A reviewer-friendly draft that names changed authentication files, explains user impact, and lists completed or needed validation."
      },
      {
        "input": "Write a PR draft and mention any risks.",
        "output": "A structured PR description with risk notes, testing status, and a conventional commit style title."
      }
    ],
    "best_practices": [
      "Review the generated summary against the actual diff before publishing.",
      "Run tests and linting before marking checklist items complete.",
      "Adjust the base branch when the project does not use main."
    ],
