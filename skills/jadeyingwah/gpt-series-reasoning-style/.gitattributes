# Line-ending policy: keep the repository 100% LF regardless of contributor OS/autocrlf.
# Working tree is normalized to LF as well (eol=lf), so checkouts stay identical on every platform.
* text=auto eol=lf

# Binary assets (never normalized)
*.png binary

# GitHub Linguist —— 本仓库是纯文本 skill。
# Markdown 计入语言统计；Python 和 YAML 也计入。
*.md linguist-detectable=true linguist-language=Markdown
*.py linguist-detectable=true linguist-language=Python
*.yml linguist-detectable=true linguist-language=YAML
