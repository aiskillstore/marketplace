  "content": {
    "user_title": "Enforce Code File Line Limits",
    "value_statement": "Large implementation files are hard to review, test, and maintain. This skill checks line counts and guides modular refactoring with clear thresholds.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "line limit",
      "code review",
      "refactoring",
      "modularization",
      "file size",
      "maintainability",
      "code organization"
    ],
    "actual_capabilities": [
      "Checks implementation file line counts against 200-line and 300-line thresholds.",
      "Distinguishes code files from documentation, configuration, generated files, fixtures, and style files.",
      "Flags files over 300 lines as requiring a modularization plan.",
      "Suggests extraction targets such as utilities, types, constants, hooks, components, and helpers.",
      "Provides modularization patterns for React, TypeScript, general utility files, Python, and Go.",
      "Prompts for user approval before carrying out broad refactoring work."
    ],
    "limitations": [
      "It does not calculate complexity, coupling, or test coverage by itself.",
      "It treats line count as a maintainability signal, not as proof of poor design.",
      "It does not apply to documentation, notebooks, configuration files, generated files, fixtures, or stylesheets.",
      "It needs project context to choose the best module boundaries."
    ],
    "use_cases": [
      {
        "title": "Review Oversized Pull Requests",
        "description": "Check changed implementation files and identify modules that should be split before review continues.",
        "target_user": "Engineering reviewers"
      },
      {
        "title": "Refactor Long Components",
        "description": "Break large UI components into focused files for headers, charts, hooks, types, and constants.",
        "target_user": "Frontend developers"
      },
      {
        "title": "Keep Generated Work Maintainable",
        "description": "Ask the assistant to monitor file length while creating new code and split sections before files become too large.",
        "target_user": "AI-assisted developers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check One File",
        "scenario": "Beginner line count review",
        "prompt": "Check the line count for this implementation file and tell me whether it is OK, warning, or violation: [file path]."
      },
      {
        "title": "Review Changed Files",
        "scenario": "Pull request review",
        "prompt": "Review the changed implementation files for line limit issues. Exclude documentation, configuration, generated files, fixtures, and stylesheets."
      },
      {
        "title": "Plan A Split",
        "scenario": "Oversized file refactoring",
        "prompt": "Analyze [file path], identify logical sections, and propose a modularization plan that keeps each new implementation file under 200 lines."
      },
      {
        "title": "Refactor With Constraints",
        "scenario": "Advanced guided refactor",
        "prompt": "Refactor [file path] into cohesive modules. Preserve behavior, avoid circular dependencies, update imports, and verify build or tests when possible."
      }
    ],
    "output_examples": [
      {
        "input": "Review src/services/api.ts for line limit issues.",
        "output": "The file has 342 lines, so it exceeds the 300-line limit. Recommended split: endpoint functions, shared types, and helper utilities."
      },
      {
        "input": "Create a dashboard component and keep it maintainable.",
        "output": "The component is approaching the warning threshold. I will separate header, metrics, chart, hooks, and constants before continuing."
      },
      {
        "input": "This utility file is too long. Please organize it.",
        "output": "The file should be grouped by responsibility. Suggested modules: string helpers, date helpers, array helpers, and validation helpers."
      }
    ],
    "best_practices": [
      "Check line counts before starting large edits or code review.",
      "Split code by responsibility, not only by line count.",
      "Run tests, builds, or lint checks after moving code between files."
    ],
    "anti_patterns": [
      "Splitting one cohesive function or class only to reduce line count.",
      "Creating many tiny files that make navigation harder.",
      "Moving code without updating imports, exports, tests, or public APIs."
    ],
    "faq": [
      {
        "question": "What files does this skill check?",
        "answer": "It checks implementation files such as JavaScript, TypeScript, Python, Go, Rust, Java, Kotlin, C, and C++ source files."
      },
      {
        "question": "What line counts are recommended?",
        "answer": "Files up to 200 lines are OK. Files from 201 to 300 lines receive a warning. Files over 300 lines need splitting."
      },
      {
        "question": "Does it apply to documentation?",
        "answer": "No. Markdown, MDX, notebooks, configuration files, generated files, fixtures, declaration files, and stylesheets are excluded."
      },
      {
        "question": "Can it refactor files automatically?",
        "answer": "It can propose and apply refactors when requested, but it should ask for approval before broad structural changes."
      },
      {
        "question": "Does a long file always mean bad code?",
        "answer": "No. Line count is a signal. The skill also considers responsibility, cohesion, and dependency boundaries."
      },
      {
        "question": "Which tools can use this skill?",
        "answer": "The skill is packaged for Claude, Codex, and Claude Code workflows."
      }
    ]
