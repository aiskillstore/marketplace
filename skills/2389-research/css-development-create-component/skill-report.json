    "actual_capabilities": [
      "Surveys existing CSS component patterns before adding a new class.",
      "Checks whether existing classes can be composed instead of creating new CSS.",
      "Guides semantic class names for atoms, molecules, and organisms.",
      "Provides Tailwind @apply structure with dark mode and interactive states.",
      "Prompts static CSS tests and component rendering tests.",
      "Requests usage documentation and markup examples for created components."
    ],
    "limitations": [
      "Requires a project with accessible CSS files and component source files.",
      "Does not generate visual design assets or brand guidelines.",
