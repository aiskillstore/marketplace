  "content": {
    "user_title": "Add Firebase Features Safely",
    "value_statement": "Adding Firebase features can break tests, rules, or authentication when project patterns are unclear. This skill guides a test-first workflow for Cloud Functions, Firestore collections, API endpoints, and emulator verification.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Firebase development",
      "Cloud Functions",
      "Firestore rules",
      "TDD workflow",
      "Firebase emulators",
      "API endpoint development",
      "security rules testing"
    ],
    "actual_capabilities": [
      "Classifies the requested Firebase feature type before implementation begins.",
      "Prompts inspection of existing Functions, Express, authentication, and rules patterns.",
      "Requires failing unit tests before writing the feature implementation.",
      "Provides patterns for Firestore rules, indexes, authentication checks, and consistent handler responses.",
      "Guides build, unit test, integration test, and emulator verification steps."
    ],
    "limitations": [
      "Assumes an existing Firebase project and does not cover initial project setup.",
      "Does not debug unrelated failures outside the requested feature workflow.",
      "Examples are templates and must be adapted to the project authentication model.",
      "Requires local Firebase tooling and test scripts to be available for verification."
    ],
    "use_cases": [
      {
        "title": "Add a Cloud Function",
        "description": "Implement a new HTTP, callable, scheduled, or trigger-based function with tests and exports.",
        "target_user": "Firebase backend developer"
      },
      {
        "title": "Create a Firestore Collection",
        "description": "Add a collection with security rules, indexes, validation, and emulator checks.",
        "target_user": "Full-stack product engineer"
      },
      {
        "title": "Extend an API Surface",
        "description": "Add an authenticated endpoint that follows the project response pattern and test conventions.",
        "target_user": "API maintainer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Add a Simple Function",
        "scenario": "Beginner request for a small Firebase feature.",
        "prompt": "Add a Firebase Cloud Function that handles [task]. Follow the project patterns, write the failing test first, then implement it."
      },
      {
        "title": "Create a Collection",
        "scenario": "Intermediate request for Firestore data modeling.",
        "prompt": "Create a Firestore collection for [entity]. Include security rules, indexes if needed, tests, and emulator verification."
      },
      {
        "title": "Build an Authenticated Endpoint",
        "scenario": "Intermediate request for Express or HTTP API work.",
        "prompt": "Add an authenticated API endpoint for [operation]. Match the existing auth model and return the standard success or error response."
      },
      {
        "title": "Implement a Complete Workflow",
        "scenario": "Advanced request spanning function logic, rules, and integration tests.",
        "prompt": "Implement [feature] across Cloud Functions and Firestore. Start with failing tests, update rules and indexes, then verify the full workflow in emulators."
      }
    ],
    "output_examples": [
      {
        "input": "Add an endpoint that creates a task for the signed-in user.",
        "output": "The assistant identifies the endpoint type, writes a failing test, adds the handler, checks authentication, updates exports, and verifies with unit and emulator tests."
      },
      {
        "input": "Create a projectInvites collection that users can read but only functions can write.",
        "output": "The assistant proposes server-write-only rules, adds collection tests, checks indexes, and validates the workflow in the Firebase emulator."
      },
      {
        "input": "Add a scheduled cleanup function for expired records.",
        "output": "The assistant creates a test plan, implements the scheduled handler, follows the response convention, and runs build and test verification."
      }
    ],
    "best_practices": [
      "Write the failing unit test before changing implementation code.",
      "Match the existing project architecture, authentication model, and response convention.",
      "Verify rules and end-to-end behavior with Firebase emulators before marking work complete."
    ],
    "anti_patterns": [
      "Adding Firestore writes without matching authentication and ownership rules.",
      "Skipping emulator tests after changing functions, rules, or indexes.",
      "Changing tests after implementation to hide a broken or incomplete feature."
    ],
    "faq": [
      {
        "question": "Does this skill create a new Firebase project?",
        "answer": "No. It is designed for adding features to an existing Firebase project."
      },
      {
        "question": "Can it help with Firestore security rules?",
        "answer": "Yes. It includes rule patterns for server-write-only and authenticated client-write collections."
      },
      {
        "question": "Does it require test-first development?",
        "answer": "Yes. The workflow asks for a failing test before implementation begins."
      },
      {
        "question": "Which Firebase features does it cover?",
        "answer": "It covers Cloud Functions, Express endpoints, callable functions, scheduled functions, Firestore triggers, and collections."
      },
      {
        "question": "Does it verify work with emulators?",
        "answer": "Yes. The workflow includes emulator checks for endpoints, Firestore data, authentication, and rules."
      },
      {
        "question": "Is it a debugging skill?",
        "answer": "No. It is focused on adding new features, not diagnosing existing production or test failures."
      }
    ]
