# Keep this file URL locally. Vercel receives the Turso URL from Marketplace.
TURSO_DATABASE_URL=file:./data/gtm.db
# Shared bearer for starts, status, approvals, cancellation, and signed links.
# Left empty, the first local command generates one here.
GTM_RUN_SECRET=
# Bearer used by scheduled Vercel cron starts.
CRON_SECRET=
# Optional locally: with a key, AI steps use the Gateway instead of your CLI.
# On Vercel, set it on the project unless your deployment authenticates to AI Gateway with OIDC.
AI_GATEWAY_API_KEY=
GTM_WORKFLOW_MODEL=deepseek/deepseek-v4.1-flash
# Written by the skill when it copies this template: claude or codex. The hosted agent sets eve.
GTM_HOST=
