    "faq": [
      {
        "question": "When should I use a switch expression?",
        "answer": "Use one when every case produces a value and the cases can remain single expressions."
      },
      {
        "question": "When is a switch statement better?",
        "answer": "Use a statement for multiple operations, side effects, or case bodies that cannot be single expressions."
      },
      {
        "question": "Can patterns validate decoded data?",
        "answer": "Yes. Map and list patterns can verify required structure and types while binding values."
      },
      {
        "question": "How do I check exhaustiveness?",
        "answer": "Run dart analyze and resolve any unmatched subtype or enum value reported for the switch."
      },
      {
        "question": "Should every switch include a wildcard?",
        "answer": "No. Avoid wildcards when explicit cases should expose newly added sealed subtypes."
      },
      {
        "question": "Can logical-or patterns bind variables?",
