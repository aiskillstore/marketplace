  "content": {
    "user_title": "Handle Code Review Feedback",
    "value_statement": "Code review feedback can be unclear, incomplete, or technically wrong. This skill helps Claude, Codex, and Claude Code verify feedback before changing code.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code review",
      "review feedback",
      "technical verification",
      "pull request comments",
      "engineering workflow",
      "review response"
    ],
    "actual_capabilities": [
      "Guides review feedback analysis before implementation.",
      "Encourages clarification when feedback is incomplete.",
      "Defines when to push back with technical evidence.",
      "Prioritizes multi-item feedback by risk and complexity.",
      "Provides response patterns for GitHub review threads."
    ],
    "limitations": [
      "It does not analyze code by itself without repository context.",
      "It does not decide product priorities without human direction.",
      "It does not replace tests or manual verification.",
      "It cannot reply to GitHub unless the required tools are available."
    ],
    "use_cases": [
      {
        "title": "Review Triage",
        "description": "Separate clear review items from unclear or risky requests before implementation.",
        "target_user": "Software engineer"
      },
      {
        "title": "Technical Pushback",
        "description": "Prepare concise evidence when a review suggestion conflicts with codebase requirements.",
        "target_user": "Senior developer"
      },
      {
        "title": "Pull Request Follow-Up",
        "description": "Respond to inline comments with factual updates after each verified change.",
        "target_user": "Open source maintainer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check Feedback",
        "scenario": "Beginner triage",
        "prompt": "Review this feedback and restate each requested change. Mark any item that needs clarification before implementation."
      },
      {
        "title": "Verify Suggestion",
        "scenario": "Single technical concern",
        "prompt": "Evaluate this review suggestion against the current codebase. Explain whether it is correct, risky, or unclear."
      },
      {
        "title": "Plan Review Fixes",
        "scenario": "Multi-item review",
        "prompt": "Create an implementation order for these review comments. Prioritize blocking issues, simple fixes, and complex refactors."
      },
      {
        "title": "Draft Evidence-Based Reply",
        "scenario": "Advanced pushback",
        "prompt": "Draft a concise review reply that explains the technical evidence, states the tradeoff, and asks for direction if needed."
      }
    ],
    "output_examples": [
      {
        "input": "Reviewer asks to remove legacy code, but old platform support may still be required.",
        "output": "The response should verify platform targets first, then propose keeping or removing the legacy path based on evidence."
      },
      {
        "input": "A reviewer sends six items, and two are unclear.",
        "output": "The response should summarize understood items and ask for clarification on the unclear ones before implementation."
      },
      {
        "input": "A reviewer asks for a larger feature that may not be used.",
        "output": "The response should check actual usage and ask whether to remove unused scope instead of expanding it."
      }
    ],
    "best_practices": [
      "Read all feedback before changing code.",
      "Verify each suggestion against tests, usage, and platform constraints.",
      "Handle one reviewed change at a time and test each result."
    ],
    "anti_patterns": [
      "Do not accept review feedback before checking the codebase.",
      "Do not implement unclear items while leaving related items unresolved.",
      "Do not add broad features when the reviewed code is unused."
    ],
    "faq": [
      {
        "question": "Does this skill implement review feedback automatically?",
        "answer": "No. It guides how to evaluate feedback before implementation."
      },
      {
        "question": "Can it help when a reviewer is wrong?",
        "answer": "Yes. It encourages evidence-based pushback when the suggestion conflicts with codebase facts."
      },
      {
        "question": "Does it require GitHub?",
        "answer": "No. The guidance applies to any code review process, including GitHub review threads."
      },
      {
        "question": "Can it help with unclear review comments?",
        "answer": "Yes. It tells the assistant to ask for clarification before making related changes."
      },
      {
        "question": "Is this useful for Claude Code and Codex?",
        "answer": "Yes. It is designed for Claude, Codex, and Claude Code workflows."
      },
      {
        "question": "Does it replace reviewer judgment?",
