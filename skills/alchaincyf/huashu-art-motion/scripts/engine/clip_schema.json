{
  "_说明": "参数化片段 spec 的字段表，clip_lint.py 读它。来源是各 clips/<语法>.js 头注释；改语法时同步改这里。cue.data 里写了表外的键只是告警（语法可能认得更多）。",
  "common": {
    "spec": ["grammar", "duration", "fps", "width", "height", "safe", "theme", "alpha", "data", "cues", "finish"],
    "cue": ["at", "kind", "text", "sub", "data", "image", "frames", "fps", "loop", "dur"],
    "themes": ["paper", "poster", "ink", "navy", "bauhaus", "snow", "wood", "chalk"],
    "finish": ["clean", "soft", "film", "punch"]
  },
  "grammars": {
    "t1_3b1b": { "kinds": ["title", "equation", "point", "line", "highlight"], "specData": ["camera"], "cueData": ["tokens", "col", "color", "values", "points", "target", "index", "dur"], "needs": { "equation": ["text|data.tokens"], "point": ["text"], "title": ["text"], "line": ["data.values|data.points"] } },
    "t2_keynote_ui": { "kinds": ["title", "card", "step", "image", "highlight", "number"], "specData": ["eyebrow", "title", "subtitle", "accent", "frame", "camera"], "cueData": ["step", "fit", "focus", "icon", "value", "prefix", "suffix", "decimals", "label", "rect", "fill", "over", "frame", "text"], "needs": { "number": ["data.value"], "highlight": ["data.rect"] } },
    "t3_finance_chart": { "kinds": ["title", "bar", "line", "candle", "highlight", "number"], "specData": ["title", "unit", "source", "badge", "chart", "series", "decimals", "prefix", "suffix", "highlight", "colors", "upDown", "theme", "camera"], "cueData": ["index", "value", "prefix", "suffix", "decimals", "text", "sub"], "needs": {}, "specNeeds": ["data.series"] },
    "y1_kurzgesagt": { "kinds": ["title", "point", "highlight", "enter"], "specData": ["center", "center_style", "image", "flow", "camera"], "cueData": ["color", "index", "style"], "needs": { "point": ["text"], "title": ["text"] } },
    "y2_vox": { "kinds": ["image", "clip", "title", "point", "highlight"], "specData": ["camera"], "cueData": ["halftone", "fit", "focus", "aspect", "rect"], "needs": { "highlight": ["data.rect"], "title": ["text"], "point": ["text"] } },
    "y3_whiteboard": { "kinds": ["title", "point", "draw", "image", "highlight"], "specData": ["camera"], "cueData": ["icon", "arrow", "index", "target", "style"], "needs": { "draw": ["data.icon"], "point": ["text"], "title": ["text"] } },
    "y4_storytime": { "kinds": ["title", "point", "highlight", "react", "insert"], "specData": ["character", "camera"], "cueData": ["pose", "mark", "hit", "count", "unit"], "needs": {}, "specNeeds": ["data.character"] },
    "y5_kinetic_type": { "kinds": ["title", "point", "number", "highlight"], "specData": ["palette", "camera"], "cueData": ["label", "key", "word", "value", "prefix", "suffix", "decimals", "num"], "needs": { "number": ["data.value"], "point": ["text"], "title": ["text"] } }
  }
}
