        "description": "Create a concise title, change summary, test plan, breaking-change note, and related issue references.",
        "target_user": "Pull request author"
      },
      {
        "title": "Maintain clean repository history",
        "description": "Plan rebases, cherry-picks, stashes, and bisects while keeping operations explicit and reviewable.",
        "target_user": "Repository maintainer"
      }
    ],
    "prompt_templates": [
