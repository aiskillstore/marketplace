      "scroll-driven 3D",
      "3D web performance"
    ],
    "actual_capabilities": [
      "Compares Spline, React Three Fiber, Three.js, and Babylon.js for project fit.",
      "Provides starter patterns for Spline and React Three Fiber scenes.",
      "Explains GLB and GLTF asset preparation for web delivery.",
      "Shows a model optimization workflow using gltf-transform.",
      "Outlines scroll-driven 3D patterns with React Three Fiber and GSAP.",
      "Identifies common 3D web anti-patterns and safer alternatives."
    ],
    "limitations": [
      "Does not include complete production applications or deployment scripts.",
      "Does not provide original 3D models or textures.",
      "Requires separate testing on mobile devices and low-end hardware.",
      "Requires developers to adapt examples to their framework and asset pipeline."
    ],
    "use_cases": [
      {
        "title": "Plan a 3D Website Stack",
        "description": "Choose between Spline, React Three Fiber, Three.js, or Babylon.js before implementation starts.",
        "target_user": "Frontend developers"
      },
      {
        "title": "Prepare Product Models for Web",
        "description": "Convert and optimize 3D assets so product pages load faster and remain usable.",
        "target_user": "Ecommerce teams"
      },
      {
        "title": "Design Scroll-Driven 3D Sections",
        "description": "Map camera movement, model rotation, and reveal effects to page scroll behavior.",
        "target_user": "Interactive designers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose a 3D Stack",
        "scenario": "Beginner project planning",
        "prompt": "Help me choose a 3D web stack for a React marketing page. Compare Spline, React Three Fiber, and Three.js for this use case."
      },
      {
        "title": "Plan a Model Pipeline",
        "scenario": "Asset preparation",
        "prompt": "Create a practical pipeline for preparing a GLB product model for a web configurator. Include size targets, texture handling, and testing steps."
      },
      {
        "title": "Design an Interactive Scene",
        "scenario": "Feature design",
        "prompt": "Design a React Three Fiber scene for a product page with loading states, orbit controls, and mobile fallbacks. Keep performance constraints explicit."
      },
      {
        "title": "Optimize Scroll-Driven 3D",
        "scenario": "Advanced performance review",
        "prompt": "Review my scroll-driven 3D concept for performance and accessibility risks. Suggest scene simplifications, fallback behavior, and measurement checks."
      }
    ],
    "output_examples": [
      {
        "input": "I need a 3D hero for a SaaS product page.",
        "output": "A stack recommendation, scene structure, loading plan, mobile fallback strategy, and performance checklist."
      },
      {
        "input": "Our product model is too heavy for mobile users.",
        "output": "A model optimization plan covering polygon reduction, texture baking, compression, file size goals, and device testing."
      },
      {
        "input": "We want a model to rotate as users scroll.",
        "output": "A scroll interaction plan with camera movement, animation timing, fallback behavior, and usability checks."
      }
    ],
    "best_practices": [
      "Use 3D only when it improves understanding, comparison, or interaction.",
      "Compress models and test frame rate on real mobile devices.",
      "Provide loading states and static fallbacks for slow or unsupported devices."
    ],
    "anti_patterns": [
      "Adding decorative 3D that slows pages without helping users.",
      "Building desktop-only 3D experiences without mobile fallbacks.",
      "Shipping large models without progress indicators or optimization."
    ],
    "faq": [
      {
        "question": "Does this skill generate 3D models?",
        "answer": "No. It guides web integration, asset preparation, and performance decisions for models you already have."
      },
      {
