  "content": {
    "user_title": "Build Interactive 3D Web Experiences",
    "value_statement": "Teams struggle to add 3D without hurting speed or usability. This skill guides stack choices, asset pipelines, and interactive scene patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Three.js",
      "React Three Fiber",
      "WebGL",
      "Spline",
