  "content": {
    "user_title": "Scaffold Production-Ready Helm Charts",
    "value_statement": "Creating consistent Helm charts requires careful metadata, values, templates, dependencies, and validation. This skill provides reusable structures and practical checks for Kubernetes packaging.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Helm chart scaffolding",
      "Kubernetes deployment",
      "Helm templates",
      "Chart.yaml",
      "values.yaml",
      "Helm validation"
    ],
    "actual_capabilities": [
      "Structures application and library charts using Helm 3 conventions.",
      "Drafts Chart.yaml metadata, dependency declarations, and values organization.",
      "Provides reusable patterns for workloads, services, ingress, probes, and security contexts.",
      "Explains multi-environment values, chart repositories, hooks, tests, and dependency management.",
      "Validates chart structure, linting, rendering, dry runs, schemas, and common security settings."
    ],
    "limitations": [
      "It does not deploy resources without an explicit Helm command.",
      "Generated charts still require testing against the target Kubernetes version and cluster policies.",
      "Example dependencies, versions, URLs, images, and credentials must be reviewed before production use.",
      "The validation script requires Bash, Helm, and optionally jq."
    ],
    "use_cases": [
      {
        "title": "Package a New Service",
        "description": "Create a reusable chart structure for a service with values, probes, resources, ingress, and secure container defaults.",
        "target_user": "Application developer"
      },
      {
        "title": "Standardize Platform Charts",
        "description": "Define consistent metadata, helpers, labels, dependencies, and validation across charts maintained by a platform team.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Prepare Multi-Environment Releases",
        "description": "Organize environment values, test rendered manifests, and package charts for controlled repository distribution.",
        "target_user": "Release engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Basic Chart",
        "prompt": "Create a Helm chart for [application] using image [repository:tag]. Include a Deployment, ClusterIP Service, values file, and standard labels.",
        "scenario": "Start a small application chart with essential resources."
      },
      {
        "title": "Add Production Settings",
        "prompt": "Extend my Helm chart with resource requests, limits, health probes, autoscaling, disruption budgets, and restricted container security settings.",
        "scenario": "Strengthen an existing chart for production workloads."
      },
      {
        "title": "Design Environment Values",
        "prompt": "Organize this chart for development, staging, and production. Separate shared defaults from overrides and identify values that require external secrets.",
        "scenario": "Support controlled deployments across multiple environments."
      },
      {
        "title": "Review and Validate a Chart",
        "prompt": "Audit the Helm chart at [path]. Check structure, metadata, dependencies, rendering, schema coverage, Kubernetes security settings, and upgrade risks.",
        "scenario": "Perform an advanced review before publishing or deploying a chart."
      }
    ],
    "output_examples": [
      {
        "input": "Create a Helm chart for a stateless web API with three replicas and an internal service.",
        "output": "A chart layout with metadata, configurable image settings, three default replicas, a ClusterIP Service, health probes, resources, and validation steps."
      },
      {
        "input": "Review a chart before publishing it to our repository.",
        "output": [
          "Metadata and semantic version checks.",
          "Dependency and lock-file review.",
          "Lint, render, dry-run, schema, and security validation results.",
          "A prioritized list of changes required before publication."
        ]
      }
    ],
    "best_practices": [
      "Pin dependency versions and review each repository before packaging.",
      "Keep shared defaults minimal and store sensitive values in an external secret system.",
      "Run linting, rendering, dry-run, schema, and policy checks before every release."
    ],
    "anti_patterns": [
      "Do not publish placeholder credentials, repositories, maintainers, or image tags.",
      "Do not place production secrets directly in values files or rendered manifests.",
      "Do not assume a successful template render proves compatibility with the target cluster."
    ],
    "faq": [
      {
        "question": "Does this skill install Helm charts?",
        "answer": "It provides scaffolding and commands. Installation occurs only when you explicitly run Helm against a selected cluster."
      },
      {
        "question": "Can it create both application and library charts?",
        "answer": "Yes. The reference explains both chart types, although most templates target deployable application charts."
      },
      {
        "question": "Does it support multiple environments?",
        "answer": "Yes. It shows how to keep shared defaults separate from development, staging, and production overrides."
      },
      {
        "question": "How are charts validated?",
        "answer": "The included script checks structure, linting, rendering, dry runs, dependencies, schema syntax, probes, resources, and selected security settings."
      },
      {
        "question": "Are the example values production ready?",
        "answer": "No. Replace placeholder URLs, versions, images, and credentials, then validate all settings against your environment."
      },
      {
        "question": "Which tools are required?",
        "answer": "Helm is required for validation. Bash runs the included script, and jq adds values schema syntax validation."
      }
    ]
