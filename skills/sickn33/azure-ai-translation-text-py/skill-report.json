    "user_title": "Build Azure Text Translation Workflows",
    "value_statement": "Developers need clear examples for Azure text translation tasks. This skill provides Python SDK patterns for translation, transliteration, language detection, dictionaries, and async clients.",
    "seo_keywords": [
      "Azure AI Translator",
      "Azure text translation",
      "Python translation SDK",
      "Claude",
      "Codex",
      "Claude Code",
      "language detection",
      "transliteration",
      "dictionary lookup",
      "localization automation"
    ],
    "actual_capabilities": [
      "Shows how to install the Azure AI Text Translation Python package.",
      "Demonstrates API key, region, endpoint, and Entra ID authentication patterns.",
      "Provides examples for single-language and multi-language translation requests.",
      "Covers transliteration, dictionary lookup, dictionary examples, and sentence boundaries.",
      "Shows how to list supported languages and use the async translation client."
    ],
    "limitations": [
      "Does not create or manage Azure Translator resources.",
      "Requires valid Azure credentials and configured environment variables.",
      "Examples need testing against the selected SDK version and Azure region.",
      "Does not replace privacy review or human quality review for sensitive content."
    ],
    "use_cases": [
      {
        "title": "Add Translation To Applications",
        "description": "Implement Python code that sends application text to Azure AI Translator and returns translated results.",
        "target_user": "Backend developers"
      },
      {
        "title": "Prepare Localization Workflows",
        "description": "Batch translate interface strings, inspect supported languages, and plan translation options for product releases.",
        "target_user": "Localization engineers"
      },
      {
        "title": "Analyze Multilingual Text",
        "description": "Detect language, transliterate scripts, and enrich text pipelines with dictionary information.",
        "target_user": "Data and product teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Authenticate A Client",
        "scenario": "Beginner setup",
        "prompt": "Show me how to authenticate Azure AI Translator in Python using environment variables and the TextTranslationClient."
      },
      {
        "title": "Translate Multiple Targets",
        "scenario": "Basic translation",
        "prompt": "Create a Python example that translates one text string to Spanish, French, and German with Azure AI Translator."
      },
      {
        "title": "Use Language Tools",
        "scenario": "Intermediate language workflow",
        "prompt": "Design a Python workflow that detects source language, transliterates text, and looks up dictionary entries."
      },
      {
        "title": "Build Async Translation",
        "scenario": "Advanced service integration",
        "prompt": "Design an async Python helper for batched Azure translations with retries, source language options, and clear error handling."
      }
    ],
    "output_examples": [
      {
        "input": "Translate \"Hello, world\" to Spanish and French.",
        "output": "Spanish: Hola, mundo. French: Bonjour le monde."
      },
      {
        "input": "Detect the language of \"Hola, como estas?\".",
        "output": "Detected language: Spanish. Confidence: high."
      },
      {
        "input": "Find dictionary information for the English word \"fly\" in Spanish.",
        "output": "Possible translations include volar as a verb. Review part of speech and confidence before use."
      }
    ],
    "best_practices": [
      "Store Azure credentials in environment variables or managed identity, not source files.",
      "Batch related text inputs and handle service errors with retries and clear fallbacks.",
      "Specify source language and text type when known to improve translation results."
    ],
    "anti_patterns": [
      "Hardcoding subscription keys in prompts, examples, or application code.",
      "Sending confidential text to translation services without approval and data handling review.",
      "Using machine translation as final copy for legal, medical, or critical customer content."
