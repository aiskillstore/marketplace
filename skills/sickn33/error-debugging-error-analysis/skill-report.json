    "user_title": "Diagnose Production Errors Faster",
    "value_statement": "Debugging production errors is slow when logs, traces, and releases are scattered. This skill guides Claude, Codex, and Claude Code through structured root-cause analysis and observability improvements.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "error debugging",
      "root cause analysis",
      "production incident response",
      "observability",
      "Sentry debugging",
      "Datadog troubleshooting",
      "OpenTelemetry traces"
    ],
    "actual_capabilities": [
      "Classifies runtime, integration, performance, configuration, and security errors.",
      "Guides stack trace, log, trace, and metric analysis.",
      "Provides checklists for production incident investigation.",
      "Suggests observability patterns using Sentry, Datadog, OpenTelemetry, and structured logging.",
      "Helps define fixes, tests, alerts, and prevention steps."
    ],
    "limitations": [
      "Requires relevant error messages, logs, traces, or incident context.",
      "Does not replace environment-specific testing or expert review.",
      "Cannot access private systems unless the host agent has permission.",
      "May need adaptation for each team tooling and deployment process."
    ],
    "use_cases": [
      {
        "title": "Triage a Production Incident",
        "description": "Analyze symptoms, impact, recent changes, and observability data to plan the next response steps.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Debug a Failing Service",
        "description": "Use stack traces, logs, and request context to identify likely root causes and validation checks.",
        "target_user": "Backend developer"
      },
      {
        "title": "Improve Error Visibility",
        "description": "Design structured logging, tracing, alerts, and runbooks that make recurring failures easier to diagnose.",
        "target_user": "Engineering manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Summarize an Error",
        "scenario": "Beginner triage with a single error message.",
        "prompt": "Analyze this error message. Explain the likely failure type, missing context, and first three checks to run."
      },
      {
        "title": "Find the Root Cause",
        "scenario": "Intermediate debugging with logs and a stack trace.",
        "prompt": "Review these logs and stack trace. Identify likely root causes, supporting evidence, and validation steps."
      },
      {
        "title": "Investigate an Incident",
        "scenario": "Advanced production incident analysis.",
        "prompt": "Compare these metrics, traces, logs, and deployment notes. Build an incident timeline and prioritize mitigation options."
      },
      {
        "title": "Design Prevention Controls",
        "scenario": "Advanced follow-up after a resolved incident.",
        "prompt": "Create a prevention plan for this failure. Include tests, alerts, logging changes, ownership, and rollout safeguards."
      }
    ],
    "output_examples": [
      {
        "input": "A checkout error increased after deployment v2.3.1.",
        "output": "A prioritized investigation plan comparing error rate, release timing, affected endpoints, and rollback options."
      },
      {
        "input": "A service shows intermittent timeouts across three dependencies.",
        "output": "Likely causes, evidence to collect, retry checks, circuit-breaker checks, and monitoring gaps."
      },
      {
        "input": "A team wants better alerts for new error types.",
        "output": "A practical alerting plan covering severity, ownership, notification paths, and runbook links."
      }
    ],
    "best_practices": [
      "Provide timestamps, service names, recent changes, and complete error messages.",
      "Validate each proposed root cause with logs, traces, metrics, or reproduction steps.",
      "Redact secrets, tokens, customer data, and private URLs before sharing diagnostics."
    ],
    "anti_patterns": [
      "Treating the first stack frame as root cause without checking upstream context.",
      "Changing production systems before approval, rollback planning, and impact analysis.",
      "Sharing raw logs that contain credentials, session identifiers, or personal data."
    ],
    "faq": [
      {
        "question": "What does this skill help me debug?",
        "answer": "It helps analyze application errors, production incidents, stack traces, logs, metrics, and distributed traces."
      },
      {
        "question": "Can it fix code automatically?",
        "answer": "It can suggest fixes and tests, but implementation still needs review, validation, and normal deployment controls."
      },
      {
        "question": "Which observability tools does it reference?",
        "answer": "The playbook references Sentry, Datadog, OpenTelemetry, Jaeger, Grafana, Prometheus, and structured logging."
      },
      {
        "question": "Does it require production access?",
        "answer": "No. It can work from shared diagnostics, but better evidence improves the analysis."
      },
      {
        "question": "How should I prepare input?",
        "answer": "Include the error message, stack trace, timestamps, affected service, recent changes, and redacted logs."
      },
      {
        "question": "Is it suitable for incident response?",
        "answer": "Yes. It includes triage, investigation, mitigation, communication, and prevention guidance for production incidents."
      }
