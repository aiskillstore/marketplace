  "content": {
    "user_title": "Diagnose Errors and Resolve Production Incidents",
    "value_statement": "Complex failures can hide across logs, traces, services, and recent changes. This skill structures evidence, tests hypotheses, and recommends fixes with prevention steps.",
    "seo_keywords": [
      "error analysis",
      "production debugging",
      "root cause analysis",
      "incident response",
      "distributed tracing",
      "observability",
      "stack trace analysis",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Classifies errors by severity, type, observability, and likely user impact.",
      "Analyzes stack traces, logs, timestamps, correlation identifiers, and service dependencies.",
      "Builds incident timelines and ranks root-cause hypotheses using available evidence.",
      "Proposes targeted reproduction steps and experiments to validate suspected causes.",
      "Recommends fixes, regression tests, rollback plans, and preventive controls.",
      "Suggests structured logging, tracing, monitoring, and alerting improvements."
    ],
    "limitations": [
      "Requires relevant error messages, logs, traces, or reproducible symptoms.",
      "Cannot verify hypotheses without access to the affected code and environment.",
      "Does not replace production testing, operational approval, or expert review.",
      "Observability examples require adaptation for each stack, vendor, and privacy policy."
    ],
    "use_cases": [
      {
        "title": "Debug an Application Failure",
        "description": "Analyze an exception and stack trace, isolate the failing path, and define focused verification steps.",
        "target_user": "Backend developers"
      },
      {
        "title": "Investigate a Production Incident",
        "description": "Correlate logs, traces, deployments, and service dependencies to build a timeline and identify likely root causes.",
        "target_user": "Site reliability engineers"
      },
      {
        "title": "Prevent Recurring Errors",
        "description": "Turn incident evidence into corrective actions for tests, monitoring, alerting, ownership, and rollback readiness.",
        "target_user": "Engineering leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Explain an Error",
        "prompt": "Analyze this error message and stack trace: [details]. Identify the likely cause, explain the evidence, and suggest safe verification steps.",
        "scenario": "Use for a single failure with basic diagnostic details."
      },
      {
        "title": "Investigate a Recurring Failure",
        "prompt": "Investigate this recurring failure using these logs and timestamps: [details]. Group patterns, rank hypotheses, and propose targeted experiments.",
        "scenario": "Use when the same error appears across multiple requests or times."
      },
      {
        "title": "Trace a Distributed Incident",
        "prompt": "Analyze this cross-service incident using logs, traces, deployment history, and service dependencies: [details]. Build a timeline and identify the root cause.",
        "scenario": "Use for failures spanning services, queues, databases, or external APIs."
      },
      {
        "title": "Design a Prevention Plan",
        "prompt": "Review this resolved incident: [details]. Create corrective actions covering code fixes, tests, observability, alerting, rollback readiness, and ownership.",
        "scenario": "Use after mitigation to reduce recurrence and improve response."
      }
    ],
    "output_examples": [
      {
        "input": "A payment request times out after 30 seconds, and the trace ends at the database client.",
        "output": [
          "Likely cause: database pool exhaustion or a slow query on the payment path.",
          "Evidence needed: pool metrics, query duration, lock waits, and deployment changes.",
          "Next step: reproduce safely with tracing and compare healthy requests."
        ]
      },
      {
        "input": "Error rates rose after version 2.3.1, but only one service shows new exceptions.",
        "output": "The deployment is the leading hypothesis. Compare changed code paths, correlate exception timestamps, and test rollback or feature-flag mitigation."
      },
      {
        "input": "Several services report failures for requests sharing the same correlation identifier.",
        "output": "Build a timestamped request path across services. Locate the first failed span, then distinguish the originating failure from downstream symptoms."
      }
    ],
    "best_practices": [
      "Provide exact timestamps, versions, error messages, and affected services.",
      "Separate observed evidence from assumptions and test each hypothesis.",
      "Redact secrets and personal data before sharing logs or traces."
    ],
    "anti_patterns": [
      "Do not change production systems without approval and a rollback plan.",
      "Do not treat the final stack frame as the root cause without tracing inputs.",
      "Do not add broad retries without checking idempotency and retryable failures."
    ],
    "faq": [
      {
        "question": "What information should I provide?",
        "answer": "Provide the error message, stack trace, timestamps, affected services, recent changes, and relevant logs or traces."
      },
      {
        "question": "Can this skill diagnose intermittent failures?",
        "answer": "Yes. It can compare timing, load, environment, and correlation patterns when enough observations are available."
      },
      {
        "question": "Does this skill make production changes?",
        "answer": "No. It recommends safe experiments and fixes, but production changes require explicit approval, testing, and rollback planning."
      },
      {
        "question": "Can it analyze distributed systems?",
        "answer": "Yes. It can correlate service dependencies, trace identifiers, queues, deployments, and cascading failures."
      },
      {
        "question": "Which observability tools are supported?",
        "answer": "The playbook includes general patterns and examples for Sentry, DataDog, OpenTelemetry, Prometheus, Grafana, and related tools."
      },
      {
        "question": "How should sensitive diagnostic data be handled?",
        "answer": "Remove credentials, authorization headers, cookies, personal data, and unnecessary payloads before sharing diagnostic material."
      }
