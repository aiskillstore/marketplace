  "content": {
    "user_title": "Build Azure Monitor Queries in Java",
    "value_statement": "Azure Monitor integrations require correct clients, query scopes, authentication, and response handling. This skill provides focused Java patterns for logs and metrics workflows.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Azure Monitor Query Java",
      "Log Analytics Java",
      "Kusto query Java",
      "Azure metrics SDK",
      "DefaultAzureCredential",
      "Azure SDK migration"
    ],
    "actual_capabilities": [
      "Explains Maven dependency setup for the combined Azure Monitor Query package.",
      "Shows synchronous and asynchronous client creation with DefaultAzureCredential.",
      "Covers workspace, resource, batch, and multi-workspace log queries.",
      "Covers resource metrics, aggregations, granularity, and multi-resource queries.",
      "Describes result mapping, partial failures, timeouts, statistics, and visualization data.",
      "Provides sovereign-cloud endpoints and migration links for replacement packages."
    ],
    "limitations": [
      "The combined azure-monitor-query package is deprecated and should be migrated.",
      "The skill provides guidance and examples but does not execute queries or verify an Azure environment.",
      "Users must supply valid Azure resources, credentials, identifiers, and permissions.",
      "Package versions and current API details require confirmation against official documentation."
    ],
    "use_cases": [
      {
        "title": "Add Log Analytics to a Java service",
        "description": "Plan authenticated workspace queries, bounded time ranges, result mapping, and failure handling.",
        "target_user": "Java application developer"
      },
      {
        "title": "Investigate Azure resource metrics",
        "description": "Design metric queries with selected aggregations, granularity, dimensions, and caching.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Migrate deprecated monitor queries",
        "description": "Identify replacement packages and preserve logs and metrics behavior during migration.",
        "target_user": "Cloud platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a basic logs query",
        "prompt": "Create a minimal Java approach for querying one Log Analytics workspace over 24 hours. Use placeholders and explain required permissions.",
        "scenario": "Starting a new logs integration"
      },
      {
        "title": "Plan a metrics query",
        "prompt": "Design a Java metrics query for {resource_id} using {metric_names}, hourly granularity, and average plus count aggregations. Include failure handling.",
        "scenario": "Monitoring an Azure resource"
      },
      {
        "title": "Design batched log analysis",
        "prompt": "Build a batched logs-query approach for {workspace_id} using {queries}. Limit results, set timeouts, and map responses to their queries.",
        "scenario": "Reducing requests across related queries"
      },
      {
        "title": "Review and migrate an integration",
        "prompt": "Review this Azure Monitor query design: {design_summary}. Recommend current packages, least-privilege authentication, bounded queries, caching, and robust error handling.",
        "scenario": "Modernizing a production integration"
      }
    ],
    "output_examples": [
      {
        "input": "Plan a workspace activity query for the last day.",
        "output": [
          "Package path: use the current logs package because the combined package is deprecated.",
          "Authentication: use DefaultAzureCredential with workspace query permissions.",
          "Scope: query one workspace for 24 hours and limit returned columns and rows.",
          "Reliability: detect partial failures and record service error details."
        ]
      },
      {
        "input": "Plan hourly TotalCalls and SuccessfulCalls metrics.",
        "output": [
          "Target: provide the full Azure resource identifier and metric namespace.",
          "Resolution: request one-hour granularity with average and count aggregations.",
          "Processing: inspect each time series and preserve dimension metadata.",
          "Efficiency: cache stable results and avoid requesting unnecessary intervals."
        ]
      },
      {
        "input": "Prepare a migration from the deprecated combined package.",
        "output": [
          "Separate log queries from metric queries before changing dependencies.",
          "Map each client and model to its replacement package.",
          "Retest authentication, sovereign-cloud endpoints, batch behavior, and partial failures.",
          "Confirm current versions and migration notes in official Azure documentation."
        ]
      }
    ],
    "best_practices": [
      "Use bounded time ranges, projections, and row limits to control query cost and response size.",
      "Handle partial failures, service errors, and timeouts before processing query results.",
      "Use least-privilege Azure roles and migrate to the current logs and metrics packages."
    ],
    "anti_patterns": [
      "Do not place real credentials, workspace identifiers, or subscription details in generated examples.",
      "Do not run unbounded Kusto queries when a smaller time range or projection meets the need.",
      "Do not start new production work on the deprecated combined package without a migration plan."
    ],
    "faq": [
      {
        "question": "Does this skill execute Azure queries?",
        "answer": "No. It provides Java guidance and examples. Query execution requires your application, Azure credentials, network access, and resource permissions."
      },
      {
        "question": "Which Azure Monitor package should new projects use?",
        "answer": "Use the current logs or metrics package. Confirm the latest package names and versions in official Azure documentation."
      },
      {
        "question": "Can it help with Kusto queries?",
        "answer": "Yes. It covers query placement, time intervals, batching, projections, and row limits. It is not a complete Kusto language reference."
      },
      {
        "question": "Does it support asynchronous Java clients?",
        "answer": "Yes. The source includes synchronous and asynchronous client creation patterns for log and metric queries."
      },
      {
        "question": "Can it target Azure sovereign clouds?",
        "answer": "It includes Azure China endpoint examples. Validate endpoints, authority hosts, and identity configuration for your selected cloud."
      },
      {
        "question": "What information should I provide in a prompt?",
        "answer": "Provide the query goal, resource type, time range, metrics or tables, expected output, package version, and operational constraints."
      }
