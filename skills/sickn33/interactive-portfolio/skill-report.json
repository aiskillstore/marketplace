  "content": {
    "user_title": "Build a Portfolio That Converts Visitors",
    "value_statement": "Many portfolios hide strong work behind unclear structure or excessive interaction. This skill organizes projects, evidence, responsive behavior, and contact paths into a focused experience.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "interactive portfolio",
      "portfolio design",
      "developer portfolio",
      "designer portfolio",
      "case study design",
      "personal branding",
      "portfolio conversion"
    ],
    "actual_capabilities": [
      "Plans essential portfolio sections around a clear 30-second visitor journey.",
      "Structures project cards and case studies around roles, decisions, results, and links.",
      "Recommends interaction levels that balance visual distinction with usability.",
      "Provides mobile requirements, browser checks, and graceful degradation guidance.",
      "Defines contact calls to action for hiring, freelance, and networking goals.",
      "Suggests project selection, update schedules, and launch criteria."
    ],
    "limitations": [
      "It provides design and content guidance, not a complete deployed website.",
      "It cannot verify portfolio claims, project metrics, or testimonials.",
      "Device testing and performance measurements still require real tools and environments.",
      "Brand strategy, copywriting, search optimization, and advanced animation may need specialized support."
    ],
    "use_cases": [
