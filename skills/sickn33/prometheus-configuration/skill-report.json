    "actual_capabilities": [
      "Explains Prometheus architecture and common deployment patterns.",
      "Provides Helm and Docker Compose setup examples for Prometheus.",
      "Shows scrape configuration patterns for static targets and Kubernetes discovery.",
      "Drafts recording rules for request, latency, CPU, memory, and disk metrics.",
      "Drafts alert rules for availability, error rate, latency, and resource usage.",
      "Lists validation commands for Prometheus configuration, rules, targets, and queries."
    ],
    "limitations": [
      "It does not inspect a live Prometheus server by itself.",
      "It does not generate organization-specific metric names without user input.",
      "It does not replace security review for TLS files, credentials, or cluster access.",
      "Referenced companion files are not included in the scanned package."
    ],
    "use_cases": [
