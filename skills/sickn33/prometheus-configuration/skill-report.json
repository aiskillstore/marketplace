        "description": "Design consistent scrape configurations for nodes, applications, and Kubernetes services.",
        "target_user": "SRE teams"
      },
      {
        "title": "Prepare alerting rules",
        "description": "Draft practical rules for service health, error rates, latency, and resource limits.",
        "target_user": "Application owners"
      }
    ],
