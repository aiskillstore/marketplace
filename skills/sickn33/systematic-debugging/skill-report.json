  "content": {
    "user_title": "Debug Software Systematically",
    "value_statement": "Guessing at fixes wastes time and can hide the real defect. This skill guides evidence gathering, root-cause analysis, focused testing, and verified implementation.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "systematic debugging",
      "root cause analysis",
      "test failure diagnosis",
      "software troubleshooting",
      "debugging workflow",
      "flaky test investigation"
    ],
    "actual_capabilities": [
      "Structures debugging into investigation, pattern analysis, hypothesis testing, and implementation phases.",
      "Guides backward tracing from a visible symptom to the original data or control-flow trigger.",
      "Compares failing behavior with working examples and recent changes before proposing a repair.",
      "Replaces arbitrary test delays with bounded condition-based waiting patterns.",
      "Recommends layered validation at entry, business, environment, and diagnostic boundaries.",
      "Provides a constrained helper for identifying which selected test creates unexpected local state."
    ],
    "limitations": [
      "It cannot diagnose a defect without relevant errors, reproduction details, code access, or runtime evidence.",
      "The polluter helper runs project test code and should only be used in an isolated checkout.",
      "The waiting examples require adaptation to the project's event types and test framework.",
      "Historical test counts and outcomes are examples, not guarantees for the current repository."
    ],
    "use_cases": [
      {
        "title": "Diagnose a failing feature",
        "description": "Trace a reproducible application failure, compare working paths, test one hypothesis, and implement a regression-covered repair.",
        "target_user": "Application developer"
      },
      {
        "title": "Stabilize asynchronous tests",
        "description": "Replace guessed delays with bounded waits for observable events, state, counts, or files.",
        "target_user": "Test engineer"
      },
      {
        "title": "Investigate production incidents",
        "description": "Separate authorized containment from root-cause work while preserving evidence and redacting sensitive diagnostic data.",
        "target_user": "Site reliability engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Investigate a simple failure",
        "prompt": "Use systematic debugging for this failure: [error]. Start with reproduction steps and evidence. Do not propose a fix until you identify a likely cause.",
        "scenario": "Beginner investigation of a reproducible bug"
      },
      {
        "title": "Compare working and failing paths",
        "prompt": "Analyze [failing path] against [working path]. List relevant differences, recent changes, dependencies, and one testable root-cause hypothesis.",
        "scenario": "Intermediate analysis using a known working reference"
      },
      {
        "title": "Trace a deep failure",
        "prompt": "Trace [symptom] backward through the call and data flow. Identify the earliest invalid state, supporting evidence, and a minimal confirmation test.",
        "scenario": "Advanced root-cause tracing across components"
      },
      {
        "title": "Design a verified repair",
        "prompt": "Given this confirmed cause: [cause], design one focused fix, a failing regression test, layered validation, and verification steps. State remaining uncertainty.",
        "scenario": "Advanced implementation after evidence confirms the cause"
      }
    ],
    "output_examples": [
      {
        "input": "The payment test sometimes remains pending after a fixed two-second sleep.",
        "output": "Observed symptom: status remains pending intermittently. Replace the fixed delay with a bounded wait for the completion event, then trace missing events before changing production logic."
      },
      {
        "input": "A command creates repository data in the source directory during tests.",
        "output": [
          "Immediate cause: the command receives an empty working directory.",
          "Tracing target: find where the empty value first enters the call chain.",
          "Confirmation: reproduce with one focused test before changing validation.",
          "Repair: fix the source and add checks at each relevant boundary."
        ]
      },
      {
        "input": "A local build works, but CI reports a missing signing identity.",
        "output": "Record configuration presence at each authorized boundary without values. Compare propagation between local and CI environments, test one forwarding hypothesis, then verify the built artifact."
      }
    ],
    "best_practices": [
      "Capture the smallest useful evidence set and redact secrets before sharing logs.",
      "Change one variable per hypothesis so each result can confirm or reject a specific cause.",
      "Add a focused regression test and rerun relevant verification before claiming resolution."
    ],
    "anti_patterns": [
      "Do not stack speculative fixes without returning to evidence after a failed hypothesis.",
      "Do not use arbitrary delays when an observable completion condition is available.",
      "Do not dump environment variables, credentials, private payloads, or unnecessary personal paths into diagnostics."
    ],
    "faq": [
      {
        "question": "When should I use this skill?",
        "answer": "Use it for reproducible bugs, test failures, build problems, integration errors, performance issues, and unexpected behavior."
      },
      {
        "question": "Can I contain a production incident before finding the root cause?",
        "answer": "Yes. Apply an authorized rollback or containment action, label it as temporary, preserve evidence, and continue root-cause analysis."
      },
      {
        "question": "What information should I provide?",
        "answer": "Provide the exact error, reproduction steps, revision, runtime, recent changes, observed evidence, and relevant working examples."
      },
      {
        "question": "Does the skill execute commands automatically?",
        "answer": "No. It provides examples and a helper script that runs only when explicitly invoked."
      },
      {
        "question": "Is the polluter helper safe for any repository?",
        "answer": "No. It executes selected project tests, so use an isolated checkout and verify that the test runner accepts file arguments."
      },
      {
        "question": "What happens after three failed fixes?",
        "answer": "Stop adding fixes, reassess assumptions and coupling, and discuss whether the architecture or debugging model needs revision."
      }
    ]
  },
