    "user_title": "Audit AWS Security Posture",
    "value_statement": "AWS accounts can hide risky IAM, network, encryption, and logging gaps. This skill guides read-only AWS CLI checks and report generation.",
    "seo_keywords": [
      "AWS security audit",
      "cloud security assessment",
      "AWS CLI security checks",
      "IAM audit",
      "compliance report",
      "Claude",
      "Codex",
      "Claude Code",
      "security posture"
    ],
    "actual_capabilities": [
      "Lists AWS CLI checks for IAM users, MFA gaps, root account keys, and old access keys.",
      "Checks security groups, public S3 buckets, VPC Flow Logs, and RDS encryption status.",
      "Reviews EBS encryption, S3 encryption, public RDS snapshots, and KMS key rotation.",
      "Provides an example bash script for a consolidated AWS security audit report.",
      "Maps findings to CIS AWS Foundations, PCI-DSS, and HIPAA control areas.",
      "Includes remediation priority guidance for critical, high, and medium issues."
    ],
    "limitations": [
      "Requires configured AWS credentials and AWS CLI access in the target account.",
      "Does not make AWS changes or automatically remediate security issues.",
      "May need service-specific permissions across multiple AWS regions.",
      "Results need expert validation before compliance or risk decisions."
    ],
    "use_cases": [
      {
        "title": "Prepare Cloud Audit Evidence",
        "description": "Collect IAM, encryption, logging, and network findings before an internal or external audit.",
        "target_user": "Security engineer"
      },
      {
        "title": "Review AWS Misconfigurations",
        "description": "Identify common risky settings such as public access, missing MFA, and disabled encryption.",
        "target_user": "Cloud operations team"
      },
      {
        "title": "Prioritize Remediation Work",
        "description": "Group issues by urgency so teams can fix critical exposure before lower-risk configuration gaps.",
        "target_user": "Engineering manager"
      }
    ],
    "prompt_templates": [
      {
