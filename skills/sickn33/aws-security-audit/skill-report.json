        "scenario": "Beginner account posture check",
        "prompt": "Use aws-security-audit to review IAM, network security, encryption, and logging in my AWS account. Summarize the highest-risk issues first."
      },
      {
        "title": "Focus on IAM Risks",
        "scenario": "Identity and access review",
        "prompt": "Use aws-security-audit to check IAM users, MFA status, root account access keys, old access keys, and administrator policies."
      },
      {
        "title": "Build Compliance Summary",
        "scenario": "Audit preparation",
        "prompt": "Use aws-security-audit to map findings to CIS AWS Foundations, PCI-DSS, and HIPAA areas. Include evidence and remediation priority."
      },
      {
        "title": "Create Remediation Plan",
        "scenario": "Advanced remediation planning",
        "prompt": "Use aws-security-audit results to create a prioritized remediation plan with owners, risk levels, validation steps, and follow-up checks."
      }
    ],
    "output_examples": [
      {
        "input": "Check IAM and access-key hygiene for an AWS account.",
        "output": "Report section with users missing MFA, root access-key status, old access keys, and recommended fixes by priority."
      },
      {
        "input": "Find public network and storage exposure.",
        "output": "Summary of open security groups, public S3 indicators, public RDS snapshots, and suggested containment steps."
      },
      {
        "input": "Create a compliance-oriented security summary.",
        "output": "Executive summary with CIS, PCI-DSS, and HIPAA mapping, issue counts, severity grouping, and remediation order."
      }
    ],
    "best_practices": [
      "Run checks with read-only AWS permissions and the correct account profile.",
      "Redact resource identifiers before sharing audit output outside trusted teams.",
      "Validate findings in each active AWS region before closing remediation work."
