    "faq": [
      {
        "question": "Which Azure package should an application use?",
        "answer": "Use @azure/app-configuration-provider for runtime loading and refresh. Use @azure/app-configuration for direct management operations."
      },
      {
        "question": "Does this skill create Azure resources?",
        "answer": "No. It assumes an Azure App Configuration resource and valid credentials already exist."
      },
      {
        "question": "Can configuration update without restarting the application?",
        "answer": "Yes. The provider supports refresh intervals, manual refresh calls, and refresh event handlers."
      },
      {
        "question": "Does it support feature targeting?",
        "answer": "Yes. Examples cover users, groups, default percentages, and contextual feature evaluation."
      },
      {
        "question": "How should secrets be handled?",
        "answer": "Use DefaultAzureCredential and Key Vault references. Never print resolved secrets or complete configuration values."
      },
      {
        "question": "What are snapshots used for?",
        "answer": "Snapshots preserve immutable configuration sets for releases and support archive, recovery, and provider loading."
      }
