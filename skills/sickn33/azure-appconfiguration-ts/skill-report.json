    "actual_capabilities": [
      "Selects Azure SDK packages for low-level management, application loading, and feature management.",
      "Shows authentication with DefaultAzureCredential or an Azure App Configuration connection string.",
      "Demonstrates creating, reading, updating, deleting, locking, and unlocking configuration settings.",
      "Configures filtered loading, key prefix trimming, dynamic refresh, and Key Vault reference resolution.",
      "Creates and evaluates feature flags with user and group targeting.",
      "Manages snapshots and environment-specific labels for controlled configuration releases."
    ],
    "limitations": [
      "Provides reference examples, not an executable project or automated deployment.",
      "Requires an existing Azure App Configuration resource, valid credentials, and suitable RBAC permissions.",
      "Does not cover Azure resource provisioning, portal administration, pricing, or service limits.",
      "Example logging must be changed before use with confidential configuration values."
    ],
    "use_cases": [
