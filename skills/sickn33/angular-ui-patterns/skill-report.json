  "content": {
    "user_title": "Build Resilient Angular UI States",
    "value_statement": "Async Angular interfaces often show stale data, hide failures, or permit duplicate actions. This skill supplies practical patterns for clear, responsive state handling.",
    "seo_keywords": [
      "Angular UI patterns",
      "Angular loading states",
      "Angular error handling",
      "Angular forms",
      "Angular signals",
      "Claude",
      "Codex",
      "Claude Code",
      "Angular deferred rendering"
    ],
    "actual_capabilities": [
      "Structures loading, error, empty, and populated states with Angular control flow.",
      "Selects skeletons or spinners based on content shape and operation context.",
      "Applies button disabling and progress feedback during asynchronous actions.",
      "Builds form validation feedback with signals and reactive forms.",
      "Uses @defer placeholders, loading states, and error fallbacks.",
      "Adds confirmation dialogs before destructive actions."
    ],
    "limitations": [
      "Provides patterns and examples, not a complete Angular component library.",
      "Does not select a project-specific design system or visual style.",
      "Does not replace testing across browsers, assistive technologies, and application states.",
      "Examples require adaptation to local services, stores, routing, and error models."
    ],
    "use_cases": [
      {
        "title": "Implement Async List States",
        "description": "Create predictable loading, empty, error, and populated views without hiding available data.",
        "target_user": "Angular developers"
      },
      {
        "title": "Review Interaction Feedback",
        "description": "Check forms, buttons, and dialogs for clear progress, validation, failure, and confirmation behavior.",
        "target_user": "Frontend reviewers"
      },
      {
        "title": "Define UI Acceptance Criteria",
        "description": "Turn asynchronous state requirements into specific implementation and accessibility checks.",
        "target_user": "Product designers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Add Basic List States",
        "prompt": "Update this Angular list to show loading, empty, error, and populated states. Preserve available data during background refreshes.",
        "scenario": "A beginner needs complete state handling for one list."
      },
      {
        "title": "Improve Form Submission",
        "prompt": "Review this Angular reactive form. Add field feedback, prevent duplicate submissions, show progress, and surface submission failures.",
        "scenario": "A developer needs reliable form interactions."
      },
      {
        "title": "Design Deferred Content",
        "prompt": "Refactor this page with @defer for noncritical content. Include stable placeholders, loading feedback, error fallbacks, and accessibility considerations.",
        "scenario": "A team wants progressive rendering without disruptive layout changes."
      },
      {
        "title": "Audit a Complex Workflow",
        "prompt": "Audit this Angular workflow across initial load, refresh, mutation, rollback, validation, empty results, partial failure, and destructive confirmation states.",
        "scenario": "An experienced team needs a comprehensive UI state review."
      }
    ],
    "output_examples": [
      {
        "input": "Review a product list that replaces existing products with a spinner during refresh.",
        "output": [
          "Keep existing products visible during background refreshes.",
          "Show a skeleton only when loading begins without product data.",
          "Place retry feedback near the list when refresh fails."
        ]
      },
      {
        "input": "Improve a save button that remains active while a request runs.",
        "output": "Disable the button during submission, preserve its width, show progress, and restore it after success or failure."
      },
      {
        "input": "Plan states for a destructive delete action.",
        "output": [
          "Request confirmation with the affected item name.",
          "Disable repeated confirmation while deletion runs.",
          "Surface failures and keep the item visible when deletion fails."
        ]
      }
    ],
    "best_practices": [
      "Preserve useful data during background loading and show initial placeholders only when data is absent.",
      "Connect every asynchronous action to visible progress, success, failure, and retry behavior.",
      "Test focus, screen-reader announcements, validation links, and layout stability across every state."
    ],
    "anti_patterns": [
      "Replacing usable content with a spinner during every refresh.",
      "Logging errors without giving users visible feedback or recovery options.",
      "Leaving action controls enabled while their asynchronous operation is pending."
    ],
    "faq": [
      {
        "question": "Which Angular versions fit these patterns?",
        "answer": "The examples use modern Angular control flow, signals, standalone components, and @defer. Older projects require syntax and architecture adjustments."
      },
      {
        "question": "Does this skill provide ready-made components?",
        "answer": "No. It provides implementation patterns and examples that must be adapted to your components, services, and design system."
      },
      {
        "question": "When should I use a skeleton instead of a spinner?",
        "answer": "Use a skeleton for known content layouts. Use a spinner for compact actions, unknown content shapes, or short inline operations."
      },
      {
        "question": "Should existing data disappear during a refresh?",
        "answer": "Usually no. Keep useful data visible, indicate background activity, and replace content only when the new result is ready."
      },
      {
        "question": "Does the skill cover accessibility?",
        "answer": "It includes checks for announcements, field relationships, and focus management. Full accessibility testing remains the project team's responsibility."
      },
      {
        "question": "Can Claude, Codex, and Claude Code use this skill?",
        "answer": "Yes. Its guidance is compatible with Claude, Codex, and Claude Code when the task concerns Angular UI state design."
      }
    ]
