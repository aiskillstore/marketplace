  "content": {
    "user_title": "Build Reliable Angular UI States",
    "value_statement": "Angular interfaces often fail when async state, errors, and empty data are handled inconsistently. This skill gives Claude, Codex, and Claude Code practical patterns for predictable UI behavior.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Angular UI patterns",
      "Angular loading states",
      "Angular error handling",
      "Angular defer",
      "Angular forms",
      "Angular signals",
      "AI coding assistant"
    ],
    "actual_capabilities": [
      "Selects skeleton, spinner, empty, error, and data states for Angular components.",
      "Guides Angular control flow with @if, @for, @empty, and @defer patterns.",
      "Shows form validation, disabled submit states, and failure feedback patterns.",
      "Explains dialog confirmation flows and async button behavior.",
      "Provides checklists for loading, error, mutation, and accessibility states."
    ],
    "limitations": [
      "Does not generate complete Angular applications by itself.",
      "Requires project-specific component APIs and design-system names.",
      "Examples may need updates for older Angular versions.",
      "Security, accessibility, and visual testing still need project validation."
    ],
    "use_cases": [
      {
        "title": "Improve Component State Handling",
        "description": "Plan loading, empty, error, and populated states for a new Angular component before implementation.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Review Async User Flows",
        "description": "Check an existing workflow for stale data, missing retry actions, and unclear failure feedback.",
        "target_user": "Code reviewer"
      },
      {
        "title": "Standardize UI Patterns",
        "description": "Create shared guidance for forms, dialogs, deferred content, and mutation feedback across an Angular product.",
        "target_user": "Engineering lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Add Basic Loading States",
        "scenario": "Beginner component planning",
        "prompt": "Use this skill to design loading, empty, error, and data states for this Angular component: [component details]. Keep the solution aligned with Angular control flow."
      },
      {
        "title": "Review Error Feedback",
        "scenario": "Intermediate workflow review",
        "prompt": "Review this Angular workflow for missing user feedback and error states: [workflow]. Suggest changes that surface failures and support retry."
      },
      {
        "title": "Design Form States",
        "scenario": "Form implementation planning",
        "prompt": "Plan the form submission and validation states for [form name]. Include disabled buttons, field messages, success feedback, and failure recovery."
      },
      {
        "title": "Refactor Complex Async UI",
        "scenario": "Advanced architecture review",
        "prompt": "Audit this Angular feature for stale data, nested conditionals, optimistic updates, and deferred content. Propose a cleaner state model and component breakdown."
      }
    ],
    "output_examples": [
      {
        "input": "A product list loads from an API and can refresh while data is already visible.",
        "output": "Recommended state flow: show an initial skeleton only before data exists, keep existing products visible during refresh, show an empty state for no products, and use an error banner with retry when cached data remains useful."
      },
      {
        "input": "A settings form can be submitted multiple times before the first request finishes.",
        "output": "The skill would recommend disabling the submit action during submission, showing inline validation messages, adding success feedback, and surfacing failed saves with a clear retry path."
      },
      {
        "input": "A details page includes comments, analytics, and recommendations below the main content.",
        "output": "The skill would keep the main details immediate, defer lower-priority sections, provide placeholders, and add local error states for deferred content."
      }
    ],
    "best_practices": [
      "Show loading indicators only when no useful data is available.",
      "Surface every recoverable error with user-facing feedback and a retry path.",
      "Disable repeated actions during async operations and restore controls after completion."
    ],
    "anti_patterns": [
      "Replacing visible data with a spinner during every background refresh.",
      "Catching errors only in logs without telling the user what failed.",
      "Submitting forms or destructive actions multiple times because controls stay active."
    ],
    "faq": [
      {
        "question": "What Angular versions does this skill target?",
        "answer": "It focuses on modern Angular patterns, including signals, new control flow, and @defer."
      },
      {
        "question": "Can it design complete UI components?",
        "answer": "It can guide component state design and examples, but project-specific styling and APIs are still needed."
      },
      {
        "question": "Does it cover accessibility?",
        "answer": "It includes checklist guidance for loading announcements, error links, and focus changes."
      },
      {
        "question": "Can Claude Code or Codex use it during refactors?",
        "answer": "Yes. The skill gives review prompts and patterns for improving existing Angular async flows."
      },
      {
        "question": "Does it replace Angular documentation?",
        "answer": "No. It summarizes practical UI patterns and should be checked against current Angular documentation."
      },
      {
        "question": "When should I avoid this skill?",
        "answer": "Avoid it for non-Angular UI work, backend-only tasks, or projects that do not use modern Angular patterns."
      }
    ]
