  "content": {
    "user_title": "Build Robust Angular UI States",
    "value_statement": "Angular interfaces often handle loading, errors, forms, and empty data inconsistently. This skill gives Claude, Codex, and Claude Code practical patterns for predictable UI state handling.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Angular UI patterns",
      "Angular loading states",
      "Angular error handling",
      "Angular forms",
      "Angular defer",
      "Angular empty states",
      "UI state management"
    ],
    "actual_capabilities": [
      "Explains when to show skeletons, spinners, empty states, and existing data.",
      "Provides Angular control-flow examples using @if, @for, @empty, and @defer.",
      "Describes error handling hierarchy from field errors to full error screens.",
      "Shows button, form, and submission patterns for async operations.",
      "Gives dialog confirmation patterns using Angular services and result handling.",
      "Lists UI state checklist items for loading, errors, feedback, and accessibility."
    ],
    "limitations": [
      "It is guidance only and does not inspect a live Angular project by itself.",
      "Examples may need adaptation for the project design system and component library.",
      "It does not replace Angular security, accessibility, or performance review.",
      "It focuses on modern Angular patterns and may not fit older Angular versions."
    ],
    "use_cases": [
      {
        "title": "Standardize Feature UI States",
        "target_user": "Frontend engineer",
        "description": "Apply consistent loading, empty, error, and data states across Angular feature screens."
      },
      {
        "title": "Review Async Component Behavior",
        "target_user": "Engineering lead",
        "description": "Check whether components disable repeated actions, surface failures, and keep existing data visible during refreshes."
      },
      {
        "title": "Guide AI Code Generation",
        "target_user": "AI-assisted developer",
        "description": "Give Claude, Codex, or Claude Code specific Angular UI rules before generating components or templates."
      }
    ],
    "prompt_templates": [
      {
        "title": "Add UI States",
        "scenario": "Beginner component improvement",
        "prompt": "Use angular-ui-patterns to add loading, empty, error, and success states to this Angular component. Keep existing data visible during refreshes."
      },
      {
        "title": "Improve Form Feedback",
        "scenario": "Form validation and submission",
        "prompt": "Review this Angular form with angular-ui-patterns. Add field validation messages, disabled submit behavior, and clear success or failure feedback."
      },
      {
        "title": "Refactor Async Flow",
        "scenario": "Intermediate state management",
        "prompt": "Apply angular-ui-patterns to refactor this async Angular screen. Use skeletons only when no data exists and surface all recoverable errors."
      },
      {
        "title": "Audit Feature Experience",
        "scenario": "Advanced UI quality review",
        "prompt": "Audit this Angular feature against angular-ui-patterns. Identify missing states, repeated-action risks, stale UI risks, and accessibility gaps."
      }
    ],
    "output_examples": [
      {
        "input": "A list page flashes a spinner every time data refreshes.",
        "output": [
          "Keep the current list visible during refresh.",
          "Show a skeleton only during the first load when no items exist.",
          "Show an error banner if refresh fails and the old list remains usable."
        ]
      },
      {
        "input": "A submit button can be clicked many times while a form is saving.",
        "output": [
          "Track the submitting state with a signal or store value.",
          "Disable the submit button while the operation runs.",
          "Show inline progress and a toast or message after success or failure."
        ]
      },
      {
        "input": "A feature has optional comments below critical page content.",
        "output": [
          "Render the critical header and main content immediately.",
          "Use progressive rendering for the comments area.",
          "Provide placeholder, loading, and error states for the deferred area."
        ]
      }
    ],
    "best_practices": [
      "Show loading indicators only when there is no useful data to display.",
      "Surface every error through a field message, toast, banner, or full error state.",
      "Disable repeated actions during async work and give visible progress feedback."
    ],
    "anti_patterns": [
      "Replacing existing data with a spinner during every refresh.",
      "Catching errors only in logs without showing users a recovery path.",
      "Leaving submit, save, or delete controls active while the operation is running."
    ],
    "faq": [
      {
        "question": "Does this skill generate complete Angular applications?",
        "answer": "No. It provides UI state patterns and examples that can guide component implementation."
      },
      {
        "question": "Which Angular features does it emphasize?",
        "answer": "It emphasizes Signals, modern control flow, @empty, @defer, forms, and async UI state handling."
      },
      {
        "question": "Can it work with Angular Material?",
        "answer": "Yes. The patterns are compatible with Angular Material and other component libraries."
      },
      {
        "question": "Does it include accessibility guidance?",
        "answer": "Yes. It reminds users to announce loading states, link field errors, and manage focus after state changes."
      },
      {
        "question": "Does it make network calls?",
        "answer": "No. The skill contains guidance and reference links, but it does not execute code or make requests."
      },
      {
        "question": "Who should use this skill?",
        "answer": "Frontend developers and AI-assisted teams building Angular interfaces with async data and user actions."
      }
    ]
