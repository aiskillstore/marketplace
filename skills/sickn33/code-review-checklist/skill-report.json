  "content": {
    "user_title": "Review Code With a Practical Checklist",
    "value_statement": "Code reviews can miss bugs, security issues, and test gaps when reviewers work from memory. This skill provides a structured checklist and comment templates for consistent reviews.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "code review checklist",
      "pull request review",
      "software quality",
      "security review",
      "test coverage",
      "developer workflow",
      "review comments"
    ],
    "actual_capabilities": [
      "Guides reviewers through context, functionality, security, performance, tests, documentation, and Git checks.",
      "Provides checklist items for pull request review and code audit workflows.",
      "Includes example issues for validation, SQL injection, hardcoded secrets, naming, and large functions.",
      "Supplies reusable review comment templates for change requests, questions, and positive feedback.",
      "Lists common pitfalls such as missing edge cases, poor tests, security issues, and unclear code."
    ],
    "limitations": [
      "Does not automatically inspect a repository unless the assistant receives the relevant files or diff.",
      "Does not replace project-specific standards, architecture knowledge, or human approval authority.",
      "Does not run tests, scanners, or linters by itself.",
      "Examples are general and may need adjustment for each language or framework."
    ],
    "use_cases": [
      {
        "title": "Review a Pull Request",
        "description": "Apply a structured checklist to find functional, security, performance, and test concerns before approval.",
        "target_user": "Software engineer"
      },
      {
        "title": "Create Team Review Standards",
        "description": "Turn the checklist into shared review expectations for consistent feedback across a development team.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Train New Reviewers",
        "description": "Teach developers what to check and how to write clear review comments.",
        "target_user": "Mentor or onboarding manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Review Checklist",
        "scenario": "Beginner review of a small pull request.",
        "prompt": "Use the code-review-checklist skill to review this pull request. Focus on functionality, readability, tests, and any obvious security risks."
      },
      {
        "title": "Security-Focused Review",
        "scenario": "Review code that handles users, data, or permissions.",
        "prompt": "Use the security section of the checklist to review this change. Look for input validation, authorization, secret handling, injection risks, and sensitive data exposure."
      },
      {
        "title": "Release Readiness Review",
        "scenario": "Review a larger change before merge or release.",
        "prompt": "Apply the full checklist to this diff. Separate findings by functionality, performance, tests, documentation, security, and maintainability."
      },
      {
        "title": "Team Standards Audit",
        "scenario": "Advanced review process improvement.",
        "prompt": "Use this checklist to audit our review process. Identify missing standards, repeated review gaps, and improvements for our team review template."
      }
    ],
    "output_examples": [
      {
        "input": "Review a pull request that adds user registration.",
        "output": "The review highlights missing email validation, weak password rules, absent negative tests, and a need to document new account errors."
      },
      {
        "input": "Prepare feedback for a large function in an order flow.",
        "output": "The output suggests separating validation, pricing, payment, notifications, and inventory updates into focused units."
      },
      {
        "input": "Create a team checklist for reviewers.",
        "output": "The result organizes checks into context, functionality, security, performance, tests, documentation, and Git hygiene."
      }
    ],
    "best_practices": [
      "Start with the pull request goal and linked requirements before reviewing individual lines.",
      "Use the checklist to prioritize correctness, security, tests, and maintainability over minor style preferences.",
      "Write specific review comments that explain the issue, impact, and suggested next step."
    ],
    "anti_patterns": [
      "Approving changes without reading the diff or understanding the intended behavior.",
      "Leaving vague comments that do not explain what should change.",
      "Using the checklist as a substitute for running tests or validating risky behavior."
    ],
    "faq": [
      {
        "question": "Does this skill review code automatically?",
        "answer": "No. It guides the assistant through a review process when you provide code, a diff, or repository context."
      },
      {
        "question": "Can it help with security reviews?",
        "answer": "Yes. It includes checks for input validation, injection risks, authorization, secret handling, and dependency security."
      },
      {
        "question": "Is it limited to one programming language?",
        "answer": "No. The checklist is language neutral, but examples use JavaScript for common review patterns."
      },
      {
        "question": "Can teams customize it?",
        "answer": "Yes. Teams can adapt the checklist to match their architecture, compliance needs, and review culture."
      },
      {
        "question": "Does it replace CI checks?",
        "answer": "No. It complements tests, linters, type checks, and security scanners."
      },
      {
        "question": "Can it help write review comments?",
        "answer": "Yes. It includes templates for requesting changes, asking questions, and recognizing good code."
      }
