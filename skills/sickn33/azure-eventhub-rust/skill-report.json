  "content": {
    "user_title": "Build Azure Event Hubs Rust Workflows",
    "value_statement": "Rust developers often need a quick path from Azure Event Hubs concepts to working SDK calls. This skill provides focused examples for producers, consumers, batches, partition reads, and references.",
    "seo_keywords": [
      "Azure Event Hubs Rust",
      "azure_messaging_eventhubs",
      "Rust event streaming",
      "ProducerClient Rust",
      "ConsumerClient Rust",
      "Azure streaming ingestion",
      "Claude",
      "Codex",
      "Claude Code",
      "Azure SDK for Rust"
    ],
    "actual_capabilities": [
      "Shows the cargo dependencies for Azure Event Hubs and Azure Identity.",
      "Defines the expected Event Hubs host and hub name environment variables.",
      "Demonstrates creating a Rust ProducerClient with DeveloperToolsCredential.",
      "Demonstrates sending single events and batches to Event Hubs.",
      "Demonstrates creating a ConsumerClient and receiving events from a partition.",
      "Links to API reference, source code, and crates.io package pages."
    ],
    "limitations": [
      "Provides examples only and does not generate a complete production service.",
      "Assumes access to an Azure Event Hubs namespace and Rust toolchain.",
      "Does not cover deployment, monitoring, or infrastructure provisioning.",
      "Mentions checkpoint storage but does not provide full checkpointing code."
    ],
    "use_cases": [
      {
        "title": "Create a Rust Event Producer",
        "description": "Build a Rust producer that sends single events or batches to an Event Hub.",
        "target_user": "Backend developer"
      },
      {
        "title": "Read Stream Partitions",
        "description": "Create a consumer that opens a partition receiver and inspects incoming event bodies.",
        "target_user": "Data engineer"
      },
      {
        "title": "Review SDK Integration Points",
        "description": "Check package names, credentials, environment variables, and reference links before implementation.",
        "target_user": "Platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Install the Rust SDK",
        "prompt": "Show me the Rust dependencies and environment variables needed for Azure Event Hubs.",
        "scenario": "Beginner setup"
      },
      {
        "title": "Send an Event",
        "prompt": "Guide me through creating a Rust producer and sending one event to Azure Event Hubs.",
        "scenario": "Basic producer workflow"
      },
      {
        "title": "Receive Events",
        "prompt": "Help me create a Rust consumer that reads events from a specific Event Hubs partition.",
        "scenario": "Consumer implementation"
      },
      {
        "title": "Design a Streaming Client",
        "prompt": "Help me plan a Rust Event Hubs client that reuses producers, batches messages, reads partitions, and prepares for checkpointing.",
        "scenario": "Advanced architecture planning"
      }
    ],
    "output_examples": [
      {
        "input": "I need to send telemetry from Rust to Azure Event Hubs.",
        "output": "The skill will identify the producer client path, required Azure credential, host format, hub name, and send options."
      },
      {
        "input": "I need to consume messages from partition zero.",
        "output": "The skill will outline the consumer client setup, partition receiver step, event read count, and body inspection approach."
      },
      {
        "input": "I want to validate my Event Hubs Rust dependency choices.",
        "output": "The skill will list the Event Hubs crate, Azure Identity crate, optional checkpoint store crate, and official reference links."
      }
    ],
    "best_practices": [
      "Reuse Event Hubs clients instead of creating new clients for every send.",
      "Use batches for efficient throughput when sending many events.",
      "Plan consumer groups and checkpointing before running distributed consumers."
    ],
    "anti_patterns": [
      "Creating a new producer for every event send.",
      "Ignoring batch capacity before sending high-volume messages.",
      "Using one consumer group for unrelated applications."
    ],
    "faq": [
