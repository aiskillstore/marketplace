        "prompt": "Convert this AngularJS controller or directive into an Angular component and explain key changes."
      },
      {
        "title": "Design hybrid setup",
        "scenario": "Advanced",
        "prompt": "Plan an ngUpgrade hybrid setup for this module, including bootstrap, dependency injection, routing, and test checkpoints."
      },
      {
        "title": "Lead migration roadmap",
        "scenario": "Expert",
        "prompt": "Create a phased AngularJS to Angular migration roadmap with milestones, validation gates, rollback options, and team responsibilities."
      }
    ],
    "output_examples": [
      {
        "input": "A team asks how to migrate a large AngularJS dashboard without stopping feature delivery.",
        "output": [
          "Recommended a hybrid ngUpgrade path.",
          "Moved shared services first.",
          "Suggested feature-by-feature migration with regression testing."
        ]
      },
      {
        "input": "A developer provides an AngularJS directive and asks for an Angular version.",
        "output": "The response explains the component boundary, input and output mappings, template changes, and required module updates."
      },
      {
        "input": "A manager needs a migration timeline for planning.",
        "output": "The response proposes setup, infrastructure, feature migration, and cleanup phases with validation points."
      }
    ],
    "best_practices": [
      "Start with services and shared utilities before migrating complex screens.",
      "Keep AngularJS and Angular integration tests active during hybrid operation.",
      "Plan rollback and staging validation before each production cutover."
    ],
    "anti_patterns": [
      "Do not migrate all features at once without rollback planning.",
      "Do not mix AngularJS scope patterns into new Angular components.",
      "Do not remove ngUpgrade until migrated features pass regression testing."
    ],
