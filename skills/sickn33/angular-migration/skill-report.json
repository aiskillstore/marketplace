    "user_title": "Plan AngularJS to Angular migrations",
    "value_statement": "Legacy AngularJS apps are hard to modernize without breaking delivery. This skill gives structured migration steps for hybrid setup, component rewrites, and validation.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "AngularJS migration",
      "Angular migration",
      "ngUpgrade",
      "hybrid Angular app",
      "component migration",
      "dependency injection migration",
      "routing migration"
    ],
    "actual_capabilities": [
      "Compares rewrite, hybrid, and vertical slice migration strategies.",
      "Shows ngUpgrade bootstrap patterns for running AngularJS and Angular together.",
      "Maps AngularJS controllers, directives, and services to Angular components and services.",
      "Explains dependency injection upgrades and downgrades between both frameworks.",
      "Outlines routing, forms, and phased migration timelines.",
      "Lists practical pitfalls and best practices for staged modernization."
    ],
    "limitations": [
      "It provides guidance and examples, not automated code transformation.",
      "It does not inspect repositories or run migration tools by itself.",
      "Examples use simplified user features and may need production hardening.",
      "Referenced resource files and scripts are not included in this package."
    ],
    "use_cases": [
      {
        "title": "Modernize a legacy product",
        "description": "Plan a staged AngularJS to Angular migration while maintaining release flow.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Convert feature slices",
        "description": "Rewrite controllers, directives, services, routes, and forms with Angular patterns.",
        "target_user": "Frontend developers"
      },
      {
        "title": "Estimate migration work",
        "description": "Use phases, risks, and common pitfalls to size a modernization project.",
        "target_user": "Technical project managers"
      }
    ],
    "prompt_templates": [
