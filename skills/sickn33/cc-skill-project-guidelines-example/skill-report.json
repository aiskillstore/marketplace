    "actual_capabilities": [
      "Documents architecture for Next.js, FastAPI, Supabase, Claude API, and Cloud Run.",
      "Provides API response, frontend fetch, Claude structured output, and React hook patterns.",
      "Lists pytest, React Testing Library, and Playwright testing expectations.",
      "Defines pre-deployment checks, build commands, and Cloud Run deployment examples.",
      "Describes frontend and backend environment variables with placeholder values."
    ],
    "limitations": [
      "It is an example template, not a complete policy for every project.",
      "It does not include executable scripts or automation.",
      "Deployment commands require human review before use.",
      "Environment values are placeholders and must be replaced for real systems."
