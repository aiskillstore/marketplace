    "value_statement": "Production errors can be hard to trace across logs, services, and alerts. This skill guides structured investigation, root-cause analysis, and incident response steps.",
    "seo_keywords": [
      "Claude error diagnostics",
      "Codex debugging skill",
      "Claude Code observability",
      "root cause analysis",
      "production incident response",
      "distributed tracing",
      "log analysis",
      "Sentry debugging",
      "Datadog APM",
      "OpenTelemetry troubleshooting"
    ],
    "actual_capabilities": [
      "Classifies errors by severity, type, and observability pattern.",
      "Guides root-cause analysis using logs, traces, stack traces, and incident timelines.",
      "Provides checklists for retry logic, error boundaries, validation, and graceful degradation.",
      "Explains observability setup patterns for Sentry, Datadog, OpenTelemetry, and alerting.",
      "Includes incident response workflows, investigation steps, and communication templates."
    ],
    "limitations": [
      "Requires relevant logs, traces, error messages, or incident context.",
      "Does not validate fixes inside the target environment.",
      "Does not replace security, privacy, or compliance review for production telemetry.",
      "Code examples must be adapted before use in a real application."
    ],
    "use_cases": [
      {
        "title": "Investigate Service Outages",
        "description": "Triage errors, identify likely root causes, and decide the next diagnostic steps during an outage.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Debug Application Failures",
        "description": "Analyze stack traces, logs, and request context to isolate defects in backend services.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Improve Incident Reviews",
        "description": "Turn incident timelines into prevention actions, monitoring changes, and clearer follow-up plans.",
        "target_user": "Engineering manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Summarize an Error",
        "scenario": "Beginner triage for a single error report.",
        "prompt": "Analyze this error message and summarize the likely impact, missing context, and first three checks: [paste error details]."
      },
      {
        "title": "Find the Root Cause",
        "scenario": "Intermediate debugging with logs and recent changes.",
        "prompt": "Use these logs, stack traces, and deployment notes to identify the most likely root cause and supporting evidence: [paste context]."
      },
      {
        "title": "Trace a Distributed Failure",
        "scenario": "Advanced analysis across multiple services.",
        "prompt": "Review these trace events and service logs. Map the failing request path, isolate the failing span, and suggest validation steps: [paste telemetry]."
      },
      {
        "title": "Plan Incident Recovery",
        "scenario": "Advanced incident response and prevention planning.",
        "prompt": "Create an incident analysis with timeline, customer impact, mitigation options, monitoring gaps, and prevention work from this evidence: [paste incident data]."
      }
    ],
    "output_examples": [
      {
        "input": "Payment errors increased after a deployment, and logs show database connection timeouts.",
        "output": [
          "Impact: payment attempts are failing for a subset of users.",
          "Likely cause: connection pool exhaustion or a deployment change affecting query latency.",
          "Next checks: compare deployment timing, database pool metrics, slow queries, and rollback options."
        ]
      },
      {
        "input": "A service returns intermittent timeouts, but single-service logs do not show a clear exception.",
        "output": [
          "Use trace IDs to follow failed requests across services.",
          "Compare timeout spans with downstream latency and retry behavior.",
          "Check whether retries amplify load during partial dependency failure."
        ]
      },
      {
        "input": "A recurring frontend exception appears after a new release.",
        "output": [
          "Group errors by release, browser, route, and user action.",
          "Identify the first application frame and the changed component.",
          "Add a regression test and monitor the error fingerprint after the fix."
        ]
      }
    ],
    "best_practices": [
      "Start with impact, timeline, and reproducible evidence before proposing fixes.",
      "Correlate logs, traces, metrics, and recent changes instead of relying on one signal.",
      "Redact secrets and sensitive user data before sharing diagnostics."
