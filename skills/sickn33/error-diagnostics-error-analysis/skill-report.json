    "user_title": "Diagnose Production Errors Faster",
    "value_statement": "Production errors can hide across logs, traces, deployments, and service boundaries. This skill guides Claude, Codex, and Claude Code through structured root-cause analysis and reliability fixes.",
    "seo_keywords": [
      "Claude error diagnostics",
      "Codex debugging skill",
      "Claude Code incident response",
      "root cause analysis",
      "production debugging",
      "observability",
      "distributed tracing",
      "Sentry troubleshooting",
      "OpenTelemetry guidance",
      "incident postmortem"
    ],
    "actual_capabilities": [
      "Classifies errors by severity, type, observability pattern, and user impact.",
      "Guides stack trace review, reproduction, call-chain analysis, and hypothesis testing.",
      "Recommends logging, tracing, alerting, and error tracking patterns for distributed systems.",
      "Suggests resilience patterns such as retries, backoff, circuit breakers, and graceful degradation.",
      "Provides incident response, communication, postmortem, and prevention checklists."
    ],
    "limitations": [
      "Requires logs, traces, stack traces, or incident details from the user.",
      "Cannot access live production systems unless the host tool already has access.",
      "Examples must be adapted to the user environment and reviewed before deployment.",
      "Does not replace security, privacy, or on-call approval processes."
    ],
    "use_cases": [
      {
        "title": "Resolve production incidents",
        "description": "An SRE can organize symptoms, timelines, traces, mitigations, and rollback options during an outage.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Debug service failures",
        "description": "A backend engineer can connect stack traces, logs, dependencies, and recent changes to find a root cause.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Improve reliability process",
        "description": "An engineering manager can turn incident lessons into monitoring, alerting, testing, and postmortem follow-ups.",
        "target_user": "Engineering manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Analyze a Stack Trace",
        "scenario": "Beginner",
        "prompt": "Analyze this stack trace and error message. Identify the likely failure point, missing context, and first debugging steps: [paste details]."
      },
      {
        "title": "Investigate a Recurring Error",
        "scenario": "Intermediate",
        "prompt": "Use the error diagnostics skill to investigate this recurring production error. Correlate logs, deployments, user impact, and probable root causes: [paste data]."
      },
      {
        "title": "Design Observability Improvements",
        "scenario": "Advanced",
        "prompt": "Review this service architecture and error history. Propose logging, tracing, metrics, alerts, and dashboards that would improve diagnosis: [paste context]."
      },
      {
        "title": "Lead Incident Analysis",
        "scenario": "Expert",
        "prompt": "Create an incident analysis for this distributed failure. Include timeline, hypotheses, mitigation plan, evidence gaps, owner actions, and prevention measures: [paste incident notes]."
      }
    ],
    "output_examples": [
      {
        "input": "A payment service started timing out after a deployment.",
        "output": "The skill would build a timeline, compare deployment changes, inspect database pool metrics, propose rollback criteria, and list prevention work."
      },
      {
        "input": "An API has intermittent 500 errors with no clear owner.",
        "output": [
          "Groups symptoms by service boundary and correlation ID.",
          "Identifies likely failing dependencies and missing telemetry.",
          "Recommends targeted experiments and alert improvements."
        ]
      },
      {
        "input": "A team needs a post-incident review.",
        "output": "The skill would summarize impact, root cause evidence, mitigation decisions, follow-up owners, and monitoring gaps."
      }
    ],
    "best_practices": [
      "Provide timestamps, affected services, recent deployments, logs, traces, and exact error messages.",
      "Ask for evidence-backed hypotheses before implementing fixes.",
      "Redact secrets, tokens, personal data, and customer identifiers from shared diagnostics."
    ],
    "anti_patterns": [
      "Do not treat the first stack frame as the root cause without verification.",
      "Do not change production systems without approval, tests, and rollback plans.",
      "Do not paste secrets or full customer records into diagnostic prompts."
    ],
    "faq": [
      {
        "question": "What information should I provide?",
        "answer": "Provide the error message, stack trace, timeline, affected service, logs, traces, recent changes, and user impact."
      },
      {
        "question": "Can it debug distributed systems?",
        "answer": "Yes. It focuses on correlation IDs, service dependencies, traces, queues, retries, and cascading failures."
      },
      {
        "question": "Does it connect to monitoring tools?",
        "answer": "No. It gives guidance for tools such as Sentry, Datadog, OpenTelemetry, and Grafana when you provide context."
      },
      {
        "question": "Can it write fixes?",
        "answer": "It can propose fixes, tests, and safeguards. You should review and run changes in your normal workflow."
      },
      {
        "question": "How should I handle sensitive logs?",
        "answer": "Redact secrets, tokens, customer records, and personal data before sharing logs or traces."
      },
      {
        "question": "Is this useful after an incident?",
        "answer": "Yes. It can structure postmortems, prevention tasks, alerts, and reliability improvements."
      }
