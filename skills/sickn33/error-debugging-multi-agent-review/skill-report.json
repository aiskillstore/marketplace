        "title": "Debug a Complex Regression",
        "description": "A developer routes a failing feature through quality, performance, and architecture reviewers.",
        "target_user": "Software developer"
      },
      {
        "title": "Standardize Review Process",
        "description": "A platform team creates repeatable agent roles, handoffs, and synthesis rules.",
        "target_user": "Platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a Review Plan",
        "prompt": "Create a multi-agent review plan for this module: [describe module]. Include agent roles and review order.",
        "scenario": "Beginner planning"
      },
      {
