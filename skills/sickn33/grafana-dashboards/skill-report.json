    "user_title": "Build Production Grafana Dashboards",
    "value_statement": "Monitoring teams often struggle to turn raw Prometheus metrics into clear operational views. This skill guides dashboard structure, queries, alerts, variables, and provisioning.",
    "seo_keywords": [
      "Grafana dashboards",
      "Prometheus monitoring",
      "observability",
      "dashboard as code",
      "Grafana alerts",
      "PromQL",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Structures dashboards using information hierarchy, RED, and USE monitoring methods.",
      "Drafts PromQL examples for request rate, error rate, latency, CPU, and service health.",
      "Recommends stat, time-series, table, and heatmap panels for common monitoring goals.",
      "Defines Grafana variables, thresholds, alert conditions, units, and time ranges.",
      "Provides provisioning guidance for Grafana YAML, Terraform, and Ansible workflows.",
      "Outlines application, infrastructure, database, and SLO dashboard layouts."
    ],
    "limitations": [
      "It does not connect to Grafana, Prometheus, or production systems.",
      "Metric names, labels, data sources, and Grafana versions require environment-specific validation.",
      "Referenced assets and supporting guides are not included in the scanned skill package.",
      "Generated alert thresholds require review against service objectives and traffic patterns."
    ],
    "use_cases": [
