    "user_title": "Create Production Grafana Dashboards",
    "value_statement": "Teams need dashboards that show system health without noise. This skill guides Grafana layouts, Prometheus queries, alerts, and provisioning workflows.",
    "seo_keywords": [
      "Grafana dashboards",
      "observability dashboards",
      "Prometheus monitoring",
      "SLO dashboard",
      "infrastructure monitoring",
      "Claude",
      "Codex",
      "Claude Code",
      "dashboard as code"
    ],
    "actual_capabilities": [
      "Explains RED and USE methods for dashboard planning.",
      "Provides Grafana panel examples for stat, graph, table, and heatmap views.",
      "Shows Prometheus query patterns for services, infrastructure, and latency metrics.",
      "Describes dashboard variables, alerts, thresholds, and notification settings.",
      "Includes provisioning examples for Terraform, Ansible, and file-based dashboards.",
      "Lists common dashboard patterns for APIs, infrastructure, databases, and applications."
    ],
    "limitations": [
      "It does not connect to a live Grafana instance or validate dashboards automatically.",
      "Referenced asset and resource files are not included in this package.",
      "Examples assume Prometheus-style metrics and may need local metric names.",
      "It does not provide credentials, permissions, or production rollout approval."
    ],
    "use_cases": [
      {
        "title": "Build an API Monitoring View",
        "description": "Create panels for request rate, error rate, latency, and alert conditions for service owners.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Standardize Infrastructure Dashboards",
        "description": "Plan CPU, memory, disk, network, pod, and node status panels across environments.",
        "target_user": "DevOps engineer"
      },
      {
        "title": "Prepare Dashboard Provisioning",
        "description": "Use dashboard-as-code patterns to manage Grafana folders and dashboard deployment workflows.",
        "target_user": "Platform engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Plan a Basic Dashboard",
        "scenario": "Beginner dashboard planning",
        "prompt": "Help me plan a Grafana dashboard for this service: [service name]. Include the key panels, metrics, and thresholds."
      },
      {
        "title": "Design Prometheus Panels",
        "scenario": "Intermediate metric selection",
        "prompt": "Create a Grafana panel plan for these Prometheus metrics: [metrics]. Include RED or USE method guidance."
      },
      {
        "title": "Add Alerts and Variables",
        "scenario": "Advanced dashboard refinement",
        "prompt": "Review this dashboard goal: [goal]. Recommend variables, alert rules, thresholds, and panel organization."
      },
      {
        "title": "Provision Dashboards as Code",
        "scenario": "Advanced operational rollout",
        "prompt": "Design a dashboard-as-code workflow for Grafana using [Terraform or Ansible]. Include validation and rollout steps."
      }
    ],
    "output_examples": [
      {
        "input": "Create an API monitoring dashboard for a production service.",
        "output": "A dashboard plan with request rate, error percentage, latency percentile, service variable, and alert recommendations."
      },
      {
        "input": "Improve an infrastructure monitoring dashboard for Kubernetes nodes.",
        "output": "A panel layout covering CPU, memory, disk, network, pod count, node status, and useful time range defaults."
      },
      {
        "input": "Prepare Grafana dashboards for repeatable deployment.",
        "output": "A provisioning approach that uses folders, dashboard files, update intervals, and a verification checklist."
      }
    ],
    "best_practices": [
      "Start with user goals, alert ownership, and the decisions each dashboard must support.",
      "Use consistent panel names, units, thresholds, and colors across related dashboards.",
      "Test dashboards with multiple time ranges and representative production metrics."
    ],
    "anti_patterns": [
      "Do not copy dashboards without mapping queries to local metric names and labels.",
      "Do not show every metric on one page when separate views would be clearer.",
      "Do not deploy alerting panels without confirming notification routes and ownership."
    ],
