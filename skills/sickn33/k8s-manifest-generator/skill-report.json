    "user_title": "Generate Kubernetes Manifests Safely",
    "value_statement": "Kubernetes manifests are easy to misconfigure when teams write them from memory. This skill turns requirements into structured YAML guidance with security, probes, resources, and service patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Kubernetes manifest generator",
      "K8s YAML",
      "Deployment manifests",
      "Service manifests",
      "ConfigMap templates",
      "Secret templates",
      "DevOps automation"
    ],
    "actual_capabilities": [
      "Creates Deployment manifests with replicas, update strategy, probes, lifecycle hooks, and security contexts.",
      "Generates Service patterns for ClusterIP, LoadBalancer, NodePort, headless, and ExternalName use cases.",
      "Provides ConfigMap, Secret, and PersistentVolumeClaim templates with common production fields.",
      "Applies Kubernetes labels, namespace fields, selectors, ports, and resource request patterns.",
      "Offers implementation checklists for validation, rollout safety, troubleshooting, and environment-specific configuration."
    ],
    "limitations": [
      "It does not connect to a Kubernetes cluster or apply manifests.",
      "It cannot validate cluster-specific admission policies, CRDs, quotas, or cloud load balancer settings.",
      "Generated examples include placeholders that users must replace before deployment.",
      "It does not manage runtime secrets or rotate credentials."
    ],
    "use_cases": [
      {
        "title": "Create a Web Service Release",
        "description": "Generate a Deployment and Service for a containerized web application with probes, resource limits, and safe rollout settings.",
        "target_user": "Application developer"
      },
      {
        "title": "Standardize Platform Templates",
        "description": "Build reusable manifest patterns for namespaces, labels, ConfigMaps, Secrets, Services, and storage claims.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Review Production Readiness",
        "description": "Compare proposed Kubernetes manifests against production practices for security contexts, availability, resources, and service exposure.",
        "target_user": "Site reliability engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Generate a Basic Deployment",
        "scenario": "Begin with a single application workload.",
        "prompt": "Generate a Kubernetes Deployment for image <image>:<tag>, namespace <namespace>, container port <port>, and three replicas. Include probes and resource requests."
      },
      {
        "title": "Add Service Exposure",
        "scenario": "Expose an existing application inside or outside the cluster.",
        "prompt": "Create the matching Kubernetes Service for my Deployment. Explain whether ClusterIP, LoadBalancer, NodePort, or headless Service fits my access requirements."
      },
      {
        "title": "Build Environment Configuration",
        "scenario": "Separate application configuration from workload definitions.",
        "prompt": "Create ConfigMap and Secret manifest guidance for these environment variables and files. Use placeholders and call out any values that must stay out of Git."
      },
      {
        "title": "Harden a Production Manifest",
        "scenario": "Review a manifest before deployment.",
        "prompt": "Review this Kubernetes manifest for production readiness. Check security context, probes, resources, update strategy, service exposure, labels, and secret handling."
      }
    ],
    "output_examples": [
      {
        "input": "Create a production web Deployment for image acme/api:1.4.2 with port 8080.",
        "output": [
          "A Deployment plan with three replicas, rolling updates, health probes, resource requests, and non-root container settings.",
          "A short checklist covering namespace, labels, image tag, secret references, and rollout verification."
        ]
      },
      {
        "input": "Expose my internal payment service to other pods only.",
        "output": [
          "A ClusterIP Service recommendation with named ports, selectors, and DNS guidance for same-namespace and cross-namespace access.",
          "Notes explaining why NodePort and public LoadBalancer are not appropriate for this internal service."
        ]
      },
      {
        "input": "Review this manifest before production deployment.",
        "output": [
          "A prioritized review of missing resource limits, unsafe service exposure, weak secret handling, and absent readiness checks.",
          "Concrete remediation steps that keep the manifest aligned with Kubernetes production practices."
        ]
      }
    ],
    "best_practices": [
      "Provide image names, ports, namespaces, storage needs, and service exposure requirements before asking for a manifest.",
      "Replace placeholders and review Secret, LoadBalancer, and ExternalIP fields before applying any generated manifest.",
      "Validate generated manifests with kubectl, policy checks, and a staging cluster before production use."
    ],
    "anti_patterns": [
      "Do not apply generated placeholder values directly to production clusters.",
      "Do not expose a LoadBalancer to every source range unless that is an intentional public API decision.",
      "Do not store real passwords, private keys, or tokens in generated YAML files committed to source control."
    ],
    "faq": [
      {
        "question": "Can this skill create complete Kubernetes YAML?",
        "answer": "Yes. It can create Deployment, Service, ConfigMap, Secret, and PVC guidance from clear requirements."
      },
      {
        "question": "Does it deploy manifests to my cluster?",
        "answer": "No. It generates and reviews manifest content only. You decide how to validate and apply it."
      },
      {
        "question": "Does it support production security settings?",
        "answer": "Yes. It includes non-root containers, dropped capabilities, resource limits, probes, and secret handling guidance."
      },
      {
        "question": "Can it choose the right Service type?",
        "answer": "Yes. It explains ClusterIP, LoadBalancer, NodePort, headless, and ExternalName choices based on access needs."
      },
      {
        "question": "Should I put real secrets in generated YAML?",
        "answer": "No. Use placeholders, sealed secrets, external secret managers, or approved cluster secret workflows."
      },
      {
        "question": "Does it validate cloud provider annotations?",
        "answer": "No. Cloud-specific annotations and policies must be checked against your provider and cluster configuration."
      }
    ]
