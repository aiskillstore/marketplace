        "description": "Design a TypeScript producer that batches sensor events and preserves per-device ordering with partition keys.",
        "target_user": "Application developer"
      },
      {
        "title": "Build a Checkpointed Consumer",
        "description": "Add Blob Storage checkpoints, consumer groups, error handling, and controlled shutdown to a stream processor.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Review Stream Processing Reliability",
        "description": "Assess batch settings, replay behavior, offsets, logging, and idempotency before a production release.",
        "target_user": "Site reliability engineer"
      }
    ],
