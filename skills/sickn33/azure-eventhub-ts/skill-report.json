      }
    ],
    "output_examples": [
      {
        "input": "Plan a producer for ordered device telemetry.",
        "output": [
          "Use each device identifier as the partition key.",
          "Create bounded batches and verify every event fits before sending.",
          "Close the producer during graceful application shutdown."
        ]
      },
      {
        "input": "Review a checkpointed consumer for duplicate processing risks.",
        "output": [
          "Treat delivery as at-least-once because events may replay after failures.",
          "Make downstream writes idempotent or deduplicate by a stable event identifier.",
          "Advance checkpoints only after successful processing."
        ]
      },
      {
        "input": "Recommend safe consumer logging.",
        "output": "Log partition, offset, sequence number, event type, and a correlation identifier. Redact or omit complete event bodies."
      }
    ],
    "best_practices": [
      "Use managed identity with least-privilege Azure roles and keep credentials outside source code.",
      "Design handlers for replay, then checkpoint only after successful processing.",
      "Monitor consumer lag, processing failures, throttling, and batch utilization."
    ],
    "anti_patterns": [
      "Do not log complete event bodies without an approved redaction policy.",
      "Do not assume checkpointing makes downstream side effects exactly-once.",
      "Do not reuse one consumer group for independent processing pipelines."
    ],
    "faq": [
      {
        "question": "Does this skill provision Azure resources?",
        "answer": "No. It assumes the Event Hubs namespace, event hub, storage account, container, and permissions already exist."
      },
      {
        "question": "Which authentication method does it use?",
        "answer": "The examples use DefaultAzureCredential, which supports managed identity and local developer credentials."
      },
      {
        "question": "Does checkpointing guarantee exactly-once processing?",
        "answer": "No. Checkpoints record progress, but failures can cause replay. Use idempotent handlers or deduplication for side effects."
      },
      {
        "question": "Can it send events to a specific partition?",
        "answer": "Yes. It shows explicit partition identifiers and partition keys. Partition keys preserve ordering for related events."
      },
      {
        "question": "Does it support receiving from a chosen position?",
        "answer": "Yes. Examples cover earliest, latest, explicit offset, and timestamp-based starting positions."
      },
      {
        "question": "Is the example logging suitable for production?",
        "answer": "Not without review. Replace complete payload logging with approved metadata and redaction controls."
      }
