  "content": {
    "user_title": "Plan Reliable Database Migrations",
    "value_statement": "Database changes can cause downtime, data loss, and rollback failures. This skill guides structured ORM migrations, data transforms, rollback plans, and zero-downtime deployment steps.",
    "seo_keywords": [
      "Claude database migration",
      "Codex database migration",
      "Claude Code ORM migration",
      "Sequelize migrations",
      "TypeORM migrations",
      "Prisma migrations",
      "zero downtime migration",
      "rollback strategy",
      "schema migration",
      "data migration"
    ],
    "actual_capabilities": [
      "Provides Sequelize, TypeORM, and Prisma migration examples.",
      "Shows safe column additions, renames, and type changes.",
      "Explains data transformation patterns with parameterized replacements.",
      "Covers transaction-based and checkpoint-based rollback strategies.",
      "Outlines blue-green deployment phases for zero-downtime changes.",
      "Compares PostgreSQL and MySQL JSON field handling."
    ],
    "limitations": [
      "Does not connect to databases or verify migrations automatically.",
      "Examples must be adapted to each schema, ORM version, and production policy.",
      "Large data migrations still require performance testing and operational review.",
      "Referenced resource files are listed but are not present in the scanned package."
    ],
    "use_cases": [
      {
        "title": "Plan an ORM migration",
        "description": "Create a migration sequence for Sequelize, TypeORM, or Prisma with matching rollback steps.",
        "target_user": "Backend engineer"
      },
      {
        "title": "Design a rollback path",
        "description": "Prepare transaction, backup, and verification steps before changing production database structures.",
        "target_user": "Database administrator"
      },
      {
        "title": "Coordinate a zero-downtime release",
        "description": "Split schema changes into deployable phases that keep old and new application versions compatible.",
        "target_user": "DevOps lead"
      }
    ],
    "prompt_templates": [
      {
