    "output_examples": [
      {
        "input": "Which client should publish high-volume telemetry with automatic batching?",
        "output": "Use EventHubBufferedProducerClient when background batching fits the delivery model. Register success and failure handlers, then flush before disposal."
      },
      {
        "input": "How should a production worker receive events across several instances?",
        "output": "Use EventProcessorClient with a shared blob container and consumer group. Each instance coordinates partition ownership and stores checkpoints in blob storage."
      },
      {
        "input": "How can related customer events preserve order?",
        "output": "Assign the same partition key to related events. Ordering is maintained within that partition, but uneven keys can create throughput hotspots."
      }
    ],
    "best_practices": [
      "Use DefaultAzureCredential with least-privilege sender or receiver roles.",
      "Reuse thread-safe clients and dispose or flush them during graceful shutdown.",
      "Batch events and choose checkpoint frequency according to throughput and replay tolerance."
    ],
    "anti_patterns": [
      "Do not use EventHubConsumerClient as the main production processing coordinator.",
      "Do not checkpoint before business processing completes successfully.",
      "Do not place connection strings or shared access keys in source code."
    ],
    "faq": [
      {
        "question": "Which client should send standard event batches?",
        "answer": "Use EventHubProducerClient when the application needs direct control over batch creation and sending."
      },
      {
        "question": "Which client supports automatic background batching?",
        "answer": "Use EventHubBufferedProducerClient and register handlers for successful and failed batches."
      },
      {
        "question": "What should production consumers use?",
        "answer": "Use EventProcessorClient with blob storage for partition coordination and checkpoint persistence."
      },
      {
        "question": "How should the application authenticate?",
        "answer": "Prefer DefaultAzureCredential and assign the narrowest Event Hubs data role required by the workload."
      },
      {
        "question": "Does a partition key guarantee global ordering?",
        "answer": "No. It preserves order only among events routed to the same partition."
      },
      {
        "question": "How often should a consumer checkpoint?",
        "answer": "Choose an interval that balances replay volume, processing cost, storage calls, and throughput requirements."
      }
    ]
