  "content": {
    "user_title": "Analyze Binary Code Patterns",
    "value_statement": "Binary analysis can be slow when assembly patterns are unclear. This skill gives reference patterns for disassembly, decompilation, control flow, and reverse engineering notes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "binary analysis",
      "reverse engineering",
      "disassembly",
      "decompilation",
      "Ghidra",
      "IDA Pro",
      "assembly patterns"
    ],
    "actual_capabilities": [
      "Explains x86-64, ARM64, and ARM32 calling conventions.",
      "Shows assembly patterns for branches, loops, switch tables, arrays, and structures.",
      "Helps recover function signatures, local variables, and simple data types from disassembly.",
      "Provides Ghidra and IDAPython examples for labeling and pattern search.",
      "Lists workflow steps and common pitfalls for static binary analysis."
    ],
    "limitations": [
      "Does not execute or inspect binaries by itself.",
      "Does not replace Ghidra, IDA Pro, radare2, or a debugger.",
      "Examples are reference snippets, not complete automation pipelines.",
      "Requires user-provided disassembly, decompiler output, or tool context."
    ],
    "use_cases": [
      {
        "title": "Reverse Engineer a Function",
        "description": "Identify calling conventions, arguments, return values, and stack usage from disassembly.",
        "target_user": "Reverse engineer"
      },
      {
        "title": "Map Control Flow",
        "description": "Recognize loops, branches, switch tables, and optimizer artifacts in compiled code.",
        "target_user": "Security analyst"
      },
      {
        "title": "Prepare Review Notes",
        "description": "Turn assembly observations into clear notes for a vulnerability review or report.",
        "target_user": "Application security engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Identify Basic Patterns",
        "scenario": "Beginner review of a short function.",
        "prompt": "Use this skill to identify the calling convention, prologue, epilogue, and likely arguments in this disassembly: [paste snippet]."
      },
      {
        "title": "Recover Control Flow",
        "scenario": "Intermediate review of branches and loops.",
        "prompt": "Use this skill to map branches, loops, and switch patterns in this function: [paste disassembly or decompiler output]."
      },
      {
        "title": "Compare Decompiled Logic",
        "scenario": "Advanced review of decompiler accuracy.",
        "prompt": "Use this skill to compare this decompiler output with nearby assembly and list uncertain types, arguments, and structure fields."
      },
      {
        "title": "Plan Static Analysis",
        "scenario": "Advanced planning for a full binary review.",
        "prompt": "Use this skill to create a static analysis plan for this binary, including Ghidra or IDA checks and verification steps."
      }
    ],
    "output_examples": [
      {
        "input": "A function starts with a standard frame setup and stores two argument registers on the stack.",
        "output": "The result identifies a normal function prologue, likely first and second parameters, and a return value location."
      },
      {
        "input": "A branch sequence compares one value against several constants before jumping to case handlers.",
        "output": "The result explains that the function likely implements a small switch or chained conditional structure."
      },
      {
        "input": "A decompiler shows pointer fields, but the field sizes and structure layout are unclear.",
        "output": "The result lists likely field offsets, type hints, and checks to confirm the structure in Ghidra or IDA."
      }
    ],
    "best_practices": [
      "Provide architecture, compiler clues, and tool output with each analysis request.",
      "Verify decompiler output against nearby assembly before naming functions or fields.",
      "Document assumptions, confidence, and unresolved questions for each recovered pattern."
    ],
    "anti_patterns": [
      "Treating decompiler output as exact source code without assembly review.",
      "Ignoring calling conventions when estimating function arguments or return values.",
      "Running untrusted binaries only to confirm patterns that static analysis can explain."
    ],
    "faq": [
      {
        "question": "What inputs work best with this skill?",
        "answer": "Short disassembly snippets, decompiler output, architecture details, and tool context work best."
      },
      {
        "question": "Can it analyze a binary file directly?",
        "answer": "No. It guides analysis of text output from tools such as Ghidra, IDA Pro, or objdump."
      },
      {
        "question": "Does it support both x86 and ARM?",
        "answer": "Yes. The reference covers x86-64, ARM64, and ARM32 calling and control flow patterns."
      },
      {
        "question": "Can it find vulnerabilities?",
        "answer": "It can help explain risky calls and suspicious patterns. Human review is still required for conclusions."
      },
      {
        "question": "Is it suitable for malware analysis?",
        "answer": "It can support defensive static analysis, but it does not provide malware deployment or evasion guidance."
      },
      {
        "question": "Which tools does it mention?",
        "answer": "It includes reference examples for Ghidra scripting and IDAPython workflows."
      }
    ]
