    "user_title": "Diagnose Linux System Issues",
    "value_statement": "Linux incidents often start with broad symptoms and scattered evidence. This skill provides a phased workflow for collecting facts, analyzing resources, checking logs, testing networking, and validating fixes.",
    "seo_keywords": [
      "Linux troubleshooting",
      "system diagnostics",
      "service failures",
      "performance analysis",
      "network diagnostics",
      "log analysis",
      "Claude",
      "Codex",
      "Claude Code",
      "DevOps workflow"
    ],
    "actual_capabilities": [
      "Guides initial assessment of uptime, OS details, kernel messages, and recent errors.",
      "Structures CPU, memory, disk, I/O, and network analysis into clear phases.",
      "Suggests process, log, and service checks for common Linux incidents.",
      "Provides copy-paste prompts for related administration and debugging skills.",
      "Includes checklists for resolution, verification, monitoring, and documentation."
    ],
    "limitations": [
      "Does not execute commands by itself or verify results automatically.",
      "Uses placeholders such as PID, service, domain, and target.",
      "Requires operator judgment before accessing logs or restarting services.",
      "Does not replace site-specific runbooks, change controls, or incident policy."
    ],
    "use_cases": [
      {
        "title": "Triage A Slow Server",
        "description": "Follow a repeatable path to inspect resources, processes, logs, and likely bottlenecks.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Debug A Failed Service",
        "description": "Check service status, logs, dependencies, and safe verification steps before remediation.",
        "target_user": "Backend developer"
      },
      {
        "title": "Investigate Network Symptoms",
        "description": "Review interfaces, connections, DNS, and firewall clues during authorized host troubleshooting.",
        "target_user": "IT administrator"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start Basic Triage",
        "scenario": "Beginner assessment of an unclear Linux issue.",
        "prompt": "Help me diagnose a Linux server issue using read-only checks. Start with symptoms, recent changes, and basic system facts."
      },
      {
        "title": "Analyze Resource Pressure",
        "scenario": "Intermediate performance troubleshooting.",
        "prompt": "Guide me through CPU, memory, disk, and I/O analysis for a slow Linux host. Ask before any risky command."
      },
      {
        "title": "Correlate Incident Evidence",
        "scenario": "Advanced root cause analysis.",
        "prompt": "Analyze process, log, and network evidence for this Linux incident. Prioritize likely root causes and list verification steps."
      },
      {
        "title": "Plan Safe Remediation",
        "scenario": "Advanced production service recovery.",
        "prompt": "Build a production-safe remediation plan for this Linux service failure. Include rollback, monitoring, owner approvals, and follow-up documentation."
      }
    ],
    "output_examples": [
      {
        "input": "A Linux host is slow after a deployment.",
        "output": [
          "Collect symptoms, timeline, and recent change details.",
          "Check resource pressure and identify top consumers.",
          "Review logs around the deployment window.",
          "Confirm the fix with monitoring before closing the incident."
        ]
      },
      {
        "input": "A service is failing after restart.",
        "output": [
          "Verify service status and recent unit logs.",
          "Check configuration, dependencies, and permissions.",
          "Propose rollback or repair steps with approval gates."
        ]
      },
      {
        "input": "A host cannot reach an internal endpoint.",
        "output": [
          "Inspect local interfaces and active connections.",
          "Test DNS and routing within authorized scope.",
          "Compare firewall rules with the expected traffic path."
        ]
      }
    ],
    "best_practices": [
      "Start with read-only checks before making changes.",
      "Record symptoms, timestamps, commands, and evidence as you work.",
      "Confirm ownership and approval before restarting services or probing networks."
    ],
    "anti_patterns": [
      "Do not run placeholder commands against systems you do not own.",
      "Do not restart production services without a rollback plan.",
      "Do not ignore log context or recent changes when diagnosing symptoms."
