  "content": {
    "user_title": "Build Terraform Infrastructure Workflows",
    "value_statement": "Terraform delivery involves many connected decisions across resources, state, environments, automation, and security. This skill organizes those decisions into a phased workflow.",
    "seo_keywords": [
      "Terraform infrastructure",
      "infrastructure as code",
      "Terraform modules",
      "Terraform state management",
      "cloud provisioning",
      "Terraform CI/CD",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Organizes Terraform work into seven phases from setup through security.",
      "Guides cloud resource, networking, compute, and storage planning.",
      "Structures reusable module design, variables, outputs, documentation, and testing.",
      "Covers remote state, locking, access controls, backups, and workspaces.",
      "Outlines multi-environment isolation and configuration practices.",
      "Provides quality gates for provisioning, modules, state, CI/CD, and security."
    ],
    "limitations": [
      "Does not include provider-specific Terraform configurations.",
      "Does not execute Terraform plans or apply infrastructure changes.",
      "Depends on referenced companion skills for detailed implementation.",
      "Requires environment-specific validation, permissions, and expert review."
    ],
    "use_cases": [
      {
        "title": "Start a Terraform Project",
        "description": "Create a phased checklist for providers, variables, outputs, backend configuration, and initial resources.",
        "target_user": "Cloud engineers beginning an infrastructure repository"
      },
      {
        "title": "Standardize Reusable Modules",
        "description": "Plan module interfaces, structures, tests, documentation, variables, and outputs for shared infrastructure components.",
        "target_user": "Platform teams maintaining internal Terraform modules"
      },
      {
        "title": "Prepare Controlled Delivery",
        "description": "Design state isolation, environment configuration, CI validation, approval gates, secrets handling, and compliance checks.",
        "target_user": "DevOps leads governing production infrastructure"
      }
    ],
