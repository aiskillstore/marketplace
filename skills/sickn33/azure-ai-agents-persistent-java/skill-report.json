      "persistent agents",
      "agent threads",
      "Azure authentication",
      "agent runs",
      "DefaultAzureCredential"
    ],
    "actual_capabilities": [
      "Adds the Maven dependency for the Azure AI Agents Persistent Java SDK.",
      "Configures a synchronous client with an environment endpoint and DefaultAzureCredential.",
      "Creates agents, threads, user messages, and runs through the Java SDK.",
      "Polls run status and lists returned thread messages.",
      "Deletes threads and agents and demonstrates HTTP response error handling."
    ],
    "limitations": [
      "The examples target SDK version 1.0.0-beta.1 and may not match later APIs.",
      "The snippets are workflow fragments, not a complete runnable application.",
      "Azure project access, a deployed model, credentials, and environment configuration are required.",
      "The polling example lacks a timeout, backoff strategy, and complete terminal status handling."
    ],
    "use_cases": [
      {
        "title": "Prototype a Java Agent",
        "description": "Create a basic persistent agent, send a user message, run it, and inspect the response.",
        "target_user": "Java application developer"
      },
      {
        "title": "Integrate Azure Authentication",
        "description": "Configure a persistent agents client with an Azure project endpoint and DefaultAzureCredential.",
        "target_user": "Cloud engineer"
      },
      {
        "title": "Design Agent Lifecycle Handling",
        "description": "Map thread creation, run polling, response retrieval, error handling, and resource cleanup.",
        "target_user": "Platform engineer"
      }
    ],
