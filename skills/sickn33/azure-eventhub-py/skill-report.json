      "Azure event consumer"
    ],
    "actual_capabilities": [
      "Shows Azure credential authentication for Event Hubs producers and consumers.",
      "Demonstrates event batching with size-limit handling.",
      "Explains partition identifiers and partition keys for event routing.",
      "Provides synchronous and asynchronous producer and consumer patterns.",
      "Demonstrates Blob Storage checkpointing for consumer progress.",
      "Shows how to inspect event properties and Event Hub partition metadata."
    ],
    "limitations": [
      "Requires an existing Azure subscription, Event Hubs namespace, Event Hub, and appropriate permissions.",
      "Uses placeholders that must be replaced with environment-specific resource names and endpoints.",
      "Does not provision Azure resources or configure role assignments.",
      "Examples require validation against the installed Azure SDK version and workload requirements."
    ],
    "use_cases": [
