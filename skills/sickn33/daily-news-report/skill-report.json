  "content": {
    "user_title": "Generate Daily Technical News Reports",
    "value_statement": "Daily technology updates are scattered across many sources. This skill collects public links, filters relevant items, and creates a Markdown briefing.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "daily news report",
      "AI research briefing",
      "technical news",
      "Markdown report",
      "web research",
      "news curation",
      "productivity research"
    ],
    "actual_capabilities": [
      "Reads configured source lists from sources.json and cache history from cache.json.",
      "Fetches public sites such as Hacker News and Hugging Face Papers.",
      "Uses subagents or serial fallback to collect and filter candidate items.",
      "Uses browser tooling for JavaScript-rendered pages when needed.",
      "Writes a dated Markdown report under NewsReport/.",
      "Updates cache metadata for deduplication and source performance."
    ],
    "limitations": [
      "Requires network access to configured public sources.",
      "Source availability can change and may reduce item count.",
      "Browser-based scraping can be slower and may fail on protected sites.",
      "It does not verify article claims beyond extraction and summarization."
    ],
    "use_cases": [
      {
        "title": "Daily Technical Briefing",
        "description": "Create a concise report of current technology, AI, and productivity links for daily review.",
        "target_user": "Engineering manager"
      },
      {
        "title": "Research Intake",
        "description": "Collect promising articles and papers from configured sources before deeper manual reading.",
        "target_user": "Product researcher"
      },
      {
        "title": "Team Knowledge Sharing",
        "description": "Generate a Markdown digest that teams can share in chat, docs, or planning notes.",
        "target_user": "Team lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create Today Report",
        "scenario": "Beginner request using default settings.",
        "prompt": "Generate today daily news report. Use the configured sources and write the Markdown report."
      },
      {
        "title": "Create Dated Report",
        "scenario": "Run the workflow for a specific date.",
        "prompt": "Generate a daily news report for 2026-07-05. Include only high-quality technology and productivity items."
      },
      {
        "title": "Continue On Failures",
        "scenario": "Handle unavailable sources without stopping the report.",
        "prompt": "Generate a report and continue if some sources fail. Note unavailable sources in the report header."
      },
      {
        "title": "Strict Quality Run",
        "scenario": "Use tighter collection and filtering expectations.",
        "prompt": "Generate a strict report with strong quality filtering. Stop after 20 high-quality items and update cache metadata."
      }
    ],
    "output_examples": [
      {
        "input": "Generate today daily news report.",
        "output": "A dated Markdown briefing with selected technology items, source links, short summaries, key points, and quality scores."
      },
      {
        "input": "Generate the report for 2026-07-05 and continue if Product Hunt fails.",
        "output": "A report built from available sources, with the failed source noted and the cache updated for future runs."
      },
      {
        "input": "Create a strict report with only the strongest items.",
        "output": [
          "Lower-quality items are excluded.",
          "Duplicate links are removed.",
          "The final report keeps the highest-scoring articles."
        ]
      }
    ],
    "best_practices": [
      "Review sources.json before first use so the source list matches your interests.",
      "Run the skill once per day to make cache deduplication more useful.",
      "Review fetched summaries before sharing them as authoritative updates."
    ],
    "anti_patterns": [
      "Do not use the report as a substitute for fact-checking important claims.",
      "Do not enable unknown domains without reviewing their content quality.",
      "Do not expect browser scraping to work on every protected or paywalled site."
    ],
    "faq": [
      {
        "question": "What does this skill create?",
        "answer": "It creates a dated Markdown report with curated technology and productivity items from configured public sources."
      },
      {
        "question": "Does it browse the web?",
        "answer": "Yes. It fetches configured public URLs and may use browser tooling for pages that require JavaScript rendering."
      },
      {
        "question": "Where are reports saved?",
        "answer": "Reports are written under NewsReport/ with a filename based on the report date."
      },
      {
        "question": "Can I change the sources?",
        "answer": "Yes. Edit sources.json to add, remove, enable, or disable configured sources."
      },
      {
        "question": "What happens when a source fails?",
        "answer": "The workflow skips failed sources when possible and continues with available content."
      },
      {
        "question": "Does it fact-check articles?",
        "answer": "No. It summarizes and filters fetched content, but users should verify important claims independently."
      }
