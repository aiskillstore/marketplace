  "content": {
    "user_title": "Create Complete API Documentation",
    "value_statement": "Incomplete API documentation slows integration and increases support work. This skill organizes discovery, specifications, guides, examples, portals, and maintenance into one workflow.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "API documentation",
      "OpenAPI specification",
      "Swagger documentation",
      "developer guide",
      "API portal",
      "code examples",
      "documentation workflow"
    ],
    "actual_capabilities": [
      "Organizes API documentation work into seven ordered phases.",
      "Guides endpoint, authentication, error, and rate-limit discovery.",
      "Defines steps for creating OpenAPI paths, schemas, security, and examples.",
      "Structures developer guides with onboarding, patterns, troubleshooting, and frequently asked questions.",
      "Covers interactive documentation, site architecture, navigation, and search.",
      "Provides quality gates and maintenance tasks for validation, review, updates, and feedback."
    ],
    "limitations": [
      "This workflow does not inspect an API or generate artifacts without supporting context and tools.",
      "Referenced companion skills may require separate installation or availability.",
      "Generated specifications and examples still require environment-specific validation and testing.",
      "The workflow does not provide platform-specific deployment configuration."
    ],
    "use_cases": [
      {
        "title": "Document a New Service",
        "description": "Create an endpoint inventory, OpenAPI plan, examples, and developer onboarding guide before release.",
        "target_user": "Backend developers"
      },
      {
        "title": "Standardize Documentation",
        "description": "Apply one repeatable structure and quality checklist across several APIs and documentation owners.",
        "target_user": "Technical writers"
      },
