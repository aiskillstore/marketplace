    "actual_capabilities": [
      "Shows the Maven dependency for the Azure Event Grid Java SDK.",
      "Explains publisher client setup with access keys or DefaultAzureCredential.",
      "Provides patterns for EventGridEvent, CloudEvent, and BinaryData payloads.",
      "Covers batch publishing, asynchronous sends, and basic error handling.",
      "Describes namespace receive, acknowledge, reject, and release workflows.",
      "Lists practical best practices for schema validation, retries, and event size."
    ],
    "limitations": [
      "Does not provision Azure resources or configure Event Grid topics.",
      "Does not verify SDK version compatibility against a live project.",
