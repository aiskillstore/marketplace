  "content": {
    "user_title": "Optimize Cloud Costs Across AWS, Azure, and GCP",
    "value_statement": "Cloud teams often overspend because resources, pricing models, storage, and governance are not reviewed together. This skill provides practical AWS, Azure, and GCP optimization patterns, checklists, and Terraform examples.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "cloud cost optimization",
      "FinOps",
      "AWS cost savings",
      "Azure cost management",
      "GCP cost optimization",
      "cloud right-sizing",
      "Terraform cost governance"
    ],
    "actual_capabilities": [
      "Structures cloud cost reviews around visibility, right-sizing, pricing, and architecture.",
      "Compares major discount options across AWS, Azure, and GCP.",
      "Suggests tagging, budget alerts, anomaly detection, and recurring cost reviews.",
      "Provides Terraform examples for S3 lifecycle policies, tagging, budgets, and autoscaling.",
      "Identifies storage tiering, serverless, database sizing, and data transfer opportunities.",
      "Produces an actionable cloud cost optimization checklist."
    ],
    "limitations": [
      "It provides guidance but does not access billing accounts or utilization metrics.",
      "Savings percentages and service details require validation against current provider terms.",
      "Terraform examples use placeholders and need environment-specific review before deployment.",
      "Referenced playbooks, tagging guides, and spreadsheet assets are not included in this package."
    ],
    "use_cases": [
      {
        "title": "Review a Startup Cloud Bill",
        "description": "Prioritize low-risk savings across compute, storage, commitments, and idle resources.",
        "target_user": "Startup engineering lead"
      },
      {
        "title": "Build FinOps Governance",
        "description": "Define tags, budgets, alerts, ownership, and a recurring review process.",
        "target_user": "FinOps practitioner"
      },
      {
        "title": "Compare Multi-Cloud Savings",
        "description": "Map equivalent discount and optimization options across AWS, Azure, and GCP.",
        "target_user": "Cloud architect"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find Basic Savings",
        "prompt": "Review this cloud inventory and monthly spend. List five low-risk savings actions, expected impact, required evidence, and validation steps.",
        "scenario": "Beginner review of one cloud environment"
      },
      {
        "title": "Create a Provider Plan",
        "prompt": "Create a 90-day cost optimization plan for [AWS, Azure, or GCP]. Use my workloads, utilization, reliability targets, and budget constraints.",
        "scenario": "Intermediate provider-specific planning"
      },
      {
        "title": "Design Cost Governance",
        "prompt": "Design tagging, budgets, anomaly alerts, ownership, and weekly review workflows for this organization. Include measurable controls and escalation thresholds.",
        "scenario": "Advanced FinOps governance design"
      },
      {
        "title": "Model Multi-Cloud Tradeoffs",
        "prompt": "Compare pricing commitments, spot capacity, storage tiers, autoscaling, and data transfer across our three providers. Rank options by savings, risk, and reversibility.",
        "scenario": "Advanced multi-cloud portfolio optimization"
      }
    ],
    "output_examples": [
      {
        "input": "Our development account has lightly used virtual machines and old snapshots.",
        "output": "Start with idle resource cleanup and right-sizing. Measure seven-day utilization, confirm ownership, retain required backups, and remove resources through an approved change process."
      },
      {
        "input": "Create governance for a growing multi-cloud team.",
        "output": "Require owner, environment, project, and cost-center tags. Add provider budgets, anomaly alerts, weekly reviews, and escalation thresholds for unassigned spending."
      },
      {
        "input": "We need savings without reducing production reliability.",
        "output": "Prioritize storage lifecycle policies, data transfer analysis, steady-workload commitments, and autoscaling. Test interruption-tolerant workloads before adopting spot or preemptible capacity."
      }
    ],
    "best_practices": [
      "Validate recommendations with billing and utilization data before making changes.",
      "Protect reliability targets and test every infrastructure change.",
      "Assign owners, deadlines, expected savings, and verification measures to each action."
    ],
