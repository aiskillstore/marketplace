  "content": {
    "user_title": "Design Angular State Management",
    "value_statement": "Angular teams can struggle to choose suitable state tools and patterns. This skill provides decision guidance and implementation examples for Signals, NgRx, and RxJS.",
    "seo_keywords": [
      "Angular state management",
      "Angular Signals",
      "NgRx Store",
      "NgRx SignalStore",
      "RxJS ComponentStore",
      "BehaviorSubject migration",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Classifies Angular state as local, shared, global, server, URL, or form state.",
      "Recommends Signals, SignalStore, NgRx Store, or ComponentStore based on application complexity.",
      "Provides Signal service and NgRx SignalStore patterns with computed state and actions.",
      "Explains NgRx actions, reducers, selectors, effects, and standalone provider setup.",
      "Demonstrates server loading, error state, and optimistic rollback patterns.",
      "Guides migration from BehaviorSubject and bridges Signals with RxJS observables."
    ],
    "limitations": [
      "Examples require adaptation to the project model, API contracts, and Angular version.",
      "The skill does not inspect an existing repository unless its files are provided.",
      "It does not replace application testing, performance measurement, or security review.",
      "Coverage focuses on Signals, NgRx, and RxJS rather than every Angular state library."
    ],
    "use_cases": [
      {
        "title": "Choose a State Strategy",
        "description": "Compare state scope and complexity to select Signals, SignalStore, ComponentStore, or NgRx Store.",
        "target_user": "Angular developers starting a feature"
      },
      {
        "title": "Standardize Enterprise State",
        "description": "Define actions, reducers, selectors, effects, and store boundaries for complex cross-feature workflows.",
        "target_user": "Frontend architects"
      },
      {
        "title": "Modernize Reactive Services",
        "description": "Plan an incremental migration from BehaviorSubject services while preserving required Observable integrations.",
        "target_user": "Teams maintaining legacy Angular applications"
      }
    ],
    "prompt_templates": [
      {
        "title": "Select a State Tool",
        "prompt": "Classify this Angular state requirement and recommend Signals, SignalStore, ComponentStore, or NgRx Store. Explain the decision: [requirement].",
        "scenario": "Beginner selection guidance"
      },
      {
        "title": "Design a Signal Service",
        "prompt": "Design a Signal-based service for [feature]. Include private writable state, public read-only state, computed values, actions, loading, and errors.",
        "scenario": "Feature implementation"
      },
      {
        "title": "Plan an NgRx Feature",
        "prompt": "Create an NgRx architecture plan for [workflow]. Define state boundaries, actions, reducers, selectors, effects, failure handling, and testing priorities.",
        "scenario": "Complex global state"
      },
      {
        "title": "Migrate Reactive State",
        "prompt": "Review this BehaviorSubject-based design: [design]. Plan a staged Signals migration, identify Observable boundaries, and address concurrency, rollback, testing, and compatibility risks.",
        "scenario": "Advanced migration review"
      }
    ],
    "output_examples": [
      {
        "input": "Choose state management for a product filter shared by one feature page.",
        "output": "Recommendation: use a feature SignalStore. Keep the filter and products together, expose computed filtered products, and avoid application-wide global state."
      },
      {
        "input": "Plan optimistic deletion for products loaded from an API.",
        "output": [
          "Capture the current product collection before deletion.",
          "Remove the product locally and expose a pending state.",
          "Call the delete endpoint.",
          "Restore the previous collection and report an error when the request fails."
        ]
      },
      {
        "input": "Migrate a user BehaviorSubject while some services still require Observables.",
        "output": "Use a private writable Signal and expose it read-only. Convert it with toObservable at existing reactive boundaries, then migrate consumers incrementally."
      }
    ],
    "best_practices": [
      "Keep state near the feature that owns it and globalize only cross-feature concerns.",
      "Expose read-only state and use computed values instead of storing derived data.",
      "Model loading, failure, concurrency, and rollback behavior before implementing remote state."
    ],
    "anti_patterns": [
      "Do not select NgRx Store only because the application is large.",
      "Do not mutate Signal values outside controlled store methods.",
      "Do not mix Signals and Observables without explicit conversion boundaries."
    ],
    "faq": [
      {
        "question": "Does this skill require NgRx?",
        "answer": "No. It recommends plain Signals for simple local or shared state and NgRx tools when their structure provides clear value."
      },
      {
        "question": "Can it help choose between SignalStore and NgRx Store?",
        "answer": "Yes. It compares feature scope, workflow complexity, global coordination, effects, and debugging needs."
      },
      {
        "question": "Does it cover server state?",
        "answer": "Yes. It includes loading, error handling, relative API calls, and optimistic rollback patterns."
      },
      {
        "question": "Can it migrate BehaviorSubject services?",
        "answer": "Yes. It explains Signal replacements and conversion boundaries using toSignal and toObservable."
      },
      {
        "question": "Will the examples run without changes?",
        "answer": "Not always. Types, imports, service contracts, providers, and API paths must match the target application."
      },
      {
        "question": "Does it generate tests?",
        "answer": "It can guide testing priorities when requested, but the source material does not provide a complete testing framework."
      }
    ]
