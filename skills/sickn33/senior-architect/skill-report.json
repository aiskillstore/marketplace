    "user_title": "Review Architecture Workflows and Project Paths",
    "value_statement": "Architecture reviews need a consistent starting point and clear project boundaries. This skill provides workspace-scoped tool templates, command examples, and generic design references.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "software architecture",
      "system design",
      "project analysis",
      "dependency analysis",
      "architecture workflows",
      "technical decisions"
    ],
    "actual_capabilities": [
      "Validates that a requested target exists within the current workspace.",
      "Provides three Python command-line templates for architecture, project, and dependency tasks.",
      "Prints a status report containing the target path and an empty findings count.",
      "Can serialize status results as JSON to standard output or a workspace file.",
      "Supplies generic references for patterns, workflows, technical decisions, security, and scalability."
    ],
    "limitations": [
      "The scripts do not perform substantive architecture, dependency, or project analysis.",
      "The architecture tool does not generate a diagram.",
      "The reference guides contain placeholder examples instead of detailed recommendations.",
      "Results require expert review and environment-specific validation."
    ],
    "use_cases": [
      {
        "title": "Inspect a Tool Template",
        "description": "Review workspace path validation and report behavior before extending the scripts.",
        "target_user": "Python developer"
