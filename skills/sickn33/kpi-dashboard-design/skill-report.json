  "content": {
    "user_title": "Design KPI Dashboards",
    "value_statement": "Teams often track metrics without a clear dashboard structure. This skill guides KPI selection, dashboard layout, and monitoring patterns for business users.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "KPI dashboard design",
      "business intelligence dashboard",
      "data visualization",
      "dashboard KPIs",
      "executive dashboard",
      "metrics governance",
      "Streamlit dashboard"
    ],
    "actual_capabilities": [
      "Explains strategic, tactical, and operational KPI levels.",
      "Lists common sales, marketing, product, and finance KPIs.",
      "Provides dashboard layout patterns for executive, SaaS, and operations views.",
      "Includes SQL examples for MRR, cohort retention, and CAC calculations.",
      "Includes a Streamlit dashboard example using pandas and Plotly.",
      "Documents dashboard best practices and common design mistakes."
    ],
    "limitations": [
      "It does not connect to live data sources or APIs.",
      "It does not validate SQL against a specific database schema.",
      "It provides example layouts, not production-ready visual design files.",
      "It does not replace metric governance or stakeholder approval."
    ],
    "use_cases": [
      {
        "title": "Executive KPI Review",
        "description": "Create a concise dashboard with revenue, profit, customers, NPS, trends, and alerts.",
        "target_user": "Business executive"
      },
      {
        "title": "SaaS Metrics Planning",
        "description": "Select MRR, ARR, churn, retention, CAC, and LTV views for subscription reporting.",
        "target_user": "SaaS product leader"
      },
      {
        "title": "Operations Monitoring",
        "description": "Design a real-time view for system health, service status, throughput, and alert review.",
        "target_user": "Operations manager"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose KPIs",
        "scenario": "Beginner metric selection",
        "prompt": "Use this skill to recommend 5 to 7 KPIs for [team]. Include definitions, update frequency, and audience."
      },
      {
        "title": "Design Layout",
        "scenario": "Intermediate dashboard planning",
        "prompt": "Use this skill to create a dashboard layout for [goal]. Include KPIs, charts, filters, alerts, and drilldowns."
      },
      {
