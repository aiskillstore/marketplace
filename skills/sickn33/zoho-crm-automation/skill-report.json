    "user_title": "Automate Zoho CRM Workflows",
    "value_statement": "Zoho CRM work often needs careful field discovery before records are changed. This skill guides Claude, Codex, and Claude Code through Rube MCP workflows for reliable CRM actions.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Zoho CRM automation",
      "Rube MCP Zoho",
      "Composio Zoho toolkit",
      "CRM lead conversion",
      "CRM record updates",
      "Zoho contact search",
      "Zoho OAuth setup"
    ],
    "actual_capabilities": [
      "Find Zoho CRM modules and field definitions before using records.",
      "Search leads, contacts, deals, accounts, and other modules by criteria.",
      "Create CRM records with required field checks and correct API names.",
      "Update existing records after searching for the correct record ID.",
      "Convert leads into contacts, accounts, and optional deals.",
      "Create tags and update related records through supported Zoho tools."
    ],
    "limitations": [
      "Requires an active Rube MCP connection and Zoho OAuth authorization.",
      "Depends on current Zoho permissions, module access, and plan limits.",
      "Does not prevent duplicate records unless Zoho rules are configured.",
      "Lead conversion can be irreversible and should be confirmed first."
    ],
    "use_cases": [
      {
        "title": "Prepare Sales Records",
        "description": "Create or update leads, contacts, accounts, and deals with the right Zoho field names.",
        "target_user": "Sales operations teams"
      },
      {
        "title": "Clean CRM Data",
        "description": "Search records, verify identifiers, and apply focused updates without changing unrelated fields.",
        "target_user": "CRM administrators"
      },
      {
        "title": "Convert Qualified Leads",
        "description": "Guide lead conversion into contacts, accounts, and deals while checking required details first.",
        "target_user": "Revenue teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find a Contact",
        "scenario": "Beginner lookup task",
        "prompt": "Use the Zoho CRM skill to search for a contact by email. First discover the current tool schema and fields, then return the best matching record summary."
      },
      {
        "title": "Create a Lead",
        "scenario": "Basic record creation",
        "prompt": "Create a Zoho CRM lead for this prospect. Check required fields for the Leads module first, then ask me for any missing required values before creating it."
      },
      {
        "title": "Update a Deal",
        "scenario": "Record update with verification",
        "prompt": "Find the deal named [deal name], confirm the record ID and current stage, then update only the stage and expected close date after I approve."
      },
      {
        "title": "Convert and Tag Leads",
        "scenario": "Advanced multi-step workflow",
        "prompt": "Search for qualified leads from [company]. For each match, summarize conversion impact, confirm required account and deal details, then convert and apply the requested tag only after approval."
      }
    ],
    "output_examples": [
      {
        "input": "Search for a contact with email alex@example.com.",
        "output": "The assistant checks available Zoho tools, searches Contacts by email, and returns matching names, account links, phone numbers, and record IDs."
      },
      {
        "input": "Create a new lead from this web form submission.",
        "output": "The assistant identifies required Lead fields, asks for missing values, creates the record, and reports the new lead ID and key saved fields."
      },
      {
        "input": "Convert this qualified lead into a contact and deal.",
        "output": "The assistant finds the lead, explains the irreversible conversion, confirms account and deal details, then reports the created contact, account, and deal."
      }
    ],
    "best_practices": [
      "Call the Rube search tool first so schemas match the current Zoho toolkit.",
      "Confirm record IDs and irreversible actions before updates or lead conversion.",
      "Use Zoho API field names and check picklist values before writing data."
    ],
