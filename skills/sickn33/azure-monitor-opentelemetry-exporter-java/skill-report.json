        "description": "Plan consistent OpenTelemetry initialization and custom span processing across managed Java services.",
        "target_user": "Platform engineer"
      },
      {
        "title": "Migrate Deprecated Exporters",
        "description": "Replace the standalone Azure Monitor exporter with the recommended autoconfigure package.",
        "target_user": "Observability engineer"
      }
    ],
