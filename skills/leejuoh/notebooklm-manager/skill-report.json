      {
        "title": "Verify topic coverage",
        "scenario": "Advanced research check",
        "prompt": "Query the product-research notebook about pricing, target users, objections, and evidence gaps. Verify each topic before answering."
      }
    ],
    "output_examples": [
      {
        "input": "Ask my claude-docs notebook about Chrome connection troubleshooting.",
        "output": "The answer names the notebook, summarizes the relevant steps, cites source passages, and suggests two follow-up questions."
      },
      {
        "input": "Add a NotebookLM URL and discover its contents.",
        "output": "The skill reports the notebook name, generated ID, detected topics, and a short discovery summary."
      },
      {
        "input": "Search notebooks for API migration notes.",
        "output": "The response lists matching notebooks with IDs, names, topics, and enough context to choose the right notebook."
      }
    ],
    "best_practices": [
      "Use stable notebook IDs that match the subject and are easy to remember.",
      "Confirm before clearing chat history when prior NotebookLM context may be useful.",
      "Review cited NotebookLM sources before using answers in external work."
    ],
    "anti_patterns": [
      "Do not use this skill for general web search or unrelated documentation lookup.",
      "Do not register sensitive notebook URLs on a shared machine without access controls.",
      "Do not skip source review when the answer affects legal, medical, financial, or security decisions."
    ],
    "faq": [
      {
        "question": "What does this skill manage?",
        "answer": "It manages a local registry of NotebookLM notebooks and routes notebook questions through Chrome automation."
      },
      {
        "question": "Does it require browser access?",
        "answer": "Yes. It requires Claude Code, Chrome integration, and a connected Claude in Chrome extension."
      },
      {
        "question": "Can it search the open web?",
        "answer": "No. It is designed for registered NotebookLM notebooks, not broad web search."
      },
      {
        "question": "Where are notebook records stored?",
        "answer": "The skill stores active, archived, and detailed notebook metadata in files under its data folder."
      },
      {
        "question": "Can it clear NotebookLM chat history?",
        "answer": "It asks before the first query to a notebook in a session and passes that choice to the browser agent."
