  "content": {
    "user_title": "Manage NotebookLM Research Notebooks",
    "value_statement": "NotebookLM users need a reliable way to find, register, and query saved notebooks from Claude Code. This skill routes notebook requests through Chrome automation and keeps a local notebook registry.",
    "seo_keywords": [
      "NotebookLM manager",
      "Claude",
      "Codex",
      "Claude Code",
      "NotebookLM automation",
      "Chrome MCP",
      "research notebooks",
      "notebook registry",
      "citation workflows",
      "AI research assistant"
    ],
    "actual_capabilities": [
      "Detects NotebookLM query, list, add, show, search, enable, disable, and remove intents.",
      "Looks up notebook IDs in a local library file under the skill data folder.",
      "Delegates NotebookLM browser interaction to the NotebookLM Chrome subagent.",
      "Asks whether to clear notebook chat history before the first query in a session.",
      "Runs follow-up coverage checks for missing query topics before presenting the answer.",
      "Defines storage schemas for active, archived, and per-notebook metadata."
    ],
    "limitations": [
      "Requires Claude Code with Chrome integration and the Claude in Chrome extension.",
      "Does not perform general web search or answer from local files outside registered notebooks.",
      "Notebook discovery depends on browser authentication and NotebookLM page availability.",
      "Stores notebook metadata locally, so shared machines need careful access controls."
    ],
    "use_cases": [
      {
        "title": "Query research notebooks",
        "target_user": "Researchers",
        "description": "Ask a registered NotebookLM notebook focused questions and receive a cited answer from its sources."
      },
      {
        "title": "Maintain a notebook registry",
        "target_user": "Documentation teams",
        "description": "Register NotebookLM URLs, discover titles and topics, and keep active and archived notebook records organized."
      },
      {
        "title": "Check support knowledge",
        "target_user": "Support engineers",
        "description": "Search saved notebooks for product guidance and confirm that important topics were covered before responding."
      }
    ],
    "prompt_templates": [
      {
        "title": "List notebooks",
        "scenario": "Beginner lookup",
        "prompt": "List my NotebookLM notebooks."
      },
      {
