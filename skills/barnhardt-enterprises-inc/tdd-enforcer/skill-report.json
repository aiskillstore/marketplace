  "content": {
    "user_title": "Enforce Test-Driven Development Workflows",
    "value_statement": "Teams often skip tests or write them after implementation. This skill guides Claude, Codex, and Claude Code through test-first delivery.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "test driven development",
      "TDD workflow",
      "AAA testing pattern",
      "unit testing",
      "integration testing",
      "coverage thresholds",
      "red green refactor"
    ],
    "actual_capabilities": [
      "Guides agents through red, green, and refactor steps.",
      "Requires tests to fail before implementation begins.",
      "Explains the Arrange, Act, Assert test structure.",
      "Shows unit, integration, component, and E2E examples.",
      "Defines coverage targets for services, utilities, and UI.",
      "Provides a checklist for test quality before committing."
    ],
    "limitations": [
      "It depends on project test tools already being configured.",
      "It does not generate a complete test framework by itself.",
      "Coverage targets may need adjustment for each repository.",
      "It cannot prove tests failed first without command history."
    ],
    "use_cases": [
      {
        "title": "Build A New Feature",
        "description": "Create failing tests that define expected behavior before implementation starts.",
        "target_user": "Application developer"
      },
      {
        "title": "Improve Test Quality",
        "description": "Review tests for clear names, AAA structure, edge cases, and behavior-focused assertions.",
        "target_user": "Engineering lead"
      },
      {
        "title": "Refactor With Confidence",
        "description": "Keep tests green while simplifying code and preserving existing behavior.",
        "target_user": "Maintainer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start A Feature With TDD",
        "scenario": "Beginner prompt for a simple feature.",
        "prompt": "Use the tdd-enforcer workflow for this feature: [feature]. First write failing tests with AAA. Then implement only enough code to pass."
      },
      {
        "title": "Fix A Bug Test First",
        "scenario": "Intermediate prompt for a defect report.",
        "prompt": "Use tdd-enforcer for this bug: [bug]. Write a failing regression test first. Then fix the issue and keep existing tests green."
      },
      {
        "title": "Review Tests Before Coding",
        "scenario": "Advanced prompt for planned implementation work.",
        "prompt": "Review my planned tests for [change]. Check AAA structure, behavior focus, edge cases, and expected initial failures before implementation."
      },
      {
        "title": "Plan Multi-Layer Coverage",
        "scenario": "Advanced prompt for complex changes.",
        "prompt": "Create a TDD plan for [feature]. Cover unit, integration, component, and E2E tests. Include coverage targets and the red-green-refactor sequence."
      }
    ],
    "output_examples": [
      {
        "input": "Add password reset support to an authentication service.",
        "output": [
          "A failing service test defines token creation and password update behavior.",
          "An API route test checks success and invalid token responses.",
          "Implementation is limited to code required for those tests."
        ]
      },
      {
        "input": "Review tests for a login form before implementation.",
        "output": [
          "The review flags vague test names and missing loading state coverage.",
          "It recommends user-visible assertions instead of internal state checks."
        ]
      },
      {
        "input": "Refactor a utility without changing behavior.",
        "output": [
          "The workflow keeps the existing tests as the safety net.",
          "New edge case tests are added before simplifying the utility."
        ]
      }
    ],
    "best_practices": [
      "Write the failing test before changing production code.",
      "Use clear Arrange, Act, Assert sections in each test.",
      "Run the full relevant test suite after refactoring."
    ],
    "anti_patterns": [
      "Do not write implementation first and backfill tests later.",
      "Do not test private implementation details when behavior is observable.",
      "Do not combine many unrelated behaviors into one large test."
    ],
    "faq": [
      {
        "question": "What does this skill enforce?",
        "answer": "It enforces writing tests first, confirming failure, implementing minimal code, and refactoring after tests pass."
      },
      {
        "question": "Does it work with Claude, Codex, and Claude Code?",
        "answer": "Yes. The skill metadata lists support for Claude, Codex, and Claude Code."
      },
      {
        "question": "Can it run tests for me?",
        "answer": "It instructs the agent to run local project test commands when the environment allows Bash use."
