  "content": {
    "user_title": "Navigate Local Documentation Efficiently",
    "value_statement": "Large documentation sets waste context when assistants load broad files or guess paths. This skill follows hierarchical indexes to find targeted local pages before web search.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "documentation navigation",
      "local AI documentation",
      "hierarchical indexes",
      "TOON files",
      "token efficiency",
      "MCP documentation"
    ],
    "actual_capabilities": [
      "Selects a starting index level from a known category, library, section, or page.",
      "Matches task terms and synonyms against descriptions, keywords, purposes, and common tasks.",
      "Follows index paths from broad categories to specific page summaries.",
      "Recommends targeted page sets for complex or cross-library questions.",
      "Compares targeted loading with full-context loading to control token use."
    ],
    "limitations": [
      "Requires an ai-docs hierarchy and index files in the current workspace.",
      "Does not create, update, or validate documentation indexes.",
      "Cannot guarantee that indexed content is current or complete.",
      "Does not define a web search provider or verify remote source availability."
    ],
    "use_cases": [
      {
        "title": "Resolve Library Questions",
        "description": "Find focused page summaries for implementation, configuration, and debugging questions without loading an entire library context.",
        "target_user": "Application developers"
      },
      {
        "title": "Research Documentation Coverage",
        "description": "Trace index sections and page priorities before planning tutorials, migrations, or documentation updates.",
        "target_user": "Technical writers"
      },
      {
        "title": "Control Assistant Context",
        "description": "Select only relevant local sources for coding sessions that have limited context or token budgets.",
        "target_user": "AI platform operators"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find One Topic",
        "prompt": "Find documentation for [library and topic]. Start at the most specific known index, select the relevant page, and summarize its guidance.",
        "scenario": "Use for a focused question with a known library."
      },
      {
        "title": "Search by Task",
        "prompt": "Locate local documentation for [task]. Match keywords and synonyms through the indexes, then load only the page summaries needed to answer.",
        "scenario": "Use when the exact documentation page is unknown."
      },
      {
        "title": "Compare Libraries",
        "prompt": "Compare [feature] across [library A] and [library B]. Navigate each hierarchy, select relevant pages, and summarize differences with source paths.",
        "scenario": "Use for a focused comparison across two indexed libraries."
      },
      {
        "title": "Plan Broad Research",
        "prompt": "Plan documentation research for [migration or architecture review]. Estimate required coverage, justify any full-context loading, and report unresolved gaps.",
        "scenario": "Use for broad work that may require multiple sections or complete context."
      }
    ],
    "output_examples": [
      {
        "input": "Where are the BAML retry and fallback instructions?",
        "output": "The library index points to the error-handling guide. Load that page summary first because its keywords include retry, error, fallback, and timeout."
      },
      {
        "input": "Compare streaming guidance for BAML and MCP.",
        "output": "Open each library index, identify sections matching streaming terms, and load the selected page summaries. Report any library without a matching indexed page."
      },
      {
        "input": "Prepare documentation sources for a complete BAML migration.",
        "output": "Review the library index and major sections first. Full context is justified only when the migration requires comprehensive coverage beyond targeted summaries."
      }
    ],
    "best_practices": [
      "Start at the most specific index supported by known details.",
      "Match both direct terms and synonyms before choosing pages.",
      "Load full-context files only when broad coverage is required."
    ],
    "anti_patterns": [
      "Do not guess page paths without checking an index.",
      "Do not load every page for a narrow question.",
      "Do not assume local summaries are current when evidence is missing."
    ],
    "faq": [
      {
        "question": "Does this skill browse the web?",
        "answer": "It prioritizes local ai-docs. It may recommend web search when local indexes do not answer the request."
      },
      {
        "question": "Which documentation format does it use?",
        "answer": "It is designed for hierarchical index and page summary files stored under ai-docs."
      },
      {
        "question": "Can it use exact keyword matching?",
        "answer": "Yes. The workflow supports exact matching or broader semantic matching with related terms."
      },
      {
        "question": "When should full context be loaded?",
        "answer": "Use full context for migrations, comprehensive tutorials, architecture reviews, or deep study that requires broad coverage."
      },
      {
        "question": "Does it work without local ai-docs?",
        "answer": "No. The navigation workflow requires the expected local hierarchy and index files."
      },
      {
        "question": "Which assistants are supported?",
        "answer": "The skill declares support for Claude, Codex, and Claude Code."
      }
