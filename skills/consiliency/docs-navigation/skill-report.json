    "user_title": "Navigate AI Documentation Faster",
    "value_statement": "Developers often waste context by loading full documentation sets or searching the web too early. This skill guides Claude, Codex, and Claude Code through indexed local docs to find focused pages quickly.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "AI documentation navigation",
      "local docs search",
      "developer documentation",
      "context management",
      "ai-docs indexes",
      "TOON documentation",
      "technical docs workflow"
    ],
    "actual_capabilities": [
      "Selects the right ai-docs index level from available task context.",
      "Guides keyword matching across category, library, section, and page indexes.",
      "Prioritizes targeted page summaries over full-context files for routine tasks.",
      "Explains when full-context files are justified for migrations or broad learning.",
      "Provides cookbook guidance for level selection, keyword matching, and page loading."
    ],
    "limitations": [
      "Requires an existing ai-docs directory with the expected index structure.",
      "Does not create, update, or validate documentation indexes.",
      "Cannot guarantee coverage when local documentation is stale or incomplete.",
      "May still need web search when local docs do not answer the task."
    ],
    "use_cases": [
      {
        "title": "Find API Details Quickly",
        "description": "Use local indexes to locate a specific page for syntax, options, or configuration details.",
        "target_user": "Application developers"
      },
      {
        "title": "Reduce Context Load",
        "description": "Load only the documentation pages needed for a task instead of broad full-context files.",
        "target_user": "AI coding assistant users"
      },
      {
        "title": "Explore Unknown Libraries",
        "description": "Start from category indexes, match task keywords, and drill into likely library sections.",
        "target_user": "Technical leads and maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find One Topic",
        "scenario": "Beginner lookup for a known library topic.",
        "prompt": "Use docs-navigation to find the best local documentation page for this topic: [topic]. Start from the right index level and load only the needed page."
      },
      {
        "title": "Compare Candidate Pages",
        "scenario": "Intermediate search when several pages may match.",
        "prompt": "Use docs-navigation to compare likely ai-docs pages for [task]. Show which index keywords matched and recommend the most relevant page to load."
      },
      {
        "title": "Plan Multi-Page Research",
        "scenario": "Advanced task requiring several related documentation pages.",
        "prompt": "Use docs-navigation to plan a focused documentation read for [implementation task]. Identify the minimum set of pages and explain why each is needed."
      },
      {
        "title": "Audit Documentation Coverage",
        "scenario": "Advanced workflow for judging whether local docs are enough.",
        "prompt": "Use docs-navigation to determine whether local ai-docs can answer [complex question]. Report the indexes checked, matching pages, gaps, and whether web search is needed."
      }
    ],
    "output_examples": [
      {
        "input": "Find documentation for BAML retry failures.",
        "output": "The skill starts at the BAML library index, matches retry and failure terms, and points to the error handling page."
      },
      {
        "input": "I know only that I need TypeScript database access docs.",
        "output": "The skill starts at the libraries index, scans descriptions and keywords, then recommends checking matching ORM library indexes."
      },
      {
        "input": "Prepare for a full migration to a documented library.",
        "output": "The skill explains that full-context loading can be justified and lists the narrower pages to review first."
      }
    ],
    "best_practices": [
      "Start from the highest index level that matches what you already know.",
      "Match task keywords against descriptions, keywords, purposes, and common tasks.",
      "Load specific page summaries before considering full-context files."
