  "content": {
    "user_title": "Detect Database Schema Drift",
    "value_statement": "Database schemas and application models can diverge, causing runtime errors and failed deployments. This skill compares migrations, schemas, and ORM models to produce prioritized alignment reports.",
    "seo_keywords": [
      "schema alignment",
      "database schema drift",
      "ORM models",
      "SQLAlchemy",
      "Prisma",
      "Alembic migrations",
      "migration analysis",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Detect ORM and migration technologies from common project indicators.",
      "Compare database columns with ORM fields for missing definitions.",
      "Identify type, nullability, naming, foreign key, and migration mismatches.",
      "Map SQLAlchemy and Prisma model types to common database types.",
      "Produce severity-ranked reports with locations and suggested fixes."
    ],
    "limitations": [
      "Live database comparison requires existing access and should use read-only credentials.",
      "Detailed parsing guidance centers on SQLAlchemy, Prisma, and Alembic.",
      "Generated migration suggestions may miss custom SQL or framework-specific behavior.",
      "The skill does not replace migration tests, backups, or human review before deployment."
    ],
    "use_cases": [
      {
        "title": "Validate model changes",
        "description": "Compare edited ORM models with migrations before opening a pull request.",
        "target_user": "Backend developer"
      },
      {
        "title": "Audit database drift",
        "description": "Find mismatched columns, constraints, relationships, and types across the application and database.",
        "target_user": "Database engineer"
      },
      {
        "title": "Check deployment readiness",
        "description": "Review pending schema differences and missing migrations before a release reaches production.",
        "target_user": "Release engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Run a basic alignment check",
        "prompt": "Inspect this project for schema drift. Detect the ORM, compare models with migrations, and report medium or higher issues.",
        "scenario": "A first review of an unfamiliar repository"
      },
      {
        "title": "Check selected tables",
        "prompt": "Compare the users and orders tables with their ORM models. Include missing fields, type mismatches, nullability, defaults, and foreign keys.",
        "scenario": "A focused review after model changes"
      },
      {
        "title": "Review migration coverage",
        "prompt": "Compare recent model changes with Alembic or Prisma migrations. Identify missing migrations and propose fixes without applying database changes.",
        "scenario": "A pull request that changes persistent data models"
      },
      {
        "title": "Perform a release audit",
        "prompt": "Use migrations as the baseline and compare models plus the read-only live schema. Rank drift, explain impact, and propose reversible remediation steps.",
        "scenario": "An advanced pre-deployment database review"
      }
    ],
    "output_examples": [
      {
        "input": "Compare SQLAlchemy models with Alembic migrations for the users table.",
        "output": [
          "High: users.retry_count exists in migrations but is missing from the model.",
          "Medium: users.email allows 255 characters in the database but is unbounded in the model.",
          "Suggested action: update the model and generate a reviewed migration if needed."
        ]
      },
      {
        "input": "Check a Prisma schema for missing migrations.",
        "output": "Low: User.preferences exists in the model, but no matching migration was found. Generate and review a migration before deployment."
      },
      {
        "input": "Review nullability and foreign keys for orders.",
        "output": "Medium: orders.user_id is required in the database, but the model allows null. Align nullability and verify the relationship constraint."
      }
    ],
    "best_practices": [
      "Prefer migration history as the baseline when it is complete and authoritative.",
      "Use read-only database credentials for live schema inspection.",
      "Review generated fixes and test migrations in an isolated environment."
    ],
    "anti_patterns": [
      "Do not apply generated migrations directly to production.",
      "Do not infer the live schema only from ORM models.",
      "Do not dismiss type or nullability mismatches because tests currently pass."
    ],
    "faq": [
      {
        "question": "Which ORMs does this skill support?",
        "answer": "It detects several common ORMs. Detailed guidance is strongest for SQLAlchemy, Prisma, and Alembic."
      },
      {
        "question": "Does it modify my database?",
        "answer": "Its primary output is a report. Review any suggested migration before running it."
      },
      {
        "question": "Can it inspect a live database?",
        "answer": "Yes, when access already exists. Use read-only credentials and limit access to the required schema."
      },
      {
        "question": "What drift can it detect?",
        "answer": "It covers missing fields, type differences, nullability, names, defaults, foreign keys, and missing migrations."
      },
      {
        "question": "Can it run in continuous integration?",
        "answer": "Yes. Use a severity threshold and fail the workflow when unacceptable drift is reported."
      },
      {
        "question": "Are generated fixes ready for production?",
        "answer": "No. Validate custom SQL, data transformations, reversibility, backups, and framework behavior before deployment."
      }
    ]
  },
