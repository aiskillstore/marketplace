  "content": {
    "user_title": "Detect Schema Drift Before Release",
    "value_statement": "Database drift causes runtime errors, broken migrations, and hidden data risk. This skill compares schemas, ORM models, and migrations to produce focused alignment reports.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "schema alignment",
      "database schema drift",
      "SQLAlchemy",
      "Prisma",
      "Alembic migrations",
      "ORM model audit",
      "migration review"
    ],
    "actual_capabilities": [
      "Detects common ORM and database stacks from project files and dependencies.",
      "Extracts schema details from migrations, live metadata, or model definitions.",
      "Compares columns, types, nullability, names, migrations, and foreign keys.",
      "Provides SQLAlchemy, Prisma, and Alembic detection guidance.",
      "Produces a severity-based alignment report with suggested fixes."
    ],
    "limitations": [
      "Requires access to migrations, model files, or database metadata.",
      "Cannot prove production state when only local files are available.",
      "Migration suggestions need human review before execution.",
      "Unlisted ORMs may need manual type mapping."
    ],
    "use_cases": [
      {
        "title": "Review Pull Requests",
        "description": "Check whether model changes include matching migrations and database constraints.",
        "target_user": "Backend engineers"
      },
      {
        "title": "Prepare Release Checks",
        "description": "Find schema drift before deploying changes that depend on database structure.",
        "target_user": "DevOps engineers"
      },
      {
        "title": "Audit Legacy Projects",
        "description": "Compare older ORM models against migrations to identify undocumented drift.",
        "target_user": "Technical leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Check My Project",
        "scenario": "Beginner scan for basic drift.",
        "prompt": "Use schema-alignment to inspect this repository and report schema drift with severity, evidence, and suggested fixes."
      },
      {
        "title": "Review This Change",
        "scenario": "Pull request validation.",
        "prompt": "Use schema-alignment to compare the current changes against migrations and models. Focus on missing migrations and type mismatches."
      },
      {
        "title": "Compare Specific Tables",
        "scenario": "Targeted investigation.",
        "prompt": "Use schema-alignment on the user and order tables. Include nullability, defaults, foreign keys, and naming differences."
      },
      {
        "title": "Design A CI Gate",
        "scenario": "Advanced automation planning.",
        "prompt": "Use schema-alignment to define a CI check for schema drift. Include failure thresholds, report format, and manual review points."
      }
    ],
    "output_examples": [
      {
        "input": "Review a SQLAlchemy project before release.",
        "output": "A report lists missing columns, type mismatches, nullable differences, and migration gaps with severity and file evidence."
      },
      {
        "input": "Check a Prisma schema after model changes.",
        "output": "A summary identifies unmatched fields, enum differences, relationship issues, and recommended migration steps."
      },
      {
        "input": "Plan a CI schema drift check.",
        "output": "A checklist defines data sources, severity thresholds, required approvals, and report artifacts for the pipeline."
      }
    ],
    "best_practices": [
      "Run the skill before merging changes that modify models or migrations.",
      "Prefer migration files as the primary source when live database access is unavailable.",
      "Review generated fixes before applying migrations to shared environments."
    ],
    "anti_patterns": [
      "Treating ORM models as the only source of truth without checking migrations.",
      "Running migration commands without reviewing generated operations first.",
      "Ignoring nullable, default, and foreign key differences because tests pass."
    ],
    "faq": [
      {
        "question": "Which stacks does this skill support?",
        "answer": "It includes guidance for SQLAlchemy, Django ORM, Prisma, TypeORM, Drizzle, Alembic, Prisma migrations, and Django migrations."
      },
      {
        "question": "Does it modify my database?",
        "answer": "The skill is designed for detection and reporting. Any migration command should require explicit user review and approval."
      },
      {
        "question": "Can it use a live database?",
        "answer": "It can guide read-only metadata checks when credentials and access are available. File-based migration review is preferred."
      },
      {
        "question": "Does it generate migration fixes?",
        "answer": "It can suggest fixes and migration patterns. Engineers should validate every generated migration before applying it."
      },
      {
        "question": "Will it work with custom ORMs?",
        "answer": "It can still compare schemas if model patterns are understandable. Custom type mappings may need manual guidance."
      },
      {
        "question": "How should teams use it in CI?",
        "answer": "Run it as a pre-merge check with clear severity thresholds and attach the alignment report to the build output."
      }
    ]
