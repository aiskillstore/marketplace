  "content": {
    "user_title": "Generate Test Scaffolds Across Codebases",
    "value_statement": "Writing first-pass test files across languages is repetitive and easy to miss. This skill analyzes source structure and creates framework-specific scaffolds for Claude, Codex, and Claude Code workflows.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "test scaffolding",
      "unit test generation",
      "pytest scaffolds",
      "Jest templates",
      "Vitest templates",
      "Go testing",
      "Rust cargo test"
    ],
    "actual_capabilities": [
      "Detects common project manifests for pytest, unittest, Jest, Vitest, Go testing, Cargo, and Flutter test templates.",
      "Maps source file paths to language-specific test file locations.",
      "Extracts public functions, classes, methods, and exported symbols for scaffold planning.",
      "Creates TODO or skip-style test stubs using language-specific templates.",
      "Returns a scaffold manifest with generated files, skipped files, and unit counts."
    ],
    "limitations": [
      "It creates scaffolds, not completed assertions or production-ready test logic.",
      "Framework detection depends on readable project manifests and dependency names.",
      "Generated imports and fixture placeholders may need manual correction.",
      "Existing test files are skipped unless the caller explicitly chooses replacement."
    ],
    "use_cases": [
      {
        "title": "Start TDD Work Quickly",
        "description": "Create starter tests before implementation so each planned source file has a matching test target.",
        "target_user": "Feature developers"
      },
      {
        "title": "Standardize Test Layouts",
        "description": "Apply consistent file naming and scaffold patterns across Python, TypeScript, Go, Rust, and Dart projects.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Prepare Test Tasks",
        "description": "Generate clear TODO stubs that a test-focused agent or teammate can complete later.",
        "target_user": "AI workflow operators"
      }
    ],
    "prompt_templates": [
      {
        "title": "Scaffold Basic Tests",
        "scenario": "Begin with one source file and automatic framework detection.",
        "prompt": "Use the test-scaffolding skill for src/auth/login.py. Detect the framework and create starter test scaffolds with TODO markers."
      },
      {
        "title": "Choose a Framework",
        "scenario": "Override automatic detection when the project supports several test frameworks.",
        "prompt": "Use the test-scaffolding skill for src/session.ts. Generate Vitest scaffolds and place tests next to the source file."
      },
      {
        "title": "Batch Scaffold a Feature",
        "scenario": "Create tests for several related files in one feature area.",
        "prompt": "Use the test-scaffolding skill for src/auth/login.ts, src/auth/session.ts, and src/auth/token.ts. Preserve source folder structure in the test output."
      },
      {
        "title": "Plan Agent Handoff",
        "scenario": "Prepare scaffolds for a later test implementation pass.",
        "prompt": "Use the test-scaffolding skill for the owned artifacts in this lane. Return the scaffold manifest and highlight skipped files for review."
      }
    ],
    "output_examples": [
      {
        "input": "A Python service module with public authentication functions.",
        "output": "A pytest scaffold plan with a test file under tests/auth, fixture placeholders, and TODO cases for happy paths, edge cases, and errors."
      },
      {
        "input": "A TypeScript module using Vitest.",
        "output": "A test scaffold that imports exported symbols, groups class and function cases, and marks unfinished assertions as TODO tests."
      },
      {
        "input": "A Go package with exported functions and methods.",
        "output": [
          "A package-local test file name following Go conventions.",
          "Separate test blocks for functions and methods.",
          "Skipped placeholders for edge and error cases."
        ]
      }
    ],
    "best_practices": [
      "Run the skill after project manifests are available so framework detection is accurate.",
      "Review generated imports and fixture placeholders before committing scaffolds.",
      "Use TODO-style stubs when you want unfinished tests to stay visible."
    ],
    "anti_patterns": [
      "Do not treat generated scaffolds as complete test coverage.",
      "Do not overwrite existing test files without reviewing the current tests first.",
      "Do not use automatic framework detection when the project intentionally supports multiple runners."
    ],
    "faq": [
      {
        "question": "Does this skill write complete tests?",
        "answer": "No. It creates starter scaffolds with TODO or skip markers for later implementation."
      },
      {
        "question": "Which languages are covered?",
        "answer": "It documents templates for Python, TypeScript, JavaScript, Go, Rust, Dart, and Flutter test workflows."
      },
      {
        "question": "How does framework detection work?",
        "answer": "It reads common project manifests and dependency names, then selects the matching test template."
      },
      {
        "question": "Can it preserve existing test files?",
        "answer": "Yes. The workflow says existing test files should be skipped unless replacement is explicitly requested."
      },
      {
        "question": "Does it support agent handoff?",
        "answer": "Yes. It creates visible TODO stubs and a manifest that another agent or teammate can complete."
      },
      {
        "question": "Is manual review still needed?",
        "answer": "Yes. Imports, fixtures, mocks, and assertions need project-specific review before tests are useful."
      }
    ]
  },
