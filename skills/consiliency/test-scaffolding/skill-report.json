  "content": {
    "user_title": "Generate Multi-Language Test Scaffolds",
    "value_statement": "Creating consistent test skeletons across mixed-language repositories takes time. This skill analyzes public symbols and generates framework-specific scaffolds with fixtures, mocks, and TODO markers.",
    "seo_keywords": [
      "test scaffolding",
      "unit test generation",
      "test-driven development",
      "pytest",
      "Jest",
      "Vitest",
      "Go testing",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Detects test frameworks from pyproject.toml, package.json, go.mod, Cargo.toml, and pubspec.yaml.",
      "Extracts public functions, classes, methods, types, and exports with language-specific heuristics.",
      "Maps source files to conventional test locations for each supported language.",
      "Generates fixture, mock, async, error-case, parameterized, and benchmark stubs when supported by the selected template.",
      "Skips existing test files unless the force option is explicitly requested.",
      "Returns a manifest of generated files, skipped files, discovered units, and counts."
    ],
    "limitations": [
      "Regex-based analysis may miss decorated, generated, macro-based, or unusually formatted symbols.",
      "Scaffolds contain placeholders and do not infer complete assertions or business expectations.",
      "Framework detection requires a recognized package manifest or an explicit framework choice.",
      "Using the force option can replace an existing test file and requires careful review."
    ],
    "use_cases": [
      {
        "title": "Start feature development",
        "description": "Generate a conventional test file before implementing a new Python, TypeScript, Go, Rust, or Dart feature.",
        "target_user": "Application developer"
      },
      {
        "title": "Expand test coverage",
        "description": "Create fixtures, mocks, async cases, and error-case stubs for public APIs that need broader coverage.",
        "target_user": "Test engineer"
      },
      {
        "title": "Standardize repository tests",
        "description": "Apply consistent naming and structure across repositories that use different languages and test frameworks.",
        "target_user": "Technical lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Scaffold one source file",
        "prompt": "Scaffold tests for {source_file}. Detect the framework, preserve existing files, and use TODO-style stubs.",
        "scenario": "Starting tests for one implementation file."
      },
      {
        "title": "Choose framework and location",
        "prompt": "Generate {framework} scaffolds for {source_files}. Include fixture stubs and mirror the source directory under {output_dir}.",
        "scenario": "Configuring scaffolds for an established repository."
      },
      {
        "title": "Analyze public APIs",
        "prompt": "Analyze {source_files} for public APIs, then scaffold tests with {framework}. Report generated files, skipped files, symbols, and unit counts.",
        "scenario": "Planning coverage for several source files."
      },
      {
        "title": "Build comprehensive scaffolds",
        "prompt": "Scaffold tests for {source_files} with {framework} and {naming_convention}. Include fixtures, async cases, error cases, and mocks. Do not overwrite existing tests.",
        "scenario": "Preparing detailed test structures for a complex change."
      }
    ],
    "output_examples": [
      {
        "input": "Create pytest scaffolds for the authentication module without overwriting tests.",
        "output": [
          "Generated a test file for authenticate, refresh, and invalidate.",
          "Added fixture and TODO stubs.",
          "Reported one generated file and three testable units."
        ]
      },
      {
        "input": "Scaffold Go tests for exported functions in the billing package.",
        "output": [
          "Created a conventional Go test file beside the source.",
          "Added table-driven test placeholders for exported functions.",
          "Reported the generated file and discovered units."
        ]
      },
      {
        "input": "Generate Vitest scaffolds where a test file already exists.",
        "output": "Skipped the existing test file and reported the reason without changing its contents."
      }
    ],
    "best_practices": [
      "Confirm the detected framework and output directory before generating files.",
      "Keep existing tests protected, and enable the force option only after reviewing target files.",
      "Run the formatter and test command after generation to catch import or syntax issues."
    ],
    "anti_patterns": [
      "Do not treat generated TODO stubs as finished test coverage.",
      "Do not force overwrites when test files contain maintained logic.",
      "Do not rely on regex heuristics for complex macros, decorators, generated exports, or unusual formatting."
    ],
    "faq": [
      {
        "question": "Which languages are supported?",
        "answer": "Python, TypeScript, JavaScript, Go, Rust, and Dart are supported through framework-specific templates and naming rules."
      },
      {
        "question": "Does this skill write complete tests?",
        "answer": "No. It creates structural stubs and TODO markers; developers must add assertions, data, and expected behavior."
      },
      {
        "question": "How does framework detection work?",
        "answer": "It reads common package manifests and matches pytest, unittest, Vitest, Jest, Go testing, Cargo test, Flutter test, or Dart test."
      },
      {
        "question": "Will existing tests be overwritten?",
        "answer": "Existing test files are skipped unless the user explicitly enables the force option."
      },
      {
        "question": "Does analysis include private symbols?",
        "answer": "No. Its heuristics target public functions, classes, methods, types, and exports while ignoring private or internal symbols."
      },
      {
        "question": "What does the generation report include?",
        "answer": "It reports generated and skipped files, detected framework, discovered units, and total unit counts."
      }
    ]
