    "user_title": "Extract Project Coding Standards",
    "value_statement": "Project conventions are often scattered across guides and tool configs. This skill extracts contribution, formatting, linting, hook, and CI rules into a clear standards summary.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "coding standards extraction",
      "repository conventions",
      "CONTRIBUTING.md analysis",
      "EditorConfig parser",
      "linter configuration summary",
      "onboarding documentation",
      "AI coding assistant"
    ],
    "actual_capabilities": [
      "Finds contribution guides, EditorConfig files, formatter configs, linter configs, git hooks, PR templates, and issue templates.",
      "Extracts commit formats, branch naming rules, PR requirements, testing expectations, and explicit style notes.",
      "Summarizes indentation, line endings, character set, trailing whitespace, final newline, quote, semicolon, and line length rules.",
      "Identifies ESLint, Ruff, Black, isort, Biome, dprint, Clippy, and golangci-lint configuration sources when present.",
      "Reports pre-commit, pre-push, and CI checks that shape contribution workflows.",
      "Can format findings as JSON, Markdown, or TOON when requested."
    ],
    "limitations": [
      "It depends on files that exist in the target repository and should not infer missing rules.",
      "It does not validate whether configs are internally consistent or currently passing.",
      "It may need extra parser support for custom or generated configuration files.",
      "The referenced config parsing cookbook is not included in this package."
    ],
    "use_cases": [
      {
        "title": "Developer Onboarding",
        "description": "Create a quick standards brief before contributing to an unfamiliar repository.",
        "target_user": "New team members"
      },
      {
        "title": "Maintainer Standards Review",
        "description": "Compare documented contribution rules against formatter, linter, hook, and CI configuration files.",
        "target_user": "Repository maintainers"
      },
      {
        "title": "Agent Setup",
        "description": "Provide Claude, Codex, or Claude Code with repository-specific rules before edits begin.",
        "target_user": "AI coding assistant users"
      }
    ],
    "prompt_templates": [
      {
        "title": "Extract Basic Standards",
        "scenario": "Use when you need a first pass over a repository.",
        "prompt": "Extract standards from this repository. Start with CONTRIBUTING.md, .editorconfig, formatter configs, linter configs, hooks, and CI files. Return a concise Markdown summary."
      },
      {
        "title": "Create Onboarding Brief",
        "scenario": "Use when a new contributor needs practical rules.",
        "prompt": "Create an onboarding standards brief for this project. Include commit rules, branch naming, PR expectations, formatting, linting, tests, hooks, and CI checks."
      },
      {
        "title": "Compare Rules And Configs",
        "scenario": "Use when documentation and tooling may disagree.",
        "prompt": "Compare documented standards with tool configuration. Flag conflicts between contribution guides, EditorConfig, Prettier, ESLint, Ruff, Black, hooks, and workflow checks."
      },
      {
        "title": "Build Automation Profile",
        "scenario": "Use when another workflow needs structured standards.",
        "prompt": "Generate a structured standards profile for automation. Include sources for every rule, unknown fields, conflicts, and checks needed before pull requests."
      }
    ],
    "output_examples": [
      {
        "input": "A JavaScript repository with a contribution guide, EditorConfig, Prettier, ESLint, Husky, and GitHub Actions.",
        "output": [
          "Contribution rules: Conventional Commits, feature branches, review before merge.",
          "Formatting: spaces, two-character indentation, final newline, and Prettier enforcement.",
          "Checks: lint, test, and build run before merge."
        ]
      },
      {
        "input": "A Python repository with pyproject.toml and pre-commit configuration but no contribution guide.",
        "output": "The report lists Ruff and Black settings, pre-commit hooks, and notes that contribution rules were not found."
      },
      {
        "input": "A repository where documentation and configs disagree about line length.",
        "output": "The report highlights the conflict, names the source files, and recommends confirming the project standard before edits."
      }
