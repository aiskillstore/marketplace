    "best_practices": [
      "Read repository configuration before summarizing conventions.",
      "Include source files for every extracted rule so reviewers can verify results.",
      "Separate confirmed rules from missing information and conflicts."
    ],
    "anti_patterns": [
      "Do not invent commit, branch, or test rules when the repository lacks evidence.",
      "Do not treat sample configuration snippets as the target project's real settings.",
