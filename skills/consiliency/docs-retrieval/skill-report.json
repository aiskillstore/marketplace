      "developer productivity"
    ],
    "actual_capabilities": [
      "Navigates hierarchical ai-docs indexes to locate relevant library pages.",
      "Selects targeted page summaries based on libraries, topics, and keywords.",
      "Consolidates findings from multiple libraries with sources and token estimates.",
      "Chooses focused summaries or full-context documentation based on task scope.",
      "Falls back to web search for missing or time-sensitive information."
    ],
    "limitations": [
      "Requires a compatible local ai-docs hierarchy and index files.",
      "Does not create or update missing documentation.",
      "Local content may be stale, incomplete, or inconsistent with installed library versions.",
      "Full-context retrieval can consume 5,000 to 15,000 tokens."
    ],
    "use_cases": [
      {
        "title": "Prepare feature implementation",
        "description": "Find focused library guidance, patterns, and gotchas before changing application code.",
        "target_user": "Software developers"
      },
      {
        "title": "Investigate dependency errors",
        "description": "Locate troubleshooting pages and known issues for the library that produced an error.",
        "target_user": "Application maintainers"
      },
      {
        "title": "Review cross-library architecture",
        "description": "Combine documentation from several libraries into one sourced context package.",
        "target_user": "Technical leads"
      }
    ],
    "prompt_templates": [
      {
        "title": "Find one topic",
        "prompt": "Find local documentation for {library} about {topic}. Load the smallest relevant page set and summarize key points, gotchas, and source paths.",
        "scenario": "Beginner lookup for a known library and topic"
      },
      {
        "title": "Investigate an error",
        "prompt": "Use local ai-docs to investigate this {library} error: {error}. Retrieve troubleshooting guidance, likely causes, and source paths before proposing fixes.",
        "scenario": "Focused debugging with local documentation"
      },
      {
        "title": "Compare multiple libraries",
        "prompt": "Gather targeted local documentation for {libraries} related to {feature}. Consolidate integration guidance, conflicts, gotchas, minimal patterns, sources, and estimated token use.",
        "scenario": "Cross-library feature planning"
      },
      {
        "title": "Prepare implementation context",
        "prompt": "Build a documentation package for {task} across {libraries}. Prioritize local indexes, verify version-sensitive details online, identify uncertainties, and provide sourced implementation guidance.",
        "scenario": "Advanced implementation research with freshness checks"
      }
    ],
    "output_examples": [
      {
        "input": "Find BAML retry configuration documentation.",
        "output": "Loaded the BAML index and error-handling summary. The result covers retry policy, timeout interactions, known gotchas, and the local source paths."
      },
      {
        "input": "Investigate an MCP tool schema validation error.",
        "output": "Located the MCP schema and troubleshooting pages. The summary lists likely validation causes, relevant constraints, recommended checks, and source paths."
      },
      {
        "input": "Prepare context for integrating BAML with MCP.",
        "output": "Gathered focused pages for BAML types and functions, plus MCP tool servers and schemas. The package includes shared gotchas, sources, and a token estimate."
      }
    ],
    "best_practices": [
      "Identify required libraries and topics before loading documentation.",
      "Use indexes and targeted page summaries before requesting full context.",
      "Record source paths and verify online when details are time-sensitive."
    ],
    "anti_patterns": [
      "Do not load every library or full-context file without a defined need.",
      "Do not skip local documentation based on remembered API behavior.",
      "Do not make sub-agents repeat navigation when relevant context is already available."
    ],
    "faq": [
      {
        "question": "Does this skill search the web first?",
        "answer": "No. It checks local ai-docs first and uses web search when local coverage is missing, insufficient, or outdated."
      },
      {
        "question": "What local structure does it expect?",
        "answer": "It expects library indexes, section indexes, targeted page summaries, and optional full-context files under ai-docs."
      },
      {
        "question": "Can it retrieve documentation for multiple libraries?",
        "answer": "Yes. It gathers selected pages from each library and consolidates key points, gotchas, sources, and token estimates."
      },
      {
        "question": "When should full-context documentation be loaded?",
        "answer": "Use it for migrations, tutorials, architecture reviews, or deep learning that requires broad library coverage."
      },
      {
        "question": "Does it guarantee current documentation?",
        "answer": "No. Local documentation can become stale, so version-sensitive or current details should be verified online."
      },
      {
        "question": "Can it update local documentation?",
        "answer": "No. This skill retrieves and organizes existing content. Documentation creation and maintenance require a separate workflow."
      }
    ]
