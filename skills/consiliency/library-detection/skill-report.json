  "content": {
    "user_title": "Detect Project Libraries and Frameworks",
    "value_statement": "Project onboarding slows down when dependencies and build tools are unclear. This skill reads common manifests and summarizes languages, frameworks, test tools, and tooling.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "library detection",
      "package manifest parsing",
      "framework detection",
      "dependency analysis",
      "technology stack summary",
      "project onboarding",
      "build tool detection"
    ],
    "actual_capabilities": [
      "Scans common manifests such as package.json, pyproject.toml, go.mod, Cargo.toml, pubspec.yaml, and CMakeLists.txt.",
      "Extracts production, development, peer, and optional dependency groups when the manifest format supports them.",
      "Classifies detected items into languages, frameworks, test frameworks, build tools, databases, cloud providers, and CI systems.",
      "Uses cookbook detection maps for JavaScript, Python, Go, Rust, Dart, Flutter, C, and C++ projects.",
      "Returns a structured stack summary with the manifest files that supported the result."
    ],
    "limitations": [
      "It depends on manifests and configuration files being present in the project.",
      "It may miss uncommon frameworks that are not listed in the detection tables.",
      "It cannot prove runtime usage without checking imports and related configuration files.",
      "It does not perform vulnerability, license, or dependency freshness analysis."
    ],
    "use_cases": [
      {
        "title": "Prepare a New Repository Brief",
        "description": "Identify the main languages, frameworks, test tools, and build tools before starting work in a new codebase.",
        "target_user": "Software engineers"
      },
      {
        "title": "Create Onboarding Documentation",
        "description": "Turn detected manifests and dependency categories into a clear stack summary for team onboarding guides.",
        "target_user": "Technical writers"
      },
