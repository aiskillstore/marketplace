  "content": {
    "user_title": "Build Reliable Tree-sitter Parsers",
    "value_statement": "Tree-sitter integrations often fail on malformed code, language differences, and inefficient traversal. This skill provides reusable parsing, query, visitor, error-handling, and optimization patterns.",
    "seo_keywords": [
      "Claude tree-sitter skill",
      "Codex tree-sitter patterns",
      "Claude Code AST parsing",
      "tree-sitter parsing",
      "AST visitor pattern",
      "tree-sitter queries",
      "language parser development",
      "incremental parsing",
      "code analysis automation"
    ],
    "actual_capabilities": [
      "Set up Python Tree-sitter parsers and access syntax tree nodes.",
      "Navigate named children and recursively find nodes by type.",
      "Write Tree-sitter queries for functions, classes, imports, and decorated definitions.",
      "Implement reusable AST visitor classes and function extractors.",
      "Detect parse errors and apply incremental parsing and query optimization."
    ],
    "limitations": [
      "Provides reference patterns, not runnable scripts or installed parser packages.",
      "Cookbook files named in the instructions are not included in this skill package.",
      "Language node types vary by grammar and require verification against installed parser versions.",
      "Examples focus mainly on Python and need adaptation for other bindings."
    ],
    "use_cases": [
      {
        "title": "Prototype a Parser",
        "description": "Set up a Python parser, inspect nodes, and extract functions from source files.",
        "target_user": "Application developers adding code analysis"
      },
      {
        "title": "Design Structural Queries",
        "description": "Create and refine Tree-sitter queries for functions, classes, imports, and decorators.",
        "target_user": "Code intelligence engineers"
      },
      {
        "title": "Harden Parsing Pipelines",
        "description": "Add error collection, visitor abstractions, incremental parsing, and performance controls to production tooling.",
        "target_user": "Developer tooling maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Basic Parser",
        "prompt": "Create a Tree-sitter Python parser for [language]. Show how to parse [sample], inspect the root, and report syntax errors.",
        "scenario": "Beginner setup for one language"
      },
      {
        "title": "Design a Structural Query",
        "prompt": "Design a Tree-sitter query for [language] that captures [constructs]. Explain each capture and list grammar node types I must verify.",
        "scenario": "Intermediate extraction with query captures"
      },
      {
        "title": "Build an AST Visitor",
        "prompt": "Refactor my traversal into an AST visitor that extracts [data]. Preserve error handling, named-child traversal, and language-specific extension points.",
        "scenario": "Advanced reusable traversal design"
      },
      {
        "title": "Architect a Parsing Pipeline",
        "prompt": "Design a production parsing pipeline for [languages] and [workload]. Include incremental parsing, query caching, version pinning, parallelism, failure handling, and tests.",
        "scenario": "Production planning across languages and repositories"
      }
    ],
    "output_examples": [
      {
        "input": "Extract Python functions and decorators from a module.",
        "output": "A query plan listing function, parameter, body, and decorator captures, plus grammar checks and malformed-code tests."
      },
      {
        "input": "Review my recursive AST traversal for scalability.",
        "output": "A visitor-based design with named-node filtering, early exits, error collection, and benchmarks for large files."
      },
      {
        "input": "Plan a multi-language repository analyzer.",
        "output": "A parser registry, version policy, language-specific queries, incremental update flow, normalized results, and failure-isolation strategy."
      }
    ],
    "best_practices": [
      "Verify node names against each language grammar before finalizing queries.",
      "Test valid, incomplete, and malformed source samples for every supported language.",
      "Pin parser versions and benchmark large files before production rollout."
    ],
    "anti_patterns": [
      "Do not assume one grammar uses the same node types as another.",
      "Do not ignore ERROR or missing nodes when extracting structure.",
      "Do not traverse entire trees when targeted queries or early exits are sufficient."
    ],
    "faq": [
      {
        "question": "Does this skill install Tree-sitter parsers?",
        "answer": "No. It guides parser selection and setup, but package installation remains part of your project workflow."
      },
      {
        "question": "Which languages does it support?",
        "answer": "The patterns are language-independent. Examples emphasize Python and identify common nodes for JavaScript, TypeScript, Go, and Rust."
      },
      {
        "question": "Can it create Tree-sitter queries?",
        "answer": "Yes. It guides captures for functions, classes, imports, decorators, parameters, and bodies."
      },
      {
        "question": "How does it handle malformed code?",
        "answer": "It recommends collecting ERROR and missing nodes while returning parse results for graceful downstream handling."
      },
      {
        "question": "Are the referenced cookbook files included?",
        "answer": "No. The package contains only SKILL.md, so those referenced cookbook paths are unavailable."
