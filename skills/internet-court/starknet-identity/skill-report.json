    "user_title": "Register and Verify Starknet Agents",
    "value_statement": "Teams need a consistent way to register agents and assess their on-chain trust signals. This skill provides ERC-8004 workflows for identity, feedback, and validation on Starknet.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Starknet agent identity",
      "ERC-8004",
      "agent registry",
      "on-chain reputation",
      "A2A Agent Card",
      "Starknet validation"
    ],
    "actual_capabilities": [
      "Explain the ERC-8004 identity, reputation, and validation registries.",
      "Show TypeScript patterns for registering agents with metadata.",
      "Show how to query ownership, metadata, reputation, and validation status.",
      "Describe signed feedback authorization with expiry and chain identifiers.",
      "Connect on-chain identity data with an A2A Agent Card.",
      "Map common registration, authorization, validation, and signature errors to recovery steps."
    ],
    "limitations": [
      "It does not deploy or verify Starknet contracts.",
      "It does not provide wallet custody, key management, or transaction execution by itself.",
      "Registry addresses, ABIs, chain settings, and SDK behavior require project-specific verification.",
      "On-chain reputation and validation data can be incomplete, stale, or transferred with the agent NFT."
    ],
    "use_cases": [
      {
        "title": "Register an Agent",
        "description": "Create an ERC-8004 identity, attach metadata, and interpret the registration transaction.",
        "target_user": "AI agent developer"
      },
      {
        "title": "Review Trust Signals",
        "description": "Query ownership, feedback summaries, client addresses, and validation results before integrating an agent.",
        "target_user": "Protocol integrator"
      },
      {
        "title": "Publish Agent Discovery Data",
        "description": "Align an A2A Agent Card with the agent registry and document recovery paths for operational errors.",
        "target_user": "Platform operator"
      }
    ],
    "prompt_templates": [
