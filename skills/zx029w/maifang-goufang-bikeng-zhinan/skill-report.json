  "content": {
    "user_title": "避开购房陷阱，做出稳妥选择",
    "value_statement": "购房者常难以比较房龄、楼层、配套、隐性成本和房屋风险。这个技能按场景整理检查项，帮助用户形成清晰的看房、验房和决策清单。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "购房避坑",
      "看房清单",
      "验房检查",
      "老破小评估",
      "户型选择",
      "房产预算",
      "学区核查"
    ],
    "actual_capabilities": [
      "比较高层住宅、老破小、商住公寓和其他房屋类型的居住成本与限制。",
      "根据户型、楼层、朝向、采光、通风和周边设施整理看房检查项。",
      "提示核对学区、地铁、商业、医院、工厂和交通设施等外部条件。",
      "帮助拆分房价、装修、物业、停车、税费和维修等预算项目。",
      "针对老房装修前的结构、管线、物业沟通和额外费用提供评估要点。",
      "把用户的购房目标、预算和房屋信息整理成可执行的比较清单。"
    ],
    "limitations": [
      "不能替代房屋检测机构、律师、银行或税务专业人士的正式意见。",
      "参考资料中的价格、比例和政策信息可能过时，必须向当地官方机构核实。",
      "不能仅凭文字确认承重结构、房屋质量、产权状态或学区资格。",
      "建议适用于信息整理和风险提示，不构成投资、贷款或交易承诺。"
    ],
    "use_cases": [
      {
        "title": "首次购房做筛选",
        "description": "输入预算、通勤、家庭成员和购房目的，生成房源比较维度与看房问题清单。",
        "target_user": "首次购房者"
      },
      {
        "title": "评估老房改造成本",
        "description": "提供房龄、楼层、结构和现状，梳理管线、拆除、搬运、物业和预算风险。",
        "target_user": "准备购买或改造老房的家庭"
      },
      {
        "title": "复核二手房交易信息",
        "description": "根据房源宣传和实地观察，整理需要向中介、业主和官方部门核实的事项。",
        "target_user": "二手房买家与家庭决策者"
      }
    ],
    "prompt_templates": [
      {
        "title": "入门：生成看房清单",
        "prompt": "我准备在[城市]购买[自住或投资]住房，预算约[金额]，请按地段、户型、楼层、采光、噪音和配套生成看房清单。",
        "scenario": "适合第一次看房前建立基础检查框架。"
      },
      {
        "title": "进阶：比较两套房源",
        "prompt": "请比较以下两套房源：房源A[信息]，房源B[信息]。按总成本、居住体验、维护风险、转手难度和待核实事项给出表格式结论。",
        "scenario": "适合缩小候选范围和安排第二次看房。"
      },
      {
        "title": "实用：审查老房改造",
        "prompt": "这套房屋房龄[年]、楼层[楼层]、结构[已知结构]，计划改造[项目]，预算[金额]。请列出不能直接施工的事项、必须向物业确认的事项和可能超支的项目。",
        "scenario": "适合购买老破小或开始装修前的风险盘点。"
      },
      {
        "title": "高级：建立购房决策报告",
        "prompt": "请根据我的目标[目标]、家庭情况[情况]、预算[金额]、通勤范围[范围]和候选房源[资料]，建立评分维度，区分已确认信息、待核实信息和高风险假设，并给出下一步核查顺序。",
        "scenario": "适合家庭共同决策和多房源系统比较。"
      }
    ],
    "output_examples": [
      {
        "input": "预算有限，正在比较一套市区老破小和一套远郊高层。",
        "output": "先比较通勤时间、维修成本、物业与停车费用、楼栋维护状态和家庭长期需求，再核对产权、学区和实际居住条件。"
      },
      {
        "input": "看中一套临近高架的二手房，准备安排复看。",
        "output": [
          "白天和晚高峰分别到场，记录卧室、阳台和客厅的噪音。",
          "核实窗户、楼层、朝向、隔音措施和高架距离。",
          "向物业和邻居了解夜间车流、投诉记录与近期改造计划。"
        ]
      },
      {
        "input": "准备改造一套老房，担心预算失控。",
        "output": "先确认结构、管线、门窗、垃圾运输和物业限制，再把拆除、找平、上下水、电路与邻里协调费用单独列入预算。"
      }
    ],
    "best_practices": [
      "先说明购房目的、预算、城市和家庭需求，再提出具体问题。",
      "把资料中的经验数字当作待核实线索，并优先查询当地官方信息。",
      "要求答案区分事实、推测、风险和下一步现场检查事项。"
    ],
    "anti_patterns": [
      "只凭一个宣传卖点判断房屋价值或未来升值空间。",
      "把通用经验、网络数据或个案感受当作当地政策和质量结论。",
      "未确认产权、结构、学区和预算，就根据建议签约或施工。"
    ],
    "faq": [
      {
        "question": "这个技能适合哪些购房者？",
        "answer": "适合首次购房者、二手房买家、老房改造家庭，以及需要比较多个房源的决策者。"
      },
      {
        "question": "它能判断某套房是否值得购买吗？",
        "answer": "它能整理比较维度和风险清单，但不能替代现场检测、产权核验和专业法律意见。"
      },
      {
        "question": "能处理老破小的装修问题吗？",
        "answer": "可以提示结构、管线、物业、搬运、拆除和预算等改造前的重点检查事项。"
      },
      {
        "question": "房产政策和学区信息可靠吗？",
        "answer": "政策和学区会变化，技能只能提供核查方向，最终应以当地政府和教育部门的最新信息为准。"
      },
      {
        "question": "如何让建议更贴合我的情况？",
        "answer": "请提供城市、预算、购房目的、家庭成员、通勤范围、房龄和候选房源信息。"
      },
      {
        "question": "它能代替验房师或律师吗？",
        "answer": "不能。它用于信息整理和问题准备，房屋检测、产权审查和合同审阅仍应由专业人士完成。"
      }
    ]
  },
