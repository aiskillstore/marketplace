  "content": {
    "user_title": "选择适合房间的窗帘与安装方案",
    "value_statement": "窗帘选择涉及遮光、隐私、窗型和安装，信息不足容易增加返工成本。这个技能结合中文参考资料、房间条件和预算，整理选购建议及施工前检查项。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "窗帘选购指南",
      "飘窗窗帘",
      "窗帘盒设计",
      "遮光隐私",
      "电动窗帘",
      "装修搭配"
    ],
    "actual_capabilities": [
      "按卧室、客厅、厨房和卫生间的功能推荐窗帘类型。",
      "比较布帘、纱帘、百叶、卷帘和梦幻帘的采光与隐私表现。",
      "根据内开窗、外开窗、推拉窗、飘窗和异形窗分析安装方案。",
      "提醒窗帘盒、轨道、褶皱、插座和空调管路的规划要点。",
      "结合空间大小、装修风格和预算给出搭配与取舍建议。",
      "按问题主题定位32篇中文参考资料，并整理改造和用电的自查提示。"
    ],
    "limitations": [
      "建议依赖用户提供的尺寸和现场条件，不能替代专业测量、结构核验或电气施工判断。",
      "资料含未经工程验证的改造案例，不能据此直接拆墙或在梁体开槽。",
      "参考文章多次提到图片，但技能未附图片；部分资料仅为标题目录，内容也存在重复或观点差异。",
      "不提供实时价格、库存或产品检测结果，也不执行采购、电动窗帘控制或智能设备配置。"
    ],
    "use_cases": [
      {
        "title": "新房业主规划窗帘",
        "description": "根据房间功能、窗型和装修阶段，提前确定窗帘盒、轨道、插座和遮光方案。",
        "target_user": "正在装修或准备装修的业主"
      },
      {
        "title": "设计师整理户型方案",
        "description": "比较飘窗、阳台和异形窗的布帘、纱帘与百叶方案，整理供客户讨论的设计取舍。",
        "target_user": "室内设计师和软装顾问"
      },
      {
        "title": "租住家庭改善采光",
        "description": "比较伸缩杆、免打孔轨道和百叶方案，结合租约、窗型及预算整理候选窗饰。",
        "target_user": "租房者和小户型住户"
      }
    ],
    "prompt_templates": [
      {
        "title": "基础窗帘推荐",
        "prompt": "我的房间是[卧室/客厅]，窗户是[窗型]，宽高为[尺寸]，预算为[预算]。请推荐窗帘类型，并先指出缺少的信息。",
        "scenario": "适合第一次咨询窗帘选择的用户。"
      },
      {
        "title": "比较两种安装方案",
        "prompt": "请比较[方案A]和[方案B]用于[房间]的优缺点。分别分析遮光、夜间隐私、采光、清洁和成本因素，不编造报价。",
        "scenario": "适合已经有初步方案，需要做取舍的用户。"
      },
      {
        "title": "处理飘窗与空调冲突",
        "prompt": "我的户型有[内开/外开/推拉]飘窗，附近有[中央空调/挂机/吊顶]。请比较窗帘盒和轨道布局，列出开窗间隙、电源及专业核验事项。",
        "scenario": "适合装修前确认复杂窗型和设备关系的用户。"
      },
      {
        "title": "制定全屋窗饰清单",
        "prompt": "根据以下户型、朝向、家庭成员、作息、风格和预算，制定逐房间窗饰清单：[详细信息]。标注遮光目标、安装方式、参考资料和待核实条件，不把目标当作产品实测值。",
        "scenario": "适合需要统筹全屋采购与施工的高级用户。"
      }
    ],
    "output_examples": [
      {
        "input": "卧室是内开飘窗，空间较小，用户需要良好遮光但不想压缩空间。",
        "output": [
          "先确认窗扇开启范围，以及窗框上方可用的安装间隙。",
          "间隙足够时，可比较飘窗内双层帘与内侧纱帘、外侧遮光布帘两种方案。",
          "间隙不足时，优先考虑窗洞外侧安装，避免阻碍开窗。",
          "轨道外露可能造成顶部漏光，不能保证完全遮光；最终尺寸需现场复核。"
        ]
      },
      {
        "input": "客厅与封闭阳台打通，用户希望采光通透并减少厚重感。",
        "output": [
          "可比较阳台侧的纱帘、百叶或梦幻帘，先核实开窗空间和夜间隐私。",
          "客厅不必重复安装厚重布帘，除非需要强遮光或投影。",
          "施工前确认阳台窗型、轨道承重和电动窗帘电源。"
        ]
      }
    ],
    "best_practices": [
      "先说明房间功能、窗型、尺寸、朝向、采光和预算，再请求具体建议。",
      "把遮光、隐私、通风、清洁、开窗和视觉效果分别比较。",
      "涉及梁体、墙体、电源或吊顶改造时，先由合格专业人员核验，不能直接照搬参考案例。"
    ],
    "anti_patterns": [
      "把文字案例当作现场勘测结果，直接确定尺寸或实施梁体开槽。",
      "把客厅、卧室、厨卫使用同一种窗帘标准，不区分功能需求。",
      "忽略内开窗、空调管路、插座和窗帘盒空间，直接承诺完全遮光。"
    ],
    "faq": [
      {
