  "content": {
    "user_title": "规划卫生间装修，避开常见坑",
    "value_statement": "卫生间布局、防水、排水和设备尺寸错误容易造成返工与长期使用问题。本技能根据户型、预算和家庭需求整理设计、选材与验收建议。",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "卫生间装修",
      "干湿分离",
      "卫生间防水",
      "地漏防臭",
      "浴室柜选购",
      "马桶坑距",
      "装修验收"
    ],
    "actual_capabilities": [
      "根据家庭人数、户型和使用习惯梳理干湿分离或三分离方案。",
      "提供防水高度、门口翻边、闭水试验和排水坡度的检查清单。",
      "比较地漏、瓷砖、美缝、浴室柜、台盆和卫浴五金的选购重点。",
      "提示马桶坑距、淋浴房尺寸、浴霸排气和水电点位的常见冲突。",
      "针对暗卫、小卫生间和浴柜外置场景提出空间优化建议。",
      "按施工阶段整理材料进场、隐蔽工程和竣工验收事项。"
    ],
    "limitations": [
      "不能替代建筑结构、给排水和电气专业人员的现场判断。",
      "建议基于参考资料，不能保证适用于所有地区、物业规定和产品型号。",
      "不能核验施工方资质、报价真实性或材料的实际质量。",
      "涉及拆墙、移位和改电时，仍需取得物业许可并进行现场复核。"
    ],
    "use_cases": [
      {
        "title": "新房业主制定卫生间方案",
        "description": "输入户型尺寸、家庭成员和预算，获得布局、设备尺寸与施工节点建议。",
        "target_user": "准备装修新房的业主"
      },
      {
        "title": "设计师快速检查方案",
        "description": "提交平面布局和设备清单，检查干湿分离、坑距、排水和收纳是否存在明显冲突。",
        "target_user": "室内设计师与空间规划人员"
      },
      {
        "title": "监理陪同业主验收",
        "description": "按防水、水电、铺贴和洁具安装阶段生成现场核对重点，减少遗漏。",
        "target_user": "装修监理和需要自验收的业主"
      }
    ],
    "prompt_templates": [
      {
        "title": "入门：列出装修重点",
        "prompt": "我家卫生间面积为【长×宽】米，常住【人数】人，预算约【金额】。请列出最需要优先确认的五项装修重点。",
        "scenario": "适合首次装修用户建立检查清单"
      },
      {
        "title": "进阶：比较布局方案",
        "prompt": "请比较我家卫生间的【方案A】和【方案B】。已知门、窗、下水和承重墙位置为【信息】，请从动线、采光、收纳、施工难度和预算分析。",
        "scenario": "适合在多个平面方案中做选择"
      },
      {
        "title": "进阶：审核材料清单",
        "prompt": "请审核这份卫生间材料清单：【清单】。按防水、排水、瓷砖、美缝、洁具和五金分类，指出缺项、规格风险和可替代项。",
        "scenario": "适合采购前复核材料与规格"
      },
      {
        "title": "高级：制定验收计划",
        "prompt": "根据户型信息【信息】、施工进度【阶段】和合同约定【内容】，制定卫生间分阶段验收表。每项包含检查方法、合格标准和发现问题后的处理建议。",
        "scenario": "适合施工管理和现场验收"
      }
    ],
    "output_examples": [
      {
        "input": "卫生间只有四平方米，想做淋浴、马桶和洗手台。",
        "output": "建议先确认门窗、下水和坑距，再优先安排干湿分离。洗手台可考虑外置，但必须复核墙体、排水和家庭动线。"
      },
      {
        "input": "开发商已经做了防水，是否可以直接铺砖？",
        "output": [
          "先确认防水范围、材料、施工记录和质保信息。",
          "铺砖前进行闭水试验，并重点检查门口、管根和地漏周边。",
          "发现渗漏时先修复并复验，不能用铺砖遮盖问题。"
        ]
      },
      {
        "input": "我想把浴室柜放到卫生间外面。",
        "output": "浴柜外置可以提升早晚高峰效率，也能改善湿区收纳。需要同步确认排水坡度、防溅水处理、照明、防潮和物业要求。"
      }
    ],
    "best_practices": [
      "先提供户型尺寸、门窗、下水、家庭人数和预算，再请求具体建议。",
      "涉及拆改、移位和用电时，要求方案明确前置条件与现场复核事项。",
      "将建议拆成设计、采购、施工和验收阶段，逐项记录结果。"
    ],
    "anti_patterns": [
      "只提供面积就要求确定完整布局和全部产品型号。",
