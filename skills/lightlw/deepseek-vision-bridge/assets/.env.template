# ============================================================
#  Codex Vision Bridge 配置模板
#  复制本文件为 .env 并填写（放在 ocr-proxy.js 同目录）
# ============================================================

# DeepSeek API Key（必填）— 在 https://platform.deepseek.com 注册获取
DEEPSEEK_API_KEY=

# 硅基流动 API Key（可选，云端看图引擎）— 在 https://cloud.siliconflow.cn 注册获取
# 不填则自动跳过云端，只用本地 VLM + OCR
SILICONFLOW_API_KEY=

# 本地视觉模型（可选，离线看图引擎）— 需安装 Ollama 并拉取模型
# 常用: minicpm-v:8b / qwen2.5-vl:7b / llama3.2-vision:11b
LOCAL_VL_MODEL=minicpm-v:8b

# Ollama 服务地址（默认本机 11434）
OLLAMA_URL=http://127.0.0.1:11434

# 代理监听端口（默认 57323）
OCR_PROXY_PORT=57323

# 上游 DeepSeek 地址（一般无需修改；如走自定义网关可改）
DEEPSEEK_BASE_URL=api.deepseek.com
DEEPSEEK_BASE_PORT=443
DEEPSEEK_BASE_HTTPS=true
