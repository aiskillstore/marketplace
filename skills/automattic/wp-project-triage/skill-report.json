  "content": {
    "user_title": "Inspect WordPress Projects Before Editing",
    "value_statement": "WordPress repositories vary by structure, tooling, and test setup. This skill runs a local detector and returns workflow guidance before changes begin.",
    "seo_keywords": [
      "WordPress project triage",
      "WordPress repository analysis",
      "Claude",
      "Codex",
      "Claude Code",
      "AI coding workflow",
      "WordPress plugin tooling",
      "WordPress theme detection",
      "Gutenberg development",
      "WP-CLI signals"
    ],
    "actual_capabilities": [
      "Detects WordPress project kinds, including plugins, themes, block themes, WP core, Gutenberg, and full sites.",
      "Reports PHP, Node, package manager, test, and WP-CLI signals from local files.",
      "Finds common WordPress files such as block metadata, theme metadata, and wp-content directories.",
      "Summarizes version hints for WordPress core and Gutenberg checkouts.",
      "Suggests local workflow commands based on detected package and Composer configuration."
    ],
    "limitations": [
      "Requires local filesystem access to the repository root.",
      "Does not perform dependency vulnerability scanning or runtime testing.",
      "May miss signals when repositories exceed configured scan limits.",
      "Classifies unknown layouts conservatively when WordPress markers are absent."
    ],
    "use_cases": [
      {
        "title": "Prepare Plugin Maintenance",
        "description": "Identify plugin structure, package tooling, and available tests before editing a WordPress plugin.",
        "target_user": "Plugin maintainer"
      },
      {
        "title": "Check Theme Workflows",
        "description": "Detect theme or block theme signals and choose the right build and verification steps.",
        "target_user": "Theme developer"
      },
