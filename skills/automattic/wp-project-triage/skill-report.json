  "content": {
    "user_title": "Analyze WordPress Project Structure",
    "value_statement": "WordPress repositories can hide their project type, tooling, and test paths across many files. This skill inspects the repository and returns structured triage guidance.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "WordPress triage",
      "WordPress repository analysis",
      "WP project detector",
      "Gutenberg workflow",
      "WordPress tooling",
      "plugin theme detection",
      "AI coding skill"
    ],
    "actual_capabilities": [
      "Runs a Node.js detector against the current repository root.",
      "Classifies WordPress projects as plugins, themes, block themes, WP core, Gutenberg, or sites.",
      "Detects Composer, package manager, wp-env, PHPUnit, Playwright, Jest, and WordPress scripts signals.",
      "Reports Interactivity API, Abilities API, InnerBlocks, WP-CLI, WordPress, and Gutenberg hints.",
      "Produces structured JSON that follows the included triage schema.",
      "Suggests likely lint, test, build, start, Composer, and PHPUnit commands without running them."
    ],
    "limitations": [
      "It reads the local repository but does not execute tests or build commands.",
