    "user_title": "Diagnose WordPress Performance Safely",
    "value_statement": "Slow WordPress sites need careful measurement before changes. This skill guides Claude, Codex, and Claude Code through backend-only profiling, bottleneck analysis, and safe verification.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "WordPress performance",
      "WP-CLI profiling",
      "wp doctor",
      "wp profile",
      "Query Monitor",
      "Server-Timing",
      "object cache"
    ],
    "actual_capabilities": [
      "Builds a backend-only WordPress performance investigation plan.",
      "Uses WP-CLI doctor and profile commands when available.",
      "Checks autoloaded options size and cache drop-in presence through the included script.",
      "Guides REST header and Query Monitor based diagnostics without a browser UI.",
      "Maps bottlenecks to database, object cache, HTTP API, cron, or autoloaded option fixes.",
      "Defines verification steps using repeatable baseline and after measurements."
    ],
    "limitations": [
      "Requires access to the target WordPress environment or a representative copy.",
      "Does not replace browser-based front-end performance testing.",
      "Cannot safely run write operations in production without explicit approval.",
      "Results depend on WP-CLI, plugins, and profiling tools available in the environment."
    ],
    "use_cases": [
      {
        "title": "Investigate slow production pages",
        "description": "Create a safe measurement plan for TTFB, WP-CLI profiling, and logs before changing code.",
        "target_user": "Site reliability engineers"
      },
      {
        "title": "Reduce backend bottlenecks",
        "description": "Identify whether database queries, autoloaded options, object cache misses, cron, or HTTP calls dominate latency.",
        "target_user": "WordPress developers"
      },
      {
        "title": "Verify performance fixes",
        "description": "Repeat the same measurements after a change and check that behavior and logs remain clean.",
        "target_user": "Release managers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a basic diagnosis",
        "scenario": "Beginner baseline request",
        "prompt": "Use the wp-performance skill to diagnose why this WordPress page is slow. I can provide the URL, environment, and WP path."
      },
      {
        "title": "Create a safe profiling plan",
        "scenario": "Staging or production planning",
        "prompt": "Use the wp-performance skill to make a backend-only profiling plan for a WordPress site. Do not run write operations unless I approve them."
      },
      {
        "title": "Analyze WP-CLI results",
        "scenario": "Interpreting diagnostic output",
        "prompt": "Use the wp-performance skill to interpret my wp doctor, wp profile, and perf_inspect output. Identify the most likely bottleneck and next safe step."
      },
      {
        "title": "Validate an optimization",
        "scenario": "Advanced verification workflow",
        "prompt": "Use the wp-performance skill to verify this WordPress performance fix. Compare baseline and after measurements, note risks, and recommend rollout steps."
      }
    ],
    "output_examples": [
      {
        "input": "A WordPress REST endpoint has high TTFB on staging.",
        "output": [
          "Baseline the route with repeated HTTP timing samples.",
          "Run WP-CLI profile for the same route when available.",
          "Check Query Monitor REST headers for slow queries and HTTP calls.",
          "Recommend one primary bottleneck to fix first."
        ]
      },
      {
        "input": "The site has many autoloaded options and slow admin pages.",
        "output": [
          "Report the autoloaded option size.",
          "Identify whether WP-CLI doctor flags the issue.",
          "Suggest reducing large autoloaded values safely.",
          "Repeat the same admin measurement after changes."
        ]
      },
      {
        "input": "A proposed cache change may affect production traffic.",
        "output": "The skill recommends staging validation, explicit cache invalidation checks, and avoiding cache flushes during traffic unless approved."
      }
    ],
    "best_practices": [
      "Capture baseline and after measurements in the same environment.",
      "Ask for approval before plugin installs, cache flushes, load tests, or production writes.",
      "Fix one dominant bottleneck first, then verify with the same measurement path."
    ],
    "anti_patterns": [
      "Running load tests against production without approval.",
      "Changing caches or plugins before collecting a baseline.",
      "Comparing results from different URLs, users, cache states, or environments."
    ],
    "faq": [
      {
        "question": "Does this skill need browser access?",
        "answer": "No. It is designed for backend-only WordPress diagnostics using WP-CLI, logs, HTTP headers, and REST responses."
      },
      {
        "question": "Can it run in production?",
        "answer": "It can guide safe read-only measurements in production. Write operations require explicit approval and careful timing."
      },
      {
        "question": "What tools does it prefer?",
        "answer": "It prefers WP-CLI doctor, WP-CLI profile, Query Monitor data, Server-Timing headers, and the included perf_inspect script."
      },
      {
        "question": "Does it fix performance automatically?",
        "answer": "No. It identifies likely bottlenecks and recommends targeted changes that the user can review and approve."
      },
      {
        "question": "What WordPress versions does it target?",
        "answer": "The skill targets WordPress 6.9 and later, with PHP 7.2.24 or later noted in the skill metadata."
      },
      {
        "question": "Can it diagnose front-end metrics like LCP?",
        "answer": "It can discuss WordPress backend causes, but it does not replace browser-based field or lab testing for front-end metrics."
      }
    ]
