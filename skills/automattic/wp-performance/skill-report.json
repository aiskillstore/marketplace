    "user_title": "Optimize WordPress Performance Safely",
    "value_statement": "Slow WordPress sites are hard to diagnose without browser access or unsafe production changes. This skill guides Claude, Codex, and Claude Code through backend measurements and safe fixes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "WordPress performance",
      "WP-CLI profiling",
      "Query Monitor",
      "autoloaded options",
      "object cache",
      "Server-Timing",
      "WordPress optimization"
    ],
    "actual_capabilities": [
      "Builds a backend-only measurement plan using WP-CLI, curl, REST headers, and logs.",
      "Runs or explains a deterministic perf_inspect script for WP-CLI availability and core performance signals.",
      "Guides WP-CLI doctor and profile workflows to identify slow stages, hooks, and callbacks.",
      "Analyzes database queries, autoloaded options, object cache behavior, cron, and remote HTTP calls.",
      "Defines safe verification steps for baseline comparisons, production guardrails, and staged rollout checks."
    ],
    "limitations": [
      "Requires access to a WordPress environment where WP-CLI or logs are available.",
      "Does not use browser UI tools or visual front-end profiling.",
      "Cannot guarantee production safety without approval for writes, plugin installs, or cache changes.",
      "Advanced APM or PHP profiler work still needs hosting or operations support."
    ],
    "use_cases": [
      {
        "title": "Diagnose Slow Requests",
        "description": "Create a repeatable plan to measure slow pages, REST routes, admin screens, or WP-Cron activity.",
        "target_user": "WordPress developer"
      },
      {
        "title": "Validate Production Readiness",
        "description": "Use read-only checks to identify autoload bloat, debug flags, plugin overhead, and cache concerns.",
        "target_user": "Site reliability engineer"
      },
      {
        "title": "Prioritize Performance Fixes",
        "description": "Turn profiling output into focused changes for queries, object caching, HTTP calls, or cron work.",
        "target_user": "Agency consultant"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Measurement Plan",
        "scenario": "Beginner: you know the slow URL but need a safe first step.",
        "prompt": "Help me diagnose a slow WordPress page. Environment: staging. Target URL: [URL]. Restrictions: read-only checks only. Create a backend-only measurement plan."
      },
      {
        "title": "Run Initial Inspection",
        "scenario": "Intermediate: you have WP-CLI access and need an initial report.",
        "prompt": "Use the wp-performance workflow for this install. Path: [WP path]. Site URL: [URL]. Summarize WP-CLI availability, core version, autoload size, cache drop-ins, and next checks."
      },
      {
        "title": "Profile a Bottleneck",
        "scenario": "Advanced: baseline data points to a slow hook, query, or route.",
        "prompt": "Analyze these WordPress performance observations: [paste notes]. Identify the dominant bottleneck, choose the right WP-CLI or REST profiling step, and explain what evidence will confirm it."
      },
      {
        "title": "Plan a Safe Production Fix",
        "scenario": "Advanced: you need a remediation plan with verification and rollback.",
        "prompt": "Given these performance findings: [paste findings]. Propose a production-safe fix plan, approval gates, validation steps, rollback criteria, and measurements to repeat after deployment."
      }
    ],
    "output_examples": [
      {
        "input": "Investigate high TTFB on a staging product page.",
        "output": [
          "Baseline the same URL with warmed caches and multiple samples.",
          "Check WP-CLI doctor results, autoload size, and object cache drop-ins.",
          "Profile stages and hooks before changing code or flushing caches."
        ]
      },
      {
        "input": "A REST route is slow only for logged-in users.",
        "output": [
          "Target the authenticated REST request and inspect Query Monitor headers when available.",
          "Compare database query count, HTTP API calls, and hook timing for the route.",
          "Verify any fix with the same user state and route parameters."
        ]
      },
      {
        "input": "Autoloaded options are larger than expected.",
        "output": [
          "List the largest autoloaded options and confirm ownership before changes.",
          "Move large computed data to non-autoload storage, transients, or object cache.",
          "Retest total autoload bytes and page timing after the change."
        ]
      }
    ],
    "best_practices": [
      "Capture a baseline before profiling or making changes.",
      "Use read-only diagnostics first, especially in production environments.",
      "Repeat the same measurement after each fix with the same URL, user state, and cache state."
    ],
    "anti_patterns": [
      "Installing plugins, enabling debug flags, or running load tests in production without approval.",
      "Flushing caches during active traffic before proving it is required for correctness.",
      "Comparing measurements from different URLs, sites, user states, or cache conditions."
    ],
    "faq": [
      {
        "question": "Does this skill require browser access?",
        "answer": "No. It is designed for backend-only workflows using WP-CLI, logs, HTTP requests, and response headers."
      },
      {
        "question": "Does it run commands automatically?",
        "answer": "It can guide command execution, but risky write operations require explicit approval and environment awareness."
      },
      {
        "question": "Can it work without WP-CLI?",
        "answer": "Yes, but results are more limited. It can still use logs, HTTP timing, REST headers, and APM observations."
      },
      {
        "question": "Is it safe for production sites?",
        "answer": "It emphasizes read-only checks first. Production writes, plugin installs, load tests, and cache flushes need approval."
      },
      {
        "question": "What performance areas does it cover?",
        "answer": "It covers WP-CLI profiling, doctor checks, database queries, autoloaded options, object cache, cron, and remote HTTP calls."
      },
      {
        "question": "How should results be verified?",
        "answer": "Repeat the same baseline measurement after changes and confirm that site behavior and logs remain healthy."
      }
    ]
