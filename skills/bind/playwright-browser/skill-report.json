  "content": {
    "user_title": "Control Browser Workflows with Playwright",
    "value_statement": "Manual browser checks slow development and make visual issues easy to miss. This skill lets agents drive Playwright from the CLI for navigation, element interaction, snapshots, and screenshots.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Playwright browser automation",
      "browser control skill",
      "accessibility snapshot",
      "screenshot automation",
      "web testing workflow",
      "Bun CLI",
      "agent browser tool"
    ],
    "actual_capabilities": [
      "Start, stop, and check a persistent Playwright browser session.",
      "Navigate the active browser to a supplied URL.",
      "Read the current page accessibility tree as a text snapshot.",
      "Type into inputs and press keys after typing.",
      "Click elements by role, text, or CSS selector.",
      "Capture normal or full page screenshots to a chosen path."
    ],
    "limitations": [
      "Requires the referenced Bun and Playwright command scripts to be available.",
      "Website network failures, bot checks, and login flows can interrupt automation.",
      "Element targeting depends on accessible names, visible text, or stable selectors.",
      "Browser cookies and localStorage can persist in the project workspace."
    ],
    "use_cases": [
      {
        "title": "Check UI Changes",
        "target_user": "Frontend developer",
        "description": "Open a local or deployed page, inspect visible structure, and capture screenshots after changes."
      },
      {
        "title": "Reproduce Browser Bugs",
        "target_user": "Quality engineer",
        "description": "Navigate through a reported flow, interact with controls, and save visual evidence for triage."
      },
      {
        "title": "Explore Web Pages",
        "target_user": "Product manager",
        "description": "Review page states and form behavior without writing a full browser test."
      }
    ],
    "prompt_templates": [
      {
        "title": "Open and Capture a Page",
        "scenario": "Beginner browser check",
        "prompt": "Start a browser session for my local app, navigate to the home page, and take a screenshot."
      },
      {
        "title": "Inspect Page Structure",
        "scenario": "Find reliable element targets",
        "prompt": "Navigate to the sign-in page and return the accessibility snapshot. Identify the best fields and buttons to target."
      },
      {
        "title": "Test a Search Flow",
        "scenario": "Interactive workflow validation",
        "prompt": "Open the search page, type a query into the search box, submit it, and report the visible result state."
      },
      {
        "title": "Document a Visual Regression",
        "scenario": "Advanced debugging workflow",
        "prompt": "Reproduce the checkout layout issue, capture a full page screenshot, and summarize the elements that appear incorrect."
      }
    ],
    "output_examples": [
      {
        "input": "Open the product page and capture a screenshot.",
        "output": "The assistant opens a visible browser, loads the requested page, and reports that the screenshot was saved."
      },
      {
        "input": "Find the submit button on the form.",
        "output": "The assistant returns a readable page snapshot and identifies the button by role and visible name."
      },
      {
        "input": "Type a search term and submit the form.",
        "output": "The assistant enters the requested text, submits the form, and summarizes the resulting page state."
      }
    ],
    "best_practices": [
      "Use snapshots before clicking or typing to choose stable element references.",
      "Use headless mode for repeatable checks and visible mode for debugging.",
      "Stop sessions and clear stored browser data after sensitive workflows."
    ],
    "anti_patterns": [
      "Do not enter passwords or tokens into unknown websites.",
      "Do not rely on brittle selectors when accessible roles are available.",
      "Do not leave persistent sessions running after the task is complete."
    ],
