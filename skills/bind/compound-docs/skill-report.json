  "content": {
    "user_title": "Document Solved Issues as Reusable Patterns",
    "value_statement": "Teams lose time when solved fixes disappear in chat history. This skill turns resolved issues into schema-checked solution notes and reusable patterns.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "compound docs",
      "solution documentation",
      "debugging notes",
      "engineering knowledge base",
      "pattern detection",
      "developer documentation",
      "team knowledge sharing"
    ],
    "actual_capabilities": [
      "Detects confirmation phrases that indicate a technical fix worked.",
      "Reads schema.yaml to use current categories and allowed metadata values.",
      "Extracts symptoms, category, root cause, solution, and prevention notes from the conversation.",
      "Searches existing solution docs for similar issues before creating a new entry.",
      "Creates structured Markdown solution documents under the chosen output directory.",
      "Suggests promotion to patterns.md when related issues recur."
    ],
    "limitations": [
      "It depends on enough conversation context to describe the solved issue accurately.",
      "It may ask follow-up questions when category, symptom, or solution details are missing.",
      "It can update schema values when a project needs new categories or metadata.",
      "Its shell examples assume a Unix-like environment with common command-line tools."
    ],
    "use_cases": [
      {
        "title": "Capture Debugging Wins",
        "description": "Record the exact symptom, cause, and fix after a developer confirms that a bug is resolved.",
        "target_user": "Software developer"
      },
      {
        "title": "Build Team Knowledge Bases",
        "description": "Create searchable solution notes so recurring engineering issues are easier to solve later.",
        "target_user": "Engineering manager"
      },
      {
        "title": "Identify Recurring Patterns",
        "description": "Promote repeated problems into a shared patterns file that agents and teammates can check first.",
        "target_user": "Platform team lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Document This Fix",
        "scenario": "Beginner capture after a confirmed fix",
        "prompt": "That worked. Please use compound-docs to document the problem, the fix, and how we can prevent it."
      },
      {
        "title": "Add Missing Context",
        "scenario": "Structured documentation with known details",
        "prompt": "Use compound-docs for this resolved issue. Category is deployment, symptom was a failing Docker build, and the fix was rebuilding without cache."
      },
      {
        "title": "Check Related Issues First",
        "scenario": "Intermediate workflow for recurring symptoms",
        "prompt": "Run the compound-docs workflow and search existing solution notes before creating a new entry for this resolved API timeout."
      },
      {
        "title": "Promote a Repeated Pattern",
        "scenario": "Advanced pattern management",
        "prompt": "Use compound-docs to document this fix, link related solution notes, and propose a patterns.md entry if this issue has occurred before."
      }
    ],
    "output_examples": [
      {
        "input": "That worked. The Docker layer error was fixed by rebuilding without cache.",
        "output": "The skill creates a deployment solution note with symptoms, root cause, solution, and prevention guidance."
      },
      {
        "input": "Use compound-docs for the API timeout fix and check prior incidents first.",
        "output": "The skill searches existing solution notes, links related entries, and creates a new integration note when needed."
      },
      {
        "input": "This is the third time we fixed the same auth header issue.",
        "output": "The skill suggests promoting the repeated fix into patterns.md for future required reading."
      }
    ],
    "best_practices": [
      "Confirm the issue is fully resolved before invoking the workflow.",
      "Include the exact symptom, root cause, and working fix in the conversation.",
      "Review related solution notes before adding a new document."
    ],
    "anti_patterns": [
      "Do not document simple typo fixes that have no future learning value.",
      "Do not create new schema categories when an existing category is accurate.",
      "Do not promote a pattern before confirming that the problem has recurred."
    ],
    "faq": [
      {
        "question": "When does this skill run?",
        "answer": "It runs after confirmation phrases such as that worked, it is fixed, or the manual compound command."
      },
      {
        "question": "What files does it create?",
        "answer": "It creates Markdown solution notes in the configured output directory and may append repeated issues to patterns.md."
      },
      {
        "question": "Does it require a fixed taxonomy?",
        "answer": "No. It reads schema.yaml and can add enum values when the project needs new categories or metadata."
      },
      {
        "question": "Can it find related past fixes?",
        "answer": "Yes. It searches existing solution notes by keywords, file paths, dependencies, categories, and tags."
      },
      {
        "question": "What information should I provide?",
        "answer": "Provide the symptom, the confirmed solution, the likely root cause, and prevention guidance when available."
      },
      {
        "question": "Is it only for one technology stack?",
        "answer": "No. The schema is general and can be extended for different languages, frameworks, and project structures."
      }
    ]
