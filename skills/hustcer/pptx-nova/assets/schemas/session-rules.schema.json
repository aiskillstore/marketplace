{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-session-rules/v1",
  "title": "pptx-nova current-deck session rules",
  "type": "object",
  "required": ["schemaVersion", "deckIdentity", "rules"],
  "properties": {
    "schemaVersion": { "const": "pptx-nova-session-rules/v1" },
    "observedAt": { "type": "string" },
    "deckIdentity": {
      "type": "object",
      "required": ["deckId", "currentRevisionSha256", "parentRevisionSha256"],
      "properties": {
        "deckId": { "type": "string", "minLength": 1 },
        "currentRevisionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "parentRevisionSha256": {
          "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "status",
          "lifetime",
          "trigger",
          "target",
          "action",
          "source",
          "supersedes"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["preserve-invariant", "future-element-style"]
          },
          "status": { "type": "string", "enum": ["active", "candidate", "superseded"] },
          "lifetime": { "const": "current-deck" },
          "trigger": {
            "type": "object",
            "required": ["event"],
            "properties": {
              "event": {
                "type": "string",
                "enum": ["any-edit", "slide-added", "element-added"]
              }
            },
            "additionalProperties": false
          },
          "target": { "type": "object" },
          "action": { "type": "object" },
          "source": {
            "type": "object",
            "required": ["kind", "quote"],
            "properties": {
              "kind": { "type": "string", "enum": ["user-feedback", "artifact"] },
              "quote": { "type": "string", "minLength": 1 },
              "turn": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": true
          },
          "supersedes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
