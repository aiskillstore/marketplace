{
  "_comment": "示例 brand profile：用于 s8fy pptx check-brand <deck> --brand brand-profile.example.json --json",
  "schemaVersion": "pptx-brand-profile/v1",
  "name": "Example Corp",
  "colors": {
    "allowed": ["1A73E8", "34A853", "FBBC04", "EA4335", "1F1F1F", "5F6368", "FFFFFF"],
    "primary": "1A73E8",
    "secondary": "34A853"
  },
  "fonts": {
    "allowed": ["Inter", "Source Han Sans SC", "Aptos", "Microsoft YaHei"],
    "heading": "Inter",
    "body": "Inter"
  },
  "logo": {
    "required": true,
    "placeholderNamePattern": "(?i)logo"
  },
  "footer": {
    "required": true,
    "textPattern": "(?i)(confidential|内部|©)"
  }
}
