{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateCoverSlide",
  "title": "slateCoverSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 6.8,
        "heightIn": 1.7,
        "maxLines": 2
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "abstract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 6.3,
        "heightIn": 1.25,
        "maxLines": 5
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12,
            "x-slotBudget": {
              "fontPt": 34,
              "widthIn": 1.85,
              "heightIn": 0.72,
              "maxLines": 1
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.85,
              "heightIn": 0.38,
              "maxLines": 1
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.85,
              "heightIn": 0.65,
              "maxLines": 3
            }
          }
        },
        "required": ["value", "label", "detail"],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 4
    },
    "callout": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4.9,
        "heightIn": 0.5,
        "maxLines": 2
      }
    }
  },
  "required": ["title", "label", "source", "asOf", "abstract", "metrics", "callout"],
  "additionalProperties": false
}
