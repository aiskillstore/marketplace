{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/green-slate/slateRoadmapSlide",
  "title": "slateRoadmapSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 24,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3,
        "heightIn": 0.25,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10.8,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 28,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2,
        "heightIn": 0.2,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.28,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.85,
        "heightIn": 0.38,
        "maxLines": 1
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 25,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 2.6,
        "heightIn": 0.35,
        "maxLines": 1
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 35,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 2.5,
              "heightIn": 0.5,
              "maxLines": 2
            }
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 2.5,
              "heightIn": 0.68,
              "maxLines": 3
            }
          }
        },
        "required": ["label", "duration", "gate"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 4
    },
    "tracks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 22,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 1.04,
              "heightIn": 0.75,
              "maxLines": 3
            }
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 70,
              "x-slotBudget": {
                "fontPt": 12,
                "widthIn": 2.5,
                "heightIn": 0.56,
                "maxLines": 2
              }
            },
            "minItems": 3,
            "maxItems": 4
          }
        },
        "required": ["label", "activities"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    }
  },
  "required": ["title", "label", "source", "asOf", "basis", "verdict", "unit", "phases", "tracks"],
  "additionalProperties": false
}
