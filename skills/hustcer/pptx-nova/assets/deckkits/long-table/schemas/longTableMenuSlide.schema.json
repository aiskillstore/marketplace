{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableMenuSlide",
  "title": "longTableMenuSlide data schema",
  "type": "object",
  "required": ["title", "subtitle", "items"],
  "properties": {
    "title": {
      "type": "string",
      "maxLength": 72,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 34,
        "widthIn": 11.9,
        "heightIn": 1.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.9,
        "heightIn": 0.35,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "string",
          "maxLength": 96,
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 11,
            "widthIn": 0.6,
            "heightIn": 0.6900000000000001,
            "lineHeight": 1.1,
            "maxLines": 3
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
