{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableFeaturedSlide",
  "title": "longTableFeaturedSlide data schema",
  "type": "object",
  "required": ["edition", "eyebrow", "title", "body", "pills", "details"],
  "properties": {
    "edition": {
      "type": "string",
      "maxLength": 3,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 0.44,
        "heightIn": 0.44,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "eyebrow": {
      "type": "string",
      "maxLength": 54,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 10,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "maxLength": 56,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 43,
        "widthIn": 5.7,
        "heightIn": 2.25,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "body": {
      "type": "string",
      "maxLength": 260,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 14,
        "widthIn": 5.7,
        "heightIn": 1.55,
        "lineHeight": 1.1,
        "maxLines": 5
      }
    },
    "pills": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "maxLength": 28,
        "minLength": 1,
        "pattern": "\\S",
        "x-slotBudget": {
          "fontPt": 11,
          "widthIn": 2.27,
          "heightIn": 0.45,
          "lineHeight": 1.1,
          "maxLines": 1
        }
      }
    },
    "details": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "maxLength": 72,
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 5.109999999999999,
            "heightIn": 0.25,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
