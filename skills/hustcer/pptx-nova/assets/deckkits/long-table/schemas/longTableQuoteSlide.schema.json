{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/long-table/longTableQuoteSlide",
  "title": "longTableQuoteSlide data schema",
  "type": "object",
  "required": ["label", "quote", "author", "role"],
  "properties": {
    "label": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 3.06,
        "heightIn": 0.45,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "quote": {
      "type": "string",
      "maxLength": 140,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 32,
        "widthIn": 11.2,
        "heightIn": 2.7,
        "lineHeight": 1.1,
        "maxLines": 4
      }
    },
    "author": {
      "type": "string",
      "maxLength": 36,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.1,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "role": {
      "type": "string",
      "maxLength": 72,
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.1,
        "heightIn": 0.5,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "long-table/design.json",
  "x-capacityCheck": "resolve-long-table-components/v1"
}
