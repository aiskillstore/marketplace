{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissCoverSlide",
  "title": "swissCoverSlide 2.0 data",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 64,
        "widthIn": 10.7,
        "heightIn": 1.5,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 19,
        "widthIn": 11.7,
        "heightIn": 0.7,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "tag": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.81,
        "heightIn": 0.67,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "footer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 10,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": ["eyebrow", "title", "subtitle", "tag"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
}
