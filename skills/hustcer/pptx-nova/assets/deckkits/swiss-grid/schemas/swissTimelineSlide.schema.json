{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/swiss-grid/swissTimelineSlide",
  "title": "swissTimelineSlide 2.0 data",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 12.03,
        "heightIn": 0.78,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 12.03,
        "heightIn": 0.42,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 22,
              "widthIn": 2.166,
              "heightIn": 0.6,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 2.166,
              "heightIn": 0.66,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 2.166,
              "heightIn": 1.35,
              "lineHeight": 1.1,
              "maxLines": 5
            }
          },
          "focus": {
            "type": "boolean",
            "x-slotRole": "control"
          }
        },
        "required": ["year", "title", "body"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    },
    "calloutTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.83,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "callout": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.83,
        "heightIn": 0.48,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "calloutHighlights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0,
      "maxItems": 12,
      "x-slotRole": "control",
      "x-slotProbeOmit": true
    }
  },
  "required": ["eyebrow", "title", "subtitle", "steps", "calloutTitle", "callout"],
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "swiss-grid/design.json",
  "x-capacityCheck": "resolve-swiss-components/v1"
