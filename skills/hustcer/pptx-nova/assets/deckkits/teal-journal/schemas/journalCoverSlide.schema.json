        "widthIn": 7.5,
        "heightIn": 2.6,
        "lineHeight": 1.12,
        "maxLines": 2
      },
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 13,
        "widthIn": 7.5,
        "heightIn": 0.56,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.5,
        "heightIn": 0.33,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
