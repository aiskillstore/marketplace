{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "journalJourneySlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 28,
        "widthIn": 11.73,
        "heightIn": 0.55,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 15,
        "widthIn": 11.73,
        "heightIn": 0.48,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.73,
        "heightIn": 0.28,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.65,
        "heightIn": 0.25,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "axisStart": {
      "type": "number",
      "x-slotProbeValue": 0,
      "x-slotRole": "control"
    },
    "axisEnd": {
      "type": "number",
      "x-slotProbeValue": 12,
      "x-slotRole": "control"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 3.676666666666667,
        "heightIn": 0.32,
        "lineHeight": 1.12,
        "maxLines": 1
      },
      "pattern": "\\S"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 3.5066666666666673,
              "heightIn": 0.4,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          },
          "start": {
            "type": "number",
            "x-slotProbeSequence": [0, 3, 6, 9],
            "x-slotRole": "control"
          },
          "end": {
            "type": "number",
            "x-slotProbeSequence": [2, 5, 8, 11],
            "x-slotRole": "control"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 3.676666666666667,
              "heightIn": 0.55,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          },
          "measure": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.676666666666667,
              "heightIn": 0.35,
              "lineHeight": 1.12,
              "maxLines": 1
            },
            "pattern": "\\S"
          }
        },
        "required": ["label", "start", "end", "detail", "measure"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 4
    }
  },
  "required": [
    "title",
    "subtitle",
    "eyebrow",
    "verdict",
    "source",
    "axisStart",
    "axisEnd",
    "unit",
    "steps"
  ],
  "additionalProperties": false
}
