      "accent6": "highlight",
      "hlink": "ink",
      "folHlink": "deep"
    },
    "fonts": {
      "major": "display",
      "minor": "body"
    }
  },
  "roles": {
    "surface": "paper",
    "text": "ink",
    "rule": "rule",
    "series": "ink",
    "focus": "accent"
  },
