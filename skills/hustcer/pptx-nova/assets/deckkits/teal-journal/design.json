    "palette": {
      "background": "paper",
      "text": "ink",
      "muted": "muted",
      "accent": "accent",
      "line": "rule",
      "surface": "highlight"
    },
    "fonts": {
      "display": "display",
      "body": "body",
      "cjk": "display"
    }
  },
  "rules": [
    {
      "id": "palette",
      "check": "allowed-colors"
    },
    {
      "id": "fonts",
      "check": "allowed-fonts"
    },
    {
      "id": "effects",
      "check": "forbidden-effects",
      "values": ["shadow", "glow", "reflection", "softEdge"]
    },
    {
      "id": "bounds",
      "check": "bounds"
    },
    {
      "id": "readable",
      "check": "font-floor",
      "minPt": 10.5
    },
    {
      "id": "journal-language",
      "check": "journal-language"
    }
  ],
  "journal": {
