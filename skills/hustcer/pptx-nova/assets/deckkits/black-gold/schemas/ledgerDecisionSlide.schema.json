{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerDecisionSlide",
  "title": "ledgerDecisionSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "threshold": {
            "type": "string",
            "minLength": 1,
            "maxLength": 85
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 135
          },
          "focus": {
            "type": "boolean"
          }
        },
        "required": ["observation", "threshold", "action"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "decision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "asOf",
    "unit",
    "verdict",
    "label",
    "actions",
    "decision"
  ],
  "additionalProperties": false
}
