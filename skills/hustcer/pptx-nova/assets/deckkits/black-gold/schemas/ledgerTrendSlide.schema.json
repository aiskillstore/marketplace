{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerTrendSlide",
  "title": "ledgerTrendSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 220
    },
    "chart": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["column", "line"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "minItems": 2,
          "maxItems": 8
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 8
        },
        "focus": {
          "type": "number",
          "minimum": 0
        },
        "numberFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-slotRole": "control"
        }
      },
      "required": ["kind", "name", "unit", "categories", "values"],
      "additionalProperties": false
    },
    "secondary": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["line"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 8
        },
        "numberFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-slotRole": "control"
        }
      },
      "required": ["kind", "name", "unit", "values"],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    },
    "support": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["bar", "column", "line"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "minItems": 2,
          "maxItems": 8
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 8
        },
        "numberFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "x-slotRole": "control"
        }
      },
      "required": ["kind", "name", "unit", "categories", "values"],
      "additionalProperties": false
    }
  },
  "required": ["title", "basis", "source", "asOf", "unit", "verdict", "chart", "notes"],
  "additionalProperties": false,
  "x-slotProbeVariants": [
    {
      "omit": ["support"]
    },
    {
      "omit": ["secondary"]
    }
  ]
}
