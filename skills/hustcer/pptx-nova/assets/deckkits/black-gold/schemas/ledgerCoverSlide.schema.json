{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/black-gold/ledgerCoverSlide",
  "title": "ledgerCoverSlide content",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 130
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "masthead": {
      "type": "string",
      "minLength": 1,
      "maxLength": 70
    },
    "date": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "abstract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "watermark": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8
    },
    "disclosure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 55
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          },
          "focus": {
            "type": "boolean"
          }
        },
        "required": ["value", "label", "basis"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "required": [
    "title",
    "source",
    "asOf",
    "unit",
    "masthead",
    "date",
    "abstract",
    "watermark",
    "disclosure",
    "metrics"
  ],
  "additionalProperties": false
}
