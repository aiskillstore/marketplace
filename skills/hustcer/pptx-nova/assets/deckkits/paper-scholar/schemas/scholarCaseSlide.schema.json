{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarCaseSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 7.05,
        "heightIn": 1,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 7.05,
        "heightIn": 0.36,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 6.819999999999999,
              "heightIn": 1.14,
              "lineHeight": 1.05,
              "maxLines": 3
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 6.819999999999999,
              "heightIn": 1.14,
              "lineHeight": 1.05,
              "maxLines": 3
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "assetCaption": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 3.49,
        "heightIn": 0.44,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "before": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "after": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "enum": ["%"],
      "x-slotBudget": {
        "fontPt": 30,
        "widthIn": 3.9000000000000004,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "resultLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3.9000000000000004,
        "heightIn": 0.5,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "resultNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 3.9000000000000004,
        "heightIn": 0.75,
        "lineHeight": 1.05,
        "maxLines": 3
      }
    },
    "caution": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 7.05,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "notes",
    "assetCaption",
    "before",
    "after",
    "unit",
    "resultLabel",
    "resultNote",
    "caution"
  ],
  "additionalProperties": false
}
