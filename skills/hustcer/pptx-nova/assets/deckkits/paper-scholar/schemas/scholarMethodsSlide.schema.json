          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 4.35,
              "heightIn": 1.4250000000000003,
              "lineHeight": 1.05,
              "maxLines": 6
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.13,
