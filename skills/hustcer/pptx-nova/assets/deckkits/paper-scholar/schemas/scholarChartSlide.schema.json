{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scholarChartSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 10.85,
        "heightIn": 0.65,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.7,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.6,
        "heightIn": 0.25,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "seriesName": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.3599999999999999,
        "heightIn": 0.5,
        "lineHeight": 1.05,
        "maxLines": 2
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.8,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.3599999999999999,
              "heightIn": 0.5,
              "lineHeight": 1.05,
              "maxLines": 2
            }
          },
          "value": {
            "type": "number"
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 5
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 4.119999999999999,
              "heightIn": 1.9299999999999997,
              "lineHeight": 1.05,
              "maxLines": 6
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 14,
              "widthIn": 4.119999999999999,
              "heightIn": 1.9299999999999997,
              "lineHeight": 1.05,
              "maxLines": 6
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "plotNote": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.8,
        "heightIn": 0.4,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    }
  },
  "required": ["title", "basis", "source", "seriesName", "unit", "points", "notes", "plotNote"],
  "additionalProperties": false
}
