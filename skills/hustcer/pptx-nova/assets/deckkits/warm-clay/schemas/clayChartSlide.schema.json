{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "clayChartSlide",
  "type": "object",
  "properties": {
    "section": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.45,
        "heightIn": 0.28,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 26,
        "widthIn": 11.55,
        "heightIn": 0.65,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 11.55,
        "heightIn": 0.51,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.45,
        "heightIn": 0.3,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.7,
        "heightIn": 0.26,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "seriesName": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.2,
        "heightIn": 0.28,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.2,
        "heightIn": 0.28,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.55,
              "heightIn": 0.5,
              "lineHeight": 1.15,
              "maxLines": 2
            }
          },
          "value": {
            "type": "number"
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    },
    "caption": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 6.2,
        "heightIn": 0.5,
        "lineHeight": 1.15,
        "maxLines": 2
      }
    },
    "analysisLabel": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.85,
        "heightIn": 0.28,
        "lineHeight": 1.15,
        "maxLines": 1
      }
    },
    "analysis": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4.85,
        "heightIn": 1.2,
        "lineHeight": 1.15,
        "maxLines": 4
      }
    },
    "conclusion": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 25,
            "widthIn": 4.85,
            "heightIn": 0.66,
            "lineHeight": 1.15,
            "maxLines": 1
          }
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 25,
            "widthIn": 4.85,
            "heightIn": 0.66,
            "lineHeight": 1.15,
            "maxLines": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 4.85,
            "heightIn": 0.93,
            "lineHeight": 1.15,
            "maxLines": 4
          }
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 4.85,
            "heightIn": 0.93,
            "lineHeight": 1.15,
            "maxLines": 4
          }
        },
        "focus": {
          "type": "boolean",
          "x-slotProbeOmit": true,
          "x-slotRole": "control"
        }
      },
      "required": ["value", "unit", "label", "note"],
      "additionalProperties": false
    }
  },
  "required": [
    "section",
    "title",
    "subtitle",
    "verdict",
    "source",
    "seriesName",
    "unit",
    "points",
    "caption",
    "analysisLabel",
    "analysis",
    "conclusion"
  ],
  "additionalProperties": false
}
