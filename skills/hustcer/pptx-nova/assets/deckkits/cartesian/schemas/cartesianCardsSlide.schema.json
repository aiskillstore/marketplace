{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianCardsSlide",
  "title": "cartesianCardsSlide data schema",
  "type": "object",
  "required": ["label", "title", "cards"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 12.27,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 12.27,
        "heightIn": 0.85,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["marker", "title", "body"],
        "properties": {
          "marker": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 0.42,
              "heightIn": 0.42,
              "lineHeight": 1.2,
              "maxLines": 2
            },
            "pattern": "^.{1,3}$"
          },
          "title": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 16,
              "widthIn": 3.2633333333333328,
              "heightIn": 0.6,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "body": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 3.2633333333333328,
              "heightIn": 0.7600000000000007,
              "lineHeight": 1.3,
              "maxLines": 3
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
