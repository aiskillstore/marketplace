{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianStatementSlide",
  "title": "cartesianStatementSlide data schema",
  "type": "object",
  "required": ["quote", "attribution"],
  "properties": {
    "quoteMark": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 46,
        "widthIn": 1.03,
        "heightIn": 1,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "quote": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 9.03,
        "heightIn": 1.9,
        "lineHeight": 1.2,
        "maxLines": 2
      }
    },
    "attribution": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 9.03,
        "heightIn": 0.45,
        "lineHeight": 1.2,
        "maxLines": 2
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
