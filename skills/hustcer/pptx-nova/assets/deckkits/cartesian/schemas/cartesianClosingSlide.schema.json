{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianClosingSlide",
  "title": "cartesianClosingSlide data schema",
  "type": "object",
  "required": ["label", "title", "cta", "contact"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 6.93,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 52,
        "widthIn": 8.03,
        "heightIn": 1.25,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "cta": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 6.93,
        "heightIn": 0.4,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "contact": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 6.93,
        "heightIn": 0.4,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
