{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/cartesian/cartesianTimelineSlide",
  "title": "cartesianTimelineSlide data schema",
  "type": "object",
  "required": ["label", "title", "items"],
  "properties": {
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 12.27,
        "heightIn": 0.3,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 12.27,
        "heightIn": 0.85,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["phase", "title", "body"],
        "properties": {
          "phase": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2.7675,
              "heightIn": 0.3,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "title": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 16,
              "widthIn": 2.7675,
              "heightIn": 0.36833333333333335,
              "lineHeight": 1.2,
              "maxLines": 1
            }
          },
          "body": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 2.7675,
              "heightIn": 0.8016666666666667,
              "lineHeight": 1.3,
              "maxLines": 3
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "cartesian/design.json",
  "x-capacityCheck": "resolve-cartesian-components/v1"
}
