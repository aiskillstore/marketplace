{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkCoverSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Short pink hero, ideally one word.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "continuation": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Paper-blush hanging continuation.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "metadata": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metadata label.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metadata value.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          }
        },
        "required": ["label", "value"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 4
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "continuation", "metadata"],
  "additionalProperties": false
}
