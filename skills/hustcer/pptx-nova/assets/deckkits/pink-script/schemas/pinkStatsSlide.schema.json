{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkStatsSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Editorial assertion; explicit line breaks preserved.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "intro": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Interpretation and synthetic/real evidence disclosure.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "stats": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Explicit unit or suffix, painted smaller than value.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metric label.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Metric context.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          }
        },
        "required": ["value", "unit", "label", "description"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 5
      }
    }
  },
  "required": ["brand", "section", "kicker", "source", "title", "intro", "stats"],
  "additionalProperties": false
}
