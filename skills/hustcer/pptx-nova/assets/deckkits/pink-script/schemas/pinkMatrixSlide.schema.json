{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pinkMatrixSlide",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-left brand; no business default.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Top-right section metadata.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "kicker": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Pink editorial eyebrow.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible source, assumptions and/or date from content.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Comparison title.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "columns": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Column header.",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 4,
              "heightIn": 0.8,
              "lineHeight": 1.12,
              "maxLines": 3
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          }
        },
        "required": ["label", "weight"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 4
      }
    },
    "rows": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 4,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Native cell text. One paragraph; wraps automatically.",
          "x-slotBudget": {
            "fontPt": 12,
            "widthIn": 4,
            "heightIn": 0.8,
            "lineHeight": 1.12,
            "maxLines": 3
          }
        },
        "x-slotBudget": {
          "maxItems": 4
        }
      },
      "x-slotBudget": {
        "maxItems": 5
      }
    },
    "focusColumn": {
      "type": "number",
      "minimum": 0,
      "x-slotProbeValue": 1,
      "x-slotRole": "control"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Visible methodology or scope note.",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 4,
        "heightIn": 0.8,
        "lineHeight": 1.12,
        "maxLines": 3
      }
    },
    "statuses": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "row": {
            "type": "number",
            "minimum": 0,
            "x-slotProbeSequence": [0, 1, 2, 3, 4, 0],
            "x-slotRole": "control"
          },
          "column": {
            "type": "number",
            "minimum": 0,
            "x-slotRole": "control",
            "x-slotProbeSequence": [0, 0, 0, 0, 0, 1]
          },
          "state": {
            "type": "string",
            "enum": ["solid", "outline", "dim"],
            "x-slotRole": "control"
          }
        },
        "required": ["row", "column", "state"],
        "additionalProperties": false
      },
      "x-slotBudget": {
        "maxItems": 6
      }
    }
  },
  "required": [
    "brand",
    "section",
    "kicker",
    "source",
    "title",
    "columns",
    "rows",
    "focusColumn",
    "note"
  ],
  "additionalProperties": false
}
