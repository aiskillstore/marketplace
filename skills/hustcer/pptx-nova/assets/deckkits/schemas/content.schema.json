{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-content/v1",
  "title": "pptx-nova content manifest",
  "type": "object",
  "required": ["meta", "slides"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["deckkit"],
      "properties": {
        "deckkit": {
          "type": "string"
        },
        "deckProfile": {
          "type": "string",
          "enum": ["animation-corpus"]
        },
        "animationCases": {
          "type": "array",
          "minItems": 1,
          "description": "Corpus cases require id, kind, visible feature and expectedPlayback, 0-based slides, and effect or morphMode. The composed patch must contain each declared effect and explicit adjacent Morph pair.",
          "items": {
            "type": "object",
            "required": ["id", "kind", "feature", "expectedPlayback", "slides"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": ["animation", "morph", "transition"]
              },
              "feature": {
                "type": "string",
                "minLength": 1
              },
              "expectedPlayback": {
                "type": "string",
                "minLength": 1
              },
              "slides": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "multipleOf": 1
                }
              },
              "effect": {
                "type": "string",
                "minLength": 1
              },
              "morphMode": {
                "type": "string",
                "enum": ["by-object", "by-word", "by-char"]
              }
            },
            "additionalProperties": false
          }
        },
        "style": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "footerLeft": {
          "type": "string"
        },
        "designScope": {
          "type": "string",
          "enum": ["complete", "excerpt"]
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "data"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "heroSlide",
              "profileTableSlide",
              "kpiRowSlide",
              "previewProductSlide",
              "multiCardSlide",
              "landscapeSlide",
              "convertFlowSlide",
              "benchmarkSlide",
              "timelineSlide",
              "askSlide",
              "mckCoverSlide",
              "mckCrisisSnapshotSlide",
              "mckDemographicProfileSlide",
              "mckPriorityMatrixSlide",
              "mckLossDriverSlide",
              "mckPillarsSlide",
              "mckInitiativeRankingSlide",
              "mckRoadmapSlide",
