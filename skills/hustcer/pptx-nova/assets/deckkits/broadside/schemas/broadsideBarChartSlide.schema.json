{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "broadsideBarChartSlide data",
  "type": "object",
  "required": ["title", "bars", "unit", "source", "seriesName"],
  "properties": {
    "section": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.7,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "page": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.7,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 32,
        "widthIn": 11.87,
        "heightIn": 0.95,
        "lineHeight": 1.05,
        "maxLines": 1
      }
    },
    "caption": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.87,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "bars": {
      "type": "array",
      "description": "If any bar sets accent=true, only explicitly marked bars are accented; otherwise the final bar is accented by default.",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": {
            "type": "string",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 1.8283333333333334,
              "heightIn": 0.55,
              "lineHeight": 1.2,
              "maxLines": 2
            }
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "accent": {
            "type": "boolean",
            "description": "Explicitly accent this bar; explicit accents disable the default final-bar accent.",
            "x-slotRole": "control"
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.87,
        "heightIn": 0.42,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "footerLeft": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 7.3,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "footerRight": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 4.35,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 11.87,
        "heightIn": 0.4,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "seriesName": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 11,
        "widthIn": 6,
        "heightIn": 0.4,
        "lineHeight": 1.2,
        "maxLines": 1
      }
    },
    "numberFormat": {
      "type": "string",
      "minLength": 1,
      "x-slotRole": "control"
    }
  },
  "additionalProperties": false,
  "$id": "pptx-nova-slide/broadside/broadsideBarChartSlide",
  "x-generatedBudgetsFrom": "broadside/design.json",
  "x-capacityCheck": "resolve-broadside-components/v1"
}
