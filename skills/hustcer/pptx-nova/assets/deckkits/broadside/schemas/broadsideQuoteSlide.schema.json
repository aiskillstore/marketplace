        "widthIn": 10.5,
        "heightIn": 2.7,
        "lineHeight": 1.15,
        "maxLines": 4
      }
    },
    "author": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10,
        "heightIn": 0.35,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 11.87,
        "heightIn": 0.5,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    }
  },
  "additionalProperties": false,
  "$id": "pptx-nova-slide/broadside/broadsideQuoteSlide",
  "x-generatedBudgetsFrom": "broadside/design.json",
