{
  "schemaVersion": "pptx-nova-design/v1",
  "id": "consulting-dark",
  "version": "2.1.0",
  "canvas": {
    "widthIn": 13.333,
    "heightIn": 7.5
  },
  "colors": {
    "paper": "F6F4EE",
    "white": "FFFDF9",
    "ink": "102B3A",
    "secondary": "52626A",
    "muted": "63747C",
    "navy": "102B3A",
    "deep": "1B3948",
    "primary": "B34F32",
    "warm": "EBAD87",
    "teal": "316E74",
    "rule": "C8CFCC",
    "darkRule": "4A6270",
    "pale": "D9E2E4",
    "sand": "E7E0D5",
    "mist": "DFE9E5",
    "copperTint": "F0E0D5",
    "primaryInk": "98432C",
    "tealLight": "9BC7C6"
  },
  "fonts": {
    "body": {
      "latin": "Arial",
      "eastAsian": "Arial Unicode MS"
    },
    "display": {
      "latin": "Arial",
      "eastAsian": "Arial Unicode MS"
    }
  },
  "textFrame": {
    "marginLeft": "0.02in",
    "marginRight": "0.02in",
    "marginTop": "0in",
    "marginBottom": "0in"
  },
  "theme": {
    "colors": {
      "lt1": "paper",
      "dk1": "ink",
      "lt2": "pale",
      "dk2": "deep",
      "accent1": "primary",
      "accent2": "teal",
      "accent3": "secondary",
      "accent4": "warm",
      "accent5": "muted",
      "accent6": "rule",
      "hlink": "teal",
      "folHlink": "primary"
    },
    "fonts": {
      "major": "display",
      "minor": "body"
    }
  },
  "roles": {
    "surface": "navy",
    "text": "paper",
    "rule": "darkRule",
    "series": "warm",
    "focus": "warm"
  },
  "refurbish": {
    "palette": {
      "background": "navy",
      "text": "paper",
      "muted": "pale",
      "accent": "warm",
      "line": "darkRule",
      "surface": "deep"
    },
    "fonts": {
      "display": "display",
      "body": "body",
      "cjk": "body"
    }
  },
  "rules": [
    {
      "id": "palette",
      "check": "allowed-colors"
    },
    {
      "id": "fonts",
      "check": "allowed-fonts"
    },
    {
      "id": "effects",
      "check": "forbidden-effects",
      "values": ["shadow", "glow", "reflection", "softEdge"]
    },
    {
      "id": "bounds",
      "check": "bounds"
    },
    {
      "id": "readable",
      "check": "font-floor",
      "minPt": 10
    },
    {
      "id": "consulting-language",
      "check": "consulting-language"
    }
  ],
  "consulting": {
    "family": "consulting-editorial/v1",
    "styles": {
      "hero": {
        "role": "body",
        "sizePt": 44,
        "color": "paper",
        "bold": true,
        "lineHeight": 1.1
      },
      "title": {
        "role": "body",
        "sizePt": 28,
        "color": "paper",
        "bold": true,
        "lineHeight": 1.1
      },
      "subtitle": {
        "role": "body",
        "sizePt": 18,
        "color": "pale",
        "bold": false,
        "lineHeight": 1.1
      },
      "heading": {
        "role": "body",
        "sizePt": 17,
        "color": "paper",
        "bold": true,
        "lineHeight": 1.1
      },
      "body": {
        "role": "body",
        "sizePt": 13,
        "color": "paper",
        "bold": false,
        "lineHeight": 1.1
      },
      "small": {
        "role": "body",
        "sizePt": 11.5,
        "color": "pale",
        "bold": false,
        "lineHeight": 1.1
      },
      "label": {
        "role": "body",
        "sizePt": 11,
        "color": "warm",
        "bold": true,
        "lineHeight": 1.1
      },
      "source": {
        "role": "body",
        "sizePt": 10,
        "color": "pale",
        "bold": false,
        "lineHeight": 1.1
      },
      "metric": {
        "role": "body",
        "sizePt": 40,
        "color": "warm",
        "bold": true,
        "lineHeight": 1.1
      },
      "index": {
        "role": "body",
        "sizePt": 25,
        "color": "warm",
        "bold": false,
        "lineHeight": 1.1
      },
      "compactMetric": {
        "role": "body",
        "sizePt": 28,
        "color": "warm",
        "bold": true,
        "lineHeight": 1.1
      },
      "reading": {
        "role": "body",
        "sizePt": 13,
        "color": "pale",
        "bold": false,
        "lineHeight": 1.1
      },
      "proofMetric": {
        "role": "body",
        "sizePt": 34,
        "color": "warm",
        "bold": true,
        "lineHeight": 1.1
      }
    },
