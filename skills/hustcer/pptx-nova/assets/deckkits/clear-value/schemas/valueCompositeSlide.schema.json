{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "valueCompositeSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 2,
        "lineHeight": 1.32
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.33,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 8,
        "heightIn": 0.22,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2.5,
        "heightIn": 0.22,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.4,
        "maxLines": 2,
        "lineHeight": 1.32
      }
    },
    "tableName": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.3,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.5,
              "heightIn": 0.5,
              "maxLines": 2,
              "lineHeight": 1.32
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          },
          "align": {
            "type": "string",
            "enum": ["left", "right", "center"],
            "x-slotRole": "control"
          }
        },
        "required": ["heading", "weight", "align"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 7
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "x-slotBudget": {
                    "fontPt": 12,
                    "widthIn": 2,
                    "heightIn": 0.6,
                    "maxLines": 2,
                    "lineHeight": 1.32
                  }
                },
                "tone": {
                  "type": "string",
                  "enum": ["normal", "positive", "negative"],
                  "x-slotRole": "control"
                }
              },
              "required": ["text", "tone"],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 7
          }
        },
        "required": ["cells"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 7
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.32,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 0.52,
              "heightIn": 0.27,
              "maxLines": 1,
              "lineHeight": 1.32
            }
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 15,
              "widthIn": 3.9,
              "heightIn": 0.38,
              "maxLines": 1,
              "lineHeight": 1.32
            }
          },
          "basis": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 4.5,
              "heightIn": 0.25,
              "maxLines": 1,
              "lineHeight": 1.32
            }
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10,
              "widthIn": 2,
              "heightIn": 0.25,
              "maxLines": 1,
              "lineHeight": 1.32
            }
          },
          "kind": {
            "type": "string",
            "enum": ["bar", "column", "line", "donut", "circles"],
            "x-slotRole": "control"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "x-slotBudget": {
                "fontPt": 10.5,
                "widthIn": 1.7,
                "heightIn": 0.45,
                "maxLines": 2,
                "lineHeight": 1.32
              }
            },
            "minItems": 2,
            "maxItems": 8
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "x-slotBudget": {
                    "fontPt": 10,
                    "widthIn": 3,
                    "heightIn": 0.2,
                    "maxLines": 1,
                    "lineHeight": 1.32
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "x-slotRole": "control"
                  },
                  "minItems": 2,
                  "maxItems": 8
                },
                "tone": {
                  "enum": ["current", "secondary", "history", "negative"],
                  "type": "string",
                  "x-slotRole": "control"
                }
              },
              "required": ["name", "values", "tone"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 4
          },
          "focus": {
            "type": "number",
            "minimum": 0,
            "maximum": 7,
            "x-slotRole": "control",
            "x-slotProbeOmit": true
          },
          "variant": {
            "type": "string",
            "enum": ["stacked"],
            "x-slotRole": "control",
            "x-slotProbeOmit": true
          },
          "forecastFrom": {
            "type": "number",
            "minimum": 1,
            "maximum": 6,
            "x-slotRole": "control",
            "x-slotProbeOmit": true
          },
          "numberFormat": {
            "type": "string",
            "minLength": 1,
            "x-slotRole": "control",
            "x-slotProbeOmit": true
          }
        },
        "required": ["label", "name", "basis", "unit", "kind", "categories", "series"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "asOf",
    "verdict",
    "tableName",
    "columns",
    "rows",
    "note",
    "charts"
  ],
  "additionalProperties": false
}
