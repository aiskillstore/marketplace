{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "valueTimelineSlide",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 25,
        "widthIn": 12.03,
        "heightIn": 0.8,
        "maxLines": 2,
        "lineHeight": 1.32
      }
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.33,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 8,
        "heightIn": 0.22,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "asOf": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 2.5,
        "heightIn": 0.22,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.4,
        "maxLines": 2,
        "lineHeight": 1.32
      }
    },
    "tableName": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.3,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.5,
              "heightIn": 0.5,
              "maxLines": 2,
              "lineHeight": 1.32
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          },
          "align": {
            "type": "string",
            "enum": ["left", "right", "center"],
            "x-slotRole": "control"
          }
        },
        "required": ["heading", "weight", "align"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 7
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "x-slotBudget": {
                    "fontPt": 12,
                    "widthIn": 2,
                    "heightIn": 0.6,
                    "maxLines": 2,
                    "lineHeight": 1.32
                  }
                },
                "tone": {
                  "type": "string",
                  "enum": ["normal", "positive", "negative"],
                  "x-slotRole": "control"
                }
              },
              "required": ["text", "tone"],
              "additionalProperties": false
            },
            "minItems": 2,
            "maxItems": 7
          }
        },
        "required": ["cells"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 7
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.03,
        "heightIn": 0.32,
        "maxLines": 1,
        "lineHeight": 1.32
      }
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3,
              "heightIn": 0.33,
              "maxLines": 1,
              "lineHeight": 1.32
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 3,
              "heightIn": 0.4,
              "maxLines": 2,
              "lineHeight": 1.32
            }
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          }
        },
        "required": ["label", "detail", "duration"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 4
    }
  },
  "required": [
    "title",
    "basis",
    "source",
    "asOf",
    "verdict",
    "tableName",
    "columns",
    "rows",
    "note",
    "phases"
  ],
  "additionalProperties": false
}
