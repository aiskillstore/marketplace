{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleCalendarSlide",
  "title": "biennaleCalendarSlide data schema",
  "type": "object",
  "required": ["title", "label", "columns", "rows"],
  "properties": {
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 36,
        "widthIn": 8,
        "heightIn": 0.74,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "label": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 4,
        "heightIn": 0.55,
        "lineHeight": 1.18,
        "maxLines": 3
      }
    },
    "columns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["date", "title", "venue", "length"],
        "properties": {
          "date": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "length": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
