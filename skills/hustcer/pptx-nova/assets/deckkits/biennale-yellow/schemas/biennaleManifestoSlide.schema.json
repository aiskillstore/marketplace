{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleManifestoSlide",
  "title": "biennaleManifestoSlide data schema",
  "type": "object",
  "required": ["quote", "attribution"],
  "properties": {
    "quote": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 52,
        "widthIn": 11.65,
        "heightIn": 4.2,
        "lineHeight": 1.18,
        "maxLines": 4
      }
    },
    "attribution": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 11,
        "heightIn": 0.32,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
