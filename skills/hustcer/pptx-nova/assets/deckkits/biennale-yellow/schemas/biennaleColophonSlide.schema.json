{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleColophonSlide",
  "title": "biennaleColophonSlide data schema",
  "type": "object",
  "required": ["kicker", "title", "footerItems"],
  "properties": {
    "kicker": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 9,
        "heightIn": 0.25,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 72,
        "widthIn": 8.2,
        "heightIn": 4.7,
        "lineHeight": 1.08,
        "maxLines": 4
      }
    },
    "footerItems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
