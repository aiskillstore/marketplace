{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pptx-nova-slide/biennale-yellow/biennaleCoverSlide",
  "title": "biennaleCoverSlide data schema",
  "type": "object",
  "required": ["dateRange", "title", "subline", "footerItems"],
  "properties": {
    "dateRange": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 40,
        "widthIn": 3.1,
        "heightIn": 1.65,
        "lineHeight": 1.08,
        "maxLines": 2
      }
    },
    "title": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 84,
        "widthIn": 7.8,
        "heightIn": 3.35,
        "lineHeight": 1.06,
        "maxLines": 2
      }
    },
    "subline": {
      "type": "string",
      "x-slotBudget": {
        "fontPt": 10,
        "widthIn": 8,
        "heightIn": 0.26,
        "lineHeight": 1.18,
        "maxLines": 1
      }
    },
    "footerItems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["label", "text"],
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "x-generatedBudgetsFrom": "biennale-yellow/design.json",
  "x-capacityCheck": "resolve-biennale-components/v1"
}
