{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.38,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 22,
        "widthIn": 12.13,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.9,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "synthesisLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.45,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.5,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 11,
              "widthIn": 2.06,
              "heightIn": 0.6725,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "x-slotRole": "control"
          },
          "align": {
            "type": "string",
            "enum": ["left", "center", "right"],
            "x-slotRole": "control"
          }
        },
        "required": ["label", "weight", "align"],
        "additionalProperties": false
      },
      "minItems": 4,
      "maxItems": 6
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "x-slotBudget": {
                    "fontPt": 11,
                    "widthIn": 2.06,
                    "heightIn": 0.6725,
                    "lineHeight": 1.1,
                    "maxLines": 2
                  }
                },
                "tone": {
                  "type": "string",
                  "enum": ["paper", "pale", "history", "deep"],
                  "x-slotRole": "control"
                }
              },
              "required": ["text", "tone"],
              "additionalProperties": false
            },
            "minItems": 4,
            "maxItems": 6
          }
        },
        "required": ["cells"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 6
    },
    "methodology": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.88,
        "heightIn": 0.45,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 2.83,
        "heightIn": 2.5999999999999996,
        "lineHeight": 1.1,
        "maxLines": 10
      }
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.83,
        "heightIn": 0.34,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "reportTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": [
    "eyebrow",
    "title",
    "subtitle",
    "period",
    "source",
    "synthesisLabel",
    "verdict",
    "columns",
    "rows",
    "methodology",
    "excerpt",
    "attribution",
    "reportTitle"
  ],
  "additionalProperties": false
}
