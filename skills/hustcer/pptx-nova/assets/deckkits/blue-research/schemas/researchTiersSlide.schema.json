        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 3
    },
    "reportTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
