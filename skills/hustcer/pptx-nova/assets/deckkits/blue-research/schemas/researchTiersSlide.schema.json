        "widthIn": 2.38,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
