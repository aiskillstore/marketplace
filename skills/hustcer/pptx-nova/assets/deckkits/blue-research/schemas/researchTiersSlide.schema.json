              "maxLines": 2
            }
          },
          "tone": {
            "type": "string",
            "enum": ["paper", "pale", "history", "deep"],
            "x-slotRole": "control"
          }
        },
        "required": ["label", "value", "secondary", "tertiary", "tone"],
        "additionalProperties": false
