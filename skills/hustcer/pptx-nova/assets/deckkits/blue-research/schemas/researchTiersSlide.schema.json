        "widthIn": 12.13,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.9,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "synthesisLabel": {
      "type": "string",
