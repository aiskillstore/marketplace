              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.43,
              "heightIn": 0.7233333333333332,
              "lineHeight": 1.1,
              "maxLines": 2
            }
