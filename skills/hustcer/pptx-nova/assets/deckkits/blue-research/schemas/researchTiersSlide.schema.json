  "required": [
    "eyebrow",
    "title",
    "subtitle",
    "period",
    "source",
    "synthesisLabel",
    "verdict",
    "headers",
    "unit",
    "rows",
    "methodology",
    "notes",
    "reportTitle"
  ],
  "additionalProperties": false
}
