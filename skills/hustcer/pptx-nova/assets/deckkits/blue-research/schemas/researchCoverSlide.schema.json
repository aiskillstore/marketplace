{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.8,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 42,
        "widthIn": 8.8,
        "heightIn": 1.85,
        "lineHeight": 1.18,
        "maxLines": 2
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 12,
        "widthIn": 9.1,
        "heightIn": 0.75,
        "lineHeight": 1.1,
        "maxLines": 2
      }
    },
    "edition": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 38,
        "widthIn": 1.6,
        "heightIn": 0.8,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.38,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 8.5,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "masthead": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
