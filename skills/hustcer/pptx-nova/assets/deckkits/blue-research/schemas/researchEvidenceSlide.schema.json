{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.38,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 22,
        "widthIn": 12.13,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.9,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "synthesisLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.45,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.5,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "chart": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["column", "line", "stacked"],
          "x-slotRole": "control",
          "x-slotProbeValue": "stacked"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 13,
            "widthIn": 5.25,
            "heightIn": 0.45,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        },
        "phaseLabel": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 7.9,
            "heightIn": 0.27,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 1.3166666666666667,
              "heightIn": 0.5,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "minItems": 3,
          "maxItems": 6
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "x-slotBudget": {
                  "fontPt": 13,
                  "widthIn": 5.25,
                  "heightIn": 0.45,
                  "lineHeight": 1.1,
                  "maxLines": 1
                }
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 6
              }
            },
            "required": ["name", "values"],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 2
        },
        "forecastFrom": {
          "type": "number",
          "minimum": 0,
          "x-slotRole": "control",
          "x-slotProbeOmit": true
        }
      },
      "required": ["kind", "unit", "phaseLabel", "categories", "series"],
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 13,
              "widthIn": 3.78,
              "heightIn": 0.34,
              "lineHeight": 1.1,
              "maxLines": 1
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 3.78,
              "heightIn": 1.345,
              "lineHeight": 1.1,
              "maxLines": 5
            }
          }
        },
        "required": ["heading", "body"],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 3
    },
    "metric": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 2.45,
            "heightIn": 0.4,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "x-slotBudget": {
            "fontPt": 10.5,
            "widthIn": 2.45,
            "heightIn": 0.4,
            "lineHeight": 1.1,
            "maxLines": 1
          }
        }
      },
      "required": ["value", "label"],
      "additionalProperties": false
    },
    "reportTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": [
    "eyebrow",
    "title",
    "subtitle",
    "period",
    "source",
    "synthesisLabel",
    "verdict",
    "chart",
    "notes",
    "metric",
    "reportTitle"
  ],
  "additionalProperties": false
}
