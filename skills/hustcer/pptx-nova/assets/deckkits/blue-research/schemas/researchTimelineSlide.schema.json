{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "eyebrow": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 2.38,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 22,
        "widthIn": 12.13,
        "heightIn": 0.85,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "subtitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 12.13,
        "heightIn": 0.32,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.9,
        "heightIn": 0.25,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "synthesisLabel": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.45,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 10.5,
        "heightIn": 0.27,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "start": {
      "type": "number",
      "x-slotProbeValue": 0
    },
    "end": {
      "type": "number",
      "x-slotProbeValue": 12
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 1.2,
        "heightIn": 0.4,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 13,
              "widthIn": 0.8074999999999998,
              "heightIn": 0.75,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 12,
              "widthIn": 0.8074999999999998,
              "heightIn": 0.75,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "gate": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "x-slotBudget": {
              "fontPt": 10.5,
              "widthIn": 0.8074999999999998,
              "heightIn": 0.55,
              "lineHeight": 1.1,
              "maxLines": 2
            }
          },
          "elapsed": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": ["elapsed", "label", "body", "gate"],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 4
    },
    "reportTitle": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "x-slotBudget": {
        "fontPt": 10.5,
        "widthIn": 9.5,
        "heightIn": 0.3,
        "lineHeight": 1.1,
        "maxLines": 1
      }
    }
  },
  "required": [
    "eyebrow",
    "title",
    "subtitle",
    "period",
    "source",
    "synthesisLabel",
    "verdict",
    "start",
    "end",
    "unit",
    "events",
    "reportTitle"
  ],
  "additionalProperties": false
}
