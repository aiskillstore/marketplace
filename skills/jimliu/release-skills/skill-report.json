      },
      {
        "title": "Maintain Bilingual Changelogs",
        "description": "A documentation owner can keep English and Chinese changelog entries aligned for each release.",
        "target_user": "Documentation owner"
      },
      {
        "title": "Preview Release Impact",
        "description": "A developer can run dry-run mode to review version, changelog, README, and file changes first.",
        "target_user": "Feature developer"
      }
    ],
    "prompt_templates": [
