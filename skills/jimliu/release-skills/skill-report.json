    "user_title": "Automate Baoyu Skill Releases",
    "value_statement": "Manual releases can miss changelog, README, version, commit, or tag steps. This skill guides Claude, Codex, and Claude Code through a consistent local release workflow.",
    "seo_keywords": [
      "Claude release skill",
      "Codex release automation",
      "Claude Code changelog workflow",
      "baoyu-skills release",
      "AI release checklist",
      "marketplace version bump",
      "git tag automation",
      "bilingual changelog",
      "skill publishing workflow"
    ],
    "actual_capabilities": [
      "Analyzes Git changes since the latest version tag.",
      "Categorizes commits into features, fixes, documentation, and maintenance work.",
      "Chooses patch, minor, or major version bumps from release rules.",
      "Updates English and Chinese changelog entries.",
      "Updates the marketplace version metadata for a new release.",
      "Creates a local release commit and version tag when executed."
    ],
    "limitations": [
      "It does not push commits or tags to a remote repository.",
      "It assumes the project uses Git tags and the documented file paths.",
      "Generated release notes still need maintainer review before publishing.",
      "The pre-release option is documented as reserved, not implemented."
    ],
    "use_cases": [
      {
        "title": "Prepare a Plugin Release",
        "description": "Maintainers can produce a complete local release with changelogs, version metadata, commit, and tag.",
        "target_user": "Plugin maintainer"
      },
      {
        "title": "Keep Bilingual Documentation Synced",
        "description": "Documentation owners can update English and Chinese release notes with matching structure and scope.",
        "target_user": "Documentation lead"
      },
      {
        "title": "Preview Release Impact",
        "description": "Release managers can run a dry-run review before any files, commits, or tags are changed.",
        "target_user": "Release manager"
      }
    ],
    "prompt_templates": [
      {
