        "prompt": "Run the release workflow in dry-run mode and show the proposed version bump, changelog entries, README updates, and files affected."
      },
      {
        "title": "Prepare a Patch Release",
        "scenario": "Routine maintenance release",
        "prompt": "Prepare a patch release from the current repository changes. Update changelogs and version metadata, then create the local release commit and tag."
      },
      {
        "title": "Force a Minor Release",
