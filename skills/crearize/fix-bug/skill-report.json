    "user_title": "Fix Bugs With Structured Triage",
    "value_statement": "Debugging across backend and frontend can lose context and miss regression tests. This skill guides root cause analysis, minimal fixes, validation, and pull request handoff.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "bug fix workflow",
      "debugging skill",
      "regression testing",
      "root cause analysis",
      "QA checklist",
      "pull request automation",
      "frontend backend debugging"
    ],
    "actual_capabilities": [
      "Checks bug details, issue numbers, target areas, and suspected files before changing code.",
      "Searches logs, source files, and existing tests for likely root causes.",
      "Produces a root cause report with impact, fix plan, and test plan.",
      "Guides minimal backend and frontend fixes with focused regression tests.",
      "Uses review, QA, and pull request handoff steps after implementation.",
      "Documents completion with cause, fix, tests, quality checks, and next steps."
    ],
    "limitations": [
      "It depends on project-specific commands, paths, and companion skills being available.",
      "It cannot prove a root cause without relevant logs, reproduction details, or failing tests.",
      "It does not replace human review for complex architecture or product decisions.",
      "Server startup and test commands may need local credentials or environment setup."
    ],
    "use_cases": [
      {
        "title": "Backend regression fix",
        "description": "Trace a failing backend path, add missing validation, create regression tests, and prepare a concise pull request summary.",
        "target_user": "Backend developer"
      },
      {
        "title": "Frontend behavior bug",
        "description": "Investigate component behavior, isolate the UI cause, apply a small fix, and verify the problem no longer appears.",
        "target_user": "Frontend developer"
      },
      {
        "title": "Release triage workflow",
        "description": "Coordinate bug investigation, quality checks, and handoff notes when a release issue needs a controlled fix.",
        "target_user": "Tech lead"
      }
    ],
    "prompt_templates": [
      {
        "title": "Fix a reported bug",
        "scenario": "Beginner workflow for a clear bug report.",
        "prompt": "Use fix-bug for this issue: [bug description]. Issue number: [number]. Target area: [backend, frontend, or both]."
      },
      {
        "title": "Investigate suspected files",
        "scenario": "Focused triage when likely files are known.",
        "prompt": "Use fix-bug with suspected files [file list]. Confirm the root cause before making the smallest safe change."
      },
      {
        "title": "Add regression coverage",
        "scenario": "Repair a bug and prevent recurrence.",
        "prompt": "Use fix-bug to reproduce this bug, implement the fix, and add regression tests for the failing path and edge cases."
      },
      {
        "title": "Complete release-ready fix",
        "scenario": "Advanced workflow with QA and pull request handoff.",
        "prompt": "Use fix-bug end to end. Include root cause, impact, tests, QA results, review notes, and the pull request summary."
      }
    ],
    "output_examples": [
      {
        "input": "A null user identifier causes a server error during profile lookup.",
        "output": "A root cause report, a minimal validation fix, focused regression tests, QA results, and a pull request summary."
      },
      {
        "input": "A frontend component logs an error after the user leaves the page.",
        "output": "An investigation summary, a lifecycle-safe state update fix, a component test, and verification notes."
      },
      {
        "input": "A release blocker affects both API behavior and screen rendering.",
        "output": "A coordinated backend and frontend fix plan with impact notes, test coverage, quality checks, and reviewer handoff."
      }
    ],
    "best_practices": [
      "Provide the bug description, target area, issue number, and any suspected files at the start.",
      "Ask for the root cause report before approving code changes in high-impact areas.",
