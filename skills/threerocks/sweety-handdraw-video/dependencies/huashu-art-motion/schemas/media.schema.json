{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "preferences": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "unconfigured",
                "off",
                "provided",
                "system",
                "clone"
              ]
            },
            "provider": {
              "type": "string",
              "enum": [
                "volcengine"
              ]
            },
            "voice_ref": {
              "type": "string"
            },
            "system_voice": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "unconfigured",
                "off",
                "existing",
                "generate"
              ]
            },
            "provider": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "properties": {
        "cloud": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "paid_api": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "voice_training": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "image_generation": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "reference_upload": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        },
        "unknown_image_cost": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "deny"
          ]
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "voice": {
          "type": "string",
          "enum": [
            "ask",
            "manual"
          ]
        },
        "image": {
          "type": "string",
          "enum": [
            "ask",
            "manual"
          ]
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "volcengine": {
          "type": "object",
          "properties": {
            "appid_env": {
              "type": "string",
              "pattern": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "token_env": {
              "type": "string",
              "pattern": "[A-Za-z_][A-Za-z0-9_]*"
            },
            "env_file": {
              "type": "string"
            },
            "registry_file": {
              "type": "string"
            },
            "trust_env": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "voices": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "type": "object",
            "properties": {
              "speaker_id": {
                "type": "string",
                "pattern": "S_[A-Za-z0-9_-]+"
              },
              "registry_file": {
                "type": "string"
              },
              "entry": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "provider_options": {
      "type": "object",
      "properties": {
        "volcengine": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string",
              "enum": [
                "seed-tts-2.0-expressive",
                "seed-tts-2.0-standard"
              ]
            },
            "speech_rate": {
              "type": "integer",
              "minimum": -50,
              "maximum": 100
            },
            "tone_fidelity": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Huashu media configuration"
}
