      },
      {
        "title": "Design a Preprocessing Workflow",
        "prompt": "Design a preprocessing workflow for [data type] using [smoothing method], centroiding, normalization, and filtering. Preserve the original experiment and explain parameter choices.",
        "scenario": "Intermediate signal processing for instrument data"
      },
      {
        "title": "Build an Identification Pipeline",
        "prompt": "Build a peptide identification workflow for [mzML path] and [FASTA path]. Include search parameters, FDR filtering at [threshold], protein inference, and idXML output.",
        "scenario": "Advanced proteomics identification and validation"
      },
      {
        "title": "Plan a Metabolomics Study",
        "prompt": "Plan a multi-sample metabolomics workflow for [input files]. Include feature detection, alignment, linking, blank filtering, normalization, missing-value handling, annotation, and table export.",
        "scenario": "Advanced cohort processing and quantitative analysis"
      }
    ],
    "output_examples": [
      {
        "input": "Inspect an mzML file and summarize its structure.",
        "output": [
          "File summary: spectra and chromatogram counts, MS-level distribution, retention-time range, and peak-count statistics.",
          "Quality notes: empty spectra, unsorted peaks, and missing metadata are identified for review."
        ]
      },
      {
        "input": "Recommend feature detection settings for centroided metabolomics data.",
        "output": [
          "Workflow: configure mass-trace detection, elution-peak detection, feature finding, and consensus linking.",
          "Parameter guidance: start from documented defaults, then tune mass tolerance, noise threshold, and retention-time windows using quality-control samples."
        ]
      },
      {
        "input": "Describe a peptide identification quality-control workflow.",
        "output": [
          "Load identification results, inspect score direction, calculate q-values, and filter at the requested FDR threshold.",
          "Retain unmodified source results, document search settings, and verify decoy strategy before protein inference."
        ]
      }
    ],
    "best_practices": [
      "Preserve original experiments and write processed data to separate outputs with recorded parameters.",
      "Tune algorithm parameters with representative standards and quality-control samples before processing a full cohort.",
      "Validate file formats, score direction, FDR assumptions, and metadata before interpreting biological results."
