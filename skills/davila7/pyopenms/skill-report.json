    "user_title": "Analyze Mass Spectrometry Data with PyOpenMS",
    "value_statement": "Mass spectrometry workflows require careful handling of complex formats, algorithms, and parameters. This skill guides PyOpenMS analysis for proteomics, metabolomics, signal processing, identification, and quantitation.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "PyOpenMS",
      "OpenMS",
      "mass spectrometry",
      "proteomics",
      "metabolomics",
      "LC-MS/MS",
      "Python data analysis"
    ],
    "actual_capabilities": [
      "Guides reading and writing mzML, mzXML, mzTab, FASTA, idXML, featureXML, consensusXML, and related formats.",
      "Explains spectral smoothing, filtering, centroiding, normalization, calibration, alignment, and deconvolution with PyOpenMS algorithms.",
      "Builds feature detection, linking, filtering, annotation, and quantitative analysis workflows.",
      "Supports peptide and protein identification workflows with search metadata, FDR filtering, inference, and sequence handling.",
      "Shows metabolomics preprocessing, quality control, compound annotation, missing-value handling, and pandas table export."
    ],
    "limitations": [
      "PyOpenMS, compatible dependencies, and local datasets must be installed or provided separately.",
      "Examples may require changes for the installed PyOpenMS version, instrument, acquisition method, and data quality.",
      "External search engines, spectral libraries, and compound databases require separate installation and configuration.",
      "Scientific parameters and identification results require domain validation before research or clinical use."
    ],
    "use_cases": [
      {
        "title": "Filter Proteomics Identifications",
        "description": "Load identification files, filter peptide-spectrum matches by FDR, infer proteins, and prepare structured results.",
        "target_user": "Proteomics researchers"
      },
      {
        "title": "Process Metabolomics Cohorts",
        "description": "Detect, align, normalize, and annotate features across sample groups while tracking blanks and quality-control samples.",
        "target_user": "Metabolomics analysts"
      },
      {
        "title": "Build OpenMS Data Pipelines",
        "description": "Create reproducible Python workflows for file conversion, signal processing, feature linking, and pandas export.",
        "target_user": "Bioinformatics developers"
      }
    ],
    "prompt_templates": [
      {
