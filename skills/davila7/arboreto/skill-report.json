  "content": {
    "user_title": "Infer Gene Regulatory Networks",
    "value_statement": "Transcriptomics teams need reliable ways to discover regulator-target links from large expression matrices. This skill guides Arboreto workflows for GRNBoost2, GENIE3, and Dask scaling.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Arboreto",
      "gene regulatory network",
      "GRNBoost2",
      "GENIE3",
      "single-cell RNA-seq",
      "Dask distributed",
      "transcriptomics"
    ],
    "actual_capabilities": [
      "Explains how to prepare expression matrices with observations as rows and genes as columns.",
      "Shows GRNBoost2 and GENIE3 workflows for gene regulatory network inference.",
      "Covers transcription factor filtering with optional TF name files.",
      "Documents reproducible runs with seed parameters and consensus analysis guidance.",
      "Describes local and distributed Dask configurations for large datasets.",
      "Includes a command-line example script for basic GRNBoost2 inference."
    ],
    "limitations": [
      "Does not prove biological causality from expression correlations alone.",
      "Requires users to provide valid expression data and transcription factor lists.",
      "Does not install Arboreto dependencies automatically inside the marketplace.",
      "Large analyses still depend on available memory, CPU, and Dask cluster capacity."
    ],
    "use_cases": [
      {
        "title": "Single-cell network discovery",
        "description": "Infer candidate transcription factor target links from single-cell RNA-seq matrices with GRNBoost2.",
        "target_user": "Computational biologist"
      },
      {
        "title": "Bulk RNA-seq regulator analysis",
        "description": "Run TF-filtered network inference on bulk expression tables and export ranked regulator target pairs.",
        "target_user": "Bioinformatics analyst"
      },
      {
        "title": "Cluster-scale transcriptomics workflow",
        "description": "Plan Dask client and worker settings for large datasets that exceed one workstation.",
        "target_user": "Research computing engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a GRNBoost2 run",
        "scenario": "Beginner workflow for a prepared expression table.",
        "prompt": "Use the arboreto skill to outline a GRNBoost2 workflow for my expression_data.tsv file. Include input format checks and the expected output columns."
      },
      {
        "title": "Add TF filtering",
        "scenario": "Intermediate workflow with a transcription factor list.",
        "prompt": "Use the arboreto skill to adapt my GRN inference workflow for a TF list file. Explain how to verify matching gene names before running."
      },
      {
        "title": "Compare algorithms",
        "scenario": "Choose between GRNBoost2 and GENIE3.",
        "prompt": "Use the arboreto skill to compare GRNBoost2 and GENIE3 for my dataset size, runtime limits, and validation goals."
      },
      {
        "title": "Scale with Dask",
        "scenario": "Advanced workflow for cluster execution.",
        "prompt": "Use the arboreto skill to design a Dask-based Arboreto workflow for a large single-cell dataset. Include worker sizing and cleanup steps."
      }
    ],
    "output_examples": [
      {
        "input": "A user asks how to infer a network from a single-cell expression table.",
        "output": "The assistant describes data orientation checks, recommends GRNBoost2, explains TF filtering, and names the TF, target, and importance output fields."
      },
      {
        "input": "A user needs to run Arboreto on a compute cluster.",
        "output": "The assistant outlines scheduler, worker, and client responsibilities, then recommends memory and thread settings for Dask workers."
      },
      {
        "input": "A user wants reproducible regulatory links across multiple seeds.",
        "output": "The assistant recommends fixed seeds, repeated runs, and consensus filtering before downstream biological interpretation."
      }
    ],
    "best_practices": [
      "Filter low-quality genes and confirm matrix orientation before running inference.",
      "Use GRNBoost2 first, then use GENIE3 when comparison or validation is needed.",
      "Set random seeds and record Arboreto, Dask, and data preprocessing versions."
    ],
    "anti_patterns": [
      "Do not treat importance scores as direct proof of regulation without validation.",
      "Do not run all genes as regulators when a trusted TF list is available.",
      "Do not start distributed runs without planning worker memory and cleanup."
    ],
    "faq": [
      {
        "question": "What data format does this skill expect?",
        "answer": "It expects expression matrices where rows are observations and columns are genes. Pandas DataFrames are the preferred input."
      },
      {
        "question": "Which Arboreto algorithm should I use first?",
        "answer": "Use GRNBoost2 first for most datasets because it is faster and designed for large-scale inference."
      },
      {
        "question": "When is GENIE3 useful?",
        "answer": "GENIE3 is useful for comparison studies, validation, and smaller datasets where longer runtime is acceptable."
      },
      {
        "question": "Can this skill run distributed jobs?",
        "answer": "It provides Dask setup guidance and examples. Users must provide and manage their own local or cluster resources."
      },
      {
        "question": "Does the skill install Arboreto automatically?",
        "answer": "No. It documents installation commands and workflows, but dependency installation remains under user control."
      },
      {
        "question": "Are inferred links biologically validated?",
        "answer": "No. Arboreto ranks candidate regulatory links, and users should validate results with domain evidence or downstream tools."
      }
    ]
