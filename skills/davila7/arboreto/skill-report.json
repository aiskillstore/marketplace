    "output_examples": [
      {
        "input": "Which algorithm should I use for 50,000 single-cell observations?",
        "output": "Start with GRNBoost2 because it is optimized for large datasets. Restrict the transcription factor list and set a seed for reproducibility."
      },
      {
        "input": "What does an Arboreto result contain?",
        "output": "Each result row identifies a transcription factor, a candidate target gene, and a relative importance score. Higher scores indicate stronger inferred associations."
      },
      {
        "input": "How should I run three robust cluster analyses?",
        "output": [
          "Create one controlled Dask client and reuse it for all runs.",
          "Run the same inputs with three documented seeds.",
          "Compare recurring high-ranked links and close the client after completion."
        ]
      }
    ],
    "best_practices": [
      "Verify that observations are rows and genes are columns before inference.",
      "Use a curated transcription factor list to reduce computation and irrelevant candidates.",
      "Record seeds, package versions, parameters, and cluster settings for every run."
    ],
    "anti_patterns": [
      "Do not interpret importance scores as proof of causal regulation.",
      "Do not compare algorithms with different inputs or undocumented parameters.",
      "Do not use example scheduler addresses without replacing them with approved cluster settings."
    ],
    "faq": [
      {
        "question": "Which algorithm should I choose first?",
        "answer": "Use GRNBoost2 for most analyses, especially large datasets. Use GENIE3 for comparison, validation, or compatibility with prior studies."
      },
      {
        "question": "What input orientation does Arboreto expect?",
        "answer": "Rows represent cells, samples, or conditions. Columns represent genes and should include gene names."
      },
      {
        "question": "Must I provide a transcription factor list?",
        "answer": "No. Arboreto can consider all genes, but a curated list usually reduces computation and improves interpretability."
      },
      {
        "question": "Can this skill run on a cluster?",
        "answer": "Yes. It explains Dask scheduler, worker, client, resource, monitoring, and cleanup settings for distributed inference."
      },
      {
        "question": "Are importance scores statistically significant?",
        "answer": "No. They rank inferred regulatory associations. Use validation or permutation methods when statistical evidence is required."
      },
      {
        "question": "How can I make results reproducible?",
        "answer": "Set explicit seeds and record data processing, transcription factor lists, package versions, algorithm parameters, and computing resources."
      }
    ]
