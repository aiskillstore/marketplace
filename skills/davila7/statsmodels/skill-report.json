  "content": {
    "user_title": "Analyze Statistical Models With Statsmodels",
    "value_statement": "Statistical modeling requires careful model choice, diagnostics, and inference. This skill guides Claude, Codex, and Claude Code through statsmodels workflows for regression, GLM, discrete choice, time series, and tests.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "statsmodels",
      "statistical modeling",
      "OLS regression",
      "GLM analysis",
      "logistic regression",
      "ARIMA forecasting",
      "model diagnostics"
    ],
    "actual_capabilities": [
      "Guides OLS, WLS, GLS, quantile regression, and mixed model selection.",
      "Explains GLM family and link choices for logistic, Poisson, Gamma, and related models.",
      "Covers discrete choice and count models, including marginal effects and zero-inflated models.",
      "Supports ARIMA, SARIMAX, VAR, stationarity testing, and forecast diagnostics.",
      "Provides workflows for residual diagnostics, influence analysis, hypothesis tests, and robust standard errors."
    ],
    "limitations": [
      "Does not run statsmodels or inspect live data without user-provided code and outputs.",
      "Does not replace expert review for study design, causal identification, or regulated decisions.",
      "Examples assume a Python environment with statsmodels and related libraries installed.",
      "Model quality depends on data quality, assumptions, and validation choices."
    ],
    "use_cases": [
      {
        "title": "Validate Regression Assumptions",
        "description": "Plan diagnostics for residuals, heteroskedasticity, autocorrelation, influence, and robust standard errors.",
        "target_user": "Research analyst"
      },
      {
        "title": "Model Discrete Outcomes",
        "description": "Choose logistic, probit, multinomial, count, or zero-inflated models and interpret effects.",
        "target_user": "Data scientist"
      },
      {
        "title": "Forecast Time Series",
        "description": "Structure ARIMA, SARIMAX, VAR, stationarity tests, residual checks, and forecast evaluation.",
        "target_user": "Economist"
      }
    ],
    "prompt_templates": [
      {
        "title": "Choose a Statistical Model",
        "scenario": "Beginner model selection",
        "prompt": "I have an outcome, predictors, sample size, and analysis goal. Help me choose the right statsmodels model and explain the tradeoffs."
      },
      {
        "title": "Check Regression Diagnostics",
        "scenario": "Intermediate model validation",
        "prompt": "Review my fitted regression results and diagnostic output. Identify assumption problems, recommended tests, and robust inference options."
      },
      {
        "title": "Compare GLM and Discrete Models",
        "scenario": "Advanced model comparison",
        "prompt": "Compare candidate GLM or discrete choice models for my data. Include link functions, interpretation, AIC or BIC, and validation checks."
      },
      {
        "title": "Design a Forecasting Workflow",
        "scenario": "Advanced time series planning",
        "prompt": "Design a statsmodels workflow for this time series. Include stationarity tests, model identification, diagnostics, validation, and forecast reporting."
      }
    ],
    "output_examples": [
      {
        "input": "A binary churn outcome with customer behavior predictors needs an interpretable model.",
        "output": "Use Logit or Probit, report odds ratios and marginal effects, evaluate AUC, and check convergence and influential observations."
      },
      {
        "input": "Monthly sales show trend, seasonality, and possible autocorrelation.",
        "output": "Test stationarity, inspect ACF and PACF, fit SARIMAX candidates, compare information criteria, and validate rolling forecasts."
      },
      {
        "input": "A Poisson count model has residual dispersion far above one.",
        "output": "Check overdispersion, consider Negative Binomial or zero-inflated alternatives, compare fit, and interpret rate ratios carefully."
      }
    ],
    "best_practices": [
      "Match the model family to the outcome type before fitting.",
      "Report coefficients with uncertainty, diagnostics, and practical interpretation.",
      "Validate assumptions using residual, influence, and out-of-sample checks."
    ],
    "anti_patterns": [
      "Using OLS for binary, ordinal, or count outcomes without justification.",
      "Interpreting transformed link coefficients as raw outcome changes.",
      "Selecting models only by in-sample fit while ignoring diagnostics and leakage."
    ],
    "faq": [
