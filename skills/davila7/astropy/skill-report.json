        "prompt": "Design a reproducible Astropy pipeline for [catalogs and research question]. Cover cleaning, units, coordinate matching, uncertainty, cosmology, performance, and validation.",
        "scenario": "Advanced research workflow"
      }
    ],
    "output_examples": [
      {
        "input": "Convert 2.5 parsecs to light-years and explain the result.",
        "output": "2.5 parsecs is approximately 8.15 light-years. The conversion preserves the distance dimension and reports the requested unit."
      },
      {
        "input": "Transform ICRS coordinates RA 83.6331 degrees and Dec 22.0145 degrees into Galactic coordinates.",
        "output": "The approximate Galactic coordinates are longitude 184.56 degrees and latitude -5.78 degrees. No observation time or location is required for this transformation."
      },
      {
        "input": "Outline a safe review of a large FITS image before analysis.",
        "output": [
          "Open the file with a context manager and use memory mapping when appropriate.",
          "Inspect the HDU structure before selecting image data.",
          "Review header metadata, dimensions, data type, missing values, and WCS validity.",
          "Avoid modifying structural header keywords without a specific requirement."
        ]
      }
    ],
    "best_practices": [
      "Attach units to quantities and validate dimensional compatibility before conversion.",
      "Specify coordinate frames, time scales, observer locations, and cosmological models explicitly.",
      "Use context managers, vectorized operations, masking, and memory mapping for reliable data processing."
    ],
    "anti_patterns": [
      "Do not mix unitless values with physical quantities when units affect the result.",
      "Do not transform observer-dependent coordinates without the required time and location.",
      "Do not overwrite FITS files or structural headers before validating the source and intended changes."
    ],
    "faq": [
      {
        "question": "Does this skill install Astropy?",
        "answer": "No. It documents installation commands, but package installation remains an explicit user action."
      },
      {
        "question": "Can it work with FITS images and tables?",
        "answer": "Yes. It covers FITS HDUs, headers, image arrays, table data, writing, validation, and large-file handling."
      },
      {
        "question": "Does coordinate transformation always require an observation time?",
        "answer": "No. Static frame transformations may not require time, while AltAz and other observer-dependent frames require time and location."
