        "description": "Read FITS headers and arrays, validate WCS information, and summarize observation metadata.",
        "target_user": "Observatory data analysts"
      },
      {
        "title": "Build Reproducible Catalog Workflows",
        "description": "Cross-match source catalogs, preserve units, and compute cosmological quantities with explicit assumptions.",
        "target_user": "Astrophysics researchers"
      }
    ],
