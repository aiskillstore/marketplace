  "content": {
    "user_title": "Prioritize Products and Turn Research Into Plans",
    "value_statement": "Product teams often struggle to turn scattered research and estimates into clear priorities and requirements. This skill provides local analysis scripts, proven frameworks, and reusable PRD templates for structured product decisions.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "product management toolkit",
      "RICE prioritization",
      "customer interview analysis",
      "PRD templates",
      "product discovery",
      "feature roadmap"
    ],
    "actual_capabilities": [
      "Calculates RICE scores from feature reach, impact, confidence, and effort values.",
      "Ranks feature backlogs and identifies quick wins and large strategic bets.",
      "Builds capacity-based quarterly roadmap suggestions from prioritized features.",
      "Extracts pain points, requests, jobs, sentiment, themes, metrics, competitors, and quotes from interview text.",
      "Produces readable text, JSON, or CSV output for supported workflows.",
      "Provides standard PRD, one-page PRD, agile epic, and feature brief templates."
    ],
    "limitations": [
      "Interview analysis uses keywords and regular expressions, so nuanced language, sarcasm, and uncommon terms may be misclassified.",
      "The command-line analyzer processes one transcript per run, although the module includes an aggregation helper.",
      "Roadmap suggestions use capacity and RICE order but do not model dependencies, deadlines, or resource specialties.",
      "Named product integrations are guidance only; the scripts do not connect to external services."
    ],
    "use_cases": [
      {
        "title": "Prioritize a Feature Backlog",
        "description": "Score competing features, review portfolio balance, and create a capacity-based quarterly sequence.",
        "target_user": "Product manager"
      },
      {
        "title": "Synthesize Customer Interviews",
        "description": "Extract recurring pains, requests, jobs, themes, metrics, and evidence quotes from research transcripts.",
        "target_user": "User researcher"
      },
      {
        "title": "Prepare an Investment Proposal",
        "description": "Turn discovery evidence into a concise PRD with scope, success metrics, risks, and launch considerations.",
        "target_user": "Startup founder"
      }
    ],
    "prompt_templates": [
      {
        "title": "Rank a Feature List",
        "prompt": "Rank these features with RICE: [feature data]. State assumptions, show each score, and explain the recommended order.",
        "scenario": "Beginner prioritization for a small backlog"
      },
      {
        "title": "Analyze an Interview",
        "prompt": "Analyze this customer interview: [transcript]. Extract pain points, requests, jobs, sentiment, themes, metrics, competitor mentions, and supporting quotes.",
        "scenario": "Structured synthesis of one research session"
      },
      {
        "title": "Draft a Product Requirement",
        "prompt": "Draft a [standard, one-page, agile epic, or feature brief] PRD from [context]. Include scope, requirements, metrics, risks, timeline, and open questions.",
        "scenario": "Intermediate requirements development"
      },
      {
        "title": "Build an Evidence-Based Roadmap",
        "prompt": "Combine [interview findings] with [feature estimates]. Create an opportunity map, calculate RICE priorities, sequence work by capacity, and separate evidence from assumptions.",
        "scenario": "Advanced research synthesis and roadmap planning"
      }
    ],
    "output_examples": [
      {
        "input": "Prioritize onboarding (20,000, massive, high, S), analytics (6,000, high, medium, L), and dark mode (8,000, medium, high, XL).",
        "output": [
          "1. Onboarding flow, score 20,000: highest reach and impact with low effort.",
          "2. Analytics dashboard, score 1,200: strong impact but greater effort.",
          "3. Dark mode, score 615.38: useful, but its large effort lowers priority."
        ]
      },
      {
        "input": "Analyze an interview describing slow weekly reporting and a request for automated exports.",
        "output": [
          "Primary pain point: weekly reporting is slow and repetitive.",
          "Feature request: automated exports, high priority because the user described it as necessary.",
          "Job: reduce manual reporting time while preserving accuracy.",
          "Sentiment: negative, supported by repeated frustration terms."
        ]
      }
    ],
    "best_practices": [
      "Validate reach, impact, confidence, and effort estimates with current evidence before accepting the ranking.",
      "Redact personal or confidential details from transcripts before analysis and review quoted output before sharing.",
      "Use generated roadmaps and PRDs as decision drafts, then confirm dependencies, feasibility, ownership, and success metrics with stakeholders."
    ],
    "anti_patterns": [
      "Do not treat RICE scores as objective truth when inputs are uncertain or strategically incomplete.",
      "Do not infer broad customer demand from one interview or from keyword frequency alone.",
      "Do not publish generated requirements without confirming scope, security, compliance, technical constraints, and accountable owners."
    ],
    "faq": [
      {
        "question": "Does the toolkit send product data to external services?",
        "answer": "No. The bundled scripts read local files and print results locally without network requests."
      },
      {
        "question": "Which input and output formats are supported?",
        "answer": "RICE accepts CSV and prints text, JSON, or CSV. Interview analysis accepts text files and prints text or JSON."
      },
      {
        "question": "Can it analyze several interviews together?",
        "answer": "The module includes an aggregation helper, but the command-line interface analyzes one transcript per run."
      },
      {
        "question": "Does the generated roadmap account for dependencies?",
        "answer": "No. It sequences work by RICE rank and capacity, so teams must review dependencies, deadlines, and specialist availability."
      },
      {
        "question": "Which PRD format should I choose?",
        "answer": "Use the standard PRD for complex work, one-page PRD for alignment, agile epic for delivery, or feature brief for exploration."
      },
      {
        "question": "Can the toolkit replace product judgment?",
        "answer": "No. It structures evidence and estimates, but teams remain responsible for validation, tradeoffs, privacy, feasibility, and final decisions."
      }
    ]
