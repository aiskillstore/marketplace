  "content": {
    "user_title": "Analyze Geospatial Data with GeoPandas",
    "value_statement": "Geospatial Python work often fails when files, projections, and geometry operations are handled inconsistently. This skill gives Claude, Codex, and Claude Code practical GeoPandas guidance for reliable spatial analysis.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "GeoPandas skill",
      "geospatial Python",
      "spatial analysis",
      "vector GIS",
      "GeoJSON",
      "PostGIS",
      "coordinate reference systems"
    ],
    "actual_capabilities": [
      "Explains reading and writing Shapefile, GeoJSON, GeoPackage, Parquet, Feather, and PostGIS data.",
      "Guides coordinate reference system checks, CRS setting, reprojection, and common EPSG choices.",
      "Shows buffers, centroids, validity checks, affine transforms, simplification, and geometry properties.",
      "Covers spatial joins, nearest joins, overlays, dissolve, clipping, distance, area, and length analysis.",
      "Demonstrates static maps, choropleths, interactive maps, basemaps, and CartoPy projection examples.",
      "Includes performance guidance for spatial filters, spatial indexes, Arrow I/O, and geometry simplification."
    ],
    "limitations": [
      "It is documentation guidance, not a complete GIS application.",
      "Users must provide valid spatial files, database connections, and project requirements.",
      "Some examples require optional Python packages such as folium, pyarrow, contextily, or cartopy.",
      "It does not verify legal rights, licensing, or privacy limits for geospatial datasets."
    ],
    "use_cases": [
      {
        "title": "Prepare Spatial Data Pipelines",
        "description": "Build repeatable workflows that load vector files, check CRS, transform coordinates, and export analysis-ready datasets.",
        "target_user": "Data engineer"
      },
      {
        "title": "Run GIS Analysis in Python",
        "description": "Use spatial joins, buffers, overlays, dissolves, and distance calculations without switching to a desktop GIS tool.",
        "target_user": "GIS analyst"
      },
      {
        "title": "Create Maps for Reports",
        "description": "Generate choropleths, multi-layer maps, interactive views, and projected figures for notebooks and publications.",
        "target_user": "Researcher"
      }
    ],
    "prompt_templates": [
      {
        "title": "Load My Spatial File",
        "scenario": "Beginner file loading task",
        "prompt": "Help me load a local GeoJSON file with GeoPandas, inspect its columns, check its CRS, and identify the geometry type."
      },
      {
        "title": "Fix Projection Issues",
        "scenario": "Intermediate CRS troubleshooting",
        "prompt": "Review my GeoPandas workflow for area calculations. Explain which CRS I should use and where to reproject the data."
      },
      {
        "title": "Design Spatial Analysis",
        "scenario": "Applied analysis workflow",
        "prompt": "Plan a workflow that joins point events to administrative polygons, aggregates counts, and exports a GeoPackage for mapping."
      },
      {
        "title": "Optimize a Large GIS Workflow",
        "scenario": "Advanced performance and architecture task",
        "prompt": "Improve a GeoPandas pipeline that reads large files, filters by bounding box, runs overlays, and produces static and interactive maps."
      }
    ],
    "output_examples": [
      {
        "input": "Calculate polygon areas accurately for a city boundary dataset.",
        "output": "The skill recommends checking the current CRS, reprojecting to a suitable projected CRS, calculating area, and documenting units."
      },
      {
        "input": "Combine points with census tract polygons and summarize counts.",
        "output": "The skill outlines a spatial join, aggregation by polygon identifier, merge back to polygons, and export to GeoPackage."
      },
      {
        "input": "Create a map that shows population density and missing data.",
        "output": "The skill suggests a choropleth with a clear colormap, explicit missing-data styling, legend settings, and optional interactive exploration."
      }
    ],
    "best_practices": [
      "Check and align CRS before joins, overlays, area calculations, or distance calculations.",
      "Use spatial filters, selected columns, and Arrow support when reading large datasets.",
      "Validate geometries and preserve topology before operations that can change shapes."
    ],
    "anti_patterns": [
      "Calculating area or distance in latitude and longitude coordinates without reprojection.",
      "Merging a pandas DataFrame into a GeoDataFrame in a way that drops geometry metadata.",
      "Using Shapefile by default when GeoPackage or Parquet would preserve richer spatial data."
    ],
    "faq": [
      {
        "question": "What does this skill help me do?",
        "answer": "It helps use GeoPandas for vector spatial data loading, CRS management, geometry operations, spatial analysis, and mapping."
      },
      {
        "question": "Does it support PostGIS workflows?",
        "answer": "Yes. It includes examples for reading from and writing to PostGIS with GeoPandas and SQLAlchemy connections."
      },
      {
        "question": "Can it help choose a coordinate reference system?",
        "answer": "Yes. It explains common CRS choices and when to use projected systems for area or distance work."
      },
      {
        "question": "Does it create interactive maps?",
        "answer": "Yes. It covers GeoPandas explore workflows, tooltips, style options, basemaps, and multi-layer interactive maps."
      },
      {
        "question": "Will it install GeoPandas automatically?",
        "answer": "No. It documents installation commands, but users control whether dependencies are installed in their environment."
      },
      {
        "question": "Is this a replacement for reviewing spatial data quality?",
