        "title": "Design an Advanced Interactive View",
        "prompt": "Build an interactive Plotly visualization for [workflow] with [controls], custom hover content, animation, and both HTML and [static format] exports.",
        "scenario": "Deliver a customized figure with interaction and multiple output formats."
      }
