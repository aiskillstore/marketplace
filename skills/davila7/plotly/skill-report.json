    "best_practices": [
      "Use Plotly Express for standard DataFrame charts, then refine the returned figure with graph object methods.",
      "Choose labels, color scales, hover fields, and dimensions that match the audience and data.",
      "Select export settings deliberately, especially embedded libraries, image size, scale, and network requirements."
    ],
    "anti_patterns": [
      "Do not use graph objects for simple charts when Plotly Express provides the required result.",
      "Do not overload figures with traces, controls, annotations, or hover fields that obscure the main comparison.",
      "Do not assume CDN-based HTML exports work offline or static exports work without Kaleido."
    ],
    "faq": [
      {
        "question": "When should I use Plotly Express?",
        "answer": "Use Plotly Express for common charts built from tidy pandas DataFrames and when concise code with automatic legends is preferred."
      },
      {
        "question": "When should I use graph objects?",
        "answer": "Use graph objects for specialized traces, mixed subplots, complex figures, or precise control over individual components."
      },
      {
        "question": "Can Plotly create static images?",
        "answer": "Yes. Plotly can export PNG, JPEG, WebP, SVG, and PDF files when Kaleido and its required browser dependency are available."
      },
      {
        "question": "Can charts work without internet access?",
        "answer": "Yes. Standalone HTML can embed Plotly.js, while CDN exports and some map styles require network access."
      },
      {
        "question": "Does this skill support dashboards?",
        "answer": "It covers multi-chart figures and basic Dash integration, including figure embedding and responsive display."
      },
      {
        "question": "Does this skill analyze my data?",
        "answer": "No. It helps visualize supplied data but does not verify data quality, statistical assumptions, or analytical conclusions."
      }
    ]
