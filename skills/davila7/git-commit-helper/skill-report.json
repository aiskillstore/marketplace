  "content": {
    "user_title": "Generate Clear Git Commit Messages",
    "value_statement": "Unclear commit messages slow reviews and make history harder to use. This skill analyzes staged diffs and turns them into focused conventional commit messages.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "git commit helper",
      "commit message generator",
      "conventional commits",
      "git diff analysis",
      "staged changes review",
      "developer productivity",
      "AI commit messages"
    ],
    "actual_capabilities": [
      "Guides review of staged Git diffs before suggesting a commit message.",
      "Formats messages with conventional commit type, scope, summary, body, and footer.",
      "Provides examples for feature, fix, refactor, multi-file, and breaking change commits.",
      "Suggests when to include body text, issue references, and breaking change notices.",
      "Documents selective staging and amend workflows with standard Git commands."
    ],
    "limitations": [
      "Requires repository context or a pasted diff to infer changes accurately.",
      "Does not run tests or verify code behavior unless asked separately.",
      "Needs user confirmation before Git commands change staging or commits.",
      "Cannot know team-specific commit rules unless they are provided."
    ],
    "use_cases": [
      {
        "title": "Draft a Commit Message",
        "description": "Turn staged changes into a concise conventional commit message with an optional body.",
        "target_user": "Individual developer"
      },
      {
        "title": "Normalize Commit History",
        "description": "Review messages for type, scope, imperative wording, and useful context before merging.",
        "target_user": "Code reviewer"
      },
      {
        "title": "Flag Breaking Changes",
        "description": "Identify changes that need a breaking change marker and migration note.",
        "target_user": "Maintainer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Create a Basic Commit Message",
        "prompt": "Review my staged changes and suggest one concise conventional commit message.",
        "scenario": "Beginner use for a simple staged change."
      },
      {
        "title": "Compare Message Options",
        "prompt": "Analyze my staged diff and give three commit message options with different scopes. Recommend the best one.",
