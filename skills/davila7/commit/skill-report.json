  "content": {
    "user_title": "Create Sentry-Style Commit Messages",
    "value_statement": "Teams need consistent commit history that follows Sentry conventions. This skill formats concise headers, useful bodies, and supported issue references.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Sentry commit messages",
      "conventional commits",
      "Git commit formatter",
      "commit message generator",
      "issue references",
      "developer workflow"
    ],
    "actual_capabilities": [
      "Formats commit headers with an approved type, optional scope, and imperative subject.",
      "Selects Sentry commit types for features, fixes, refactors, documentation, tests, and maintenance.",
      "Writes commit bodies that explain the change and its motivation.",
      "Adds supported Fixes and Refs footers for GitHub, Sentry, and Linear issues.",
      "Produces documented formats for breaking changes and reverts."
    ],
    "limitations": [
      "It does not run Git commands or create commits.",
      "It cannot verify whether an issue identifier exists or should be closed.",
      "Its conventions are tailored to Sentry projects and may differ from another repository.",
      "Output quality depends on the change details supplied by the user."
    ],
    "use_cases": [
      {
        "title": "Standardize daily commits",
        "description": "Turn a change summary into a consistent Sentry-style commit message.",
        "target_user": "Software developers"
      },
      {
        "title": "Improve review context",
        "description": "Create commit bodies that explain motivation and previous behavior for reviewers.",
        "target_user": "Code reviewers"
      },
      {
        "title": "Prepare release history",
