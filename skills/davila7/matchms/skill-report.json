  "content": {
    "user_title": "Analyze Mass Spectrometry Data with matchms",
    "value_statement": "Mass spectrometry workflows need consistent preprocessing and comparison methods. This skill guides matchms usage for spectra import, filtering, scoring, and export.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "matchms",
      "mass spectrometry",
      "metabolomics",
      "spectral similarity",
      "mzML processing",
      "MGF files",
      "compound identification"
    ],
    "actual_capabilities": [
      "Explains how to load and export mzML, MGF, MSP, JSON, pickle, and USI spectra.",
      "Guides metadata harmonization, intensity normalization, peak filtering, and quality control filters.",
      "Compares spectra with cosine, modified cosine, neutral losses, fingerprints, metadata, and mass matching.",
      "Shows how to build reusable SpectrumProcessor pipelines for repeatable preprocessing.",
      "Provides workflow guidance for library matching, format conversion, validation, and batch processing."
    ],
    "limitations": [
      "Requires the matchms Python package and user-provided mass spectrometry data files.",
      "Similarity results depend on spectrum quality, metadata completeness, tolerances, and reference library coverage.",
      "Chemical structure features may require optional chemistry dependencies such as RDKit.",
      "Does not replace expert review of compound identification or analytical method validation."
    ],
    "use_cases": [
      {
        "title": "Identify Unknown Metabolites",
        "description": "Compare query spectra with reference libraries and review the best spectral matches.",
        "target_user": "Metabolomics researchers"
      },
      {
        "title": "Clean Spectral Libraries",
        "description": "Apply standard filters to remove poor spectra and harmonize metadata before analysis.",
        "target_user": "Bioinformatics analysts"
      },
      {
        "title": "Build Reproducible Pipelines",
        "description": "Create repeatable preprocessing and scoring workflows for large spectral datasets.",
        "target_user": "Data engineers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Load and Inspect Spectra",
        "scenario": "Beginner exploration of a new file.",
        "prompt": "Use matchms to load my MGF file. Summarize spectrum count, key metadata fields, and missing values."
      },
      {
        "title": "Clean a Spectral Dataset",
        "scenario": "Basic preprocessing before analysis.",
        "prompt": "Prepare this MGF dataset for similarity scoring. Apply default filters, normalize intensities, remove weak peaks, and explain each quality decision."
      },
      {
        "title": "Match Queries to a Library",
        "scenario": "Intermediate compound identification workflow.",
        "prompt": "Compare my query spectra with a reference library using cosine and modified cosine scoring. Report the best matches and score interpretation."
      },
      {
        "title": "Design a Multi-Metric Workflow",
        "scenario": "Advanced workflow planning.",
        "prompt": "Design a matchms workflow that combines spectral, neutral loss, fingerprint, and metadata scores. Include validation checks and export recommendations."
      }
    ],
    "output_examples": [
      {
        "input": "A researcher wants to clean raw MGF spectra before library searching.",
        "output": [
          "Recommended workflow: load spectra, apply default filters, require precursor m/z, normalize intensities, and remove low-intensity peaks.",
          "Expected result: a smaller set of spectra with consistent metadata and stronger scoring inputs."
        ]
      },
      {
        "input": "An analyst asks for a query-versus-library comparison plan.",
        "output": [
          "Suggested scoring: use cosine for direct peak overlap and modified cosine for related precursor masses.",
          "Report: include compound name, precursor m/z, similarity score, matched peaks, and any missing metadata warnings."
        ]
      },
      {
        "input": "A team needs format conversion from mzML to MGF for sharing.",
        "output": [
          "Conversion plan: load MS2 spectra from mzML, preserve key metadata, then export to MGF.",
          "Quality check: confirm spectrum count, precursor m/z coverage, and representative metadata after export."
        ]
      }
    ],
    "best_practices": [
      "Run metadata harmonization before similarity scoring so fields use consistent names and values.",
      "Check for filters that return no spectrum before applying the next processing step.",
      "Record tolerances, filters, and score thresholds so results are reproducible."
    ],
    "anti_patterns": [
      "Do not compare spectra before normalization and basic quality filtering.",
      "Do not treat high similarity scores as confirmed identifications without reference review.",
      "Do not mix positive and negative ion modes without explicit handling."
    ],
    "faq": [
      {
        "question": "What data formats does this skill cover?",
        "answer": "It covers mzML, mzXML, MGF, MSP, JSON, pickle, and metabolomics USI references."
      },
      {
        "question": "Can it help identify unknown compounds?",
        "answer": "Yes. It guides spectral library matching and explains how to rank candidate matches."
      },
      {
        "question": "Does it run matchms by itself?",
        "answer": "No. It provides guidance and examples for an environment where matchms is installed."
      },
      {
        "question": "When should I use modified cosine scoring?",
        "answer": "Use it when precursor mass differences matter, such as analog or derivative matching."
      },
      {
        "question": "Does it support chemical structure features?",
        "answer": "Yes. It explains SMILES, InChI, fingerprints, and annotation validation when dependencies are available."
      },
      {
        "question": "How should I validate results?",
        "answer": "Review metadata completeness, matched peak counts, tolerances, reference quality, and expert chemical evidence."
      }
