    "faq": [
      {
        "question": "What data can UMAP process?",
        "answer": "UMAP supports numeric arrays, sparse matrices, vectors, binary data, and precomputed distances when configured with an appropriate metric."
      },
      {
        "question": "Should features be standardized first?",
        "answer": "Yes, standardize numeric features with different scales so large-valued features do not dominate distance calculations."
      },
      {
        "question": "How do I choose n_neighbors?",
        "answer": "Start near 15. Use smaller values for local detail and larger values for broader structure."
      },
      {
        "question": "Can UMAP transform new samples?",
        "answer": "Yes. Fit the reducer on training data, then apply its transform method to consistently preprocessed new samples."
      },
      {
        "question": "Is UMAP suitable before clustering?",
        "answer": "Yes, but use more than two output dimensions and validate clusters because UMAP can alter density and create apparent separation."
      },
      {
        "question": "Are UMAP results reproducible?",
        "answer": "Set random_state for repeatable runs. Parallel execution and dependency differences can still affect exact results."
      }
