        "prompt": "Create a beginner-friendly Cirq plan for a two-qubit Bell state. Explain the qubits, gates, measurements, and expected results."
      },
      {
        "title": "Plan a Parameter Sweep",
        "scenario": "Intermediate simulation workflow",
        "prompt": "Design a parameter sweep in Cirq for a single-qubit rotation. Include simulation goals, result interpretation, and common mistakes."
      },
      {
        "title": "Compare Noise Strategies",
        "scenario": "Advanced noisy simulation",
        "prompt": "Plan a noisy simulation study for my circuit. Compare state vector and density matrix options, then recommend noise metrics."
      },
      {
        "title": "Review Hardware Execution",
        "scenario": "Expert hardware readiness check",
        "prompt": "Review my Cirq hardware execution plan for Google Quantum AI and IonQ. Check authentication, device constraints, optimization, and result handling."
      }
    ],
    "output_examples": [
      {
        "input": "I need to teach Bell states with Cirq.",
        "output": "The response explains qubit selection, entangling gates, measurement keys, and expected correlated outcomes."
      },
      {
        "input": "My simulation is slow with a noisy circuit.",
        "output": [
          "Use a state vector simulator for pure circuits.",
          "Use a density matrix simulator only when modeling mixed-state noise.",
          "Reduce qubit count or repetitions before increasing model detail."
        ]
      },
      {
        "input": "I want to run on IonQ through Cirq.",
        "output": "The response outlines package setup, credential handling, simulator validation, target choice, job submission, and result checks."
      }
    ],
    "best_practices": [
      "Validate circuits on simulators before submitting hardware jobs.",
      "Match qubit topology, gateset, and optimization steps to the target device.",
      "Record parameters, repetitions, provider targets, and result metadata for reproducible experiments."
    ],
    "anti_patterns": [
      "Do not place real API keys directly in prompts, examples, or notebooks.",
