    "user_title": "Build Quantum Circuits with Cirq",
    "value_statement": "Quantum teams need reliable guidance for Cirq circuit design, simulation, optimization, and hardware workflows. This skill provides structured examples and references for Claude, Codex, and Claude Code.",
    "seo_keywords": [
      "Cirq quantum computing",
      "Claude",
      "Codex",
      "Claude Code",
      "quantum circuit design",
      "quantum simulation",
      "quantum hardware",
      "noise modeling",
      "VQE QAOA",
      "Cirq Python"
    ],
    "actual_capabilities": [
      "Guide Cirq circuit construction with qubits, gates, measurements, and reusable circuit patterns.",
      "Explain exact simulation, noisy simulation, parameter sweeps, and result interpretation.",
      "Support circuit optimization, gate decomposition, routing, and target gateset compilation.",
      "Describe hardware workflows for Google Quantum AI, IonQ, Azure Quantum, AQT, and Pasqal.",
      "Provide experiment patterns for VQE, QAOA, phase estimation, benchmarking, and data analysis.",
      "Cover noise models, calibration data, visualization, and error mitigation concepts."
    ],
    "limitations": [
      "It does not provide live quantum hardware access, accounts, or provider credentials.",
      "Examples require local Python packages and may need provider-specific setup.",
      "Large simulations remain limited by available memory and compute resources.",
      "Hardware APIs and device availability can change after the skill content was written."
    ],
    "use_cases": [
      {
        "title": "Prototype Quantum Algorithms",
        "description": "Build and simulate VQE, QAOA, or phase estimation workflows before moving to hardware.",
        "target_user": "Quantum researcher"
      },
      {
        "title": "Teach Cirq Concepts",
        "description": "Create clear lessons about qubits, gates, measurements, noise, and circuit visualization.",
        "target_user": "Instructor"
      },
      {
        "title": "Prepare Hardware Runs",
        "description": "Review provider setup, device constraints, circuit optimization, and result handling steps.",
        "target_user": "Quantum software engineer"
      }
    ],
    "prompt_templates": [
      {
        "title": "Explain a Simple Circuit",
