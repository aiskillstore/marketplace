        "title": "Resolve database errors",
        "description": "Work through constraint, synchronization, and RLS troubleshooting steps for CookMode V2.",
        "target_user": "Support engineer"
      },
      {
        "title": "Review data access",
        "description": "Assess existing Supabase policies and replace permissive rules with scoped access controls.",
        "target_user": "Database administrator"
      }
    ],
    "prompt_templates": [
