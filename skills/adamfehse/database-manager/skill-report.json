    "user_title": "Manage Supabase Database Changes",
    "value_statement": "Database changes can cause data loss, slow queries, or access-control errors. This skill provides structured guidance for CookMode V2 schemas, migrations, RLS, and Supabase troubleshooting.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Supabase database manager",
      "PostgreSQL migrations",
