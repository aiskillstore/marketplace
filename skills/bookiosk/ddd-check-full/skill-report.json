  "content": {
    "user_title": "Audit Java DDD Architecture Across a Full Project",
    "value_statement": "Large Java projects can accumulate hidden domain-driven design violations across many layers. This skill provides a structured full-project review and a prioritized compliance report.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Java DDD audit",
      "domain-driven design",
      "architecture review",
      "Java code quality",
      "dependency analysis",
      "DDD compliance"
    ],
    "actual_capabilities": [
      "Discovers non-test Java files with a sorted local file search.",
      "Guides a layer-by-layer review of packages, base classes, naming, dependencies, and structure.",
      "Checks listed DDD conventions for domain, application, infrastructure, and client layers.",
      "Highlights dependency direction, exception boundaries, missing patterns, and anemic domain models.",
      "Produces a structured audit with summaries, severity counts, layer findings, and recommendations."
    ],
    "limitations": [
      "It only describes an audit workflow and does not automatically change project files.",
      "The listed rule and reference files are not included in this skill package.",
      "Its checks target Java projects using the named Bookiosk DDD conventions.",
      "Results depend on complete project access and accurate interpretation of each Java file."
    ],
    "use_cases": [
      {
        "title": "Review Release Architecture",
        "description": "Assess DDD layer boundaries and prioritize issues before a Java service release.",
        "target_user": "Java architects"
      },
      {
        "title": "Onboard Engineering Teams",
        "description": "Give new engineers a repeatable checklist for reviewing a project architecture.",
        "target_user": "Engineering leads"
      },
      {
        "title": "Assess Refactoring Work",
        "description": "Check whether large refactors preserve package, dependency, and domain model conventions.",
        "target_user": "Java maintainers"
      }
    ],
    "prompt_templates": [
      {
        "title": "Start a Full Audit",
        "prompt": "Run a full DDD audit of this Java project and summarize the highest-priority violations.",
        "scenario": "Beginner project review"
      },
      {
        "title": "Review Domain Layer",
        "prompt": "Audit every Java file, then focus the report on domain-layer base classes, dependencies, and business behavior.",
        "scenario": "Focused architecture review"
      },
      {
        "title": "Check Release Readiness",
        "prompt": "Perform a full DDD compliance audit and list critical and high issues that must be resolved before release.",
        "scenario": "Pre-release quality gate"
      },
      {
        "title": "Analyze a Refactor",
        "prompt": "Compare the current Java architecture against the DDD checklist and recommend fixes ordered by layer and severity.",
        "scenario": "Advanced refactoring assessment"
      }
    ],
    "output_examples": [
      {
