{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "preview_sha256", "payload"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-evidence-campaign-aggregate-preview"]
    },
    "preview_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "model-evidence-campaign-aggregate.schema.json"
    }
  },
  "oneOf": [
    {
      "properties": {
        "schema_version": {"const": 1},
        "payload": {"$ref": "model-evidence-campaign-aggregate.schema.json#/definitions/v1"}
      }
    },
    {
      "properties": {
        "schema_version": {"const": 2},
        "payload": {"$ref": "model-evidence-campaign-aggregate.schema.json#/definitions/v2"}
      }
    }
  ]
}
