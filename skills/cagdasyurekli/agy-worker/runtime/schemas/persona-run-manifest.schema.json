{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "persona", "target_state", "artifacts"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"type": "string", "enum": ["agy-worker-persona-run-manifest"]},
    "persona": {"type": "string", "enum": ["bulk-test-writer", "diff-reviewer", "repo-inventory"]},
    "target_state": {"type": "string", "enum": ["real-escalation-observed", "accepted-real-candidate"]},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["benchmark_plan", "benchmark_receipt", "benchmark_result", "candidate", "dispatch_profile", "real_receipt", "run_evidence", "selection", "tool_attestation", "verifier_001", "version_attestation"],
      "properties": {
        "benchmark_plan": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/benchmark-plan.json", "compat/personas/evidence/diff-reviewer/benchmark-plan.json", "compat/personas/evidence/repo-inventory/benchmark-plan.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "benchmark_receipt": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/benchmark-receipt.json", "compat/personas/evidence/diff-reviewer/benchmark-receipt.json", "compat/personas/evidence/repo-inventory/benchmark-receipt.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "benchmark_result": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/benchmark-result.json", "compat/personas/evidence/diff-reviewer/benchmark-result.json", "compat/personas/evidence/repo-inventory/benchmark-result.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "candidate": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/candidate.diff", "compat/personas/evidence/diff-reviewer/candidate.diff", "compat/personas/evidence/repo-inventory/candidate.diff"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "dispatch_profile": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/dispatch-profile.json", "compat/personas/evidence/diff-reviewer/dispatch-profile.json", "compat/personas/evidence/repo-inventory/dispatch-profile.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "real_receipt": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/real-receipt.json", "compat/personas/evidence/diff-reviewer/real-receipt.json", "compat/personas/evidence/repo-inventory/real-receipt.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "run_evidence": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/run-evidence.json", "compat/personas/evidence/diff-reviewer/run-evidence.json", "compat/personas/evidence/repo-inventory/run-evidence.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "selection": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/selection.json", "compat/personas/evidence/diff-reviewer/selection.json", "compat/personas/evidence/repo-inventory/selection.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "tool_attestation": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/tool-attestation.json", "compat/personas/evidence/diff-reviewer/tool-attestation.json", "compat/personas/evidence/repo-inventory/tool-attestation.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "verifier_001": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/verifier-001.json", "compat/personas/evidence/diff-reviewer/verifier-001.json", "compat/personas/evidence/repo-inventory/verifier-001.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}},
        "version_attestation": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "enum": ["compat/personas/evidence/bulk-test-writer/version-attestation.json", "compat/personas/evidence/diff-reviewer/version-attestation.json", "compat/personas/evidence/repo-inventory/version-attestation.json"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}}}
      }
    }
  }
}
