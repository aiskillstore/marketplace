{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "plan_sha256",
    "lane",
    "subject_role",
    "model_identity",
    "scenario_id",
    "harness",
    "evaluator",
    "config_sha256",
    "measurement_window",
    "policy",
    "measured_metadata",
    "telemetry",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-evidence-campaign-record"]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "lane": {
      "type": "string",
      "enum": ["vendor_declared", "measured", "observational"]
    },
    "subject_role": {
      "type": "string",
      "enum": ["candidate", "anchor"]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_model", "observed_model", "substituted"],
      "properties": {
        "requested_model": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "observed_model": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "substituted": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "measured_metadata": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provenance_type", "source_uri", "agy_version", "effort",
            "accounting", "tokenizer", "currency", "cost_basis",
            "confidence", "observed_date", "expiry_date"
          ],
          "properties": {
            "provenance_type": {"enum": ["independent", "local"]},
            "source_uri": {"type": "string", "pattern": "^(https://[a-zA-Z0-9_./-]{1,2000}|local://[a-zA-Z0-9_./-]{1,2000})$"},
            "agy_version": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            "effort": {"enum": ["low", "medium", "high", "none", "unspecified"]},
            "accounting": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            "tokenizer": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            "currency": {"type": "string", "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"},
            "cost_basis": {"enum": ["observed_billed", "version_bound_list_price"]},
            "confidence": {"enum": ["high", "medium", "low"]},
            "observed_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            "expiry_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          }
        }
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "invocation_count",
        "telemetry_bindings",
        "coverage",
        "error_rate",
        "drift_fraction",
        "metrics",
        "uncertainty",
        "verification_passed"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "invocation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "telemetry_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{1,50}$"
          },
          "maxItems": 20
        },
        "coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "error_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "drift_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality_score": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 100.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_p50_seconds": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "latency_p95_seconds": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "mean_input_tokens": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "mean_output_tokens": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "mean_cached_tokens": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "mean_thinking_tokens": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000000.0
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimated_cost_usd": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1000000.0
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100.0
        },
        "verification_passed": {
          "type": "boolean"
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "identity-observation-caller-supplied",
          "observational-evidence-not-measured",
          "provider-declaration-not-measurement",
          "token-telemetry-not-billing-evidence"
        ]
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"lane": {"const": "measured"}}},
      "then": {"properties": {"measured_metadata": {"type": "object"}}},
      "else": {"properties": {"measured_metadata": {"type": "null"}}}
    }
  ]
}
