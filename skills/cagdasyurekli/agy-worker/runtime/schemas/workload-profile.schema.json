{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker data-only workload profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "name", "summary", "suggested_mode",
    "suggested_persona", "path_policy_shape", "caller_required",
    "non_executable", "authority"
  ],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"type": "string", "enum": ["agy-worker-workload-profile"]},
    "name": {
      "type": "string",
      "enum": ["bounded-test-backfill", "diff-review", "repository-inventory"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 160},
    "suggested_mode": {"type": "string", "enum": ["plan", "accept-edits"]},
    "suggested_persona": {
      "type": "string",
      "enum": ["bulk-test-writer", "diff-reviewer", "repo-inventory"]
    },
    "path_policy_shape": {
      "type": "string",
      "enum": [
        "caller-declared-repo-relative-paths",
        "caller-declared-repo-relative-subtrees"
      ]
    },
    "caller_required": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "approval", "exact-repository", "path-policy", "selected-tier",
          "verification-commands"
        ]
      }
    },
    "non_executable": {"type": "boolean", "enum": [true]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance", "authorization", "dispatch", "routing"],
      "properties": {
        "acceptance": {"type": "boolean", "enum": [false]},
        "authorization": {"type": "boolean", "enum": [false]},
        "dispatch": {"type": "boolean", "enum": [false]},
        "routing": {"type": "boolean", "enum": [false]}
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "name": {"const": "bounded-test-backfill"},
        "suggested_mode": {"const": "accept-edits"},
        "suggested_persona": {"const": "bulk-test-writer"},
        "path_policy_shape": {"const": "caller-declared-repo-relative-subtrees"}
      }
    },
    {
      "properties": {
        "name": {"const": "diff-review"},
        "suggested_mode": {"const": "plan"},
        "suggested_persona": {"const": "diff-reviewer"},
        "path_policy_shape": {"const": "caller-declared-repo-relative-paths"}
      }
    },
    {
      "properties": {
        "name": {"const": "repository-inventory"},
        "suggested_mode": {"const": "plan"},
        "suggested_persona": {"const": "repo-inventory"},
        "path_policy_shape": {"const": "caller-declared-repo-relative-subtrees"}
      }
    }
  ]
}
