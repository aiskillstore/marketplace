{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "claim", "status", "version", "limitations"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"type": "string", "enum": ["agy-worker-public-version-attestation"]},
    "claim": {"type": "string", "enum": ["maintainer-reviewed-private-version-reference"]},
    "status": {"type": "string", "enum": ["accepted"]},
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "call_count", "binding_sha256", "profile_sha256", "executable_sha256", "source_sha256", "snapshot_sha256", "runner_sha256", "stdout_sha256", "stderr_sha256"],
      "properties": {
        "observed": {"type": "string", "minLength": 5, "maxLength": 32, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"},
        "call_count": {"type": "integer", "enum": [1]},
        "binding_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "profile_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "executable_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "source_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "snapshot_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "runner_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "stdout_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "stderr_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binary_provenance_proven", "private_evidence_public", "private_evidence_revalidated", "signed"],
      "properties": {
        "binary_provenance_proven": {"type": "boolean", "enum": [false]},
        "private_evidence_public": {"type": "boolean", "enum": [false]},
        "private_evidence_revalidated": {"type": "boolean", "enum": [false]},
        "signed": {"type": "boolean", "enum": [false]}
      }
    }
  }
}
