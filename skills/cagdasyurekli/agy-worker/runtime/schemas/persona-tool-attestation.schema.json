{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "agy_version", "agy_version_binding_sha256", "version_attestation_sha256", "selection_sha256", "verifier_sha256", "dispatcher", "qa_gate", "verify_job", "version_runner"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"type": "string", "enum": ["agy-worker-persona-tool-attestation"]},
    "agy_version": {"type": "string", "minLength": 5, "maxLength": 32, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])"},
    "agy_version_binding_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "version_attestation_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "selection_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "verifier_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "dispatcher": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit", "mode"], "properties": {"path": {"type": "string", "enum": ["skills/agy-worker/runtime/agy-worker.sh"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}, "mode": {"type": "string", "enum": ["100755"]}}},
    "qa_gate": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit", "mode"], "properties": {"path": {"type": "string", "enum": ["skills/agy-worker/runtime/qa-gate.sh"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}, "mode": {"type": "string", "enum": ["100755"]}}},
    "verify_job": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit", "mode"], "properties": {"path": {"type": "string", "enum": ["skills/agy-worker/runtime/verify-job.sh"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}, "mode": {"type": "string", "enum": ["100755"]}}},
    "version_runner": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit", "mode"], "properties": {"path": {"type": "string", "enum": ["scripts/version_attestation_runner.py"]}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}, "mode": {"type": "string", "enum": ["100755"]}}}
  }
}
