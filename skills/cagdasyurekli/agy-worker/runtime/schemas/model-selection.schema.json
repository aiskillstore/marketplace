{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker driver selection record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "selection_mode"],
  "definitions": {
    "v2_version_relation": {
      "oneOf": [
        {
          "properties": {
            "installed_agy_version": {"const": "1.1.22"},
            "matrix_agy_version": {"const": "1.1.22"},
            "version_relation": {"const": "match"},
            "compatibility_status": {"const": "reviewed-version-match"}
          }
        },
        {
          "properties": {
            "installed_agy_version": {"not": {"const": "1.1.22"}},
            "matrix_agy_version": {"const": "1.1.22"},
            "version_relation": {"const": "drift"},
            "compatibility_status": {"const": "critical-interface-compatible-version-drift"}
          }
        }
      ]
    },
    "v3_approved_help": {
      "properties": {
        "installed_agy_version": {"not": {"const": "1.1.22"}},
        "matrix_agy_version": {"const": "1.1.22"},
        "version_relation": {"const": "drift"},
        "compatibility_status": {"const": "critical-interface-compatible-version-drift"}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2, 3]},
    "kind": {"type": "string", "const": "agy-worker-selection"},
    "selection_mode": {"type": "string", "enum": ["tier", "literal-model", "exact-model", "model-effort"]},
    "selected_tier": {"type": "string", "minLength": 1},
    "selected_tier_source": {"type": "string", "enum": ["cli", "environment", "implicit-default"]},
    "user_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
    "user_model_source": {"type": "string", "enum": ["cli", "environment"]},
    "user_effort": {"type": "string", "enum": ["low", "medium", "high"]},
    "user_effort_source": {"type": "string", "enum": ["cli", "environment"]},
    "resolved_agy_model": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 128},
        {"type": "null"}
      ]
    },
    "installed_agy_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_agy_version": {"type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "matrix_source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "version_relation": {"type": "string", "enum": ["match", "drift"]},
    "compatibility_status": {"type": "string", "enum": ["unreconciled-pass-through", "reviewed-version-match", "critical-interface-compatible-version-drift"]},
    "critical_interface_probe_version": {"type": "integer", "const": 1},
    "critical_interface_status": {"type": "string", "const": "compatible"},
    "critical_capabilities_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_availability": {"type": "string", "const": "not_assessed"},
    "compatibility_disposition": {"type": "string", "const": "proceed"},
    "approved_help_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compatibility_decision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probed_executable": {
      "type": "object", "additionalProperties": false,
      "required": ["path_sha256", "target_lstat", "symlink_chain", "components"],
      "properties": {
        "path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_lstat": {
          "type": "object", "additionalProperties": false,
          "required": ["device", "inode", "mode", "uid", "gid", "size", "mtime_ns"],
          "properties": {
            "device": {"type": "integer", "minimum": 1},
            "inode": {"type": "integer", "minimum": 1},
            "mode": {"type": "integer", "minimum": 1},
            "uid": {"type": "integer", "minimum": 0},
            "gid": {"type": "integer", "minimum": 0},
            "size": {"type": "integer", "minimum": 0},
            "mtime_ns": {"type": "integer", "minimum": 0},
            "ctime_ns": {"type": "integer", "minimum": 0}
          }
        },
        "symlink_chain": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path_sha256", "lstat", "target_sha256"],
            "properties": {
              "path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "target_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "lstat": {"type": "object", "additionalProperties": false,
                "required": ["device", "inode", "mode", "uid", "gid", "size", "mtime_ns"],
                "properties": {
                  "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1},
                  "mode": {"type": "integer", "minimum": 1}, "uid": {"type": "integer", "minimum": 0},
                  "gid": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 0},
                  "mtime_ns": {"type": "integer", "minimum": 0},
                  "ctime_ns": {"type": "integer", "minimum": 0}
                }}
            }
          }
        },
        "components": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path_sha256", "lstat"],
            "properties": {
              "path_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "lstat": {"type": "object", "additionalProperties": false,
                "required": ["device", "inode", "mode", "uid", "gid", "size", "mtime_ns"],
                "properties": {
                  "device": {"type": "integer", "minimum": 1}, "inode": {"type": "integer", "minimum": 1},
                  "mode": {"type": "integer", "minimum": 1}, "uid": {"type": "integer", "minimum": 0},
                  "gid": {"type": "integer", "minimum": 0}, "size": {"type": "integer", "minimum": 0},
                  "mtime_ns": {"type": "integer", "minimum": 0},
                  "ctime_ns": {"type": "integer", "minimum": 0}
                }}
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "title": "legacy tier selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "selected_tier",
        "selected_tier_source",
        "resolved_agy_model"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "selection_mode": {"const": "tier"}
      },
      "allOf": [
        {
          "if": {
            "required": ["selected_tier"],
            "properties": {"selected_tier": {"const": "default"}}
          },
          "then": {"properties": {"resolved_agy_model": {"type": "null"}}},
          "else": {"properties": {"resolved_agy_model": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {
            "required": ["selected_tier_source"],
            "properties": {"selected_tier_source": {"const": "implicit-default"}}
          },
          "then": {"properties": {"selected_tier": {"const": "default"}}}
        }
      ],
      "not": {
        "anyOf": [
          {"required": ["user_model"]},
          {"required": ["user_model_source"]},
          {"required": ["user_effort"]},
          {"required": ["user_effort_source"]},
          {"required": ["installed_agy_version"]},
          {"required": ["matrix_sha256"]},
          {"required": ["matrix_agy_version"]},
          {"required": ["matrix_source_revision"]}
          ,{"required": ["compatibility_status"]}, {"required": ["version_relation"]},
          {"required": ["critical_interface_probe_version"]}, {"required": ["critical_interface_status"]},
          {"required": ["critical_capabilities_sha256"]}, {"required": ["help_sha256"]},
          {"required": ["model_availability"]}, {"required": ["probed_executable"]},
          {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
          {"required": ["compatibility_decision_sha256"]}
        ]
      }
    },
    {
      "title": "unreconciled literal model selection",
      "required": [
        "schema_version", "kind", "selection_mode", "user_model",
        "user_model_source", "resolved_agy_model", "compatibility_status"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "selection_mode": {"const": "literal-model"},
        "user_model_source": {"const": "cli"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
        "compatibility_status": {"const": "unreconciled-pass-through"}
      },
      "not": {"anyOf": [
        {"required": ["selected_tier"]}, {"required": ["selected_tier_source"]},
        {"required": ["user_effort"]}, {"required": ["user_effort_source"]},
        {"required": ["installed_agy_version"]}, {"required": ["matrix_sha256"]},
        {"required": ["matrix_agy_version"]}, {"required": ["matrix_source_revision"]},
        {"required": ["version_relation"]}, {"required": ["critical_interface_probe_version"]},
        {"required": ["critical_interface_status"]}, {"required": ["critical_capabilities_sha256"]},
        {"required": ["help_sha256"]}, {"required": ["model_availability"]}, {"required": ["probed_executable"]},
        {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
        {"required": ["compatibility_decision_sha256"]}
      ]}
    },
    {
      "title": "exact reviewed model selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "user_model",
        "user_model_source",
        "resolved_agy_model",
        "installed_agy_version",
        "matrix_sha256",
        "matrix_agy_version",
        "matrix_source_revision"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "selection_mode": {"const": "exact-model"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {
        "anyOf": [
          {"required": ["selected_tier"]},
          {"required": ["selected_tier_source"]},
          {"required": ["user_effort"]},
          {"required": ["user_effort_source"]}
          ,{"required": ["compatibility_status"]}, {"required": ["version_relation"]},
          {"required": ["critical_interface_probe_version"]}, {"required": ["critical_interface_status"]},
          {"required": ["critical_capabilities_sha256"]}, {"required": ["help_sha256"]},
          {"required": ["model_availability"]}, {"required": ["probed_executable"]},
          {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
          {"required": ["compatibility_decision_sha256"]}
        ]
      }
    },
    {
      "title": "reviewed model and effort selection",
      "required": [
        "schema_version",
        "kind",
        "selection_mode",
        "user_model",
        "user_model_source",
        "user_effort",
        "user_effort_source",
        "resolved_agy_model",
        "installed_agy_version",
        "matrix_sha256",
        "matrix_agy_version",
        "matrix_source_revision"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "selection_mode": {"const": "model-effort"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {
        "anyOf": [
          {"required": ["selected_tier"]},
          {"required": ["selected_tier_source"]}
          ,{"required": ["compatibility_status"]}, {"required": ["version_relation"]},
          {"required": ["critical_interface_probe_version"]}, {"required": ["critical_interface_status"]},
          {"required": ["critical_capabilities_sha256"]}, {"required": ["help_sha256"]},
          {"required": ["model_availability"]}, {"required": ["probed_executable"]},
          {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
          {"required": ["compatibility_decision_sha256"]}
        ]
      }
    },
    {
      "title": "v2 exact reviewed model selection",
      "required": ["schema_version", "kind", "selection_mode", "user_model", "user_model_source", "resolved_agy_model", "installed_agy_version", "matrix_sha256", "matrix_agy_version", "matrix_source_revision", "version_relation", "compatibility_status", "critical_interface_probe_version", "critical_interface_status", "critical_capabilities_sha256", "help_sha256", "model_availability", "probed_executable"],
      "properties": {
        "schema_version": {"const": 2},
        "selection_mode": {"const": "exact-model"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {"anyOf": [
        {"required": ["selected_tier"]}, {"required": ["selected_tier_source"]},
        {"required": ["user_effort"]}, {"required": ["user_effort_source"]},
        {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
        {"required": ["compatibility_decision_sha256"]}
      ]},
      "allOf": [{"$ref": "#/definitions/v2_version_relation"}]
    },
    {
      "title": "v2 reviewed model and effort selection",
      "required": ["schema_version", "kind", "selection_mode", "user_model", "user_model_source", "user_effort", "user_effort_source", "resolved_agy_model", "installed_agy_version", "matrix_sha256", "matrix_agy_version", "matrix_source_revision", "version_relation", "compatibility_status", "critical_interface_probe_version", "critical_interface_status", "critical_capabilities_sha256", "help_sha256", "model_availability", "probed_executable"],
      "properties": {
        "schema_version": {"const": 2},
        "selection_mode": {"const": "model-effort"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"}
      },
      "not": {"anyOf": [
        {"required": ["selected_tier"]}, {"required": ["selected_tier_source"]},
        {"required": ["compatibility_disposition"]}, {"required": ["approved_help_sha256"]},
        {"required": ["compatibility_decision_sha256"]}
      ]},
      "allOf": [{"$ref": "#/definitions/v2_version_relation"}]
    },
    {
      "title": "v3 approved drift exact-model selection",
      "required": ["schema_version", "kind", "selection_mode", "user_model", "user_model_source", "resolved_agy_model", "installed_agy_version", "matrix_sha256", "matrix_agy_version", "matrix_source_revision", "version_relation", "compatibility_status", "critical_interface_probe_version", "critical_interface_status", "critical_capabilities_sha256", "help_sha256", "model_availability", "probed_executable", "compatibility_disposition", "approved_help_sha256", "compatibility_decision_sha256"],
      "properties": {
        "schema_version": {"const": 3}, "selection_mode": {"const": "exact-model"},
        "compatibility_disposition": {"const": "proceed"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
        "probed_executable": {
          "allOf": [
            {"$ref": "#/properties/probed_executable"},
            {
              "required": ["content_sha256"],
              "properties": {
                "target_lstat": {"required": ["ctime_ns"]},
                "symlink_chain": {"items": {"properties": {"lstat": {"required": ["ctime_ns"]}}}},
                "components": {"items": {"properties": {"lstat": {"required": ["ctime_ns"]}}}}
              }
            }
          ]
        }
      },
      "allOf": [{"$ref": "#/definitions/v3_approved_help"}],
      "not": {"anyOf": [{"required": ["selected_tier"]}, {"required": ["selected_tier_source"]}, {"required": ["user_effort"]}, {"required": ["user_effort_source"]}]}
    },
    {
      "title": "v3 approved drift model and effort selection",
      "required": ["schema_version", "kind", "selection_mode", "user_model", "user_model_source", "user_effort", "user_effort_source", "resolved_agy_model", "installed_agy_version", "matrix_sha256", "matrix_agy_version", "matrix_source_revision", "version_relation", "compatibility_status", "critical_interface_probe_version", "critical_interface_status", "critical_capabilities_sha256", "help_sha256", "model_availability", "probed_executable", "compatibility_disposition", "approved_help_sha256", "compatibility_decision_sha256"],
      "properties": {
        "schema_version": {"const": 3}, "selection_mode": {"const": "model-effort"},
        "compatibility_disposition": {"const": "proceed"},
        "resolved_agy_model": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$", "maxLength": 128},
        "probed_executable": {
          "allOf": [
            {"$ref": "#/properties/probed_executable"},
            {
              "required": ["content_sha256"],
              "properties": {
                "target_lstat": {"required": ["ctime_ns"]},
                "symlink_chain": {"items": {"properties": {"lstat": {"required": ["ctime_ns"]}}}},
                "components": {"items": {"properties": {"lstat": {"required": ["ctime_ns"]}}}}
              }
            }
          ]
        }
      },
      "allOf": [{"$ref": "#/definitions/v3_approved_help"}],
      "not": {"anyOf": [{"required": ["selected_tier"]}, {"required": ["selected_tier_source"]}]}
    }
  ]
}
