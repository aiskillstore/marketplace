{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker driver selection record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "selection_mode",
    "resolved_agy_model"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 5
    },
    "kind": {
      "type": "string",
      "const": "agy-worker-selection"
    },
    "selection_mode": {
      "type": "string",
      "enum": [
        "agy-default",
        "exact-model",
        "model-effort"
      ]
    },
    "user_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "user_model_source": {
      "type": "string",
      "enum": [
        "cli",
        "environment"
      ]
    },
    "user_effort": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "user_effort_source": {
      "type": "string",
      "enum": [
        "cli",
        "environment"
      ]
    },
    "resolved_agy_model": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "installed_agy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "probed_executable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_sha256",
        "target_lstat",
        "symlink_chain",
        "components",
        "content_sha256"
      ],
      "properties": {
        "path_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_lstat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device",
            "inode",
            "mode",
            "uid",
            "gid",
            "size",
            "mtime_ns",
            "ctime_ns"
          ],
          "properties": {
            "device": {
              "type": "integer",
              "minimum": 1
            },
            "inode": {
              "type": "integer",
              "minimum": 1
            },
            "mode": {
              "type": "integer",
              "minimum": 1
            },
            "uid": {
              "type": "integer",
              "minimum": 0
            },
            "gid": {
              "type": "integer",
              "minimum": 0
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "mtime_ns": {
              "type": "integer",
              "minimum": 0
            },
            "ctime_ns": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "symlink_chain": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path_sha256",
              "lstat",
              "target_sha256"
            ],
            "properties": {
              "path_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "target_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "lstat": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device",
                  "inode",
                  "mode",
                  "uid",
                  "gid",
                  "size",
                  "mtime_ns",
                  "ctime_ns"
                ],
                "properties": {
                  "device": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mtime_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ctime_ns": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "components": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path_sha256",
              "lstat"
            ],
            "properties": {
              "path_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "lstat": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device",
                  "inode",
                  "mode",
                  "uid",
                  "gid",
                  "size",
                  "mtime_ns",
                  "ctime_ns"
                ],
                "properties": {
                  "device": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mode": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "uid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "gid": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mtime_ns": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "ctime_ns": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "selection_mode": {
          "const": "agy-default"
        },
        "resolved_agy_model": {
          "type": "null"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "user_model"
            ]
          },
          {
            "required": [
              "user_model_source"
            ]
          },
          {
            "required": [
              "user_effort"
            ]
          },
          {
            "required": [
              "user_effort_source"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "selection_mode": {
          "const": "exact-model"
        },
        "resolved_agy_model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "user_model",
        "user_model_source"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "user_effort"
            ]
          },
          {
            "required": [
              "user_effort_source"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "selection_mode": {
          "const": "model-effort"
        },
        "resolved_agy_model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "user_model",
        "user_model_source",
        "user_effort",
        "user_effort_source"
      ]
    }
  ],
  "dependencies": {
    "installed_agy_version": [
      "probed_executable"
    ],
    "probed_executable": [
      "installed_agy_version"
    ]
  }
}
