{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "lane",
    "candidate_model_id",
    "anchor_model_ids",
    "anchors",
    "trigger",
    "scenario_id",
    "harness",
    "evaluator",
    "config_sha256",
    "measurement_window",
    "policy",
    "acceptance_rules",
    "budget",
    "drift_tolerance",
    "required_telemetry",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-evidence-campaign-plan"]
    },
    "lane": {
      "type": "string",
      "enum": ["vendor_declared", "measured", "observational"]
    },
    "candidate_model_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
    },
    "anchor_model_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
      },
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true
    },
    "anchors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_review_sha256",
        "inventory_binding_sha256",
        "model_matrix_sha256",
        "dataset_sha256"
      ],
      "properties": {
        "benchmark_review_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "inventory_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_matrix_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark_review_status",
        "review_reason",
        "maintainer_disposition"
      ],
      "properties": {
        "benchmark_review_status": {
          "type": "string",
          "enum": ["benchmark-review-due"]
        },
        "review_reason": {
          "type": "string",
          "enum": ["inventory-added"]
        },
        "maintainer_disposition": {
          "type": "string",
          "enum": ["collect"]
        }
      }
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date"],
      "properties": {
        "start_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._:+-]{1,100}$"
        }
      }
    },
    "acceptance_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_sample_size",
        "min_coverage",
        "max_error_rate",
        "uncertainty_rule"
      ],
      "properties": {
        "min_sample_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "min_coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "max_error_rate": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "min_quality_score": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0.0,
              "maximum": 100.0
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_uncertainty"],
          "properties": {
            "max_uncertainty": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 100.0
            }
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_budget", "invocation_budget"],
      "properties": {
        "sample_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "invocation_budget": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "drift_tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_drift_fraction"],
      "properties": {
        "max_drift_fraction": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "required_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings", "min_coverage"],
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]{1,50}$"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "min_coverage": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "minItems": 1,
      "maxItems": 20
    }
  }
}
