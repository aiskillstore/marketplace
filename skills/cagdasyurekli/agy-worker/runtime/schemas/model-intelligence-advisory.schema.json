{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "evidence_dataset_sha256",
    "task_taxonomy",
    "recommendation_only",
    "applied",
    "dispatch_authorized",
    "model_change_authorized",
    "effort_change_authorized",
    "acceptance_authorized",
    "git_authorized",
    "recommendation",
    "pareto_frontier",
    "reason_code",
    "rationale",
    "limitations",
    "token_inference_disclaimer"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "kind": {
      "type": "string",
      "enum": ["agy-model-intelligence-advisory"]
    },
    "evidence_dataset_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_taxonomy": {
      "type": "string",
      "maxLength": 100
    },
    "recommendation_only": {
      "type": "boolean",
      "enum": [true]
    },
    "applied": {
      "type": "boolean",
      "enum": [false]
    },
    "dispatch_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "model_change_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "effort_change_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "acceptance_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "git_authorized": {
      "type": "boolean",
      "enum": [false]
    },
    "recommendation": {
      "type": "string",
      "maxLength": 100
    },
    "pareto_frontier": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requested_model",
          "effort",
          "quality_score",
          "tradeoff_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "requested_model": {
            "type": "string",
            "maxLength": 100
          },
          "effort": {
            "type": "string",
            "maxLength": 50
          },
          "quality_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "latency_p50_seconds": {
            "oneOf": [
              {"type": "number", "minimum": 0, "maximum": 1000000},
              {"type": "null"}
            ]
          },
          "mean_total_tokens": {
            "oneOf": [
              {"type": "number", "minimum": 0, "maximum": 2000000000},
              {"type": "null"}
            ]
          },
          "estimated_cost_per_task": {
            "oneOf": [
              {"type": "number", "minimum": 0, "maximum": 1000000},
              {"type": "null"}
            ]
          },
          "tradeoff_notes": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "stale-evidence",
        "expired-evidence",
        "incomplete-evidence",
        "calibration-only",
        "substituted-model",
        "incomparable-harness",
        "incomparable-agy-version",
        "incomparable-provenance",
        "incomparable-confidence",
        "incomparable-accounting",
        "incomparable-tokenizer",
        "incomparable-cost-basis",
        "incomparable-taxonomy",
        "no-comparable-models",
        "single-candidate",
        "pareto-tradeoffs",
        "pareto-dominant"
      ]
    },
    "rationale": {
      "type": "string",
      "maxLength": 2000
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "token_inference_disclaimer": {
      "type": "string",
      "enum": [
        "Token observations are telemetry counts only and must never be used to infer billing, quota, allowance, or general cost savings."
      ]
    }
  }
}
