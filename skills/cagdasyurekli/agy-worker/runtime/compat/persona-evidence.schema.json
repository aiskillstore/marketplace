{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agy-worker persona evidence record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "name", "status", "modes", "persona", "offline_evidence", "real_evidence", "transition_approval", "human_review", "limitations"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "kind": {"type": "string", "enum": ["agy-worker-persona-evidence"]},
    "name": {"type": "string", "enum": ["bulk-test-writer", "diff-reviewer", "repo-inventory"]},
    "status": {"type": "string", "enum": ["offline-only", "real-escalation-observed", "accepted-real-candidate"]},
    "modes": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "enum": ["plan", "accept-edits"]}},
    "persona": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 17, "maxLength": 45, "pattern": "^agents/[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.md(?![\\s\\S])"},
        "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}
      }
    },
    "offline_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "benchmark_manifest_path", "benchmark_manifest_sha256", "benchmark_variant_path", "benchmark_variant_sha256", "selection_sha256", "task_id", "initial_sha256", "candidate_sha256", "envelope_sha256", "plan_schema_sha256", "result_schema_sha256", "receipt_schema_sha256", "qa_gate_sha256", "verify_job_sha256", "dispatcher_sha256", "gate_authority", "persona_executed", "live_execution"],
      "properties": {
        "kind": {"type": "string", "enum": ["p1-c-public-contract"]},
        "benchmark_manifest_path": {"type": "string", "enum": ["benchmarks/v1/manifest.json"]},
        "benchmark_manifest_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "benchmark_variant_path": {"type": "string", "enum": ["benchmarks/v1/variants/bulk.json"]},
        "benchmark_variant_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "selection_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "task_id": {"type": "string", "enum": ["exact-edit"]},
        "initial_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "candidate_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "envelope_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "plan_schema_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "result_schema_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "receipt_schema_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "qa_gate_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "verify_job_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "dispatcher_sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "gate_authority": {"type": "string", "enum": ["qa-gate"]},
        "persona_executed": {"type": "boolean", "enum": [false]},
        "live_execution": {"type": "boolean", "enum": [false]}
      }
    },
    "real_evidence": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 160}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}}}]},
    "transition_approval": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 160}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}}}]},
    "human_review": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "commit"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 160}, "sha256": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])"}, "commit": {"type": "string", "minLength": 40, "maxLength": 40, "pattern": "^[0-9a-f]{40}(?![\\s\\S])"}}}]},
    "limitations": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptance_authority", "general_reliability", "persona_enforcement", "prompt_guidance_only"],
      "properties": {
        "acceptance_authority": {"type": "boolean", "enum": [false]},
        "general_reliability": {"type": "boolean", "enum": [false]},
        "persona_enforcement": {"type": "boolean", "enum": [false]},
        "prompt_guidance_only": {"type": "boolean", "enum": [true]}
      }
    }
  }
}
