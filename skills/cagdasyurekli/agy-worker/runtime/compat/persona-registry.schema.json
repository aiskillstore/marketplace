{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "kind": {"enum": ["agy-worker-persona-registry"], "type": "string"},
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {"enum": ["bulk-test-writer", "diff-reviewer", "repo-inventory"], "type": "string"},
          "path": {"maxLength": 37, "minLength": 18, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?\\.json(?![\\s\\S])", "type": "string"},
          "sha256": {"maxLength": 64, "minLength": 64, "pattern": "^[0-9a-f]{64}(?![\\s\\S])", "type": "string"}
        },
        "required": ["name", "path", "sha256"],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "schema_version": {"enum": [1], "type": "integer"},
    "states": {
      "items": {"enum": ["offline-only", "real-escalation-observed", "accepted-real-candidate"], "type": "string"},
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "required": ["schema_version", "kind", "states", "records"],
  "title": "agy-worker persona registry manifest v1",
  "type": "object"
}
