  "content": {
    "user_title": "Optimize Knowledge Graph Entity Presence",
    "value_statement": "Inconsistent entity facts weaken search and AI recognition. This skill audits evidence, resolves identity conflicts, and records authorized canonical updates with provenance.",
    "seo_keywords": [
      "entity optimization",
      "Knowledge Graph audit",
      "Wikidata optimization",
      "schema.org identity",
      "sameAs links",
      "entity disambiguation",
      "AI recognition audit",
      "Claude",
      "Codex",
      "Claude Code"
    ],
    "actual_capabilities": [
      "Audits structured data, knowledge bases, identity consistency, corroboration, and AI recognition signals.",
      "Reconciles duplicate or ambiguous entities using verified cross-links and user confirmation.",
      "Tracks canonical entity types, aliases, domains, QIDs, sameAs links, and disambiguation evidence.",
      "Distinguishes unknown observations from failed or partial checks.",
      "Reviews proposals and records authorized accept, reject, or upsert events through the registry runtime.",
      "Produces prioritized actions with sources, dates, confidence limits, revisions, and unresolved conflicts."
    ],
    "limitations": [
      "Requires the verified registry runtime to persist canonical changes.",
      "Does not create page copy, implement schema markup, or define brand positioning.",
      "Cannot guarantee a Knowledge Panel, Wikipedia eligibility, search ranking, or AI recognition.",
      "Optional recognition checks may be unavailable and must remain unknown."
    ],
    "use_cases": [
      {
        "title": "Audit an organization",
        "description": "Assess machine-facing identity signals and prioritize evidence-backed corrections across owned and authoritative sources.",
        "target_user": "SEO and GEO specialists"
      },
      {
        "title": "Reconcile registry proposals",
        "description": "Review proposed facts, resolve duplicate identifiers, and preserve conflicting evidence before authorized acceptance.",
        "target_user": "Knowledge management teams"
      },
      {
        "title": "Diagnose AI confusion",
        "description": "Compare entity descriptions and associations to identify why AI systems confuse similar organizations or products.",
        "target_user": "Brand and product teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Run a basic entity audit",
        "prompt": "Audit entity recognition for [entity name]. Use [official domain] and these verified profiles: [links]. Mark unavailable checks as unknown.",
        "scenario": "Start with a known organization and a small set of verified sources."
      },
      {
        "title": "Check identity consistency",
        "prompt": "Compare the canonical name, type, domain, schema @id, QID, and sameAs links for [entity]. Report conflicts and missing evidence.",
        "scenario": "Find inconsistent identifiers across owned and external sources."
      },
      {
        "title": "Resolve ambiguous entities",
        "prompt": "Disambiguate [entity A] from [entity B]. Require verified cross-links, preserve conflicting evidence, and propose changes without writing them.",
        "scenario": "Separate organizations, products, or people with similar names."
      },
      {
        "title": "Adjudicate registry proposals",
        "prompt": "Review pending proposals for [aggregate ID] in offset order. Validate provenance, revision expectations, authority, and downstream dependencies before recommending decisions.",
        "scenario": "Perform an advanced governance review before authorized registry updates."
      }
    ],
    "output_examples": [
      {
        "input": "Audit Acme Analytics using its official domain and verified LinkedIn profile.",
        "output": [
          "Structured data: Partial. The organization type is present, but sameAs evidence is incomplete.",
          "Knowledge bases: Unknown. No verified QID was supplied.",
          "Priority action: Verify external identifiers before proposing a canonical update."
        ]
      },
      {
        "input": "Explain why two products named Atlas are being confused.",
        "output": "The records share a name but lack verified cross-links. Keep separate IDs and add domain, product category, and official profile evidence."
      },
      {
        "input": "Review pending changes for entity-7f42.",
        "output": [
          "Proposal review: One fact has current evidence and matching revision context.",
          "Open conflict: Two same-date sources disagree on the canonical domain.",
          "Decision: Leave the conflicting proposal pending until the owner confirms the domain."
        ]
      }
    ],
    "best_practices": [
      "Use primary sources, record observation dates, and preserve provenance for every factual claim.",
      "Require verified cross-links or explicit confirmation before merging similar entities.",
      "Ask before persistent writes and keep capability values out of prompts, files, and logs."
    ],
    "anti_patterns": [
      "Do not treat missing optional checks as failures or partial results.",
      "Do not manufacture notability, citations, profiles, or evidence.",
      "Do not edit canonical event streams or generated projections by hand."
    ],
    "faq": [
      {
        "question": "What entity types can this skill audit?",
        "answer": "It supports organizations, people, brands, products, creative works, events, places, publications, and concepts when reliable evidence exists."
      },
      {
        "question": "Does it create Wikidata or Wikipedia pages?",
        "answer": "No. It assesses eligibility and evidence, but any contribution must follow sourcing, neutrality, notability, and conflict-of-interest rules."
      },
      {
        "question": "Can it guarantee a Knowledge Panel?",
        "answer": "No. It can improve evidence quality and consistency, but search platforms control panel creation and display."
      },
      {
        "question": "Will it update the canonical registry automatically?",
        "answer": "No. Persistent changes require explicit authorization, a verified runtime, valid revisions, and the correct host capability."
      },
      {
        "question": "How does it handle unavailable AI checks?",
        "answer": "It records them as unknown. It does not convert unavailable observations into partial or failed results."
      },
      {
        "question": "How does it protect personal information?",
        "answer": "It requires a lawful basis, minimizes fields, uses pseudonymous IDs, excludes contact details, and respects prior erasure records."
      }
