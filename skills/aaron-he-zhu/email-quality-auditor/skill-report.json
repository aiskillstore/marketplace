  "content": {
    "user_title": "Audit Email Campaigns Before Sending",
    "value_statement": "Email teams need a consistent way to identify release blockers before a campaign is sent. This skill applies structured SEND checks to evidence for authentication, consent, opt-outs, claims, and outcomes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "email quality audit",
      "email deliverability",
      "email consent",
      "campaign readiness",
      "SEND scoring",
      "unsubscribe compliance",
      "email campaign review"
    ],
    "actual_capabilities": [
      "Audits one email program or campaign against 20 SEND criteria.",
      "Checks supplied evidence for authentication, consent, suppressions, claims, and measurement quality.",
      "Separates verified findings from unknown or missing evidence.",
      "Returns SHIP, FIX, BLOCK, or UNDECIDED outcomes when evidence supports them.",
      "Caveats open and click metrics when Apple Mail Privacy Protection affects them.",
      "Creates a persistent audit artifact only after explicit authorization."
    ],
    "limitations": [
      "It evaluates only the evidence supplied or available to the host environment.",
      "It does not send email or change provider, consent, or claim settings.",
      "DNS evidence alone cannot prove inbox placement or deliverability.",
      "Incomplete program evidence produces an UNDECIDED or not-scored result."
    ],
    "use_cases": [
      {
        "title": "Review a newsletter release",
        "description": "Check a planned newsletter for authentication, subscription, suppression, and measurement gaps before release.",
        "target_user": "Email marketer"
      },
      {
        "title": "Assess promotional campaign safety",
        "description": "Evaluate a promotion against consent records, opt-out handling, claims, and order outcome evidence.",
        "target_user": "Lifecycle marketing manager"
      },
      {
        "title": "Establish a program baseline",
        "description": "Create an evidence-based SEND baseline for one program and identify owners for required fixes.",
        "target_user": "Email operations specialist"
      }
    ],
    "prompt_templates": [
      {
        "title": "Audit a newsletter",
        "prompt": "Audit this newsletter before release. I will provide the last 90 days of provider, subscription, suppression, and engagement evidence.",
        "scenario": "Beginner review of one newsletter."
      },
      {
        "title": "Check a promotional send",
        "prompt": "Check this promotional send against DMARC, consent events, live suppressions, rendered content, and order IDs. State any missing evidence.",
        "scenario": "Campaign readiness review."
      },
      {
        "title": "Score an email program",
        "prompt": "Run a SEND audit for our retention program. Use this provider split, MPP share, observation window, lifecycle export, and outcome truth set.",
        "scenario": "Structured program baseline."
      },
      {
        "title": "Request an evidence trace",
        "prompt": "Audit this cold-outbound program and show the evidence trace for every SEND-S1, SEND-S2, SEND-N1, and SEND-D1 decision.",
        "scenario": "Advanced compliance and release review."
      }
    ],
    "output_examples": [
      {
        "input": "Review a complete newsletter profile with aligned authentication and valid consent evidence.",
        "output": [
          "Verdict: SHIP",
          "Score: 81",
          "Verified controls: aligned authentication, live suppression handling, and documented consent.",
          "Caveat: Open-rate evidence is segmented for MPP impact."
        ]
      },
      {
        "input": "Review a promotion with verified scraped-list use and broken opt-out handling.",
        "output": [
          "Verdict: BLOCK",
          "Blocking controls: SEND-S2 and SEND-N1.",
          "Required action: stop the send, remove unlawful recipients, and repair suppression processing."
        ]
      },
      {
        "input": "Review a send with no consent provenance or provider export.",
        "output": [
          "Verdict: UNDECIDED",
          "Score state: NOT_SCORED",
          "Missing inputs: consent provenance and dated provider evidence."
        ]
      }
    ],
    "best_practices": [
      "Provide dated provider, consent, suppression, rendered-content, and outcome evidence.",
      "Declare the program type, market, observation window, list age, and MPP share before scoring.",
      "Treat unknown evidence as a gap and assign an owner before approving a release."
    ],
    "anti_patterns": [
      "Do not treat missing consent evidence as proof of consent.",
      "Do not use DNS configuration alone to claim inbox placement.",
      "Do not replace an explicit verdict or score state with narrative language."
    ],
    "faq": [
      {
        "question": "Does this skill send email?",
        "answer": "No. It audits supplied evidence and does not execute a send."
      },
      {
        "question": "What evidence should I provide?",
        "answer": "Provide provider reports, consent events, live suppressions, rendered messages, and outcome data when available."
      },
      {
        "question": "Can it approve a campaign with missing records?",
        "answer": "No. Missing qualified evidence results in an UNDECIDED or not-scored outcome."
      },
      {
        "question": "Does it change email provider settings?",
        "answer": "No. Provider, consent, claim, and cache mutations require separate explicit approval."
      },
      {
        "question": "How are open rates handled?",
        "answer": "Open rates and CTOR are treated as proxy evidence and require MPP segmentation or caveats."
      },
      {
        "question": "Can it save the audit?",
        "answer": "Yes, but only after explicit authorization to create the defined audit artifact."
      }
    ]
  },
