    "actual_capabilities": [
      "Registers claim and offer proposals with exact wording and terms.",
      "Tracks evidence references, dates, scope, and provenance.",
      "Records disclosures, review dates, expiry dates, and usage pointers.",
      "Separates unresolved proposals from accepted registry records.",
      "Regenerates readable claims and offers views from accepted state."
    ],
    "limitations": [
      "Does not verify legal compliance or make legal conclusions.",
