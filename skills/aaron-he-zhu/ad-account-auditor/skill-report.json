      "campaign measurement integrity",
      "ad placement safety"
    ],
    "actual_capabilities": [
      "Applies direct-response, prospecting, or incremental-profit ROAS profiles.",
      "Normalizes currency, attribution windows, conversion lag, IDs, and portfolio scope.",
      "Scores 20 Return, Offer, Audience, and Spend Efficiency criteria using typed evidence states.",
      "Verifies five veto controls for tracking, attribution, claims, policy, and placement safety.",
      "Reports the gate, score or missing coverage, confidence, reconciliation, unknown evidence, and prioritized fixes.",
      "Creates a permissioned v3 audit artifact only after explicit authorization."
    ],
    "limitations": [
      "Requires normalized account exports and own-data outcomes; it does not connect to ad platforms automatically.",
      "Cannot produce a comparable score when required context or evidence is missing.",
      "Does not modify campaigns, bids, audiences, budgets, claims, or account state.",
      "Standalone installs collect observations but cannot calculate final scores without the root deterministic runtime."
    ],
