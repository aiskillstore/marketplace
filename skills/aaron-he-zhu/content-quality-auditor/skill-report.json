  "content": {
    "user_title": "Audit Content Quality and E-E-A-T Readiness",
    "value_statement": "Content audits can miss weak evidence, disclosure gaps, and publish blockers. This skill applies an 80-item CORE-EEAT review with typed states and prioritized fixes.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "content quality audit",
      "E-E-A-T audit",
      "publish readiness",
      "SEO content review",
      "evidence coverage",
      "content compliance"
    ],
    "actual_capabilities": [
      "Audits one declared content artifact against 80 stable CORE-EEAT items.",
      "Applies profile-specific weights for nine supported content types.",
      "Records pass, partial, fail, unknown, and not-applicable states with evidence.",
      "Checks qualified vetoes for promise mismatch, factual contradiction, and missing material-connection disclosure.",
      "Produces SHIP, FIX, BLOCK, or UNDECIDED guidance when the required runtime and evidence are available."
    ],
    "limitations": [
      "A comparable score requires complete evidence for every applicable item.",
      "The audit does not predict search rankings, citations, traffic, or business outcomes.",
      "Visual and mobile claims require rendered captures or user-provided exports.",
      "Standalone installations without the root runtime cannot calculate scores, persist artifacts, or issue a gate verdict."
    ],
    "use_cases": [
      {
        "title": "Review a Draft Before Publication",
        "description": "Find evidence gaps, trust issues, and priority fixes before an article enters final approval.",
        "target_user": "Content editors"
      },
      {
        "title": "Compare Content Quality Consistently",
        "description": "Apply one versioned framework across reviews, comparisons, guides, landing pages, and other supported profiles.",
        "target_user": "SEO specialists"
      },
      {
        "title": "Check Claims and Disclosures",
        "description": "Identify material contradictions, promise mismatches, and missing relationship disclosures in higher-risk content.",
        "target_user": "Compliance and marketing teams"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Draft Audit",
        "prompt": "Audit this blog post for the U.S. market before publication: [paste content]. Show the verdict, major findings, and priority fixes.",
        "scenario": "Use for a first publish-readiness review."
      },
      {
        "title": "Evidence Gap Review",
        "prompt": "Audit this how-to guide with CORE-EEAT. List every unknown item, required evidence, and the fastest actions needed for a complete score.",
        "scenario": "Use when source coverage may be incomplete."
      },
      {
        "title": "Comparison Content Audit",
        "prompt": "Audit this comparison for [market]. Verify claim support, author expertise, methodology, disclosures, contradictions, and profile-specific evidence: [content and sources].",
        "scenario": "Use for commercial comparison content."
      },
      {
        "title": "Advanced Re-Audit",
        "prompt": "Re-audit this revised product review against the prior findings. Preserve item traceability, explain score changes, verify vetoes, and identify remaining evidence gaps.",
        "scenario": "Use after evidence-backed revisions."
      }
    ],
    "output_examples": [
      {
        "input": "A complete blog post with citations, author details, and publication context.",
        "output": "Verdict: FIX. Strong research coverage, but the article needs clearer methodology, a corrections policy reference, and two claim-level citations."
      },
      {
        "input": "A product review with affiliate links but no visible relationship disclosure.",
        "output": "Verdict: FIX. A material connection exists without adequate disclosure, so the final score is capped until the disclosure is corrected."
      },
      {
        "input": "A draft with missing source records and no rendered evidence.",
        "output": "Verdict: UNDECIDED. The audit lists unknown items, the missing inputs, current coverage, and the available score interval without inventing a total."
      }
    ],
    "best_practices": [
      "Provide one stable artifact, its content type, market, publication state, and observation date.",
      "Include primary sources, author details, disclosures, policies, and rendered captures when relevant.",
      "Use the same runtime and catalog version when comparing audits over time."
    ],
    "anti_patterns": [
      "Do not request a numeric score when applicable evidence is missing.",
      "Do not treat the audit as a guarantee of rankings, citations, or conversions.",
      "Do not select a content profile only because it produces a higher score."
    ],
    "faq": [
      {
        "question": "What content types are supported?",
        "answer": "The skill supports reviews, guides, comparisons, landing pages, blog posts, FAQs, alternatives, best-of pages, and testimonials."
      },
      {
        "question": "Does every audit produce a score?",
        "answer": "No. Missing applicable evidence produces an UNDECIDED result with coverage, gaps, and an interval instead of a comparable total."
      },
      {
        "question": "Can it audit a live URL?",
        "answer": "Yes. Provide the URL, content type, market, publication state, and any evidence unavailable from the rendered page."
      },
      {
        "question": "Does it replace legal or medical review?",
        "answer": "No. It checks evidence and presentation but does not provide professional advice or fabricate expert approval."
      },
      {
        "question": "What can block publication?",
        "answer": "Qualified vetoes cover material promise mismatch, material internal factual contradiction, and absent disclosure for a material relationship."
      },
      {
        "question": "Can it save audit results?",
        "answer": "Only with explicit permission, the full repository runtime, the required validator, and a valid constrained artifact path."
      }
    ]
