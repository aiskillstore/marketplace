      {
        "title": "Prepare a Product Page",
        "description": "Check metadata, product headings, image optimization, internal links, and schema signals before launch.",
        "target_user": "E-commerce manager"
      },
      {
        "title": "Triage a Content Portfolio",
        "description": "Sample grouped URLs, identify repeated template issues, and prioritize fixes across many pages.",
        "target_user": "SEO consultant"
      }
    ],
    "prompt_templates": [
      {
        "title": "Basic Page Audit",
        "prompt": "Audit the on-page SEO of [URL] for [target keyword]. Score each area and list the three highest-priority fixes.",
        "scenario": "Review one page with a known target keyword."
      },
      {
        "title": "Prepublication Review",
        "prompt": "Review this draft for on-page SEO before publication: [content]. Infer a keyword, label assumptions, and suggest improved metadata.",
        "scenario": "Optimize a draft without keyword research data."
      },
      {
        "title": "Competitor Comparison",
        "prompt": "Compare [your URL] with [competitor URL] for [keyword]. Identify evidence-based gaps in titles, headings, content structure, links, and images.",
        "scenario": "Benchmark one page against a competing result."
      },
      {
        "title": "Bulk Portfolio Audit",
        "prompt": "Cluster and sample these URLs: [URLs]. Report common issues, estimated prevalence, confidence, portfolio priorities, and pages needing individual review.",
        "scenario": "Prioritize improvements across five or more pages."
      }
    ],
    "output_examples": [
      {
        "input": "Audit a headphone guide targeting best noise cancelling headphones.",
        "output": "Overall score: 71/100. Priorities: strengthen internal links, add missing image descriptions, and rewrite the meta description with a clear action."
      },
      {
        "input": "Review six articles before publication without target keywords.",
        "output": [
          "Status: completed with concerns because keywords were inferred.",
          "Repeated issue: weak metadata across sampled drafts.",
          "Next action: validate inferred keywords before publishing."
        ]
      }
    ],
    "best_practices": [
      "Provide the page URL, target keyword, page type, and business goal.",
      "Separate measured evidence from user-provided data and model estimates.",
      "Confirm client-rendered content before reporting missing schema or headings."
    ],
    "anti_patterns": [
      "Do not treat estimated keyword demand or rankings as measured data.",
      "Do not use a single-page audit as a full technical crawl.",
      "Do not apply sampled bulk findings to every URL without confidence labels."
    ],
    "faq": [
      {
        "question": "Can this skill audit a page without a target keyword?",
        "answer": "Yes. It infers a provisional keyword from the page and clearly labels that assumption for later validation."
      },
      {
        "question": "Does it fetch live web pages?",
        "answer": "Yes, when a compatible fetch tool is available. You can also provide HTML or pasted content."
      },
      {
        "question": "Can it audit multiple pages?",
        "answer": "Yes. For five or more URLs, it clusters pages, samples each cluster, and reports estimated pattern prevalence."
      },
      {
        "question": "Does it check Core Web Vitals?",
        "answer": "No. It focuses on page-controlled SEO signals and routes performance diagnostics to technical SEO tools."
      },
      {
        "question": "Can it detect JavaScript-injected schema?",
        "answer": "Only with rendered page content. Raw fetches can miss schema added by client-side scripts."
      },
      {
        "question": "What does the final report include?",
        "answer": "It includes section scores, evidence, prioritized issues, quick wins, recommendations, an action checklist, and a handoff summary."
      }
