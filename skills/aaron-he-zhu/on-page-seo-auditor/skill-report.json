    "actual_capabilities": [
      "Scores titles, metadata, headings, content structure, keywords, links, images, and page-level tags.",
      "Suggests optimized titles, descriptions, headings, links, and image improvements.",
      "Infers a provisional target keyword when the user provides none.",
      "Compares page-level signals against competitor pages.",
      "Samples URL clusters and reports pattern-level findings for bulk audits."
    ],
    "limitations": [
      "It does not provide full crawl, indexing, Core Web Vitals, or HTTPS diagnostics.",
      "It cannot verify search volume or ranking data without connected sources.",
      "Raw HTML fetches can miss client-rendered schema and content.",
      "Bulk findings are estimates when only sampled pages are reviewed."
    ],
    "use_cases": [
      {
