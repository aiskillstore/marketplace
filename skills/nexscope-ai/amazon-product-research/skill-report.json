  "content": {
    "user_title": "Research Amazon Product Opportunities",
    "value_statement": "Amazon sellers need evidence before buying inventory. This skill structures demand, competition, profit, and entry research for Amazon product ideas.",
    "seo_keywords": [
      "Claude",
      "Codex",
      "Claude Code",
      "Amazon product research",
      "Amazon seller research",
      "product opportunity analysis",
      "market validation",
      "profit margin analysis",
      "competition analysis",
      "FBA product research"
    ],
    "actual_capabilities": [
      "Scores product opportunities across demand, competition, profit, entry difficulty, growth, differentiation, seasonality, and risk",
      "Guides public web research for search trends, category context, and social validation",
      "Maps competitor density, market leaders, review patterns, and price segments",
      "Builds profit estimates with product cost, Amazon fees, FBA fees, shipping, marketing, and returns",
      "Compares multiple products with side-by-side scoring and a clear recommendation",
      "Flags market, operational, regulatory, and financial risks before sourcing"
    ],
    "limitations": [
      "It relies on public web data unless the user provides paid marketplace data.",
      "Sales volume, supplier cost, and margin estimates require direct verification.",
      "It does not connect to Amazon Seller Central or supplier systems.",
      "Regulatory guidance is directional and is not legal advice."
    ],
    "use_cases": [
      {
        "title": "Validate a First Product",
        "description": "Compare demand, competition, and startup costs before buying inventory.",
        "target_user": "New Amazon seller"
      },
      {
        "title": "Screen a Product Pipeline",
        "description": "Rank product ideas and focus research on the strongest opportunities.",
        "target_user": "Ecommerce team lead"
      },
      {
        "title": "Prepare a Client Brief",
        "description": "Create structured opportunity reports with risks, margins, and launch considerations.",
        "target_user": "Marketplace consultant"
      }
    ],
    "prompt_templates": [
      {
        "title": "Research One Product",
        "scenario": "Beginner product validation",
        "prompt": "Research [product] as an Amazon opportunity in [marketplace]. Score demand, competition, profit potential, entry difficulty, and key risks."
      },
      {
        "title": "Compare Two Ideas",
        "scenario": "Intermediate product selection",
        "prompt": "Compare [product A] and [product B] for Amazon [marketplace]. Recommend the stronger option with scoring, margins, and entry barriers."
      },
      {
        "title": "Analyze a Supplier Lead",
        "scenario": "Advanced margin validation",
        "prompt": "I can source [product] for [cost] and sell near [price]. Estimate fees, margin, competition, demand, and launch risks."
      },
      {
        "title": "Build a Category Entry Plan",
        "scenario": "Advanced go-to-market planning",
        "prompt": "Create a go-to-market research plan for [category] on Amazon [marketplace]. Include positioning, differentiation, sourcing checks, compliance, and success metrics."
      }
    ],
    "output_examples": [
      {
        "input": "Research smart water bottles for Amazon US.",
        "output": "The report scores demand, competition, profit, and entry difficulty. It highlights pricing bands, review gaps, margin assumptions, and a pursue or avoid recommendation."
      },
      {
        "input": "Compare yoga mats and resistance bands for Amazon UK.",
        "output": "The comparison ranks both products across core factors. It identifies the stronger opportunity, explains tradeoffs, and lists next validation steps."
      },
      {
        "input": "Validate a product that costs 3 dollars and sells for 25 dollars.",
        "output": "The analysis estimates landed cost, Amazon fees, marketing allowance, and realistic net margin. It flags sourcing, quality, and inventory risks."
      }
    ],
    "best_practices": [
      "Research three to five related products before choosing one opportunity.",
      "Verify fees, supplier costs, and compliance requirements with primary sources.",
      "Use customer complaints to define differentiation before sourcing inventory."
    ],
    "anti_patterns": [
      "Do not treat public search estimates as confirmed sales data.",
      "Do not ignore regulations for electronics, food, beauty, medical, or children products.",
      "Do not launch commodity products without a clear differentiation plan."
    ],
